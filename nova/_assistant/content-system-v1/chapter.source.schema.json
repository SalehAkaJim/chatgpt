{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova://content-system-v1/chapter.source.schema.json",
  "title": "Nova canonical Chapter source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","contentSystemVersion","courseCode","cefrLevel","chapterKey","sortOrder","titleEn","titleFa","primaryOutcomeKey","scenarioFa","learningUnits","lessons"],
  "properties": {
    "schemaVersion": {"const": "1.1.0"},
    "contentSystemVersion": {"const": "1"},
    "courseCode": {"const": "en-fa"},
    "cefrLevel": {"const": "A1"},
    "chapterKey": {"type": "string", "pattern": "^EN-A1-CH-[0-9]{4}$"},
    "sortOrder": {"type": "integer", "minimum": 1},
    "titleEn": {"type": "string", "minLength": 1, "maxLength": 180},
    "titleFa": {"type": "string", "minLength": 1, "maxLength": 180},
    "descriptionFa": {"type": "string"},
    "primaryOutcomeKey": {"type": "string", "minLength": 1},
    "reinforcementOutcomeKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "prerequisiteOutcomeKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "scenarioFa": {"type": "string", "minLength": 1},
    "learningUnits": {"type": "array", "items": {"$ref": "#/$defs/learningUnit"}},
    "lessons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lesson"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "learningUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitKey","unitType","displayForm","translationFa"],
      "properties": {
        "unitKey": {"type": "string", "minLength": 1},
        "unitType": {"enum": ["lexical_item","construction","grammar","pronunciation"]},
        "lexicalKind": {"enum": ["word","multiword_expression"]},
        "displayForm": {"type": "string", "minLength": 1, "maxLength": 255},
        "translationFa": {"type": "string", "minLength": 1, "maxLength": 500},
        "descriptionFa": {"type": "string"},
        "lemma": {"type": "string", "minLength": 1, "maxLength": 255},
        "partOfSpeech": {"type": "string", "minLength": 1, "maxLength": 64},
        "senseKey": {"type": "string", "minLength": 1, "maxLength": 160},
        "audioEligible": {"type": "boolean"},
        "data": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"unitType": {"const": "lexical_item"}}, "required": ["unitType"]},
          "then": {"required": ["lexicalKind","lemma","partOfSpeech","senseKey","audioEligible"]}
        }
      ]
    },
    "unitRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitKey","role"],
      "properties": {
        "unitKey": {"type": "string", "minLength": 1},
        "role": {"enum": ["target","review","support","incidental"]}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnKey","role","textEn","translationFa"],
      "properties": {
        "turnKey": {"type": "string", "pattern": "^T[0-9]{2,3}$"},
        "role": {"enum": ["character","learner","system"]},
        "characterKey": {"type": "string", "minLength": 1},
        "textEn": {"type": "string", "minLength": 1},
        "translationFa": {"type": "string", "minLength": 1},
        "speechTargetEn": {"type": "string", "minLength": 1},
        "acceptedSpeechEn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "audioRequired": {"type": "boolean", "default": true},
        "metadata": {"type": "object"}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activityKey","type","purpose","instructionFa"],
      "properties": {
        "activityKey": {"type": "string", "pattern": "^A[0-9]{2,3}$"},
        "type": {"enum": ["listen","speak","meaning_choice","word_order","reading","writing","pronunciation","unit_teach","response_choice"]},
        "purpose": {"enum": ["exposure","noticing","supported","retrieval","transfer","mastery"]},
        "instructionFa": {"type": "string", "minLength": 1},
        "promptFa": {"type": "string"},
        "promptEn": {"type": "string"},
        "sourceTurnKey": {"type": "string"},
        "targetUnitKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "acceptedAnswersEn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "config": {"type": "object"}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessonKey","sortOrder","lessonType","titleEn","titleFa","objectiveFa","unitRoles","turns","activities"],
      "properties": {
        "lessonKey": {"type": "string", "pattern": "^L[0-9]{2}$"},
        "sortOrder": {"type": "integer", "minimum": 1},
        "lessonType": {"enum": ["dialogue","scenario","listening","reading","practice","review","mixed"]},
        "titleEn": {"type": "string", "minLength": 1, "maxLength": 180},
        "titleFa": {"type": "string", "minLength": 1, "maxLength": 180},
        "objectiveFa": {"type": "string", "minLength": 1},
        "interlocutorKey": {"type": "string"},
        "estimatedDurationSec": {"type": "integer", "minimum": 30},
        "unitRoles": {"type": "array", "items": {"$ref": "#/$defs/unitRole"}},
        "turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}},
        "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
        "metadata": {"type": "object"}
      }
    }
  }
}
