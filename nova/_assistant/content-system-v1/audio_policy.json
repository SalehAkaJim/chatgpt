{
  "version": "2.2.0",
  "enabled": true,
  "requiredForPilotCompletion": true,
  "provider": "ElevenLabs",
  "learningLanguage": "en",
  "turnAudio": {
    "requiredByDefault": true,
    "voiceMode": "character_voice_key",
    "pathTemplate": "nova/audio/turns/{course}/{lessonKey}/{turnKey}.mp3",
    "characterIdentityRequiredForRoles": [
      "character",
      "learner"
    ],
    "courseWideLearnerVoiceAllowed": false
  },
  "lexicalAudio": {
    "enabled": true,
    "voiceMode": "fixed_course_lexical_voice",
    "voiceName": "Lori",
    "allowSingleWord": true,
    "allowValidatedMultiwordExpression": true,
    "pathTemplate": "nova/audio/lexical/{course}/{asset_identity_hash}.mp3",
    "registry": "nova/audio/lexical/{course}/index.json",
    "identityFields": [
      "sourceText",
      "voiceId",
      "modelId"
    ],
    "reuseAcrossLessons": true
  },
  "qa": {
    "manifestRequired": true,
    "exactSourceHashRequired": true,
    "decodeCheckRequired": true,
    "durationCheckRequired": true,
    "voiceCheckRequired": true,
    "staleAudioCheckRequired": true,
    "sourceTextMatchRequired": true
  }
}
