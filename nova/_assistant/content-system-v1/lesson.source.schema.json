{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova://content-system-v1/lesson.source.schema.json",
  "title": "Nova canonical Lesson source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion","contentSystemVersion","courseCode","levelKey",
    "lessonKey","sortOrder","titleEn","titleFa","primaryOutcomeKey",
    "outcomeFa","scenarioFa","lexicalItems","turns","activities"
  ],
  "properties": {
    "schemaVersion": {"const": "2.2.0"},
    "contentSystemVersion": {"const": "1"},
    "courseCode": {"type": "string", "minLength": 1},
    "levelKey": {"type": "string", "minLength": 1},
    "lessonKey": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "sortOrder": {"type": "integer", "minimum": 1},
    "titleEn": {"type": "string", "minLength": 1, "maxLength": 180},
    "titleFa": {"type": "string", "minLength": 1, "maxLength": 180},
    "descriptionFa": {"type": "string"},
    "primaryOutcomeKey": {"type": "string", "minLength": 1},
    "outcomeFa": {"type": "string", "minLength": 1},
    "scenarioFa": {"type": "string", "minLength": 1},
    "prerequisiteOutcomeKeys": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}, "default": []
    },
    "curriculum": {"type": "object"},
    "lexicalItems": {
      "type": "array",
      "items": {"$ref": "#/$defs/lexicalItem"}
    },
    "turns": {
      "type": "array",
      "items": {"$ref": "#/$defs/turn"}
    },
    "activities": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/activity"}
    },
    "review": {"$ref": "#/$defs/review"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "lexicalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexicalKey","itemType","displayForm","translationFa","role","audioEligible"],
      "properties": {
        "lexicalKey": {"type": "string", "minLength": 1},
        "itemType": {"enum": ["word","expression","phrasal_verb"]},
        "displayForm": {"type": "string", "minLength": 1, "maxLength": 255},
        "translationFa": {"type": "string", "minLength": 1, "maxLength": 500},
        "role": {"enum": ["target","review","support","incidental"]},
        "lemma": {"type": "string", "maxLength": 255},
        "partOfSpeech": {"type": "string", "maxLength": 64},
        "senseKey": {"type": "string", "maxLength": 160},
        "audioEligible": {"type": "boolean"},
        "metadata": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"itemType": {"enum": ["expression","phrasal_verb"]}}},
          "then": {
            "required": ["metadata"],
            "properties": {
              "metadata": {
                "anyOf": [
                  {"required": ["referenceKey"]},
                  {
                    "required": ["lexicalized","lexicalizationEvidence"],
                    "properties": {
                      "lexicalized": {"const": true},
                      "lexicalizationEvidence": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"displayForm": {"pattern": "\\s"}}},
          "then": {
            "required": ["metadata"],
            "properties": {
              "metadata": {
                "anyOf": [
                  {"required": ["referenceKey"]},
                  {
                    "required": ["lexicalized","lexicalizationEvidence"],
                    "properties": {
                      "lexicalized": {"const": true},
                      "lexicalizationEvidence": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnKey","role","textEn","translationFa","audioRequired"],
      "allOf": [{"if":{"properties":{"role":{"enum":["character","learner"]}}},"then":{"required":["characterKey"]}}],
      "properties": {
        "turnKey": {"type": "string", "pattern": "^T[0-9]{2,3}$"},
        "role": {"enum": ["character","learner","system"]},
        "characterKey": {"type": "string", "minLength": 1},
        "textEn": {"type": "string", "minLength": 1},
        "translationFa": {"type": "string", "minLength": 1},
        "speechTargetEn": {"type": "string", "minLength": 1},
        "acceptedSpeechEn": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "audioRequired": {"type": "boolean"},
        "metadata": {"type": "object"}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activityKey","type","instructionFa","config"],
      "properties": {
        "activityKey": {"type": "string", "pattern": "^A[0-9]{2,3}$"},
        "type": {
          "enum": [
            "dialogue","speak","sentence_order","fill_blank","comprehension",
            "listen","reading","pronunciation","writing","lexical_teach","response_choice"
          ]
        },
        "instructionFa": {"type": "string"},
        "promptFa": {"type": "string"},
        "promptEn": {"type": "string"},
        "config": {"type": "object"},
        "metadata": {"type": "object"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pendingDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decisionKey","question","recommendedOption","rationale"],
            "properties": {
              "decisionKey": {"type": "string", "minLength": 1},
              "question": {"type": "string", "minLength": 1},
              "options": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "recommendedOption": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
