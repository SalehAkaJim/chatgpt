{
  "schemaVersion": 2,
  "enforceFromSortOrder": 125,
  "legacyRemediation": {
    "fromSortOrder": 40,
    "toSortOrder": 84,
    "hardGatePlaceholderDistractors": true,
    "hardGateKnownBadEnglishDistractors": true
  },
  "distractors": {
    "bannedPlaceholderPatternsFa": [
      "یک معنی نامربوط",
      "نام یک شخص",
      "یک گزینه نامربوط",
      "معنی نامربوط",
      "گزینه نامربوط"
    ],
    "bannedGenericOptionsEn": [
      "People like coffee.",
      "This is my house."
    ],
    "bannedExactOptionsEn": [
      "I read tea.",
      "I read there is a pen.",
      "Read, very help.",
      "read action.",
      "I read action.",
      "I very go there.",
      "I very eat there.",
      "book here is good.",
      "It is book.",
      "Try very.",
      "Wait at the book.",
      "read me the map.",
      "I read tired.",
      "read the bag there."
    ],
    "requireExplicitEnglishDistractorAuditFromSortOrder": 125
  },
  "naturalness": {
    "banTeacherDirectiveDialogueFromEnforcement": true,
    "teacherDirectivePrefixes": ["Say:", "Say ", "Now say:", "Now say "],
    "bannedExactUtterances": [
      "I know this pen.",
      "This week is busy.",
      "Next week is free."
    ],
    "maxUsageFallbacksPerLessonBeforeWarning": 5
  },
  "wave": {
    "size": 8,
    "requiredArchetypes": [
      "lexical_context",
      "grammar_pattern",
      "story_task",
      "review_recombination",
      "listening_focus",
      "functional_exchange"
    ],
    "minimumDistinctArchetypes": 3,
    "maximumSameArchetype": 4,
    "minimumDistinctActivitySignatures": 3,
    "minimumGrammarFocusedLessons": 2,
    "minimumReviewRecombinationLessons": 1,
    "minimumLegacyReviewItems": 4
  },
  "spacedRetrieval": {
    "futureTargetFirstReviewMinGap": 3,
    "futureTargetFirstReviewMaxGap": 10,
    "legacyBacklogFromSortOrder": 40,
    "legacyBacklogToSortOrder": 84
  },
  "releaseReadiness": {
    "requireRealLearnerPilotForPublicRelease": true,
    "minimumLearners": 10,
    "minimumLessonsPerLearner": 20,
    "minimumCompletedSessions": 100
  }
}
