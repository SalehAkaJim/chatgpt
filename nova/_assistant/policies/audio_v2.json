{
  "version": "2.0.0",
  "provider": "elevenlabs",
  "publication_gate": true,
  "turn_audio": {
    "required_coverage": 1,
    "model": "eleven_multilingual_v2",
    "format": "mp3_44100_64",
    "distinct_voice_per_character": true,
    "course_scoped_voice_maps": true
  },
  "word_audio": {
    "required_eligible_coverage": 1,
    "voice_name": "Lori - Happy and Sweet",
    "source_voice_id": "TbMNBJ27fH2U0VgpSNko",
    "max_phrase_tokens": 3,
    "max_phrase_characters": 48,
    "exclude_sentence_ending_punctuation": true
  },
  "paths": {
    "turns": "nova/audio/turns/{course}/...",
    "words": "nova/audio/words/{course}/...",
    "state": "nova/audio/{course}/"
  },
  "failure_policy": "commit_resumable_progress_then_fail; never mark chapter complete without full coverage"
}
