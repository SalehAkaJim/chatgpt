    "chapter_empty_guard",
    "batch_cross_chapter_duplicate_target_audit",
    "level_progression_audit",
    "v9_0_only_no_DDL",
    "course_scope_audit",
    "all_used_word_tuples_materialized",
    "new_word_definitions_complete"
