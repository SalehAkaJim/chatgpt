{
  "version": "3.2.0",
  "paused": false,
  "stop_requested": false,
  "maintenance_mode": null,
  "allow_new_chapters": true,
  "max_chapters_per_run": 2,
  "on_failure": "repair_same_series_without_pausing_automation",
  "allow_series_gaps": false,
  "state_model": {
    "generation_pointer": "generated_through_series",
    "publication_pointer": "published_through_series",
    "next_series_rule": "generated_through_series + 1"
  },
  "repair_policy": {
    "max_repair_cycles_per_run": 3,
    "resume_same_series_next_run": true,
    "automation_must_remain_enabled": true,
    "advance_generated_state_after_local_gates_pass": true,
    "advance_published_state_only_after_all_publication_gates_pass": true
  }
}
