{
  "version": "3.0.0",
  "course": "de-fa",
  "contract": "nova/contracts/independent_course_v3.json",
  "curriculum": "nova/courses/de-fa/curriculum.json",
  "schema_base": "nova/database/schema_v9.sql",
  "schema_semantic_layer": "nova/database/semantic_layer_v10.sql",
  "mode": "audit_and_repair_only",
  "new_chapter_generation_enabled": false,
  "max_chapters_per_run": 2,
  "strict_sequential": true,
  "qa_required": true,
  "linguistic_audit_required": true,
  "curriculum_gate_required": true,
  "review_ledger_required": true,
  "audio_required": true,
  "writing_allowed": true,
  "writing_required_from_level": "A2",
  "dynamic_activity_count": [12, 18],
  "fixed_activity_distribution": false,
  "publish_batch_size": 2,
  "sequential_chapter_gate": true,
  "repair_policy": {
    "repair_existing_before_new": true,
    "max_repair_cycles_per_run": 3,
    "resume_same_series_next_run": true,
    "advance_state_only_after_structural_linguistic_curriculum_review_mysql_audio_pass": true
  }
}
