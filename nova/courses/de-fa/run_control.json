{
  "version": "2.0.0",
  "paused": false,
  "stop_requested": false,
  "max_chapters_per_run": 2,
  "on_failure": "repair_same_series_without_pausing_automation",
  "allow_series_gaps": false,
  "repair_policy": {
    "max_repair_cycles_per_run": 3,
    "resume_same_series_next_run": true,
    "automation_must_remain_enabled": true,
    "advance_state_only_after_all_gates_pass": true
  }
}
