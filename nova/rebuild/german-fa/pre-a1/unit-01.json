  "lessons": [
    {
      "id": "fa-de-pre-a1-u01-l01",
      "title_fa": "سلام کردن",
      "stages": [
        {
          "type": "exposure",
          "items": [
            {"type":"utterance","de":"Guten Morgen.","fa":"صبح بخیر."},
            {"type":"utterance","de":"Guten Tag.","fa":"سلام / روز بخیر."},
            {"type":"utterance","de":"Guten Abend.","fa":"عصر بخیر."}
          ]
        },
        {
          "type": "teach",
          "items": [
            {"type":"lexeme","de":"Morgen","fa":"صبح","note_fa":"در عبارت Guten Morgen برای سلام صبحگاهی به‌کار می‌رود."},
            {"type":"lexeme","de":"Tag","fa":"روز","note_fa":"Guten Tag یک سلام رایج و نسبتاً رسمی در طول روز است."},
            {"type":"lexeme","de":"Abend","fa":"عصر / شب","note_fa":"Guten Abend هنگام عصر و اوایل شب استفاده می‌شود."}
          ]
        },
        {
          "type": "practice",
          "items": [
            {"type":"choice","prompt_fa":"برای سلام کردن در صبح کدام عبارت مناسب است؟","options_de":["Guten Morgen.","Guten Abend.","Auf Wiedersehen."],"answer":0},
            {"type":"choice","prompt_fa":"«Guten Abend» یعنی چه؟","options_fa":["عصر بخیر","صبح بخیر","خداحافظ"],"answer":0}
          ]
        }
      ]
    },
    {
      "id": "fa-de-pre-a1-u01-l02",
      "title_fa": "حالت چطوره؟",
      "stages": [
        {
          "type":"dialogue",
          "items":[
            {"type":"utterance","de":"Wie geht es Ihnen?","fa":"حال شما چطور است؟","annotations":[{"surface":"Ihnen","fa":"شما","explanation_fa":"ضمیر رسمی برای خطاب محترمانه."}]},
            {"type":"utterance","de":"Danke, sehr gut.","fa":"ممنون، خیلی خوبم."},
            {"type":"utterance","de":"Danke, auch gut.","fa":"ممنون، من هم خوبم."}
          ]
        },
        {
          "type":"practice",
          "items":[
            {"type":"choice","prompt_fa":"کسی می‌پرسد «Wie geht es Ihnen?»؛ کدام پاسخ مناسب است؟","options_de":["Danke, sehr gut.","Wo ist der Flughafen?","Guten Abend."],"answer":0}
          ]
        }
      ]
    },
    {
      "id":"fa-de-pre-a1-u01-l03",
      "title_fa":"فهمیدن و درخواست تکرار",
      "stages":[
        {"type":"exposure","items":[
          {"type":"utterance","de":"Verstehen Sie mich?","fa":"حرف من را می‌فهمید؟","annotations":[{"surface":"verstehen","fa":"فهمیدن"},{"surface":"mich","fa":"من را"}]},
          {"type":"utterance","de":"Ja, ich verstehe Sie gut.","fa":"بله، حرف شما را خوب می‌فهمم."},
          {"type":"utterance","de":"Wie bitte?","fa":"ببخشید؟ / چی فرمودید؟"},
          {"type":"utterance","de":"Sprechen Sie bitte langsam.","fa":"لطفاً آهسته صحبت کنید.","annotations":[{"surface":"langsam","fa":"آهسته"},{"surface":"bitte","fa":"لطفاً"}]}
        ]},
        {"type":"recall","items":[
          {"type":"choice","prompt_fa":"اگر طرف مقابل خیلی سریع صحبت می‌کند چه می‌گویید؟","options_de":["Sprechen Sie bitte langsam.","Das Wasser ist gut.","Guten Morgen."],"answer":0}
        ]}
      ]
    },
    {
      "id":"fa-de-pre-a1-u01-l04",
      "title_fa":"پیدا کردن یک مکان",
      "stages":[
        {"type":"dialogue","items":[
          {"type":"utterance","de":"Wo ist der Flughafen?","fa":"فرودگاه کجاست؟","annotations":[{"surface":"Wo","fa":"کجا"},{"surface":"Flughafen","fa":"فرودگاه","grammar_note_fa":"اسم مذکر: der Flughafen"}]},
          {"type":"utterance","de":"Der Flughafen ist dort drüben.","fa":"فرودگاه آنجاست."},
          {"type":"utterance","de":"Wo ist das Café?","fa":"کافه کجاست؟"},
          {"type":"utterance","de":"Dort, geradeaus.","fa":"آنجا، مستقیم جلو."}
        ]},
        {"type":"mastery","items":[
          {"type":"choice","prompt_fa":"«فرودگاه کجاست؟» را انتخاب کن.","options_de":["Wo ist der Flughafen?","Wie geht es Ihnen?","Möchten Sie essen?"],"answer":0},
          {"type":"choice","prompt_fa":"«geradeaus» در این موقعیت چه معنی دارد؟","options_fa":["مستقیم جلو","سمت چپ","خیلی آهسته"],"answer":0}
        ]}
      ]
    }
  ]
}
