{
  "schemaVersion": 3,
  "courseCode": "en-fa",
  "qualityThreshold": 90,
  "cefrPrecedence": [
    "cefrj_exact_pos",
    "octanove_exact_pos",
    "cefrj_lemma_consensus",
    "octanove_lemma_consensus",
    "openjam_frequency_band"
  ],
  "dialogueLicensePolicy": {
    "approvedLicenses": [
      "CC-BY-4.0",
      "CC-BY-SA-4.0"
    ],
    "defaultReuseMode": "verbatim-first",
    "preserveAttribution": true,
    "preserveSourceText": true,
    "shareAlikeRule": "CC-BY-SA dialogue may be copied verbatim. Any learner-visible adaptation must retain provenance and be distributed under a compatible ShareAlike license."
  },
  "sources": {
    "openjam": {
      "repository": "amirj4m/openjam",
      "commit": "e05622665494f18d414190b5f738dc1eb4b414fa",
      "datasetVersion": "0.8.1",
      "license": "MIT",
      "files": {
        "words": "data/json/words_en.json",
        "translationsFa": "data/json/translations_fa.json",
        "categories": "data/json/categories.json",
        "wordCategories": "data/json/word_categories.json"
      }
    },
    "cefrj": {
      "repository": "openlanguageprofiles/olp-en-cefrj",
      "commit": "d4e45b75b38f27b30dfc5c44d8c571aec7e7092f",
      "license": "free commercial use with attribution per project terms",
      "files": {
        "vocabulary": "cefrj-vocabulary-profile-1.5.csv",
        "grammar": "cefrj-grammar-profile-20180315.csv",
        "c1c2": "octanove-vocabulary-profile-c1c2-1.0.csv"
      }
    },
    "cmudict": {
      "repository": "cmusphinx/cmudict",
      "commit": "74790861f652b15e4ac49015a90074ad62a27690",
      "license": "CMUdict permissive license",
      "files": {
        "dictionary": "cmudict.dict"
      }
    },
    "ngslSpoken": {
      "datasetVersion": "1.2",
      "sourceUrl": "https://charliebrownecompany.squarespace.com/s/NGSL-Spoken_12_stats.csv",
      "license": "CC BY-SA 4.0",
      "snapshotPolicy": "download-and-hash"
    },
    "tatoeba": {
      "apiBase": "https://api.tatoeba.org/v1/sentences",
      "apiSchema": "https://api.tatoeba.org/openapi.json",
      "license": "per-sentence license retained in snapshot",
      "snapshotPolicy": "query-and-pin-sentence-ids",
      "filters": {
        "lang": "eng",
        "is_orphan": "no",
        "is_unapproved": "no"
      }
    },
    "taskmaster": {
      "repository": "google-research-datasets/Taskmaster",
      "commit": "d92cb6af3005f1dc09c39e75e7daf4a04905e00b",
      "dataset": "TM-1-2019",
      "license": "CC-BY-4.0",
      "attribution": "Taskmaster-1, Google Research",
      "reuseMode": "verbatim-or-attributed-adaptation",
      "files": {
        "selfDialogs": "TM-1-2019/self-dialogs.json",
        "wozDialogs": "TM-1-2019/woz-dialogs.json"
      }
    },
    "schemaGuidedDialogue": {
      "repository": "google-research-datasets/dstc8-schema-guided-dialogue",
      "commit": "e852981ae34990f4358979625854259302feaa78",
      "dataset": "Schema-Guided Dialogue",
      "license": "CC-BY-SA-4.0",
      "attribution": "Schema-Guided Dialogue Dataset, Google Research",
      "reuseMode": "verbatim-sharealike",
      "treeDiscovery": {
        "include": [
          "train/dialogues_*.json",
          "dev/dialogues_*.json",
          "test/dialogues_*.json"
        ]
      }
    }
  }
}
