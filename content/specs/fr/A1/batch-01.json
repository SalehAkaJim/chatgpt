,["demain","demain","فردا","adverb",1],["midi","midi","ظهر","noun",2],["soir","soir","عصر / شب","noun",2],["quand","quand","کی / چه زمانی","question_word",2]],"utterances":[["u1","Quelle heure est-il ?","ساعت چنده؟","ask_time",["heure"],1],["u2","Il est huit heures.","ساعت هشت است.","tell_time",["heure"],1],["u3","On se voit demain ?","فردا همدیگه رو می‌بینیم؟","suggest_plan",["demain"],2],["u4","Quand est-ce que tu travailles ?","کی کار می‌کنی؟","ask_schedule",["quand"],2]],"grammar":["Il est + heure","Clock time uses il est followed by the number and heure(s).","برای گفتن ساعت از il est + عدد + heure(s) استفاده می‌شود: Il est huit heures.",[["Il est midi.","ظهر است."],["Il est huit heures.","ساعت هشت است."]]],"dialogues":[["Le rendez-vous","قرار",[["emma","Quelle heure est-il ?","ساعت چنده؟"],["hugo","Il est neuf heures.","ساعت نه است."],["emma","Le cours est à dix heures ?","کلاس ساعت دهه؟"],["hugo","Oui, à dix heures.","بله، ساعت ده."]],1],["Demain ?","هماهنگ کردن",[["julien","On se voit demain ?","فردا همدیگه رو ببینیم؟"],["nora","Oui. Le matin ou le soir ?","بله. صبح یا شب؟"],["julien","Le soir, vers sept heures.","شب، حدود ساعت هفت."],["nora","D'accord.","باشه."]],2]]},{"slug":"cafe-basics","topic":"food-drink","title":"Je voudrais un café","vocab":[["cafe","café","قهوه","noun",1],["the","thé","چای","noun",1],["eau","eau","آب","noun",1],["croissant","croissant","کروسان","noun",2],["voudrais","je voudrais","می‌خواهم / مایل هستم","chunk",2],["avec","avec","با","preposition",2]],"utterances":[["u1","Je voudrais un café, s'il vous plaît.","یک قهوه می‌خواهم، لطفاً.","order_drink",["cafe","voudrais"],1],["u2","Une eau, s'il vous plaît.","یک آب، لطفاً.","order_drink",["eau"],1],["u3","Un croissant avec un café.","یک کروسان با یک قهوه.","order_food",["croissant","avec","cafe"],2],["u4","Vous avez du thé ?","چای دارید؟","ask_availability",["the"],2]],"grammar":["Je voudrais…","Je voudrais is a polite high-frequency way to order or request something.","برای سفارش مؤدبا