      "utterances": [["u1","Vado in centro.","به مرکز شهر می‌روم.","state_destination",["andare","centro"],1],["u2","Vai alla stazione?","به ایستگاه قطار می‌روی؟","ask_destination",["andare","stazione"],1],["u3","Prendo l'autobus.","سوار اتوبوس می‌شوم / اتوبوس می‌گیرم.","state_transport",["autobus"],2],["u4","Dov'è la fermata?","ایستگاه اتوبوس کجاست؟","ask_transport_location",["fermata"],2]],
      "grammar": ["Vado a / in...","With andare, Italian commonly uses a with cities and in with many countries, regions and certain places.","با andare برای شهرها معمولاً a می‌آید: vado a Roma. برای کشورها و بعضی مکان‌ها in رایج است: vado in Italia، vado in centro.",[["Vado a Roma.","به رم می‌روم."],["Vado in centro.","به مرکز شهر می‌روم."]]],
      "dialogues": [["Alla stazione","در مسیر",[["sofia","Vai alla stazione?","به ایستگاه می‌روی؟"],["davide","Sì, prendo il treno per Firenze.","بله، قطار فلورانس را می‌گیرم."],["sofia","Anch'io vado da quella parte.","من هم آن سمت می‌روم."],["davide","Andiamo insieme.","با هم برویم."]],1],["La fermata","خیابان",[["giulia","Scusa, dov'è la fermata dell'autobus?","ببخشید، ایستگاه اتوبوس کجاست؟"],["matteo","È davanti al bar.","جلوی کافه است."],["giulia","È lontana?","دور است؟"],["matteo","No, due minuti a piedi.","نه، دو دقیقه پیاده."]],2]]
