      "dialogues": [["Il prezzo","فروشگاه",[["elena","Quanto costa questa borsa?","این کیف چنده؟"],["marco","Costa trenta euro.","سی یورو است."],["elena","È un po' cara.","یک‌کم گران است."],["marco","Questa costa venti.","این یکی بیست است."]],1],["La taglia giusta","فروشگاه لباس",[["chiara","Avete questa in una taglia più grande?","این را در سایز بزرگ‌تر دارید؟"],["luca","Sì, un momento.","بله، یک لحظه."],["chiara","Questa va bene.","این خوب است."],["luca","Perfetto.","عالیه."]],2]]
