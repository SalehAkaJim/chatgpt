      "utterances": [["u1","Quanto costa questo?","این چقدر قیمت دارد؟","ask_price",["costare"],1],["u2","Costa dieci euro.","ده یورو قیمت دارد.","state_price",["costare","euro"],1],["u3","Questa taglia è grande.","این سایز بزرگ است.","describe_size",["taglia"],2],["u4","Questi sono più economici.","این‌ها ارزان‌تر هستند.","compare_price",["questi","economico"],2]],
