    {"slug":"past-weekend","topic":"daily-routine","title":"Hafta sonu ne yaptın?","objective":"Talk about completed past events and sequence a short weekend story.","grammar_focus":"definite past -di and personal endings","vocab":[["dun","dün","دیروز","adverb",1],["hafta_sonu","hafta sonu","آخر هفته","noun",1],["gezmek","gezmek","گشتن / گردش کردن","verb",1],["gormek","görmek","دیدن","verb",2],["yapmak","yapmak","انجام دادن","verb",2],["sonra","sonra","بعد / سپس","adverb",2]],"utterances":[["u1","Dün arkadaşlarımla gezdim.","دیروز با دوستانم گردش کردم.","tell_past_event",["dun","gezmek"],1],["u2","Hafta sonu ne yaptın?","آخر هفته چه کار کردی؟","ask_past_event",["hafta_sonu","yapmak"],1],["u3","Bir film gördüm.","یک فیلم دیدم.","tell_past_event",["gormek"],2],["u4","Sonra eve döndüm.","بعد به خانه برگشتم.","sequence_past",["sonra"],2]],"grammar":["Belirli geçmiş zaman: -di","Use the -di family for completed events the speaker presents as definite.","برای اتفاق تمام‌شده‌ای که گوینده آن را قطعی و مشخص بیان می‌کند از خانوادهٔ -di استفاده می‌کنیم: geldim «آمدم»، gördüm «دیدم».",[["Dün çalıştım.","دیروز کار کردم."],["Bir film gördüm.","یک فیلم دیدم."]]],"dialogues":[["Hafta sonu","دوشنبه صبح",[["Elif","Hafta sonu ne yaptın?","آخر هفته چه کار کردی؟"],["Mert","Arkadaşlarımla gezdim.","با دوستانم گردش کردم."],["Elif","Nereye gittiniz?","کجا رفتید؟"],["Mert","Kadıköy'e gittik.","به کادیکوی رفتیم."]],1],["Dün akşam","صحبت بعد از کلاس",[["Kaan","Dün akşam evde miydin?","دیشب خانه بودی؟"],["Selin","Hayır, sinemaya gittim.","نه، سینما رفتم."],["Kaan","Film nasıldı?","فیلم چطور بود؟"],["Selin","Güzeldi.","خوب بود."]],2]]},
    {"slug":"habits-and-frequency","topic":"daily-routine","title":"Genelde erken kalkarım","objective":"Describe routines, habits and frequency in ordinary life.","grammar_focus":"aorist/geniş zaman for habitual actions","vocab":[["genelde","genelde","معمولاً","adverb",1],["her_gun","her gün","هر روز","expression",1],["bazen","bazen","گاهی","adverb",1],["erken","erken","زود","adverb",2],["gec","geç","دیر","adverb",2],["kalkmak","kalkmak","بیدار شدن / بلند شدن","verb",2]],"utterances":[["u1","Genelde erken kalkarım.","معمولاً زود بیدار می‌شوم.","state_habit",["genelde","erken","kalkmak"],1],["u2","Her gün kahve içer misin?","هر روز قهوه می‌نوشی؟","ask_habit",["her_gun"],1],["u3","Bazen geç yatarım.","گاهی دیر می‌خوابم.","state_frequency",["bazen","gec"],2],["u4","Pazar günleri uzun kahvaltı yaparız.","یکشنبه‌ها صبحانه مفصل می‌خوریم.","state_shared_habit",[],2]],"grammar":["Geniş zaman","Use the aorist/geniş zaman to talk about habits, routines and general tendencies.","برای عادت‌ها و کارهای معمول از geniş zaman استفاده می‌شود: kalkarım «معمولاً بیدار می‌شوم»، içer misin? «معمولاً می‌نوشی؟».",[["Her gün yürürüm.","هر روز پیاده‌روی می‌کنم."],["Bazen evde kalırım.","گاهی خانه می‌مانم."]]],"dialogues":[["Sabah rutini","آشپزخانه",[["Deniz","Genelde kaçta kalkarsın?","معمولاً ساعت چند بیدار می‌شوی؟"],["Zeynep","Yedide kalkarım.","ساعت هفت بیدار می‌شوم."],["Deniz","Kahvaltı yapar mısın?","صبحانه می‌خوری؟"],["Zeynep","Evet, her gün yaparım.","بله، هر روز می‌خورم."]],1],["Pazar planı","آخر هفته",[["Emre","Pazar günleri ne yaparsın?","یکشنبه‌ها چه کار می‌کنی؟"],["Burak","Bazen ailemi ziyaret ederim.","گاهی به خانواده‌ام سر می‌زنم."],["Emre","Ben genelde evde kalırım.","من معمولاً خانه می‌مانم."],["Burak","Bu hafta birlikte çıkalım.","این هفته با هم بیرون برویم."]],2]]},
    {"slug":"comparisons","topic":"shopping","title":"Bu daha uygun","objective":"Compare options by price, size and quality and express a preference.","grammar_focus":"comparatives with daha and kadar","vocab":[["daha","daha","بیشتر / ـتر","adverb",1],["ucuz","ucuz","ارزان","adjective",1],["pahali","pahalı","گران","adjective",1],["buyuk","büyük","بزرگ","adjective",2],["kucuk","küçük","کوچک","adjective",2],["uygun","uygun","مناسب","adjective",2]],"utterances":[["u1","Bu çanta daha ucuz.","این کیف ارزان‌تر است.","compare_price",["daha","ucuz"],1],["u2","Hangisi daha uygun?","کدام‌یک مناسب‌تر است؟","ask_comparison",["daha","uygun"],1],["u3","Mavi olan daha büyük.","آن آبی بزرگ‌تر است.","compare_size",["daha","buyuk"],2],["u4","Bu, diğeri kadar pahalı değil.","این به گرانی آن یکی نیست.","compare_degree",["pahali"],2]],"grammar":["Karşılaştırma: daha ... / ... kadar","Use daha before an adjective for a simple comparative; kadar can compare degree.","برای مقایسهٔ ساده، daha قبل از صفت می‌آید: daha ucuz «ارزان‌تر». با kadar می‌توان گفت چیزی به اندازهٔ چیز دیگری یک ویژگی را دارد یا ندارد.",[["Bu daha hızlı.","این سریع‌تر است."],["O kadar pahalı değil.","آن‌قدر گران نیست."]]],"dialogues":[["İki telefon","فروشگاه",[["Selin","Hangisi daha uygun?","کدام مناسب‌تر است؟"],["Kaan","Bu daha ucuz.","این ارزان‌تر است."],["Selin","Ama diğeri daha büyük.","اما آن یکی بزرگ‌تر است."],["Kaan","Evet, karar vermek zor.","بله، تصمیم گرفتن سخت است."]],1],["Otel seçimi","برنامه سفر",[["Mert","Bu otel daha pahalı.","این هتل گران‌تر است."],["Elif","Ama merkeze daha yakın.","اما به مرکز نزدیک‌تر است."],["Mert","Diğeri de uygun görünüyor.","آن یکی هم مناسب به نظر می‌رسد."],["Elif","Fiyatlara tekrar bakalım.","دوباره قیمت‌ها را ببینیم."]],2]]},
    {"slug":"polite-requests","topic":"restaurants","title":"Yardım edebilir misiniz?","objective":"Make polite requests, ask permission and respond appropriately.","grammar_focus":"polite ability/request forms -ebilir misiniz","vocab":[["yardim","yardım","کمک","noun",1],["mumkun","mümkün","ممکن","adjective",1],["getirmek","getirmek","آوردن","verb",1],["vermek","vermek","دادن","verb",2],["beklemek","beklemek","صبر کردن","verb",2],["lutfen","lütfen","لطفاً","adverb",2]],"utterances":[["u1","Yardım edebilir misiniz?","می‌توانید کمک کنید؟","polite_request",["yardim"],1],["u2","Menüyü getirebilir misiniz?","می‌توانید منو را بیاورید؟","polite_request",["getirmek"],1],["u3","Bir dakika bekleyebilir misiniz?","می‌توانید یک دقیقه صبر کنید؟","polite_request",["beklemek"],2],["u4","Lütfen bana su verir misiniz?","لطفاً به من آب می‌دهید؟","polite_request",["lutfen","vermek"],2]],"grammar":["Kibar istek: -ebilir misiniz?","Use the ability form plus a question to make polite requests to people you do not know well.","برای درخواست مؤدبانه، ساختار -ebilir misiniz? بسیار طبیعی است: Yardım edebilir misiniz? یعنی «می‌توانید کمک کنید؟».",[["Kapıyı açabilir misiniz?","می‌توانید در را باز کنید؟"],["Biraz bekleyebilir misiniz?","می‌توانید کمی صبر کنید؟"]]],"dialogues":[["Restoranda","رستوران",[["Zeynep","Affedersiniz, menüyü getirebilir misiniz?","ببخشید، می‌توانید منو را بیاورید؟"],["Emre","Tabii, hemen getiriyorum.","حتماً، همین الان می‌آورم."],["Zeynep","Bir de su alabilir miyim?","یک آب هم می‌توانم بگیرم؟"],["Emre","Elbette.","حتماً."]],1],["Resepsiyonda","هتل",[["Deniz","Yardım edebilir misiniz?","می‌توانید کمک کنید؟"],["Burak","Tabii, sorun nedir?","حتماً، مشکل چیست؟"],["Deniz","Bir taksi çağırabilir misiniz?","می‌توانید یک تاکسی صدا کنید؟"],["Burak","Tabii ki.","البته."]],2]]},
    {"slug":"appointments-and-plans","topic":"time","title":"Yarın buluşabiliriz","objective":"Arrange appointments, suggest times and negotiate availability.","grammar_focus":"future planning and ability with -ebilir","vocab":[["bulusmak","buluşmak","همدیگر را دیدن / قرار گذاشتن","verb",1],["musait","müsait","آزاد / وقت‌دار","adjective",1],["randevu","randevu","قرار / نوبت","noun",1],["ogleden_sonra","öğleden sonra","بعدازظهر","expression",2],["degistirmek","değiştirmek","تغییر دادن","verb",2],["uygun","uygun","مناسب","adjective",2]],"utterances":[["u1","Yarın buluşabiliriz.","فردا می‌توانیم همدیگر را ببینیم.","suggest_meeting",["bulusmak"],1],["u2","Öğleden sonra müsait misin?","بعدازظهر وقت داری؟","ask_availability",["ogleden_sonra","musait"],1],["u3","Randevuyu değiştirebilir miyiz?","می‌توانیم قرار را تغییر دهیم؟","renegotiate_plan",["randevu","degistirmek"],2],["u4","Saat dört benim için uygun.","ساعت چهار برای من مناسب است.","confirm_time",["uygun"],2]],"grammar":["-ebilir / -abilir ile plan","Ability forms can soften suggestions and make scheduling language flexible.","ساختار -ebilir/-abilir فقط «توانستن» نیست؛ در برنامه‌ریزی برای پیشنهاد نرم و قابل مذاکره هم می‌آید: Yarın buluşabiliriz «می‌توانیم فردا قرار بگذاریم».",[["Akşam konuşabiliriz.","می‌توانیم عصر صحبت کنیم."],["Saati değiştirebilir miyiz?","می‌توانیم ساعت را عوض کنیم؟"]]],"dialogues":[["Kahve randevusu","پیام تلفنی",[["Kaan","Yarın müsait misin?","فردا وقت داری؟"],["Selin","Öğleden sonra müsaitim.","بعدازظهر وقتم آزاد است."],["Kaan","Dörtte buluşabilir miyiz?","می‌توانیم ساعت چهار همدیگر را ببینیم؟"],["Selin","Evet, dört uygun.","بله، چهار مناسب است."]],1],["Randevu değişikliği","تماس کلینیک",[["Elif","Randevuyu değiştirebilir miyiz?","می‌توانیم نوبت را تغییر دهیم؟"],["Mert","Hangi gün uygunsunuz?","چه روزی برایتان مناسب است؟"],["Elif","Cuma öğleden sonra.","جمعه بعدازظهر."],["Mert","Tamam, değiştirdim.","باشه، تغییرش دادم."]],2]]},
    {"slug":"health-and-advice","topic":"health","title":"Biraz dinlenmelisin","objective":"Describe common symptoms and give or understand simple advice.","grammar_focus":"necessity/advice with -meli/-malı","vocab":[["bas","baş","سر","noun",1],["agri","ağrı","درد","noun",1],["dinlenmek","dinlenmek","استراحت کردن","verb",1],["ilac","ilaç","دارو","noun",2],["doktor","doktor","پزشک","noun",2],["iyi","iyi","خوب","adjective",2]],"utterances":[["u1","Başım ağrıyor.","سرم درد می‌کند.","state_symptom",["bas","agri"],1],["u2","Biraz dinlenmelisin.","باید کمی استراحت کنی.","give_advice",["dinlenmek"],1],["u3","Doktora gitmelisin.","باید پیش پزشک بروی.","give_advice",["doktor"],2],["u4","Bu ilacı yemekle almalısın.","باید این دارو را همراه غذا بخوری.","give_instruction",["ilac"],2]],"grammar":["Gereklilik: -meli / -malı","Use -meli/-malı for necessity and common advice.","برای «باید» و توصیهٔ نسبتاً مستقیم از -meli/-malı استفاده می‌شود: dinlenmelisin یعنی «باید استراحت کنی».",[["Su içmelisin.","باید آب بنوشی."],["Doktora gitmelisin.","باید پیش پزشک بروی."]]],"dialogues":[["Kendini iyi hissetmiyorum","خانه",[["Mert","İyi misin?","خوبی؟"],["Elif","Pek değil. Başım ağrıyor.","نه خیلی. سرم درد می‌کند."],["Mert","Biraz dinlenmelisin.","باید کمی استراحت کنی."],["Elif","Haklısın.","حق با توست."]],1],["Eczanede","داروخانه",[["Selin","Bu ilacı ne zaman almalıyım?","این دارو را چه زمانی باید بخورم؟"],["Kaan","Yemekten sonra almalısınız.","باید بعد از غذا بخورید."],["Selin","Günde kaç kez?","روزی چند بار؟"],["Kaan","İki kez.","دو بار."]],2]]},
    {"slug":"travel-and-hotel","topic":"travel","title":"Rezervasyonum var","objective":"Handle a simple hotel stay, check-in and basic travel problems.","grammar_focus":"possessive and case combinations in travel contexts","vocab":[["rezervasyon","rezervasyon","رزرو","noun",1],["oda","oda","اتاق","noun",1],["kimlik","kimlik","مدرک شناسایی","noun",1],["anahtar","anahtar","کلید","noun",2],["gece","gece","شب","noun",2],["kalmak","kalmak","ماندن","verb",2]],"utterances":[["u1","Rezervasyonum var.","رزرو دارم.","state_reservation",["rezervasyon"],1],["u2","İki gece kalacağım.","دو شب می‌مانم.","state_future_stay",["gece","kalmak"],1],["u3","Kimliğinizi görebilir miyim?","می‌توانم مدرک شناسایی‌تان را ببینم؟","request_document",["kimlik"],2],["u4","Oda anahtarınız burada.","کلید اتاقتان اینجاست.","hand_over_item",["oda","anahtar"],2]],"grammar":["İyelik + durum ekleri","Turkish can stack possessive and case endings; travel phrases often combine them.","در ترکی پسوندها می‌توانند پشت سر هم بیایند. در موقعیت‌های سفر، مالکیت و حالت دستوری زیاد با هم می‌آیند؛ مثلاً rezervasyonum «رزروِ من».",[["Rezervasyonum var.","رزرو دارم."],["Odanız hazır.","اتاقتان آماده است."]]],"dialogues":[["Otele giriş","پذیرش هتل",[["Deniz","Merhaba, rezervasyonum var.","سلام، رزرو دارم."],["Zeynep","Adınız nedir?","نامتان چیست؟"],["Deniz","Deniz Kaya.","دنیز کایا."],["Zeynep","Evet, odanız hazır.","بله، اتاقتان آماده است."]],1],["Oda sorunu","پذیرش هتل",[["Burak","Affedersiniz, oda anahtarım çalışmıyor.","ببخشید، کلید اتاقم کار نمی‌کند."],["Emre","Kontrol edeyim.","بگذارید بررسی کنم."],["Burak","Teşekkür ederim.","ممنونم."],["Emre","Yeni anahtarınız burada.","کلید جدیدتان اینجاست."]],2]]},
    {"slug":"reasons-and-results","topic":"daily-routine","title":"Trafik olduğu için geç kaldım","objective":"Give simple reasons and connect cause with a result.","grammar_focus":"causal clauses with için","vocab":[["cunku","çünkü","چون","conjunction",1],["icin","için","برای / به دلیل","postposition",1],["trafik","trafik","ترافیک","noun",1],["gec_kalmak","geç kalmak","دیر رسیدن","verb",2],["yorgun","yorgun","خسته","adjective",2],["bu_yuzden","bu yüzden","به همین دلیل","expression",2]],"utterances":[["u1","Trafik olduğu için geç kaldım.","چون ترافیک بود دیر رسیدم.","give_reason",["trafik","icin","gec_kalmak"],1],["u2","Neden gelmedin?","چرا نیامدی؟","ask_reason",[],1],["u3","Çünkü çok yorgundum.","چون خیلی خسته بودم.","give_reason",["cunku","yorgun"],2],["u4","Otobüs gelmedi, bu yüzden taksiye bindim.","اتوبوس نیامد، برای همین تاکسی گرفتم.","state_result",["bu_yuzden"],2]],"grammar":["Neden-sonuç: çünkü / ... için","Use çünkü to introduce a reason; ... olduğu için and similar forms connect a cause before the result.","برای گفتن دلیل می‌توان از çünkü «چون» استفاده کرد. ساختار ... olduğu için دلیل را قبل از نتیجه می‌آورد و در A2 بسیار پرکاربرد است.",[["Çünkü hastaydım.","چون مریض بودم."],["Yağmur olduğu için evde kaldık.","چون باران بود خانه ماندیم."]]],"dialogues":[["Geç kaldım","محل کار",[["Kaan","Neden geç kaldın?","چرا دیر رسیدی؟"],["Selin","Trafik olduğu için.","به خاطر ترافیک."],["Kaan","Otobüs de geç mi geldi?","اتوبوس هم دیر آمد؟"],["Selin","Evet, bu yüzden taksiye bindim.","بله، برای همین تاکسی گرفتم."]],1],["Davet","تماس دوستانه",[["Elif","Dün neden gelmedin?","دیروز چرا نیامدی؟"],["Mert","Çünkü çok yorgundum.","چون خیلی خسته بودم."],["Elif","Şimdi daha iyi misin?","الان بهتری؟"],["Mert","Evet, teşekkürler.","بله، ممنون."]],2]]},
    {"slug":"choices-and-preferences","topic":"shopping","title":"Ben bunu tercih ederim","objective":"Express preferences, compare alternatives and justify a choice.","grammar_focus":"preference with tercih etmek and -mek istemek","vocab":[["tercih","tercih","ترجیح","noun",1],["secenek","seçenek","گزینه","noun",1],["renk","renk","رنگ","noun",1],["rahat","rahat","راحت","adjective",2],["denemek","denemek","امتحان کردن","verb",2],["bence","bence","به نظر من","adverb",2]],"utterances":[["u1","Ben bunu tercih ederim.","من این را ترجیح می‌دهم.","state_preference",["tercih"],1],["u2","Hangi seçeneği istersin?","کدام گزینه را می‌خواهی؟","ask_preference",["secenek"],1],["u3","Bence bu daha rahat.","به نظر من این راحت‌تر است.","justify_preference",["bence","rahat"],2],["u4","Mavi olanı denemek istiyorum.","می‌خواهم آن آبی را امتحان کنم.","state_choice",["renk","denemek"],2]],"grammar":["Tercih ve seçim","Use tercih etmek, istemek and comparative language to make and justify choices.","برای بیان انتخاب می‌توان از tercih etmek «ترجیح دادن» و istemek «خواستن» همراه با مقایسه استفاده کرد. در A2 بهتر است دلیل کوتاه هم اضافه کنیم.",[["Bunu tercih ederim.","این را ترجیح می‌دهم."],["Daha rahat olduğu için bunu istiyorum.","چون راحت‌تر است این را می‌خواهم."]]],"dialogues":[["Ayakkabı seçimi","فروشگاه کفش",[["Zeynep","Hangisini tercih edersin?","کدام را ترجیح می‌دهی؟"],["Deniz","Bence siyah olan daha rahat.","به نظرم آن مشکی راحت‌تر است."],["Zeynep","Denemek ister misin?","می‌خواهی امتحانش کنی؟"],["Deniz","Evet, lütfen.","بله، لطفاً."]],1],["Yemek seçimi","رستوران",[["Emre","Et mi, balık mı?","گوشت یا ماهی؟"],["Burak","Balığı tercih ederim.","ماهی را ترجیح می‌دهم."],["Emre","Neden?","چرا؟"],["Burak","Daha hafif olduğu için.","چون سبک‌تر است."]],2]]},
    {"slug":"a2-city-day-capstone","topic":"travel","title":"İstanbul'da yoğun bir gün","objective":"Integrate A2 past, habits, comparisons, polite requests, plans, advice and reasons in a coherent city-day scenario.","grammar_focus":"A2 batch 1 communicative integration","vocab":[["plan","plan","برنامه","noun",1],["degisiklik","değişiklik","تغییر","noun",1],["sorun","sorun","مشکل","noun",1],["cozum","çözüm","راه‌حل","noun",2],["karar","karar","تصمیم","noun",2],["zamaninda","zamanında","به‌موقع","adverb",2]],"utterances":[["u1","Planımızı değiştirmeliyiz.","باید برنامه‌مان را تغییر دهیم.","propose_change",["plan","degisiklik"],1],["u2","Trafik olduğu için geç kalacağız.","چون ترافیک است دیر خواهیم رسید.","explain_future_result",["sorun"],1],["u3","Daha hızlı bir seçenek bulabilir miyiz?","می‌توانیم یک گزینه سریع‌تر پیدا کنیم؟","seek_solution",["cozum"],2],["u4","Bence metro daha uygun.","به نظر من مترو مناسب‌تر است.","make_decision",["karar"],2]],"grammar":["A2 iletişim entegrasyonu","Combine tense, comparison, reason, necessity and polite request forms according to communicative purpose.","در پایان این بخش، هدف حفظ کردن یک فرمول نیست؛ باید بتوانی زمان گذشته، دلیل، مقایسه، «باید» و درخواست مؤدبانه را متناسب با موقعیت کنار هم استفاده کنی.",[["Trafik olduğu için planı değiştirmeliyiz.","چون ترافیک است باید برنامه را عوض کنیم."],["Daha uygun bir yol bulabilir miyiz?","می‌توانیم راه مناسب‌تری پیدا کنیم؟"]]],"dialogues":[["Şehirde plan değişikliği","خیابان استانبول",[["Elif","Otobüs hâlâ gelmedi.","اتوبوس هنوز نیامده."],["Mert","Trafik olduğu için gecikiyor.","به خاطر ترافیک دیر کرده."],["Elif","Planımızı değiştirmeliyiz.","باید برنامه‌مان را تغییر دهیم."],["Mert","Bence metro daha uygun.","به نظرم مترو مناسب‌تر است."]],1],["Akşam buluşması","کافه",[["Selin","Bugün çok yoruldum.","امروز خیلی خسته شدم."],["Kaan","Biraz dinlenmelisin.","باید کمی استراحت کنی."],["Selin","Yarın öğleden sonra buluşabilir miyiz?","می‌توانیم فردا بعدازظهر قرار بگذاریم؟"],["Kaan","Tabii, benim i