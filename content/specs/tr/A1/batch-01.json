      "utterances": [["u1","Bu kitap.","این کتاب است.","identify_object",["bu","kitap"],1],["u2","Bu telefon mu?","این تلفن است؟", "ask_object",["bu","telefon"],1],["u3","Bunlar anahtarlar.","این‌ها کلید هستند.","identify_plural",["bunlar","anahtar","lar"],2],["u4","Bunlar kitaplar mı?","این‌ها کتاب هستند؟","ask_plural",["bunlar","kitap","lar"],2]],
      "grammar": ["Çoğul: -lar / -ler","Turkish plural uses -lar or -ler according to vowel harmony.","جمع در ترکی با -lar یا -ler ساخته می‌شود. فعلاً به صدای آخرین واکه توجه کن: kitaplar ولی evler.",[["kitaplar","کتاب‌ها"],["evler","خانه‌ها"]]],
