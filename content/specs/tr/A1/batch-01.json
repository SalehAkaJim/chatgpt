      "utterances": [["u1","Ben öğrenciyim.","من دانشجو هستم.","state_identity",["ogrenci"],1],["u2","Sen öğretmensin.","تو معلم هستی.","state_identity_other",["ogretmen"],1],["u3","Ben İranlıyım.","من ایرانی هستم.","state_origin",["iranli"],2],["u4","Ben öğretmen değilim.","من معلم نیستم.","negate_identity",["ogretmen","degil"],2]],
      "grammar": ["Kişi eki: -im / -sin","In present nominal sentences Turkish usually attaches the person meaning to the predicate: öğrenciyim, öğretmensin.","در جمله‌های اسمیِ زمان حال، معنی «هستم/هستی» معمولاً با پسوند روی خودِ کلمه می‌آید: öğrenciyim یعنی «دانشجو هستم». شکل پسوند با واکهٔ کلمه هماهنگ می‌شود.",[["Ben öğrenciyim.","من دانشجو هستم."],["Sen öğretmensin.","تو معلم هستی."]]],
      "dialogues": [["Yeni sınıf arkadaşı","کلاس زبان",[["Elif","Sen öğrenci misin?","تو دانشجویی؟"],["Mert","Evet, öğrenciyim. Sen?","بله، دانشجو هستم. تو؟"],["Elif","Ben öğretmenim.","من معلم هستم."],["Mert","Memnun oldum.","خوشوقتم."]],1],["Nerelisin?","آشنایی کوتاه",[["Selin","Sen İranlı mısın?","تو ایرانی هستی؟"],["Kaan","Evet, İranlıyım.","بله، ایرانی هستم."],["Selin","Ben Türkiyeliyim.","من اهل ترکیه هستم."],["Kaan","Anladım.","فهمیدم."]],2]]
