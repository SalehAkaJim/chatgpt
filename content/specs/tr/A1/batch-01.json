      "utterances": [["u1","Bu benim annem.","این مادر من است.","introduce_family",["anne","benim"],1],["u2","Bu benim babam.","این پدر من است.","introduce_family",["baba","benim"],1],["u3","Bir kardeşim var.","یک خواهر یا برادر دارم.","state_family",["kardes","var"],2],["u4","Ailem İstanbul'da.","خانواده‌ام در استانبول است.","state_family_location",["aile"],2]],
      "grammar": ["İyelik: annem, babam","Possession can be marked on the noun: annem = my mother, babam = my father.","در ترکی «مالِ من» می‌تواند داخل خود اسم بیاید: annem یعنی «مادرم»، babam یعنی «پدرم». این همان الگوی adım از Pre-A1 است که حالا گسترشش می‌دهیم.",[["annem","مادرم"],["babam","پدرم"]]],
      "dialogues": [["Fotoğraftaki aile","دیدن عکس",[["Elif","Bu kim?","این کیه؟"],["Kaan","Bu benim annem.","این مادرم است."],["Elif","Bu da baban mı?","این یکی هم پدرته؟"],["Kaan","Evet, babam.","بله، پدرمه."]],1],["Kardeşler","صحبت درباره خانواده",[["Selin","Kardeşin var mı?","خواهر یا برادر داری؟"],["Mert","Evet, bir kardeşim var.","بله، یکی دارم."],["Selin","Benim iki kardeşim var.","من دو خواهر یا برادر دارم."],["Mert","Güzel!","عالیه!"]],2]]
