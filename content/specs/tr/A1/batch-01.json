      "utterances": [["u1","Bu ne kadar?","این چنده؟","ask_price",["kadar"],1],["u2","Yüz lira.","صد لیر.","state_price",["lira"],1],["u3","Bu çok pahalı.","این خیلی گران است.","evaluate_price",["pahali"],2],["u4","İki tane alıyorum.","دو تا می‌گیرم.","buy_quantity",["tane"],2]],
      "grammar": ["Sayı + tane","tane can be used as a very common classifier after numbers when counting individual items.","برای شمارش چیزها در مکالمه، tane خیلی رایج است: iki tane یعنی «دو تا». بعد از عدد لازم نیست اسم را جمع کنی.",[["iki tane","دو تا"],["üç tane","سه تا"]]],
