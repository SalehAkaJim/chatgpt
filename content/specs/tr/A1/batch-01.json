      "utterances": [["u1","Saat kaç?","ساعت چنده؟","ask_time",["saat"],1],["u2","Saat üç.","ساعت سه است.","tell_time",["saat"],1],["u3","Yarın saat kaçta?","فردا ساعت چند؟","ask_plan_time",["yarin","kacta"],2],["u4","Akşam saat yedide.","عصر ساعت هفت.","tell_plan_time",["aksam","saat"],2]],
      "grammar": ["Saat üç / saat üçte","For clock time, saat üç states the time; saat üçte means at three o'clock.","برای گفتن خودِ ساعت می‌گویی saat üç؛ برای «ساعت سه / در ساعت سه» پسوند مکانی/زمانی می‌آید: saat üçte.",[["Saat üç.","ساعت سه است."],["Saat üçte.","ساعت سه / در ساعت سه."]]],
