{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-learning.local/content-batch.schema.json",
  "title": "Language Learning Content Batch",
  "type": "object",
  "required": ["batch_id", "target_language", "curriculum_unit", "items"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "course": {"type": "string", "minLength": 1},
    "learner_language": {"type": "string", "minLength": 2, "maxLength": 16},
    "learner_variant": {"type": "string", "minLength": 2, "maxLength": 32},
    "target_language": {"type": "string", "minLength": 2, "maxLength": 16},
    "target_variant": {"type": "string", "minLength": 2, "maxLength": 32},
    "cefr": {"type": ["string", "null"], "enum": [null, "Pre-A1", "A1", "A2", "B1", "B2", "C1", "C2"]},
    "source_level": {"type": ["string", "null"]},
    "curriculum_unit": {"type": "string", "minLength": 1},
    "generator": {"type": "string"},
    "translation": {
      "type": "object",
      "properties": {
        "language": {"type": "string"},
        "variant": {"type": "string"},
        "method": {"type": "string"},
        "provider": {"type": "string"},
        "source_languages": {"type": "array", "items": {"type": "string"}},
        "review_status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["source_id", "title", "publisher", "source_url", "license"],
      "properties": {
        "source_id": {"type": "string"},
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "author": {"type": "string"},
        "source_url": {"type": "string"},
        "license": {"type": "string"},
        "license_url": {"type": "string"},
        "retrieved_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "unit": {"type": "object", "additionalProperties": true},
    "lessons": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "data"],
        "properties": {
          "kind": {"enum": ["concept", "lexeme", "word_form", "utterance", "grammar_point", "dialogue", "exercise"]},
          "external_id": {"type": "string"},
          "data": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
