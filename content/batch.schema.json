{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-learning.local/content-batch.schema.json",
  "title": "Language Learning Content Batch",
  "type": "object",
  "required": ["batch_id", "target_language", "cefr", "curriculum_unit", "items"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "target_language": {"type": "string", "minLength": 2, "maxLength": 16},
    "cefr": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]},
    "curriculum_unit": {"type": "string", "minLength": 1},
    "generator": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "data"],
        "properties": {
          "kind": {
            "enum": ["concept", "utterance", "grammar_point", "dialogue", "exercise"]
          },
          "external_id": {"type": "string"},
          "data": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
