    {
      "kind": "grammar_point",
      "external_id": "g_implicit_meaning_and_subtext_core",
      "data": {
        "lesson_key": "c1-ko-implicit-meaning-and-subtext-01",
        "slug": "c1-ko-implicit-meaning-and-subtext-grammar",
        "title": "함축과 맥락 읽기",
        "rule_summary": "Use discourse context and constructions such as -다는 말은 and -는 셈이다 to infer what a speaker implies without overstating certainty.",
        "explanation": {
          "fa": "در سطح پیشرفته، معنی همیشه مستقیم در واژه‌ها نیست. با -다는 말은 یا -는 셈이다 می‌توان نتیجه ضمنی را بازگویی کرد، اما باید بین برداشت و واقعیت قطعی فرق گذاشت."
        },
        "examples": [
          {
            "ko": "그렇게 말한다는 건 아직 결정하지 않았다는 뜻이죠.",
            "fa": "این حرف یعنی هنوز تصمیم نگرفته‌اید، درست است؟"
          },
          {
            "ko": "아무 말도 하지 않았다면 사실상 받아들인 셈이 될 수 있어요.",
            "fa": "اگر چیزی نگفته باشد، ممکن است عملاً به منزله پذیرفتن تلقی شود."
          }
        ],
        "cefr": "C1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_implicit_meaning_and_subtext_01",
      "data": {
        "lesson_key": "c1-ko-implicit-meaning-and-subtext-01",
        "title": "말의 속뜻",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "지민",
          "민수"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "팀장님이 '조금 더 생각해 보죠'라고 했는데 긍정적인 뜻일까요?",
            "translation_fa": "مدیر گفت «کمی بیشتر فکر کنیم»؛ یعنی نظرش مثبت است؟"
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "꼭 그렇지는 않아요. 맥락상 바로 승인하기 어렵다는 암시일 수도 있어요.",
            "translation_fa": "لزومی ندارد. در این بافت ممکن است تلویحاً یعنی تأیید فوری دشوار است."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "그럼 거절로 단정해서도 안 되겠네요.",
            "translation_fa": "پس نباید آن را هم قطعی رد تلقی کنیم."
          },
          {
            "order": 4,
            "speaker": "민수",
            "text": "맞아요. 다음 행동까지 보고 해석하는 게 안전해요.",
            "translation_fa": "دقیقاً؛ بهتر است رفتار بعدی را هم ببینیم و بعد تفسیر کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_implicit_meaning_and_subtext_02",
      "data": {
        "lesson_key": "c1-ko-implicit-meaning-and-subtext-02",
        "title": "눈치와 의도",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "서연",
          "준호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "왜 직접 싫다고 말하지 않았을까요?",
            "translation_fa": "چرا مستقیم نگفت دوست ندارد؟"
          },
          {
            "order": 2,
            "speaker": "준호",
            "text": "상대 체면을 생각해서 완곡하게 선을 그은 것 같아요.",
            "translation_fa": "فکر می‌کنم برای حفظ آبروی طرف، غیرمستقیم مرز گذاشته."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "말보다 분위기를 읽어야 했던 거군요.",
            "translation_fa": "پس باید بیشتر از کلمات، فضا را می‌خواندم."
          },
          {
            "order": 4,
            "speaker": "준호",
            "text": "네, 다만 추측이니 확인할 기회가 있으면 확인하는 게 좋죠.",
            "translation_fa": "بله، ولی چون برداشت است، اگر فرصتی بود بهتر است تأییدش کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
