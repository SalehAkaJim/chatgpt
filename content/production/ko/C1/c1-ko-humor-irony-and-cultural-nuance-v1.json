    {
      "kind": "grammar_point",
      "external_id": "g_humor_irony_and_cultural_nuance_core",
      "data": {
        "lesson_key": "c1-ko-humor-irony-and-cultural-nuance-01",
        "slug": "c1-ko-humor-irony-and-cultural-nuance-grammar",
        "title": "반어와 화용적 유머",
        "rule_summary": "Irony and teasing depend on relationship, prosody and context. Avoid treating one expression as inherently sarcastic.",
        "explanation": {
          "fa": "طعنه و شوخی به رابطه، لحن و موقعیت وابسته‌اند. یک عبارت ذاتاً «طعنه‌آمیز» نیست؛ C1 یعنی بتوانید نشانه‌ها را کنار هم بگذارید و همچنان احتمال خطا را باز بگذارید."
        },
        "examples": [
          {
            "ko": "참 빨리도 오셨네요.",
            "fa": "چه زود هم رسیدید! (بسته به موقعیت می‌تواند طعنه باشد.)"
          },
          {
            "ko": "제가 전문가이기는요. 아직 배울 게 많아요.",
            "fa": "من کجا و متخصص بودن کجا؛ هنوز خیلی چیزها باید یاد بگیرم."
          }
        ],
        "cefr": "C1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_humor_irony_and_cultural_nuance_01",
      "data": {
        "lesson_key": "c1-ko-humor-irony-and-cultural-nuance-01",
        "title": "칭찬인가요?",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "지민",
          "민수"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "준호가 저한테 '오늘은 정말 일찍 왔네'라고 했어요.",
            "translation_fa": "جونهو به من گفت «امروز واقعاً زود آمدی»."
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "평소에 늦는 걸 알고 한 말이면 가벼운 놀림일 가능성이 커요.",
            "translation_fa": "اگر می‌داند معمولاً دیر می‌رسی، احتمالاً شوخی دوستانه بوده."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "기분 나빠할 필요는 없겠네요.",
            "translation_fa": "پس لازم نیست ناراحت شوم."
          },
          {
            "order": 4,
            "speaker": "민수",
            "text": "관계와 억양을 봐야 하지만, 그 상황이라면 그럴 것 같아요.",
            "translation_fa": "باید رابطه و لحن را دید، ولی در آن موقعیت احتمالاً همین است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_humor_irony_and_cultural_nuance_02",
      "data": {
        "lesson_key": "c1-ko-humor-irony-and-cultural-nuance-02",
        "title": "과소표현",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "서연",
          "준호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "프로젝트가 정말 힘들었는데 팀장님은 '조금 바빴죠'라고만 하셨어요.",
            "translation_fa": "پروژه واقعاً سخت بود ولی مدیر فقط گفت «کمی شلوغ بودیم»."
          },
          {
            "order": 2,
            "speaker": "준호",
            "text": "상황을 공유하는 사람들끼리 일부러 약하게 말한 것 같아요.",
            "translation_fa": "به نظر می‌رسد بین کسانی که شرایط را می‌دانند عمداً کم‌گویی کرده."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "그게 유머처럼 들린 이유군요.",
            "translation_fa": "پس برای همین شبیه شوخی شنیده شد."
          },
          {
            "order": 4,
            "speaker": "준호",
            "text": "네, 실제 강도와 표현 강도의 차이가 효과를 만든 거죠.",
            "translation_fa": "بله، فاصله بین شدت واقعی و شدت بیان اثر طنز ساخته."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
