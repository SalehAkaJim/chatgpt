    {
      "kind": "grammar_point",
      "external_id": "g_stance_and_hedging_core",
      "data": {
        "lesson_key": "c1-ko-stance-and-hedging-01",
        "slug": "c1-ko-stance-and-hedging-grammar",
        "title": "인식 태도와 완곡화",
        "rule_summary": "Advanced Korean distinguishes evidence strength from speaker commitment. Use hedging to calibrate a claim, not merely to sound polite.",
        "explanation": {
          "fa": "در زبان پیشرفته، «احتیاط در ادعا» فقط برای مؤدب‌بودن نیست؛ شدت ادعا باید با قدرت شواهد متناسب باشد. ساختارهایی مثل -다고 볼 여지가 있다 فاصله تحلیلی ایجاد می‌کنند."
        },
        "examples": [
          {
            "ko": "이 변화가 일시적이라고 볼 여지가 있습니다.",
            "fa": "می‌توان این تغییر را تا حدی موقتی دانست."
          },
          {
            "ko": "외부 변수의 영향을 배제하기는 어렵습니다.",
            "fa": "کنار گذاشتن اثر متغیرهای بیرونی دشوار است."
          }
        ],
        "cefr": "C1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_stance_and_hedging_01",
      "data": {
        "lesson_key": "c1-ko-stance-and-hedging-01",
        "title": "확신을 조절하기",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "서연",
          "준호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "이 수치면 정책이 성공했다고 써도 되죠?",
            "translation_fa": "با این عدد می‌توانیم بنویسیم سیاست موفق بوده، نه؟"
          },
          {
            "order": 2,
            "speaker": "준호",
            "text": "아직은 그렇게 단정하기보다 긍정적 신호라고 표현하는 게 맞아요.",
            "translation_fa": "فعلاً بهتر است به‌جای قطعیت، آن را نشانه مثبت بنامیم."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "추가 자료가 나오면 표현 강도를 높일 수 있겠네요.",
            "translation_fa": "اگر داده بیشتری بیاید می‌توانیم شدت بیان را بالا ببریم."
          },
          {
            "order": 4,
            "speaker": "준호",
            "text": "네, 확신의 정도도 근거와 함께 움직여야 하니까요.",
            "translation_fa": "بله، چون میزان اطمینان هم باید با شواهد تغییر کند."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_stance_and_hedging_02",
      "data": {
        "lesson_key": "c1-ko-stance-and-hedging-02",
        "title": "가능성을 남겨 두기",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "지민",
          "민수"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "반례가 하나뿐이면 무시해도 될까요?",
            "translation_fa": "اگر فقط یک مثال نقض باشد می‌توان نادیده‌اش گرفت؟"
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "크기가 작아도 설명을 바꿀 단서라면 남겨 둬야죠.",
            "translation_fa": "اگر حتی کوچک باشد ولی بتواند توضیح را تغییر دهد باید نگهش داشت."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "결론을 유보하자는 뜻인가요?",
            "translation_fa": "یعنی نتیجه را موقتاً محفوظ نگه داریم؟"
          },
          {
            "order": 4,
            "speaker": "민수",
            "text": "적어도 다른 가능성을 배제할 근거가 생길 때까지는요.",
            "translation_fa": "حداقل تا وقتی شواهد کافی برای رد احتمال‌های دیگر پیدا کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
