    {
      "kind": "grammar_point",
      "external_id": "g_institutional_and_bureaucratic_korean_core",
      "data": {
        "lesson_key": "c1-ko-institutional-and-bureaucratic-korean-01",
        "slug": "c1-ko-institutional-and-bureaucratic-korean-grammar",
        "title": "제도 문서와 절차 언어",
        "rule_summary": "Institutional Korean requires precise reference to clauses, eligibility, scope and procedure. Separate what a rule says from how an office applies it.",
        "explanation": {
          "fa": "در زبان اداری پیشرفته باید متن مقرره، دامنه شمول و اجرای واقعی را از هم جدا کرد. درخواست کتبی و اشاره دقیق به معیارها، ابهام را کم می‌کند."
        },
        "examples": [
          {
            "ko": "이 규정에 의거하여 재심을 요청합니다.",
            "fa": "بر اساس این مقرره درخواست بررسی مجدد می‌کنم."
          },
          {
            "ko": "해당 조항이 제 경우에도 적용되는지 확인 부탁드립니다.",
            "fa": "لطفاً تأیید کنید آیا این بند شامل مورد من هم می‌شود یا نه."
          }
        ],
        "cefr": "C1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_institutional_and_bureaucratic_korean_01",
      "data": {
        "lesson_key": "c1-ko-institutional-and-bureaucratic-korean-01",
        "title": "규정 확인",
        "setting": "item",
        "cefr": "C1",
        "topic": "requests",
        "characters": [
          "유나",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "유나",
            "text": "안내문에는 가능하다고 되어 있는데 접수는 안 된다고 하네요.",
            "translation_fa": "در اطلاعیه نوشته ممکن است، اما پذیرش می‌گوید نمی‌شود."
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "어떤 규정과 기준으로 거절된 건지 먼저 서면으로 요청해 보세요.",
            "translation_fa": "اول کتبی بخواهید مشخص کنند رد درخواست بر اساس کدام مقرره و معیار بوده."
          },
          {
            "order": 3,
            "speaker": "유나",
            "text": "그다음 이의를 제기하면 되겠죠?",
            "translation_fa": "بعد می‌توانم اعتراض کنم؟"
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "네, 문구와 실제 적용이 다른지 비교할 수 있어야 해요.",
            "translation_fa": "بله، باید بتوانید متن را با نحوه اجرا مقایسه کنید."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_institutional_and_bureaucratic_korean_02",
      "data": {
        "lesson_key": "c1-ko-institutional-and-bureaucratic-korean-02",
        "title": "적용 범위",
        "setting": "item",
        "cefr": "C1",
        "topic": "requests",
        "characters": [
          "하나",
          "태호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "하나",
            "text": "새 규정이 이번 학기 신청에도 적용된대요.",
            "translation_fa": "می‌گویند مقرره جدید به درخواست‌های این ترم هم اعمال می‌شود."
          },
          {
            "order": 2,
            "speaker": "태호",
            "text": "시행일과 소급 적용 조항을 확인했어요?",
            "translation_fa": "تاریخ اجرا و بند عطف‌به‌ماسبق را بررسی کردی؟"
          },
          {
            "order": 3,
            "speaker": "하나",
            "text": "아직요. 그 부분이 명확하지 않아요.",
            "translation_fa": "هنوز نه، آن بخش روشن نیست."
          },
          {
            "order": 4,
            "speaker": "태호",
            "text": "그럼 추측하지 말고 담당 부서에 적용 범위를 정확히 물어보죠.",
            "translation_fa": "پس حدس نزنیم؛ دامنه اجرا را دقیق از بخش مربوط بپرسیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
