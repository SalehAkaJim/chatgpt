    {
      "kind": "grammar_point",
      "external_id": "g_precision_reformulation_core",
      "data": {
        "lesson_key": "c1-ko-precision-reformulation-01",
        "slug": "c1-ko-precision-reformulation-grammar",
        "title": "정밀한 재진술",
        "rule_summary": "At C1, reformulation is not repetition: narrow scope, replace an imprecise label and preserve the original speaker's intended force.",
        "explanation": {
          "fa": "در C1 بازگویی فقط تکرار نیست؛ باید دامنه ادعا، شدت و تعریف واژه را دقیق نگه داشت. -라기보다 برای جایگزین‌کردن یک برچسب نادقیق بسیار طبیعی است."
        },
        "examples": [
          {
            "ko": "비판이라기보다 보완 요청에 가깝습니다.",
            "fa": "بیشتر درخواست تکمیل است تا انتقاد."
          },
          {
            "ko": "다시 표현하자면 속도가 아니라 방향이 문제라는 뜻입니다.",
            "fa": "یعنی اگر دوباره بیان کنیم، مشکل سرعت نیست بلکه جهت است."
          }
        ],
        "cefr": "C1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_precision_reformulation_01",
      "data": {
        "lesson_key": "c1-ko-precision-reformulation-01",
        "title": "용어를 바로잡기",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "하나",
          "태호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "하나",
            "text": "이 결과를 '효과 없음'으로 정리해도 될까요?",
            "translation_fa": "می‌توانیم نتیجه را «بدون اثر» جمع‌بندی کنیم؟"
          },
          {
            "order": 2,
            "speaker": "태호",
            "text": "정확히는 효과가 없다는 게 아니라 통계적으로 확정하기 어렵다는 뜻이에요.",
            "translation_fa": "دقیق‌تر این است که اثر صفر نیست؛ بلکه تأیید آماری دشوار است."
          },
          {
            "order": 3,
            "speaker": "하나",
            "text": "표현 하나가 결론의 강도를 바꾸네요.",
            "translation_fa": "یک عبارت شدت نتیجه را عوض می‌کند."
          },
          {
            "order": 4,
            "speaker": "태호",
            "text": "그래서 범위와 확실성을 함께 적어야 합니다.",
            "translation_fa": "برای همین باید دامنه و میزان قطعیت را با هم بنویسیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_precision_reformulation_02",
      "data": {
        "lesson_key": "c1-ko-precision-reformulation-02",
        "title": "오해 줄이기",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "유나",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "유나",
            "text": "독자들이 '자율'을 제각각 이해할 것 같아요.",
            "translation_fa": "فکر می‌کنم خواننده‌ها «خودمختاری» را متفاوت می‌فهمند."
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "첫 문단에서 우리가 쓰는 의미를 재정의하죠.",
            "translation_fa": "بیایید در پاراگراف اول معنایی را که مدنظر داریم بازتعریف کنیم."
          },
          {
            "order": 3,
            "speaker": "유나",
            "text": "일상적 의미와도 구분하고요?",
            "translation_fa": "و از معنای روزمره هم جدا کنیم؟"
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "네, 그래야 뒤의 논증이 흔들리지 않아요.",
            "translation_fa": "بله، وگرنه استدلال بعدی مبهم می‌شود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
