      "external_id": "u_source_synthesis_and_framing_02",
      "data": {
        "lesson_key": "c1-ko-source-synthesis-and-framing-01",
        "text": {
          "ko": "출처를 지우고 내용을 합치면 누구의 주장인지 구분하기 어려워집니다."
        },
        "translations": {
          "fa": "اگر منبع را حذف کنیم و مطالب را یکی کنیم، تشخیص اینکه ادعا از کیست دشوار می‌شود."
        },
        "intent": "attribution",
        "concept_refs": [
