    {
      "kind": "grammar_point",
      "external_id": "g_source_synthesis_and_framing_core",
      "data": {
        "lesson_key": "c1-ko-source-synthesis-and-framing-01",
        "slug": "c1-ko-source-synthesis-and-framing-grammar",
        "title": "출처 종합과 프레이밍",
        "rule_summary": "Synthesis at C1 retains source ownership and explains why accounts converge or diverge instead of flattening them into one summary.",
        "explanation": {
          "fa": "در C1 جمع‌بندی چند منبع نباید تفاوت‌ها را صاف کند. باید منبع هر ادعا، زاویه نگاه و علت اختلاف داده‌ها مشخص بماند."
        },
        "examples": [
          {
            "ko": "한 보고서에 따르면 비용이 줄었지만 다른 조사에서는 체감 부담이 늘었다고 합니다.",
            "fa": "طبق یک گزارش هزینه کم شده، اما پژوهش دیگری می‌گوید فشار احساس‌شده بیشتر شده است."
          },
          {
            "ko": "종합하면 방향에는 합의가 있지만 원인 설명은 엇갈립니다.",
            "fa": "در جمع‌بندی، درباره جهت کلی توافق هست اما توضیح علت‌ها متفاوت است."
          }
        ],
        "cefr": "C1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_source_synthesis_and_framing_01",
      "data": {
        "lesson_key": "c1-ko-source-synthesis-and-framing-01",
        "title": "서로 다른 기사",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "하나",
          "태호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "하나",
            "text": "두 기사 제목이 완전히 반대처럼 보여요.",
            "translation_fa": "عنوان دو خبر انگار کاملاً مخالف هم است."
          },
          {
            "order": 2,
            "speaker": "태호",
            "text": "자료는 비슷한데 하나는 위험을, 다른 하나는 기회를 강조했어요.",
            "translation_fa": "داده‌ها مشابه‌اند، اما یکی خطر و دیگری فرصت را برجسته کرده."
          },
          {
            "order": 3,
            "speaker": "하나",
            "text": "그럼 사실과 프레이밍을 분리해서 정리하죠.",
            "translation_fa": "پس واقعیت و چارچوب‌بندی را جدا جمع‌بندی کنیم."
          },
          {
            "order": 4,
            "speaker": "태호",
            "text": "좋아요. 출처별 표현 차이도 표시하고요.",
            "translation_fa": "خوب است، تفاوت بیان هر منبع را هم مشخص کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_source_synthesis_and_framing_02",
      "data": {
        "lesson_key": "c1-ko-source-synthesis-and-framing-02",
        "title": "상충하는 통계",
        "setting": "item",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "유나",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "유나",
            "text": "두 조사 수치가 너무 달라서 어느 쪽을 믿어야 할지 모르겠어요.",
            "translation_fa": "اعداد دو پژوهش خیلی متفاوت‌اند و نمی‌دانم کدام را باور کنم."
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "표본과 질문 방식부터 비교해야 해요.",
            "translation_fa": "اول باید نمونه و شیوه سؤال‌کردن را مقایسه کنیم."
          },
          {
            "order": 3,
            "speaker": "유나",
            "text": "하나를 틀렸다고 처리하면 안 되겠네요.",
            "translation_fa": "پس نباید یکی را صرفاً غلط حساب کنیم."
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "맞아요. 차이가 생긴 조건까지 설명해야 제대로 종합한 거예요.",
            "translation_fa": "دقیقاً؛ جمع‌بندی درست باید شرایط ایجاد اختلاف را هم توضیح دهد."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
