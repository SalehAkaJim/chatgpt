    {
      "kind": "grammar_point",
      "external_id": "g_formal_mediation_and_face_core",
      "data": {
        "lesson_key": "c1-ko-formal-mediation-and-face-01",
        "slug": "c1-ko-formal-mediation-and-face-grammar",
        "title": "고급 완곡화와 체면",
        "rule_summary": "C1 mediation balances deference with clarity. Honorific and indirect wording can soften interpersonal force without weakening factual accountability.",
        "explanation": {
          "fa": "در میانجی‌گری پیشرفته، احترام و وضوح باید همزمان حفظ شوند. بیان غیرمستقیم می‌تواند فشار اجتماعی را کم کند، اما نباید مسئولیت یا اصل اختلاف را محو کند."
        },
        "examples": [
          {
            "ko": "말씀은 이해합니다만 이 부분은 재검토가 필요합니다.",
            "fa": "حرفتان را درک می‌کنم، اما این بخش نیاز به بازبینی دارد."
          },
          {
            "ko": "가능하시다면 표현을 조금 조정해 주셨으면 합니다.",
            "fa": "اگر ممکن است، مایلم عبارت را کمی تعدیل کنید."
          }
        ],
        "cefr": "C1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_formal_mediation_and_face_01",
      "data": {
        "lesson_key": "c1-ko-formal-mediation-and-face-01",
        "title": "민감한 회의",
        "setting": "item",
        "cefr": "C1",
        "topic": "requests",
        "characters": [
          "지민",
          "민수"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "이 문제를 바로 책임자에게 지적하면 분위기가 더 나빠질까요?",
            "translation_fa": "اگر مستقیم به مسئول تذکر دهیم، فضا بدتر می‌شود؟"
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "사실은 분명히 하되 사람 자체를 공격하는 방식은 피하는 게 좋겠어요.",
            "translation_fa": "بهتر است واقعیت روشن باشد ولی از حمله به شخص پرهیز کنیم."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "그럼 절차의 문제로 먼저 제시하죠.",
            "translation_fa": "پس اول آن را به‌عنوان مشکل روند مطرح کنیم."
          },
          {
            "order": 4,
            "speaker": "민수",
            "text": "네, 체면을 지키면서도 책임은 남길 수 있어요.",
            "translation_fa": "بله، می‌شود هم آبرو را حفظ کرد و هم مسئولیت را روشن گذاشت."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_formal_mediation_and_face_02",
      "data": {
        "lesson_key": "c1-ko-formal-mediation-and-face-02",
        "title": "중재 문구",
        "setting": "item",
        "cefr": "C1",
        "topic": "requests",
        "characters": [
          "서연",
          "준호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "양쪽 모두 자기 입장만 반복하고 있어요.",
            "translation_fa": "هر دو طرف فقط موضع خودشان را تکرار می‌کنند."
          },
          {
            "order": 2,
            "speaker": "준호",
            "text": "공통 목표부터 확인한 뒤 쟁점을 하나씩 분리해 보죠.",
            "translation_fa": "اول هدف مشترک را تأیید کنیم و بعد اختلاف‌ها را جداگانه بررسی کنیم."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "반대 의견도 그대로 기록할까요?",
            "translation_fa": "نظر مخالف را هم عیناً ثبت کنیم؟"
          },
          {
            "order": 4,
            "speaker": "준호",
            "text": "네, 다만 공격적인 표현은 의미를 보존하면서 중립적으로 바꾸죠.",
            "translation_fa": "بله، اما عبارت‌های تهاجمی را با حفظ معنا خنثی‌تر کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
