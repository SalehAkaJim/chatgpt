    {
      "kind": "grammar_point",
      "external_id": "g_strategic_ambiguity_irony_core",
      "data": {
        "lesson_key": "c2-ko-strategic-ambiguity-irony-01",
        "slug": "c2-ko-strategic-ambiguity-irony-grammar",
        "title": "전략적 모호성과 반어",
        "rule_summary": "At C2, ambiguity may serve face, negotiation, humor or deniability. Interpretation requires evidence from wording, prosody, relationship and consequences.",
        "explanation": {
          "fa": "در C2 ابهام می‌تواند برای حفظ وجهه، مذاکره، طنز یا امکان انکار به‌کار رود. تفسیر باید به واژه‌ها، لحن، رابطه و پیامدها تکیه کند."
        },
        "examples": [
          {
            "ko": "가능성은 열어 두겠습니다라고 했다고 해서 추진 의사가 있다는 뜻은 아닙니다.",
            "fa": "اینکه گفته «امکان را باز می‌گذارم» لزوماً یعنی قصد پیشبرد دارد نیست."
          },
          {
            "ko": "참 투명한 절차네요라는 말이 상황에 따라 정반대의 평가가 될 수 있습니다.",
            "fa": "عبارت «چه روند شفافی!» بسته به موقعیت می‌تواند دقیقاً ارزیابی مخالف باشد."
          }
        ],
        "cefr": "C2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_strategic_ambiguity_irony_01",
      "data": {
        "lesson_key": "c2-ko-strategic-ambiguity-irony-01",
        "title": "열어 둔 가능성",
        "setting": "item",
        "cefr": "C2",
        "topic": "questions",
        "characters": [
          "지민",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "상대가 '검토 가능성은 열려 있다'고 했으니 거의 합의한 거 아닌가요?",
            "translation_fa": "طرف گفت «امکان بررسی باز است»؛ یعنی تقریباً توافق کرده، نه؟"
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "그 표현은 거절을 피하면서도 아무 약속도 하지 않는 방식일 수 있어요.",
            "translation_fa": "ممکن است راهی باشد برای پرهیز از رد صریح بدون هیچ تعهدی."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "그럼 후속 행동이 없으면 의미를 과하게 읽으면 안 되겠네요.",
            "translation_fa": "پس اگر اقدامی دنبال نشد نباید بیش از حد معنی‌اش کنیم."
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "맞아요. 문장보다 행동과 맥락이 더 결정적일 수 있습니다.",
            "translation_fa": "دقیقاً؛ رفتار و بافت می‌تواند از خود جمله تعیین‌کننده‌تر باشد."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_strategic_ambiguity_irony_02",
      "data": {
        "lesson_key": "c2-ko-strategic-ambiguity-irony-02",
        "title": "칭찬처럼 들리는 비판",
        "setting": "item",
        "cefr": "C2",
        "topic": "questions",
        "characters": [
          "민수",
          "유나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "민수",
            "text": "'대단히 일관된 기준이네요'가 왜 다들 비꼬는 말이라고 느꼈을까요?",
            "translation_fa": "چرا همه «چه معیار فوق‌العاده منسجمی!» را طعنه فهمیدند؟"
          },
          {
            "order": 2,
            "speaker": "유나",
            "text": "바로 앞에서 기준이 세 번 바뀌었다는 얘기가 나왔으니까요.",
            "translation_fa": "چون درست قبلش گفته بودند معیار سه بار عوض شده."
          },
          {
            "order": 3,
            "speaker": "민수",
            "text": "문장 자체만 보면 칭찬인데 맥락이 뒤집는군요.",
            "translation_fa": "پس خود جمله تعریف است ولی بافت معنایش را برمی‌گرداند."
          },
          {
            "order": 4,
            "speaker": "유나",
            "text": "네, 그래서 반어는 문장만 떼어 보면 자주 놓칩니다.",
            "translation_fa": "بله، برای همین اگر جمله را جدا کنیم طعنه را زیاد از دست می‌دهیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
