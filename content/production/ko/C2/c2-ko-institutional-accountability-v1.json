    {
      "kind": "grammar_point",
      "external_id": "g_institutional_accountability_core",
      "data": {
        "lesson_key": "c2-ko-institutional-accountability-01",
        "slug": "c2-ko-institutional-accountability-grammar",
        "title": "근거·귀속·절차",
        "rule_summary": "C2 institutional Korean tracks who asserts, who decides, what evidence supports the decision and which procedural rule authorizes it.",
        "explanation": {
          "fa": "در زبان نهادی C2 باید دقیقاً مشخص باشد چه کسی ادعا می‌کند، چه کسی تصمیم می‌گیرد، چه شواهدی پشت تصمیم است و کدام قاعده رویه‌ای آن را مجاز می‌کند."
        },
        "examples": [
          {
            "ko": "기록에 따르면 해당 결정은 위원회 의결을 거친 것으로 확인됩니다.",
            "fa": "طبق سوابق، تأیید می‌شود که این تصمیم از رأی کمیته گذشته است."
          },
          {
            "ko": "재량 판단이었다고 하더라도 근거를 제시할 의무까지 사라지는 것은 아닙니다.",
            "fa": "حتی اگر تصمیم در حوزه اختیار بوده باشد، وظیفه ارائه مبنا از بین نمی‌رود."
          }
        ],
        "cefr": "C2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_institutional_accountability_01",
      "data": {
        "lesson_key": "c2-ko-institutional-accountability-01",
        "title": "책임의 주체",
        "setting": "item",
        "cefr": "C2",
        "topic": "requests",
        "characters": [
          "서연",
          "태호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "답변서에는 계속 '기관의 판단'이라고만 되어 있어요.",
            "translation_fa": "در پاسخ‌نامه مدام فقط نوشته «تصمیم نهاد»."
          },
          {
            "order": 2,
            "speaker": "태호",
            "text": "그 판단을 누가 어떤 권한으로 했는지부터 확인해야 합니다.",
            "translation_fa": "اول باید روشن شود چه کسی با چه اختیاری آن تصمیم را گرفته."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "결정 주체와 근거를 따로 요청하겠습니다.",
            "translation_fa": "پس تصمیم‌گیرنده و مبنا را جداگانه درخواست می‌کنم."
          },
          {
            "order": 4,
            "speaker": "태호",
            "text": "네, 그래야 이의 제기도 정확한 대상을 향할 수 있어요.",
            "translation_fa": "بله، آن‌وقت اعتراض هم متوجه مرجع درست می‌شود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_institutional_accountability_02",
      "data": {
        "lesson_key": "c2-ko-institutional-accountability-02",
        "title": "사실과 해석",
        "setting": "item",
        "cefr": "C2",
        "topic": "requests",
        "characters": [
          "준호",
          "하나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "준호",
            "text": "보고서에 '고의성이 확인됐다'고 써도 될까요?",
            "translation_fa": "می‌توانیم بنویسیم «عمدی بودن تأیید شد»؟"
          },
          {
            "order": 2,
            "speaker": "하나",
            "text": "확인된 건 행동의 반복이고 고의성은 그에 대한 해석이에요.",
            "translation_fa": "چیزی که تأیید شده تکرار رفتار است؛ عمدی بودن تفسیر ماست."
          },
          {
            "order": 3,
            "speaker": "준호",
            "text": "증거 수준보다 표현이 앞서갔네요.",
            "translation_fa": "پس بیان ما از سطح شواهد جلو زده."
          },
          {
            "order": 4,
            "speaker": "하나",
            "text": "맞아요. 사실과 판단을 분리해야 문서가 버틸 수 있어요.",
            "translation_fa": "دقیقاً؛ سند فقط وقتی قابل دفاع است که واقعیت و قضاوت جدا باشند."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
