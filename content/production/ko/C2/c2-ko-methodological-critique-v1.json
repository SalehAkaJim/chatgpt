    {
      "kind": "grammar_point",
      "external_id": "g_methodological_critique_core",
      "data": {
        "lesson_key": "c2-ko-methodological-critique-01",
        "slug": "c2-ko-methodological-critique-grammar",
        "title": "방법론적 유보와 비판",
        "rule_summary": "C2 academic critique links the strength of wording to design quality, alternative explanations and the scope of inference.",
        "explanation": {
          "fa": "در نقد دانشگاهی C2 شدت زبان باید با کیفیت طراحی، توضیح‌های رقیب و دامنه استنباط هماهنگ باشد؛ نقد روش با رد کل پژوهش یکی نیست."
        },
        "examples": [
          {
            "ko": "이 설계만으로 정책 효과라고 단정하기는 어렵습니다.",
            "fa": "با این طراحی به‌تنهایی دشوار است نتیجه را اثر سیاست بدانیم."
          },
          {
            "ko": "관찰되지 않은 교란 변수가 개입했을 가능성을 배제할 수 없습니다.",
            "fa": "نمی‌توان احتمال دخالت متغیر مخدوش‌گر مشاهده‌نشده را کنار گذاشت."
          }
        ],
        "cefr": "C2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_methodological_critique_01",
      "data": {
        "lesson_key": "c2-ko-methodological-critique-01",
        "title": "강한 결론, 약한 설계",
        "setting": "item",
        "cefr": "C2",
        "topic": "questions",
        "characters": [
          "지민",
          "유나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "결과가 세 번 반복됐으니 원인이 확실하다고 볼 수 있지 않나요?",
            "translation_fa": "نتیجه سه بار تکرار شده؛ نمی‌شود علت را قطعی دانست؟"
          },
          {
            "order": 2,
            "speaker": "유나",
            "text": "반복성은 중요하지만 같은 교란 요인이 계속 작동했을 가능성도 있어요.",
            "translation_fa": "تکرار مهم است، اما ممکن است همان عامل مخدوش‌گر هر بار فعال بوده باشد."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "그럼 결론의 범위를 좁혀야겠네요.",
            "translation_fa": "پس باید دامنه نتیجه را محدود کنیم."
          },
          {
            "order": 4,
            "speaker": "유나",
            "text": "네, 관찰된 관계와 인과 해석을 분리하는 게 좋습니다.",
            "translation_fa": "بله، بهتر است رابطه مشاهده‌شده را از تفسیر علّی جدا کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_methodological_critique_02",
      "data": {
        "lesson_key": "c2-ko-methodological-critique-02",
        "title": "일반화의 범위",
        "setting": "item",
        "cefr": "C2",
        "topic": "questions",
        "characters": [
          "민수",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "민수",
            "text": "서울의 한 기관 자료만으로 전국 현상을 설명한 부분이 걸립니다.",
            "translation_fa": "بخشی که با داده یک نهاد در سئول کل کشور را توضیح داده مشکل دارد."
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "표본의 특수성을 논의하지 않고 일반화했기 때문이죠.",
            "translation_fa": "چون بدون بحث درباره ویژگی خاص نمونه تعمیم داده."
          },
          {
            "order": 3,
            "speaker": "민수",
            "text": "결과 자체보다 적용 범위가 문제라는 식으로 쓰겠습니다.",
            "translation_fa": "پس می‌نویسم مشکل بیشتر دامنه کاربرد است تا خود نتیجه."
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "그게 더 정확한 비판입니다.",
            "translation_fa": "این نقد دقیق‌تری است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
