      "data": {
        "lesson_key": "b2-ko-summarizing-and-mediation-01",
        "title": "두 입장 정리하기",
        "setting": "item",
        "cefr": "B2",
        "topic": "questions",
        "characters": [
          "서연",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "회의가 길었는데 결국 쟁점이 뭐였어요?",
            "translation_fa": "جلسه طولانی شد؛ در نهایت اختلاف اصلی چه بود؟"
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "한쪽은 속도를, 다른 쪽은 검증 절차를 더 중요하게 봤어요.",
            "translation_fa": "یک طرف سرعت و طرف دیگر روند راستی‌آزمایی را مهم‌تر می‌دانست."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "공통점도 있었나요?",
            "translation_fa": "نقطه مشترکی هم داشتند؟"
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "네, 올해 안에 시작해야 한다는 데는 모두 동의했어요.",
            "translation_fa": "بله، همه موافق بودند که باید امسال شروع شود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
