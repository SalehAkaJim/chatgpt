    {
      "kind": "dialogue",
      "external_id": "d_summarizing_and_mediation_02",
      "data": {
        "lesson_key": "b2-ko-summarizing-and-mediation-02",
        "title": "중간에서 설명하기",
        "setting": "item",
        "cefr": "B2",
        "topic": "questions",
        "characters": [
          "지민",
          "태호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "두 부서 의견을 경영진에게 어떻게 전달하죠?",
            "translation_fa": "نظر دو بخش را چطور به مدیریت منتقل کنیم؟"
          },
          {
            "order": 2,
            "speaker": "태호",
            "text": "찬반으로만 나누지 말고 각각의 우선순위를 설명해요.",
            "translation_fa": "فقط به موافق و مخالف تقسیم نکنیم؛ اولویت هر کدام را توضیح بدهیم."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "그리고 공통 기준도 넣을까요?",
            "translation_fa": "معیار مشترک را هم اضافه کنیم؟"
          },
          {
            "order": 4,
            "speaker": "태호",
            "text": "네, 그래야 중재안이 현실적으로 보여요.",
            "translation_fa": "بله، این‌طور راه‌حل میانی واقع‌بینانه‌تر دیده می‌شود."
          }
        ],
        "qa": {
