    {
      "kind": "grammar_point",
      "external_id": "g_formal_negotiation_core",
      "data": {
        "lesson_key": "b2-ko-formal-negotiation-01",
        "slug": "b2-ko-formal-negotiation-grammar",
        "title": "격식을 갖춘 요청과 조건",
        "rule_summary": "Use honorific request forms and explicit condition markers to negotiate politely without weakening the content.",
        "explanation": {
          "fa": "در مذاکره رسمی، درخواست را با شکل‌های مؤدبانه بیان می‌کنیم و شرط را صریح نگه می‌داریم تا احترام باعث مبهم شدن موضع نشود."
        },
        "examples": [
          {
            "ko": "자료를 오늘 안에 보내 주시면 감사하겠습니다.",
            "fa": "ممنون می‌شویم اگر مدارک را تا امروز بفرستید."
          },
          {
            "ko": "품질이 보장되는 조건으로 계약을 연장하겠습니다.",
            "fa": "به شرط تضمین کیفیت قرارداد را تمدید می‌کنیم."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_formal_negotiation_01",
      "data": {
        "lesson_key": "b2-ko-formal-negotiation-01",
        "title": "납기 조정",
        "setting": "item",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "하나",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "하나",
            "text": "현재 일정으로는 품질을 보장하기 어렵습니다.",
            "translation_fa": "با برنامه فعلی تضمین کیفیت دشوار است."
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "어느 정도 조정이 필요합니까?",
            "translation_fa": "چه میزان تغییر لازم است؟"
          },
          {
            "order": 3,
            "speaker": "하나",
            "text": "최소 일주일 연장해 주시면 좋겠습니다.",
            "translation_fa": "بهتر است حداقل یک هفته تمدید شود."
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "추가 비용이 없다면 내부 검토 후 답드리겠습니다.",
            "translation_fa": "اگر هزینه اضافی نباشد، بعد از بررسی داخلی پاسخ می‌دهم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
