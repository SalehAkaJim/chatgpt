    {
      "kind": "dialogue",
      "external_id": "d_formal_negotiation_02",
      "data": {
        "lesson_key": "b2-ko-formal-negotiation-02",
        "title": "서로의 조건",
        "setting": "item",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "민수",
          "유나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "민수",
            "text": "가격을 유지하는 대신 수량을 늘리는 건 어떨까요?",
            "translation_fa": "چطور است در عوض ثابت نگه داشتن قیمت، تعداد را بیشتر کنیم؟"
          },
          {
            "order": 2,
            "speaker": "유나",
            "text": "배송 일정을 앞당길 수 있다면 검토해 볼 수 있어요.",
            "translation_fa": "اگر بتوانید تحویل را جلو بیندازید، می‌توانیم بررسی کنیم."
          },
          {
            "order": 3,
            "speaker": "민수",
            "text": "그 조건이면 저희도 한 번 양보할 수 있습니다.",
            "translation_fa": "با آن شرط ما هم می‌توانیم یک امتیاز بدهیم."
          },
          {
            "order": 4,
            "speaker": "유나",
            "text": "좋습니다. 합의 내용을 문서로 정리하죠.",
            "translation_fa": "خوب است. توافق را مکتوب کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
