    {
      "kind": "utterance",
      "external_id": "u_source_comparison_03",
      "data": {
        "lesson_key": "b2-ko-source-comparison-02",
        "text": {
          "ko": "두 출처의 결론이 상반돼서 조사 방법을 먼저 확인해야 해요."
        },
        "translations": {
          "fa": "نتیجه دو منبع متضاد است، پس باید اول روش تحقیق را بررسی کنیم."
