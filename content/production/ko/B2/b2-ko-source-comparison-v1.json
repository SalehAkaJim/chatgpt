    {
      "kind": "grammar_point",
      "external_id": "g_source_comparison_core",
      "data": {
        "lesson_key": "b2-ko-source-comparison-01",
        "slug": "b2-ko-source-comparison-grammar",
        "title": "출처를 밝히며 비교하기",
        "rule_summary": "Use -에 따르면 to attribute information and -는 데 비해 to contrast how sources frame the same issue.",
        "explanation": {
          "fa": "با -에 따르면 منبع اطلاعات را مشخص می‌کنیم و با -는 데 비해 تفاوت میان تأکید یا چارچوب‌بندی دو منبع را نشان می‌دهیم."
        },
        "examples": [
          {
            "ko": "통계청 자료에 따르면 인구 이동이 늘었습니다.",
            "fa": "طبق داده اداره آمار، جابه‌جایی جمعیت بیشتر شده است."
          },
          {
            "ko": "첫 보고서는 비용을 다루는 데 비해 두 번째 보고서는 만족도를 분석합니다.",
            "fa": "گزارش اول هزینه را بررسی می‌کند، در حالی که گزارش دوم رضایت را تحلیل می‌کند."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_source_comparison_01",
      "data": {
        "lesson_key": "b2-ko-source-comparison-01",
        "title": "같은 숫자, 다른 기사",
        "setting": "item",
        "cefr": "B2",
        "topic": "questions",
        "characters": [
          "서연",
          "민수"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "두 기사에 같은 통계가 있는데 분위기가 완전히 달라요.",
            "translation_fa": "دو مقاله آمار یکسان دارند اما حال‌وهوایشان کاملاً متفاوت است."
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "제목에서 강조하는 부분이 다르기 때문이에요.",
            "translation_fa": "چون بخش متفاوتی را در تیتر برجسته کرده‌اند."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "어느 쪽을 믿어야 할까요?",
            "translation_fa": "کدام را باید باور کنیم؟"
          },
          {
            "order": 4,
            "speaker": "민수",
            "text": "원자료와 조사 방법을 먼저 확인하는 게 좋아요.",
            "translation_fa": "بهتر است اول داده اصلی و روش تحقیق را بررسی کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_source_comparison_02",
      "data": {
        "lesson_key": "b2-ko-source-comparison-02",
        "title": "충돌하는 보고서",
        "setting": "item",
        "cefr": "B2",
        "topic": "questions",
        "characters": [
          "태호",
          "하나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "태호",
            "text": "이 보고서는 효과가 있다고 하고 다른 보고서는 없다고 해요.",
            "translation_fa": "این گزارش می‌گوید اثر دارد و گزارش دیگر می‌گوید ندارد."
          },
          {
            "order": 2,
            "speaker": "하나",
            "text": "표본과 기간이 같은지부터 봐야 해요.",
            "translation_fa": "اول باید ببینیم نمونه و بازه زمانی یکسان است یا نه."
          },
          {
            "order": 3,
            "speaker": "태호",
            "text": "결론만 비교하면 위험하겠네요.",
            "translation_fa": "پس مقایسه فقط نتیجه خطرناک است."
          },
          {
            "order": 4,
            "speaker": "하나",
            "text": "네, 신뢰도는 자료가 만들어진 과정까지 봐야 판단할 수 있어요.",
            "translation_fa": "بله، برای سنجش اعتبار باید فرایند تولید داده را هم دید."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
