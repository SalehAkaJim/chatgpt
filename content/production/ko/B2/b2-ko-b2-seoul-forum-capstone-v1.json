    {
      "kind": "grammar_point",
      "external_id": "g_b2_seoul_forum_capstone_core",
      "data": {
        "lesson_key": "b2-ko-b2-seoul-forum-capstone-01",
        "slug": "b2-ko-b2-seoul-forum-capstone-grammar",
        "title": "B2 통합 과제",
        "rule_summary": "Combine evidence marking, qualified stance, mediation, formal register and negotiation without collapsing them into one vague style.",
        "explanation": {
          "fa": "در فعالیت نهایی B2 باید شواهد، موضع مشروط، میانجی‌گری، رسمیت و مذاکره را کنار هم به کار ببریم، بدون اینکه تفاوت کارکرد هرکدام از بین برود."
        },
        "examples": [
          {
            "ko": "근거는 충분해 보이지만 반대 의견도 함께 검토할 필요가 있습니다.",
            "fa": "شواهد کافی به نظر می‌رسد، اما لازم است نظر مخالف هم بررسی شود."
          },
          {
            "ko": "합의가 어렵더라도 공통 기준부터 정해 봅시다.",
            "fa": "حتی اگر توافق دشوار باشد، اول معیار مشترک را تعیین کنیم."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_seoul_forum_capstone_01",
      "data": {
        "lesson_key": "b2-ko-b2-seoul-forum-capstone-01",
        "title": "포럼 준비",
        "setting": "item",
        "cefr": "B2",
        "topic": "future-plans",
        "characters": [
          "지민",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "발표에서 어떤 입장을 취하는 게 좋을까요?",
            "translation_fa": "در ارائه چه موضعی بگیریم؟"
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "찬반을 먼저 정하기보다 확인된 사실과 쟁점을 구분해요.",
            "translation_fa": "به‌جای اینکه اول موافق یا مخالف شویم، واقعیت‌های تأییدشده را از نقاط اختلاف جدا کنیم."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "이해관계자 의견도 모두 넣어야겠죠?",
            "translation_fa": "نظر همه ذی‌نفعان را هم باید وارد کنیم، درست است؟"
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "네, 그리고 공통 기준을 제안하면 논의가 더 생산적일 겁니다.",
            "translation_fa": "بله، و اگر معیار مشترکی پیشنهاد کنیم بحث سازنده‌تر می‌شود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_seoul_forum_capstone_02",
      "data": {
        "lesson_key": "b2-ko-b2-seoul-forum-capstone-02",
        "title": "최종 합의안",
        "setting": "item",
        "cefr": "B2",
        "topic": "future-plans",
        "characters": [
          "유나",
          "준호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "유나",
            "text": "완전한 합의는 어렵지만 공통점은 찾은 것 같아요.",
            "translation_fa": "توافق کامل دشوار است، اما به نظر می‌رسد نقاط مشترک را پیدا کرده‌ایم."
          },
          {
            "order": 2,
            "speaker": "준호",
            "text": "안전 기준은 유지하고 시행 시기는 조정하는 안이 가장 현실적이에요.",
            "translation_fa": "واقع‌بینانه‌ترین راه این است که استاندارد ایمنی بماند و زمان اجرا تنظیم شود."
          },
          {
            "order": 3,
            "speaker": "유나",
            "text": "반대 측 우려도 반영됐다고 볼 수 있나요?",
            "translation_fa": "می‌شود گفت نگرانی طرف مخالف هم لحاظ شده؟"
          },
          {
            "order": 4,
            "speaker": "준호",
            "text": "네, 비용 자료를 다시 검토하는 조건을 넣으면 더 균형 잡힌 안이 됩니다.",
            "translation_fa": "بله، اگر شرط بازبینی داده‌های هزینه را اضافه کنیم، پیشنهاد متعادل‌تر می‌شود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
