    {
      "kind": "grammar_point",
      "external_id": "g_concession_and_disagreement_core",
      "data": {
        "lesson_key": "b2-ko-concession-and-disagreement-01",
        "slug": "b2-ko-concession-and-disagreement-grammar",
        "title": "양보하면서 반대하기",
        "rule_summary": "Use concession forms to acknowledge a valid point before preserving a different conclusion or priority.",
        "explanation": {
          "fa": "با ساخت‌های امتیازی، نکته درست طرف مقابل را می‌پذیریم اما نتیجه یا اولویت متفاوت خود را حفظ می‌کنیم؛ این روش در کره‌ای رسمی و حرفه‌ای طبیعی‌تر است."
        },
        "examples": [
          {
            "ko": "어렵기는 해도 불가능한 일은 아니에요.",
            "fa": "هرچند دشوار است، غیرممکن نیست."
          },
          {
            "ko": "시간이 걸리더라도 정확하게 확인해야 합니다.",
            "fa": "حتی اگر زمان ببرد، باید دقیق بررسی شود."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_concession_and_disagreement_01",
      "data": {
        "lesson_key": "b2-ko-concession-and-disagreement-01",
        "title": "반대하지만 듣기",
        "setting": "item",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "태호",
          "서연"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "태호",
            "text": "이 방식이 너무 느리다는 비판에 동의하세요?",
            "translation_fa": "با انتقاد اینکه این روش خیلی کند است موافقید؟"
          },
          {
            "order": 2,
            "speaker": "서연",
            "text": "느린 건 인정하지만 검증 단계를 없애는 건 반대예요.",
            "translation_fa": "کند بودن را می‌پذیرم، اما با حذف مرحله بررسی مخالفم."
          },
          {
            "order": 3,
            "speaker": "태호",
            "text": "그럼 어디까지 줄일 수 있을까요?",
            "translation_fa": "پس تا کجا می‌توانیم آن را کوتاه کنیم؟"
          },
          {
            "order": 4,
            "speaker": "서연",
            "text": "중복 절차는 줄이되 핵심 검증은 유지해야 해요.",
            "translation_fa": "روال‌های تکراری را کم کنیم، اما بررسی اصلی باید بماند."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_concession_and_disagreement_02",
      "data": {
        "lesson_key": "b2-ko-concession-and-disagreement-02",
        "title": "쟁점 좁히기",
        "setting": "item",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "도윤",
          "지민"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "도윤",
            "text": "서로 입장이 너무 다른 것 같습니다.",
            "translation_fa": "به نظر می‌رسد مواضع دو طرف خیلی متفاوت است."
          },
          {
            "order": 2,
            "speaker": "지민",
            "text": "전체를 놓고 싸우기보다 쟁점을 두세 개로 좁혀 봐요.",
            "translation_fa": "به‌جای بحث درباره کل موضوع، اختلاف را به دو سه نکته محدود کنیم."
          },
          {
            "order": 3,
            "speaker": "도윤",
            "text": "그러면 합의 가능성이 높아지겠네요.",
            "translation_fa": "این‌طور احتمال توافق بیشتر می‌شود."
          },
          {
            "order": 4,
            "speaker": "지민",
            "text": "네, 인정할 부분과 양보할 수 없는 부분을 나누면 됩니다.",
            "translation_fa": "بله، باید بخش‌های قابل پذیرش را از بخش‌های غیرقابل امتیاز جدا کنیم."
          }
        ],
        "qa": {
