    {
      "kind": "grammar_point",
      "external_id": "g_counterfactual_reflection_core",
      "data": {
        "lesson_key": "b2-ko-counterfactual-reflection-01",
        "slug": "b2-ko-counterfactual-reflection-grammar",
        "title": "과거의 반사실 조건: -았/었더라면",
        "rule_summary": "Use -았/었더라면 for a past condition that did not happen, often followed by a hypothetical result.",
        "explanation": {
          "fa": "-았/었더라면 برای شرطی در گذشته است که واقعاً رخ نداده؛ نتیجه معمولاً فرضی، حسرت‌آمیز یا تحلیلی است."
        },
        "examples": [
          {
            "ko": "미리 알았더라면 준비했을 거예요.",
            "fa": "اگر از قبل می‌دانستم، آماده می‌شدم."
          },
          {
            "ko": "길을 바꾸지 않았더라면 더 늦었을 텐데요.",
            "fa": "اگر مسیر را عوض نکرده بودیم، احتمالاً دیرتر می‌رسیدیم."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_counterfactual_reflection_01",
      "data": {
        "lesson_key": "b2-ko-counterfactual-reflection-01",
        "title": "다시 선택한다면",
        "setting": "item",
        "cefr": "B2",
        "topic": "future-plans",
        "characters": [
          "지민",
          "준호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "같은 상황이 다시 온다면 똑같이 결정할 거예요?",
            "translation_fa": "اگر همان موقعیت دوباره پیش بیاید، همان تصمیم را می‌گیرید؟"
          },
          {
            "order": 2,
            "speaker": "준호",
            "text": "아니요. 자료를 더 봤더라면 서두르지 않았을 거예요.",
            "translation_fa": "نه. اگر داده بیشتری دیده بودم عجله نمی‌کردم."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "가장 아쉬운 점은 뭐예요?",
            "translation_fa": "بیشتر از همه از چه چیزی ناراضی هستید؟"
          },
          {
            "order": 4,
            "speaker": "준호",
            "text": "대안을 하나만 두었던 게 가장 아쉬워요.",
            "translation_fa": "بیشتر از همه اینکه فقط یک گزینه جایگزین داشتیم."
          }
        ],
        "qa": {
