    {
      "kind": "grammar_point",
      "external_id": "g_register_and_social_distance_core",
      "data": {
        "lesson_key": "b2-ko-register-and-social-distance-01",
        "slug": "b2-ko-register-and-social-distance-grammar",
        "title": "상황에 맞는 높임과 문체",
        "rule_summary": "Korean politeness is not only verb endings: titles, indirectness and institutional register also signal social distance.",
        "explanation": {
          "fa": "ادب در کره‌ای فقط پایان فعل نیست؛ عنوان خطاب، میزان غیرمستقیم بودن و سبک رسمیِ سازمانی هم فاصله اجتماعی را نشان می‌دهند."
        },
        "examples": [
          {
            "ko": "잠시만 기다려 주시겠습니까?",
            "fa": "ممکن است لطفاً کمی منتظر بمانید؟"
          },
          {
            "ko": "확인 후 다시 안내드리겠습니다.",
            "fa": "پس از بررسی دوباره اطلاع‌رسانی خواهیم کرد."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_register_and_social_distance_01",
      "data": {
        "lesson_key": "b2-ko-register-and-social-distance-01",
        "title": "메일과 대화의 차이",
        "setting": "item",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "민수",
          "하나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "민수",
            "text": "팀장님께 메일을 쓰는데 '확인해 주세요'면 괜찮을까요?",
            "translation_fa": "برای مدیر تیم ایمیل می‌زنم؛ «لطفاً بررسی کنید» کافی است؟"
          },
          {
            "order": 2,
            "speaker": "하나",
            "text": "틀리진 않지만 첫 메일이면 조금 더 격식을 갖추는 게 좋아요.",
            "translation_fa": "غلط نیست، اما برای اولین ایمیل بهتر است کمی رسمی‌تر باشد."
          },
          {
            "order": 3,
            "speaker": "민수",
            "text": "어떻게 바꾸면 자연스러울까요?",
            "translation_fa": "چطور تغییرش بدهم طبیعی‌تر است؟"
          },
          {
            "order": 4,
            "speaker": "하나",
            "text": "'확인해 주시면 감사하겠습니다' 정도가 무난해요.",
            "translation_fa": "«ممنون می‌شوم اگر بررسی بفرمایید» مناسب است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_register_and_social_distance_02",
      "data": {
        "lesson_key": "b2-ko-register-and-social-distance-02",
        "title": "공식 안내",
        "setting": "item",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "준호",
          "유나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "준호",
            "text": "현장 안내는 해요체로 해도 돼요?",
            "translation_fa": "اطلاع‌رسانی حضوری را می‌شود با 해요체 انجام داد؟"
          },
          {
            "order": 2,
            "speaker": "유나",
            "text": "친근한 행사는 괜찮지만 안전 안내는 더 공식적으로 하는 게 좋아요.",
            "translation_fa": "برای برنامه دوستانه اشکالی ندارد، اما اطلاعیه ایمنی بهتر است رسمی‌تر باشد."
          },
          {
            "order": 3,
            "speaker": "준호",
            "text": "상황에 따라 문체를 바꾸는 거군요.",
            "translation_fa": "پس سبک جمله را بسته به موقعیت عوض می‌کنیم."
          },
          {
            "order": 4,
            "speaker": "유나",
            "text": "맞아요. 친절함과 공식성은 같이 갈 수 있어요.",
            "translation_fa": "دقیقاً. صمیمیت و رسمیت می‌توانند هم‌زمان باشند."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
