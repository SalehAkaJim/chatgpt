    {
      "kind": "grammar_point",
      "external_id": "g_process_and_responsibility_core",
      "data": {
        "lesson_key": "b2-ko-process-and-responsibility-01",
        "slug": "b2-ko-process-and-responsibility-grammar",
        "title": "과정과 결과의 표현",
        "rule_summary": "Use passive/result constructions when the process matters, but add the responsible actor when accountability is relevant.",
        "explanation": {
          "fa": "وقتی خود فرایند مهم است از ساخت‌های مجهول یا نتیجه‌ای استفاده می‌کنیم؛ اما اگر مسئولیت اهمیت دارد، عامل را هم روشن می‌کنیم."
        },
        "examples": [
          {
            "ko": "결과는 다음 주에 발표됩니다.",
            "fa": "نتیجه هفته بعد اعلام می‌شود."
          },
          {
            "ko": "최종 검토는 법무팀이 담당하게 되었습니다.",
            "fa": "بررسی نهایی به عهده تیم حقوقی گذاشته شده است."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_process_and_responsibility_01",
      "data": {
        "lesson_key": "b2-ko-process-and-responsibility-01",
        "title": "승인 절차",
        "setting": "item",
        "cefr": "B2",
        "topic": "daily-routine",
        "characters": [
          "유나",
          "민수"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "유나",
            "text": "이 문서는 바로 승인되는 건가요?",
            "translation_fa": "این سند مستقیم تأیید می‌شود؟"
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "아니요. 먼저 실무 검토를 거친 뒤 책임자가 승인합니다.",
            "translation_fa": "نه. اول بررسی اجرایی می‌شود و بعد مسئول آن را تأیید می‌کند."
          },
          {
            "order": 3,
            "speaker": "유나",
            "text": "수정이 필요하면 누가 연락하죠?",
            "translation_fa": "اگر اصلاح لازم باشد چه کسی تماس می‌گیرد؟"
          },
          {
            "order": 4,
            "speaker": "민수",
            "text": "담당자가 신청자에게 직접 안내합니다.",
            "translation_fa": "مسئول پرونده مستقیم به متقاضی اطلاع می‌دهد."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_process_and_responsibility_02",
      "data": {
        "lesson_key": "b2-ko-process-and-responsibility-02",
        "title": "책임 범위",
        "setting": "item",
        "cefr": "B2",
        "topic": "daily-routine",
        "characters": [
          "하나",
          "준호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "하나",
            "text": "장애가 생기면 어느 팀이 대응하나요?",
            "translation_fa": "اگر اختلال پیش بیاید کدام تیم پاسخ می‌دهد؟"
          },
          {
            "order": 2,
            "speaker": "준호",
            "text": "기술 문제는 개발팀, 고객 안내는 운영팀이 맡아요.",
            "translation_fa": "مشکل فنی با تیم توسعه است و اطلاع‌رسانی به مشتری با تیم عملیات."
          },
          {
            "order": 3,
            "speaker": "하나",
            "text": "경계가 애매한 경우는요?",
            "translation_fa": "اگر مرز مسئولیت مبهم باشد چه؟"
          },
          {
            "order": 4,
            "speaker": "준호",
            "text": "공동 책임으로 처리하되 최종 담당자는 한 명 정해야 해요.",
            "translation_fa": "به‌صورت مسئولیت مشترک رسیدگی می‌کنیم، اما باید یک مسئول نهایی مشخص شود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
