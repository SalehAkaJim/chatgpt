    {
      "kind": "grammar_point",
      "external_id": "g_evidence_and_inference_core",
      "data": {
        "lesson_key": "b2-ko-evidence-and-inference-01",
        "slug": "b2-ko-evidence-and-inference-grammar",
        "title": "근거에 따른 추론",
        "rule_summary": "Use -는 것으로 보이다 and -(으)ㄹ 가능성이 있다 to mark conclusions as evidence-based but not absolute.",
        "explanation": {
          "fa": "برای نتیجه‌گیری مبتنی بر شواهد بدون قطعیت کامل از -는 것으로 보이다 و -(으)ㄹ 가능성이 있다 استفاده می‌کنیم."
        },
        "examples": [
          {
            "ko": "참여율이 다시 높아지는 것으로 보입니다.",
            "fa": "به نظر می‌رسد نرخ مشارکت دوباره در حال افزایش است."
          },
          {
            "ko": "추가 비용이 발생할 가능성이 있어요.",
            "fa": "احتمال ایجاد هزینه اضافی وجود دارد."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_evidence_and_inference_01",
      "data": {
        "lesson_key": "b2-ko-evidence-and-inference-01",
        "title": "확인된 것과 추정",
        "setting": "item",
        "cefr": "B2",
        "topic": "questions",
        "characters": [
          "하나",
          "태호"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "하나",
            "text": "원인이 밝혀졌다는 보도가 맞아요?",
            "translation_fa": "خبر درست است که علت مشخص شده؟"
          },
          {
            "order": 2,
            "speaker": "태호",
            "text": "아직 공식 확인은 없고 몇 가지 정황만 나온 상태예요.",
            "translation_fa": "هنوز تأیید رسمی نیست و فقط چند قرینه منتشر شده."
          },
          {
            "order": 3,
            "speaker": "하나",
            "text": "그럼 제목을 확정적으로 쓰면 안 되겠네요.",
            "translation_fa": "پس نباید تیتر را قطعی بنویسیم."
          },
          {
            "order": 4,
            "speaker": "태호",
            "text": "네, 가능성으로 표현하는 게 맞아요.",
            "translation_fa": "بله، بهتر است آن را به‌صورت احتمال بیان کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
