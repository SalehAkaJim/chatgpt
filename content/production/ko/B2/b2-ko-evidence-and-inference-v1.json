    {
      "kind": "dialogue",
      "external_id": "d_evidence_and_inference_02",
      "data": {
        "lesson_key": "b2-ko-evidence-and-inference-02",
        "title": "자료 해석",
        "setting": "item",
        "cefr": "B2",
        "topic": "questions",
        "characters": [
          "유나",
          "도윤"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "유나",
            "text": "지난달 수치가 올랐는데 회복세라고 봐도 될까요?",
            "translation_fa": "عدد ماه قبل بالا رفته؛ می‌شود آن را روند بهبود دانست؟"
          },
          {
            "order": 2,
            "speaker": "도윤",
            "text": "한 달 자료만으로 단정하기는 어려워요.",
            "translation_fa": "با داده یک ماه نمی‌شود قطعی حکم داد."
          },
          {
            "order": 3,
            "speaker": "유나",
            "text": "어떤 근거가 더 필요하죠?",
            "translation_fa": "چه شواهد دیگری لازم است؟"
          },
          {
            "order": 4,
            "speaker": "도윤",
            "text": "최소 몇 달의 추세와 외부 요인을 함께 봐야 합니다.",
            "translation_fa": "حداقل باید روند چند ماه و عوامل بیرونی را با هم ببینیم."
          }
        ],
        "qa": {
