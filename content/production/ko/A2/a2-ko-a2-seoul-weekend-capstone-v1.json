        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "오늘 어디에 가려고 해요?",
            "translation_fa": "امروز قصد داری کجا بروی؟"
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "아침에는 경복궁에 가려고 해요.",
            "translation_fa": "صبح قصد دارم به گیونگ‌بوک بروم."
