    {
      "kind": "grammar_point",
      "external_id": "g_storytelling_sequence_core",
      "data": {
        "lesson_key": "b1-ko-storytelling-sequence-01",
        "slug": "b1-ko-storytelling-sequence-grammar",
        "title": "-더니 / -다가",
        "rule_summary": "-더니 links an observed situation to a later result; -다가 marks an action interrupted midway.",
        "explanation": {
          "fa": "-더니 یک وضعیت مشاهده‌شده را به نتیجهٔ بعدی وصل می‌کند و -다가 برای کاری است که وسط انجامش اتفاق دیگری رخ می‌دهد."
        },
        "examples": [
          {
            "ko": "날씨가 흐리더니 비가 왔어요.",
            "fa": "هوا ابری شد و بعد باران آمد."
          },
          {
            "ko": "공부하다가 잠들었어요.",
            "fa": "وسط درس خواندن خوابم برد."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_storytelling_sequence_01",
      "data": {
        "lesson_key": "b1-ko-storytelling-sequence-01",
        "title": "이상한 아침",
        "setting": "office",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "준호",
          "유나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "준호",
            "text": "오늘 아침에 무슨 일이 있었어요?",
            "translation_fa": "امروز صبح چه اتفاقی افتاد؟"
          },
          {
            "order": 2,
            "speaker": "유나",
            "text": "회사에 왔더니 문이 잠겨 있었어요.",
            "translation_fa": "وقتی به شرکت رسیدم دیدم در قفل است."
          },
          {
            "order": 3,
            "speaker": "준호",
            "text": "그래서 어떻게 했어요?",
            "translation_fa": "پس چه کار کردی؟"
          },
          {
            "order": 4,
            "speaker": "유나",
            "text": "기다리다가 경비실에 전화했어요.",
            "translation_fa": "کمی منتظر ماندم و بعد به نگهبانی زنگ زدم."
          }
        ],
        "qa": {
