      "data": {
        "lesson_key": "b1-ko-conditions-and-consequences-01",
        "slug": "b1-ko-conditions-and-consequences-grammar",
        "title": "-(으)면 / -지 않으면",
        "rule_summary": "Use -(으)면 for realistic conditions and -지 않으면 for consequences when something is not done.",
        "explanation": {
          "fa": "-(으)면 برای شرط‌های واقعی و -지 않으면 برای پیامد انجام ندادن کاری استفاده می‌شود."
        },
        "examples": [
          {
            "ko": "시간이 있으면 전화해요.",
            "fa": "اگر وقت داشتی زنگ بزن."
          },
          {
            "ko": "지금 안 가면 늦어요.",
            "fa": "اگر الان نرویم دیر می‌شود."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
