    {
      "kind": "dialogue",
      "external_id": "d_experiences_and_change_02",
      "data": {
        "lesson_key": "b1-ko-experiences-and-change-02",
        "title": "새로운 습관",
        "setting": "library",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "서연",
          "하나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "서연",
            "text": "요즘 새로 생긴 습관이 있어요?",
            "translation_fa": "این روزها عادت تازه‌ای پیدا کرده‌ای؟"
          },
          {
            "order": 2,
            "speaker": "하나",
            "text": "매일 짧게라도 한국어 일기를 쓰게 됐어요.",
            "translation_fa": "عادت کرده‌ام هر روز حتی کوتاه، خاطرات کره‌ای بنویسم."
          },
          {
            "order": 3,
            "speaker": "서연",
            "text": "도움이 많이 돼요?",
            "translation_fa": "خیلی کمک می‌کند؟"
          },
          {
            "order": 4,
            "speaker": "하나",
            "text": "네, 표현이 훨씬 빨리 늘어요.",
            "translation_fa": "بله، عبارت‌ها خیلی سریع‌تر بهتر می‌شوند."
          }
        ],
