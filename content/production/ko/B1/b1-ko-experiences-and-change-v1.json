    {
      "kind": "grammar_point",
      "external_id": "g_experiences_and_change_core",
      "data": {
        "lesson_key": "b1-ko-experiences-and-change-01",
        "slug": "b1-ko-experiences-and-change-grammar",
        "title": "-(으)ㄴ 뒤로 / -게 되다",
        "rule_summary": "Use -(으)ㄴ 뒤로 for a continuing change since an event; -게 되다 presents a change that came about.",
        "explanation": {
          "fa": "برای بیان تغییری که از یک اتفاق به بعد ادامه داشته از -(으)ㄴ 뒤로 و برای تغییری که به‌تدریج رخ داده از -게 되다 استفاده می‌کنیم."
        },
        "examples": [
          {
            "ko": "이사한 뒤로 자주 걸어요.",
            "fa": "از وقتی اسباب‌کشی کردم زیاد پیاده‌روی می‌کنم."
          },
          {
            "ko": "일찍 자게 됐어요.",
            "fa": "کم‌کم عادت کردم زود بخوابم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_experiences_and_change_01",
      "data": {
        "lesson_key": "b1-ko-experiences-and-change-01",
        "title": "생활이 어떻게 달라졌어요?",
        "setting": "cafe",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "지민",
          "민수"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "지민",
            "text": "한국에 온 뒤로 생활이 어떻게 달라졌어요?",
            "translation_fa": "از وقتی به کره آمدی، سبک زندگی‌ات چطور عوض شده؟"
          },
          {
            "order": 2,
            "speaker": "민수",
            "text": "대중교통을 더 자주 이용하게 됐어요.",
            "translation_fa": "کم‌کم بیشتر از حمل‌ونقل عمومی استفاده می‌کنم."
          },
          {
            "order": 3,
            "speaker": "지민",
            "text": "이제는 익숙해요?",
            "translation_fa": "حالا عادت کرده‌ای؟"
          },
          {
            "order": 4,
            "speaker": "민수",
            "text": "네, 어느새 아주 자연스러워졌어요.",
            "translation_fa": "بله، کم‌کم کاملاً طبیعی شده است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
