    {
      "kind": "grammar_point",
      "external_id": "g_social_nuance_core",
      "data": {
        "lesson_key": "b1-ko-social-nuance-01",
        "slug": "b1-ko-social-nuance-grammar",
        "title": "-기는 하지만 / -(으)면 좋겠다",
        "rule_summary": "Use -기는 하지만 to acknowledge a point before a contrast; -(으)면 좋겠다 softens a wish or request.",
        "explanation": {
          "fa": "-기는 하지만 ابتدا یک نکته را می‌پذیرد و بعد مخالفت را می‌آورد؛ -(으)면 좋겠다 خواسته را نرم‌تر می‌کند."
        },
        "examples": [
          {
            "ko": "편하기는 하지만 비싸요.",
            "fa": "راحت است، اما گران است."
          },
          {
            "ko": "조금 일찍 오면 좋겠어요.",
            "fa": "خوب می‌شود کمی زودتر بیایی."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_social_nuance_01",
      "data": {
        "lesson_key": "b1-ko-social-nuance-01",
        "title": "부드럽게 거절하기",
        "setting": "office",
        "cefr": "B1",
        "topic": "requests",
        "characters": [
          "하나",
          "지민"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "하나",
            "text": "오늘 저녁 모임에 올 수 있어요?",
            "translation_fa": "می‌توانی امشب به دورهمی بیایی؟"
          },
          {
            "order": 2,
            "speaker": "지민",
            "text": "가고 싶기는 하지만 오늘은 일이 많아요.",
            "translation_fa": "دوست دارم بیایم، اما امروز کارم زیاد است."
          },
          {
            "order": 3,
            "speaker": "하나",
            "text": "괜찮아요. 다음에 같이 가요.",
            "translation_fa": "اشکالی ندارد. دفعه بعد با هم برویم."
          },
          {
            "order": 4,
            "speaker": "지민",
            "text": "네, 다음에는 꼭 갈게요.",
            "translation_fa": "بله، دفعه بعد حتماً می‌آیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_social_nuance_02",
      "data": {
        "lesson_key": "b1-ko-social-nuance-02",
        "title": "요청을 부드럽게",
        "setting": "meeting",
        "cefr": "B1",
        "topic": "requests",
        "characters": [
          "준호",
          "유나"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "준호",
            "text": "자료를 오늘 받을 수 있을까요?",
            "translation_fa": "می‌شود مدارک را امروز بگیرم؟"
          },
          {
            "order": 2,
            "speaker": "유나",
            "text": "오늘은 조금 어려워요.",
            "translation_fa": "امروز کمی سخت است."
          },
          {
            "order": 3,
            "speaker": "준호",
            "text": "그럼 내일 오전까지 주시면 좋겠어요.",
            "translation_fa": "پس خوب می‌شود تا فردا صبح بدهید."
          },
          {
            "order": 4,
            "speaker": "유나",
            "text": "네, 그렇게 할게요.",
            "translation_fa": "بله، همین کار را می‌کنم."
          }
        ],
        "qa": {
