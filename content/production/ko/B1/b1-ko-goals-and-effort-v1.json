      "data": {
        "lesson_key": "b1-ko-goals-and-effort-01",
        "slug": "b1-ko-goals-and-effort-grammar",
        "title": "-기 위해(서) / -(으)려고 노력하다",
        "rule_summary": "Use -기 위해(서) to state a purpose and -(으)려고 노력하다 for sustained effort toward it.",
        "explanation": {
          "fa": "-기 위해(서) هدف را بیان می‌کند و -(으)려고 노력하다 برای تلاش مداوم به سوی آن است."
        },
        "examples": [
          {
            "ko": "건강을 위해 운동해요.",
            "fa": "برای سلامتی ورزش می‌کنم."
          },
          {
            "ko": "매일 읽으려고 노력해요.",
            "fa": "تلاش می‌کنم هر روز بخوانم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
