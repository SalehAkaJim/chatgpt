      "data": {
        "lesson_key": "b1-ko-media-and-sources-01",
        "slug": "b1-ko-media-and-sources-grammar",
        "title": "-다는 말 / -(으)ㄴ/는지 확인하다",
        "rule_summary": "Use -다는 말 to refer to a claim and -(으)ㄴ/는지 확인하다 to check whether it is true.",
        "explanation": {
          "fa": "-다는 말 برای اشاره به یک ادعا و -(으)ㄴ/는지 확인하다 برای بررسی درست بودن آن به کار می‌رود."
        },
        "examples": [
          {
            "ko": "가격이 오른다는 말을 들었어요.",
            "fa": "شنیدم که می‌گویند قیمت بالا می‌رود."
          },
          {
            "ko": "사실인지 확인해요.",
            "fa": "بررسی می‌کنم واقعیت دارد یا نه."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
