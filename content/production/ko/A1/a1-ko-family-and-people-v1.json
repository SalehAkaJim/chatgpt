    {
      "kind": "grammar_point",
      "external_id": "g_family_and_people_core",
      "data": {
        "lesson_key": "a1-ko-family-and-people-01",
        "slug": "a1-ko-family-and-people-grammar",
        "title": "우리 + 가족, 사람 수 + 명",
        "rule_summary": "Korean often uses 우리 ('our') where Persian or English would say 'my' for close in-groups such as family. 명 is a counter for people.",
        "explanation": {
          "fa": "در کره‌ای برای چیزهای نزدیک مثل خانواده خیلی وقت‌ها به‌جای «مال من» از 우리 یعنی «ما/مال ما» استفاده می‌شود. برای شمردن آدم‌ها شمارندهٔ 명 می‌آید."
        },
        "examples": [
          {
            "ko": "우리 엄마예요.",
            "fa": "مادرم است."
          },
          {
            "ko": "동생이 한 명 있어요.",
            "fa": "یک خواهر یا برادر کوچک‌تر دارم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
