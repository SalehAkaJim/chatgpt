    {
      "kind": "grammar_point",
      "external_id": "g_cafe_orders_core",
      "data": {
        "lesson_key": "a1-ko-cafe-orders-01",
        "slug": "a1-ko-cafe-orders-grammar",
        "title": "수량 + 단위 + 주세요",
        "rule_summary": "Korean places a counter after a number: 한 잔 for one cup and 두 개 for two items. 주세요 turns the noun phrase into a polite request.",
        "explanation": {
          "fa": "در کره‌ای برای شمردن معمولاً عدد با «شمارنده» می‌آید: 한 잔 یعنی یک فنجان و 두 개 یعنی دو عدد. با 주세요 این عبارت به درخواست مؤدبانه تبدیل می‌شود."
        },
        "examples": [
          {
            "ko": "커피 한 잔 주세요.",
            "fa": "یک فنجان قهوه لطفاً."
          },
          {
            "ko": "빵 두 개 주세요.",
            "fa": "دو عدد نان/شیرینی لطفاً."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
