      "data": {
        "lesson_key": "a1-ko-time-and-schedule-01",
        "slug": "a1-ko-time-and-schedule-grammar",
        "title": "시간 + 에",
        "rule_summary": "Use 에 after a clock time to mark when an event happens. Korean typically uses native-Korean numerals for the hour and Sino-Korean numerals for minutes.",
        "explanation": {
          "fa": "برای گفتن زمان انجام کار، بعد از ساعت 에 می‌آید: 두 시에 만나요. برای ساعت معمولاً عدد بومی کره‌ای و برای دقیقه عدد چینی-کره‌ای به‌کار می‌رود."
        },
        "examples": [
          {
            "ko": "두 시에 만나요.",
            "fa": "ساعت دو همدیگر را می‌بینیم."
          },
          {
            "ko": "세 시 반이에요.",
            "fa": "ساعت سه و نیم است."
          }
        ],
        "cefr": "A1",
        "status": "validated"
