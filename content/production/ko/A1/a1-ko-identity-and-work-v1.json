    {
      "kind": "grammar_point",
      "external_id": "g_identity_and_work_core",
      "data": {
        "lesson_key": "a1-ko-identity-and-work-01",
        "slug": "a1-ko-identity-and-work-grammar",
        "title": "이에요 / 예요, 아니에요",
        "rule_summary": "Korean uses 이에요 after a consonant and 예요 after a vowel for polite nominal statements; 아니에요 negates them.",
        "explanation": {
          "fa": "برای گفتن «هستم/است» در سبک مؤدبانه از 이에요 یا 예요 استفاده می‌شود؛ بعد از صامت معمولاً 이에요 و بعد از واکه 예요 می‌آید. 아니에요 برای منفی‌کردن به‌کار می‌رود."
        },
        "examples": [
          {
            "ko": "저는 회사원이에요.",
            "fa": "من کارمند شرکت هستم."
          },
          {
            "ko": "저는 선생님이 아니에요.",
            "fa": "من معلم نیستم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
