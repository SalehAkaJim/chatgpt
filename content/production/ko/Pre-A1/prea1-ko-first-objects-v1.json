    {
      "kind": "grammar_point",
      "external_id": "g_first_objects_core",
      "data": {
        "lesson_key": "prea1-ko-first-objects-01",
        "slug": "prea1-ko-first-objects-grammar",
        "title": "이에요 / 예요",
        "rule_summary": "The polite copula appears as 이에요 after many consonant-final nouns and 예요 after many vowel-final nouns.",
        "explanation": {
          "fa": "برای گفتن «... است»، معمولاً بعد از اسمِ ختم‌شده به صامت «이에요» و بعد از اسمِ ختم‌شده به واکه «예요» می‌آید. فعلاً با مثال‌ها الگو را بساز."
        },
        "examples": [
          {
            "ko": "책이에요.",
            "fa": "کتاب است."
          },
          {
            "ko": "커피예요.",
            "fa": "قهوه است."
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
