    {
      "kind": "grammar_point",
      "external_id": "g_my_name_core",
      "data": {
        "lesson_key": "prea1-ko-my-name-01",
        "slug": "prea1-ko-my-name-grammar",
        "title": "저는 / 제 이름은",
        "rule_summary": "Korean marks the topic with 는/은 and commonly omits information that is obvious from context.",
        "explanation": {
          "fa": "در «저는» نقش «من» به‌عنوان موضوع جمله مشخص می‌شود. فعلاً «저는 …예요» و «제 이름은 …예요» را به‌صورت الگوهای آماده یاد بگیر."
        },
        "examples": [
          {
            "ko": "저는 민수예요.",
            "fa": "من مین‌سو هستم."
          },
          {
            "ko": "제 이름은 지민이에요.",
            "fa": "اسم من جی‌مین است."
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
