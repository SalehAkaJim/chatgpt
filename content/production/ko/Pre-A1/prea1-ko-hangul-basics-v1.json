      "data": {
        "lesson_key": "prea1-ko-hangul-basics-01",
        "slug": "prea1-ko-hangul-basics-grammar",
        "title": "한글 음절 블록",
        "rule_summary": "Hangul letters combine into syllable blocks such as 가, 너 and 모; the block is one syllable, not one indivisible letter.",
        "explanation": {
          "fa": "در هانگول، چند حرف داخل یک بلوک هجا کنار هم قرار می‌گیرند. مثلاً «가» از ㄱ + ㅏ ساخته شده و یک هجا است."
        },
        "examples": [
          {
            "ko": "ㄱ + ㅏ → 가",
            "fa": "ㄱ و ㅏ با هم «가» می‌سازند."
          },
          {
            "ko": "ㄴ + ㅓ → 너",
            "fa": "ㄴ و ㅓ با هم «너» می‌سازند."
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
