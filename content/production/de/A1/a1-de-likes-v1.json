      "data": {
        "lesson_key": "a1-de-likes-01",
        "slug": "a1-de-likes-grammar",
        "title": "Das mag ich",
        "rule_summary": "Use mögen with nouns (Ich mag Musik) and gern with verbs (Ich höre gern Musik).",
        "explanation": {
          "fa": "«mögen + اسم» را از «فعل + gern» جدا نگه دار: «Ich mag Kaffee» ولی «Ich trinke gern Kaffee»."
        },
        "examples": [
          {
            "de": "Ich mag Musik.",
            "fa": "من موسیقی دوست دارم."
          },
          {
            "de": "Das gefällt mir.",
            "fa": "این را می‌پسندم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
