        "turns": [
          {
            "order": 1,
            "speaker": "Nina",
            "text": "Was machst du beruflich?",
            "translation_fa": "چه کاره‌ای؟"
          },
          {
            "order": 2,
            "speaker": "Jonas",
            "text": "Ich arbeite als Designer.",
            "translation_fa": "به‌عنوان طراح کار می‌کنم."
          },
          {
            "order": 3,
            "speaker": "Nina",
            "text": "Wo arbeitest du?",
            "translation_fa": "کجا کار می‌کنی؟"
          },
          {
            "order": 4,
            "speaker": "Jonas",
            "text": "In einer kleinen Firma.",
            "translation_fa": "در یک شرکت کوچک."
          }
        ],
        "status": "validated",
