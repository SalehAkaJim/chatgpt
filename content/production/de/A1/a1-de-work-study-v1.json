    {
      "kind": "grammar_point",
      "external_id": "g_work_study_core",
      "data": {
        "lesson_key": "a1-de-work-study-01",
        "slug": "a1-de-work-study-grammar",
        "title": "Arbeit & Lernen",
        "rule_summary": "Use arbeiten, lernen and studieren for activities; job nouns are capitalized and useful with als.",
        "explanation": {
          "fa": "برای شغل، الگوی «Ich arbeite als …» را یاد بگیر. اسم شغل‌ها هم مثل همهٔ اسم‌های آلمانی با حرف بزرگ نوشته می‌شوند."
        },
        "examples": [
          {
            "de": "arbeiten",
            "fa": "کار کردن"
          },
          {
            "de": "Ich arbeite als Designer.",
            "fa": "من به‌عنوان طراح کار می‌کنم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
