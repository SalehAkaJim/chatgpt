      "data": {
        "lesson_key": "a1-de-describing-01",
        "slug": "a1-de-describing-grammar",
        "title": "Personen beschreiben",
        "rule_summary": "With sein, German adjectives stay in their base form: Er ist freundlich; Sie ist ruhig.",
        "explanation": {
          "fa": "بعد از «sein» صفت پسوند نمی‌گیرد؛ این بهترین راه برای شروع توصیف آدم‌ها پیش از یادگیری صرف صفت است."
        },
        "examples": [
          {
            "de": "freundlich",
            "fa": "مهربان / خوش‌برخورد"
          },
          {
            "de": "Sie hat kurze Haare.",
            "fa": "او موهای کوتاه دارد."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
