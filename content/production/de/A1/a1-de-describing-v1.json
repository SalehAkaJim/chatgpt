          "Anna",
          "Lukas"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Anna",
            "text": "Wie ist deine neue Kollegin?",
            "translation_fa": "همکار جدیدت چطوره؟"
          },
          {
            "order": 2,
            "speaker": "Lukas",
            "text": "Sie ist sehr freundlich.",
            "translation_fa": "خیلی خوش‌برخورد است."
          },
          {
            "order": 3,
            "speaker": "Anna",
            "text": "Ist sie ruhig?",
            "translation_fa": "آرامه؟"
          },
          {
            "order": 4,
            "speaker": "Lukas",
            "text": "Ja, meistens.",
            "translation_fa": "بله، بیشتر وقت‌ها."
          }
