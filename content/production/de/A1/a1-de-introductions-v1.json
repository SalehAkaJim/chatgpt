    {"kind":"dialogue","external_id":"d_de_origin_meeting","data":{"lesson_key":"a1-de-introductions-02","language_variant":"de-DE","title":"Woher kommst du?","setting":"language_meetup","cefr":"A1","topic":"introductions","characters":["Sofia","Noah"],"turns":[{"order":1,"speaker":"Sofia","text":"Hallo! Woher kommst du?","translation_fa":"سلام! اهل کجایی؟"},{"order":2,"speaker":"Noah","text":"Ich komme aus Deutschland. Und du?","translation_fa":"من اهل آلمان هستم. تو چطور؟"},{"order":3,"speaker":"Sofia","text":"Ich komme aus dem Iran.","translation_fa":"من اهل ایران هستم."},{"order":4,"speaker":"Noah","text":"Ah, schön. Freut mich!","translation_fa":"آها، عالیه. از آشنایی خوشحالم!"}],"status":"validated","qa":{"character_pair_unique_within_unit":true,"naturalness":"passed","single_situation":true}}},

