            "de": "Deutschland",
            "fa": "آلمان"
          },
          {
            "de": "Ich spreche Persisch und Deutsch.",
            "fa": "من فارسی و آلمانی صحبت می‌کنم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
