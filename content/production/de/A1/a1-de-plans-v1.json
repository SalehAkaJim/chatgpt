    {
      "kind": "dialogue",
      "external_id": "d_plans_03",
      "data": {
        "lesson_key": "a1-de-plans-03",
        "title": "Termin ändern",
        "setting": "termin_andern",
        "cefr": "A1",
        "topic": "future-plans",
        "characters": [
          "Lea",
          "Noah"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Lea",
            "text": "Unser Termin ist um drei, oder?",
            "translation_fa": "قرارمان ساعت سه است، درسته؟"
          },
          {
            "order": 2,
            "speaker": "Noah",
            "text": "Ja. Können wir vier Uhr machen?",
            "translation_fa": "بله. می‌تونیم ساعت چهار کنیم؟"
          },
          {
            "order": 3,
            "speaker": "Lea",
            "text": "Kein Problem.",
            "translation_fa": "مشکلی نیست."
          },
          {
            "order": 4,
            "speaker": "Noah",
            "text": "Super, bis dann.",
            "translation_fa": "عالی، پس تا آن موقع."
          }
        ],
