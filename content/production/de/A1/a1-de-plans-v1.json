      "kind": "grammar_point",
      "external_id": "g_plans_core",
      "data": {
        "lesson_key": "a1-de-plans-01",
        "slug": "a1-de-plans-grammar",
        "title": "Termine & Pläne",
        "rule_summary": "German often uses the present tense with a future time expression: Morgen treffe ich Anna; use am for days and um for times.",
        "explanation": {
          "fa": "برای برنامهٔ نزدیک لازم نیست حتماً زمان آینده بسازی؛ حال ساده همراه زمان آینده طبیعی است: «Morgen arbeite ich»."
        },
        "examples": [
          {
            "de": "morgen",
            "fa": "فردا"
          },
          {
            "de": "Das passt mir gut.",
            "fa": "این زمان برای من خوبه."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
