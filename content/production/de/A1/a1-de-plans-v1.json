      "data": {
        "lesson_key": "a1-de-plans-02",
        "title": "Montag",
        "setting": "montag",
        "cefr": "A1",
        "topic": "future-plans",
        "characters": [
          "Mia",
          "Emil"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mia",
