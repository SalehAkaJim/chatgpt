      "data": {
        "lesson_key": "a1-de-articles-01",
        "slug": "a1-de-articles-grammar",
        "title": "der, die oder das?",
        "rule_summary": "German nouns have grammatical gender: der (masculine), die (feminine), das (neuter); indefinite articles are ein/eine.",
        "explanation": {
          "fa": "جنس دستوری را از خود اسم جدا نکن؛ به جای «Tisch» بهتر است «der Tisch» را واحد یادگیری بدانی."
        },
        "examples": [
          {
            "de": "der Tisch",
            "fa": "میز"
          },
          {
            "de": "ein Fenster",
            "fa": "یک پنجره"
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
