          },
          {
            "order": 2,
            "speaker": "Noah",
            "text": "Mit dem Bus.",
            "translation_fa": "با اتوبوس."
          },
          {
            "order": 3,
            "speaker": "Mia",
            "text": "Jeden Tag?",
            "translation_fa": "هر روز؟"
          },
          {
            "order": 4,
            "speaker": "Noah",
            "text": "Ja, fast jeden Tag.",
            "translation_fa": "بله، تقریباً هر روز."
