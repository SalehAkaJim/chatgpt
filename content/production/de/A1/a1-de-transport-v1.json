            "speaker": "Max",
            "text": "Ja. Der Bus ist zu spät.",
            "translation_fa": "بله. اتوبوس خیلی دیر کرده."
          },
          {
            "order": 3,
            "speaker": "Lea",
            "text": "Wann kommt die Bahn?",
