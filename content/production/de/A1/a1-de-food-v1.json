        "turns": [
          {
            "order": 1,
            "speaker": "Sofia",
            "text": "Was isst du zum Frühstück?",
            "translation_fa": "برای صبحانه چی می‌خوری؟"
          },
          {
            "order": 2,
            "speaker": "Leon",
            "text": "Brot und Käse.",
            "translation_fa": "نان و پنیر."
          },
          {
            "order": 3,
            "speaker": "Sofia",
            "text": "Und was trinkst du?",
            "translation_fa": "و چی می‌نوشی؟"
          },
          {
            "order": 4,
            "speaker": "Leon",
            "text": "Kaffee.",
            "translation_fa": "قهوه."
