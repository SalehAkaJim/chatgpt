        "cefr": "A1",
        "topic": "food-basics",
        "characters": [
          "Nina",
          "Lukas"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Nina",
            "text": "Möchtest du Kaffee?",
            "translation_fa": "قهوه می‌خوای؟"
          },
          {
            "order": 2,
            "speaker": "Lukas",
            "text": "Nein, danke. Wasser, bitte.",
            "translation_fa": "نه ممنون. آب لطفاً."
          },
          {
            "order": 3,
            "speaker": "Nina",
            "text": "Mit Eis?",
            "translation_fa": "با یخ؟"
          },
          {
            "order": 4,
            "speaker": "Lukas",
            "text": "Nein, ohne Eis.",
            "translation_fa": "نه، بدون یخ."
          }
        ],
        "status": "validated",
