      "data": {
        "lesson_key": "b2-it-passive-and-impersonal-01",
        "slug": "b2-it-passive-and-impersonal-grammar",
        "title": "Passivo, si passivante e si impersonale",
        "rule_summary": "Choose the passive when the affected entity matters, and si constructions when the agent is generic, institutional or deliberately backgrounded.",
        "explanation": {
          "fa": "وقتی خود نتیجه یا چیزی که روی آن عمل انجام شده مهم است، مجهول طبیعی است. وقتی انجام‌دهنده عمومی یا نهادی است، ساخت‌های si passivante و si impersonale بسیار رایج‌اند."
        },
        "examples": [
          {
            "it": "La proposta è stata approvata.",
            "fa": "پیشنهاد تصویب شد."
          },
          {
            "it": "In questo ufficio si lavora su appuntamento.",
            "fa": "در این اداره با وقت قبلی کار می‌کنند."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
