          {
            "order": 2,
            "speaker": "davide",
            "text": "Aveva detto che sarebbe arrivato in serata.",
            "translation_fa": "گفته بود عصر می‌رسد."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Poi ha cambiato programma?",
            "translation_fa": "بعد برنامه‌اش را عوض کرد؟"
