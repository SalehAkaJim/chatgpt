    {
      "kind": "grammar_point",
      "external_id": "g_counterfactual_choices_core",
      "data": {
        "lesson_key": "b2-it-counterfactual-choices-01",
        "slug": "b2-it-counterfactual-choices-grammar",
        "title": "Periodo ipotetico della possibilità: se + congiuntivo imperfetto, condizionale presente",
        "rule_summary": "Use this pattern for hypothetical but conceivable situations and their projected consequences.",
        "explanation": {
          "fa": "برای موقعیت‌های فرضی اما قابل تصور، در بخش se از congiuntivo imperfetto و در نتیجه از condizionale presente استفاده می‌کنیم."
        },
        "examples": [
          {
            "it": "Se potessi, partirei domani.",
            "fa": "اگر می‌توانستم، فردا می‌رفتم."
          },
          {
            "it": "Se avessimo più dati, decideremmo meglio.",
            "fa": "اگر داده بیشتری داشتیم، بهتر تصمیم می‌گرفتیم."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_counterfactual_choices_01",
      "data": {
        "lesson_key": "b2-it-counterfactual-choices-01",
        "title": "Cambiare lavoro?",
        "setting": "item",
        "cefr": "B2",
        "topic": "future-plans",
        "characters": [
          "chiara",
          "matteo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "chiara",
            "text": "Se ricevessi un'offerta all'estero, la accetteresti?",
            "translation_fa": "اگر پیشنهاد کاری خارج از کشور می‌گرفتی، قبولش می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "matteo",
            "text": "Dipenderebbe dal progetto e dalla durata.",
            "translation_fa": "به پروژه و مدت آن بستگی داشت."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "A cosa non rinunceresti?",
            "translation_fa": "از چه چیزی صرف‌نظر نمی‌کردی؟"
          },
          {
            "order": 4,
            "speaker": "matteo",
            "text": "Alla possibilità di tornare senza perdere il mio ruolo qui.",
            "translation_fa": "به امکان برگشتن بدون از دست دادن نقشم اینجا."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_counterfactual_choices_02",
      "data": {
        "lesson_key": "b2-it-counterfactual-choices-02",
        "title": "Un investimento prudente",
        "setting": "item",
        "cefr": "B2",
        "topic": "future-plans",
        "characters": [
          "elena",
          "davide"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "elena",
            "text": "Investiresti tutto il budget nella prima fase?",
            "translation_fa": "کل بودجه را در مرحله اول سرمایه‌گذاری می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "No. Se qualcosa andasse storto, avremmo poche alternative.",
            "translation_fa": "نه. اگر چیزی بد پیش می‌رفت، گزینه‌های کمی داشتیم."
          },
          {
            "order": 3,
            "speaker": "elena",
            "text": "Quindi divideresti il rischio.",
            "translation_fa": "پس ریسک را تقسیم می‌کردی."
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Esatto, soprattutto finché i risultati non sono chiari.",
            "translation_fa": "دقیقاً، مخصوصاً تا وقتی نتایج روشن نیستند."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
