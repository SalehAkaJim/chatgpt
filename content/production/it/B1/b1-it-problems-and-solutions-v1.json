    {
      "kind": "grammar_point",
      "external_id": "g_problems_and_solutions_core",
      "data": {
        "lesson_key": "b1-it-problems-and-solutions-01",
        "slug": "b1-it-problems-and-solutions-grammar",
        "title": "Bisogna / conviene + infinito e soluzioni impersonali",
        "rule_summary": "Use bisogna and conviene when the recommendation applies generally and the agent is not important. These forms are common in practical problem-solving.",
        "explanation": {
          "fa": "برای توصیه‌ای که فاعل مشخصی ندارد یا به‌طور کلی صدق می‌کند، bisogna و conviene طبیعی‌اند: bisogna controllare، conviene chiamare. این ساخت‌ها در حل مسئله بسیار رایج‌اند."
        },
        "examples": [
          {
            "it": "Bisogna controllare il numero.",
            "fa": "باید شماره را بررسی کرد."
          },
          {
            "it": "Conviene chiamare prima.",
            "fa": "بهتر است اول تماس گرفت."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_problems_and_solutions_01",
      "data": {
        "lesson_key": "b1-it-problems-and-solutions-01",
        "title": "Il computer non parte",
        "setting": "item",
        "cefr": "B1",
        "topic": "requests",
        "characters": [
          "giulia",
          "matteo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "giulia",
            "text": "Il computer non si accende più.",
            "translation_fa": "کامپیوتر دیگر روشن نمی‌شود."
          },
          {
            "order": 2,
            "speaker": "matteo",
            "text": "Hai già provato a riavviarlo?",
            "translation_fa": "قبلاً سعی کردی دوباره راه‌اندازیش کنی؟"
          },
          {
            "order": 3,
            "speaker": "giulia",
            "text": "Sì, ma non funziona.",
            "translation_fa": "بله، ولی جواب نمی‌دهد."
          },
          {
            "order": 4,
            "speaker": "matteo",
            "text": "Allora conviene chiamare l'assistenza.",
            "translation_fa": "پس بهتر است با پشتیبانی تماس بگیریم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_problems_and_solutions_02",
      "data": {
        "lesson_key": "b1-it-problems-and-solutions-02",
        "title": "Una segnalazione",
        "setting": "item",
        "cefr": "B1",
        "topic": "requests",
        "characters": [
          "sofia",
          "davide"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "sofia",
            "text": "L'app continua a chiudersi da sola.",
            "translation_fa": "برنامه مدام خودش بسته می‌شود."
          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "Bisogna segnalare il problema con uno screenshot.",
            "translation_fa": "باید مشکل را با یک اسکرین‌شات گزارش کنیم."
          },
          {
            "order": 3,
            "speaker": "sofia",
            "text": "Pensi che basti?",
            "translation_fa": "فکر می‌کنی کافی باشد؟"
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Se non basta, apriamo una richiesta all'assistenza.",
            "translation_fa": "اگر کافی نبود، یک درخواست پشتیبانی باز می‌کنیم."
          }
        ],
