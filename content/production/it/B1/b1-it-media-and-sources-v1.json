    {
      "kind": "grammar_point",
      "external_id": "g_media_and_sources_core",
      "data": {
        "lesson_key": "b1-it-media-and-sources-01",
        "slug": "b1-it-media-and-sources-grammar",
        "title": "Pronomi relativi: che e cui nelle frasi utili",
        "rule_summary": "Use che as a subject or direct-object relative pronoun. After a preposition, use cui: la fonte di cui parlo, la persona con cui lavoro.",
        "explanation": {
          "fa": "در جمله موصولی، che معمولاً نقش فاعل یا مفعول مستقیم دارد. بعد از حرف اضافه از cui استفاده می‌کنیم: di cui، con cui، per cui. این ساخت‌ها در توضیح منابع و آدم‌ها بسیار کاربردی‌اند."
        },
        "examples": [
          {
            "it": "La fonte che ho letto è seria.",
            "fa": "منبعی که خواندم جدی است."
          },
          {
            "it": "È il sito di cui ti parlavo.",
            "fa": "این همان سایتی است که درباره‌اش با تو حرف می‌زدم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
