        "characters": [
          "giulia",
          "davide"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "giulia",
            "text": "Scusa, potresti controllare questo documento?",
            "translation_fa": "ببخشید، ممکن است این سند را بررسی کنی؟"
          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "Certo. Ti serve subito?",
            "translation_fa": "حتماً. همین الان لازم داری؟"
          },
          {
            "order": 3,
            "speaker": "giulia",
            "text": "Se possibile, entro oggi sarebbe perfetto.",
            "translation_fa": "اگر ممکن است، تا امروز عالی می‌شود."
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Va bene, lo guardo dopo pranzo.",
            "translation_fa": "باشه، بعد از ناهار نگاهش می‌کنم."
          }
        ],
        "qa": {
