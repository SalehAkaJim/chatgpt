    {
      "kind": "dialogue",
      "external_id": "d_reported_information_02",
      "data": {
        "lesson_key": "b1-it-reported-information-02",
        "title": "Una notizia da verificare",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "elena",
          "marco"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "elena",
            "text": "È vero che domani la linea chiude?",
            "translation_fa": "درست است که فردا خط بسته می‌شود؟"
          },
          {
            "order": 2,
            "speaker": "marco",
            "text": "Non ne sono sicuro. Un collega mi ha riferito la notizia.",
            "translation_fa": "مطمئن نیستم. یکی از همکارها خبر را به من منتقل کرد."
          },
          {
            "order": 3,
            "speaker": "elena",
            "text": "Meglio aspettare una conferma ufficiale.",
            "translation_fa": "بهتر است منتظر تأیید رسمی بمانیم."
          },
          {
            "order": 4,
            "speaker": "marco",
            "text": "Sì, ti avviso appena so qualcosa.",
            "translation_fa": "بله، به‌محض اینکه چیزی فهمیدم خبرت می‌کنم."
          }
        ],
