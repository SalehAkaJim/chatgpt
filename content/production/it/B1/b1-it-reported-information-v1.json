    {
      "kind": "grammar_point",
      "external_id": "g_reported_information_core",
      "data": {
        "lesson_key": "b1-it-reported-information-01",
        "slug": "b1-it-reported-information-grammar",
        "title": "Discorso indiretto con dire, spiegare e confermare",
        "rule_summary": "Use che after reporting verbs to relay the content of a message. In past reporting, tense choice reflects whether the reported situation was simultaneous, earlier or still valid.",
        "explanation": {
          "fa": "برای نقل محتوای یک پیام معمولاً بعد از dire، spiegare یا confermare از che استفاده می‌شود. وقتی فعل گزارش در گذشته است، زمان جمله وابسته را بر اساس رابطه زمانی و ادامه‌دار بودن اطلاعات انتخاب می‌کنیم."
        },
        "examples": [
          {
            "it": "Ha detto che arrivava tardi.",
            "fa": "گفت که دیر می‌رسید."
          },
          {
            "it": "Mi ha spiegato che aveva perso il biglietto.",
            "fa": "برایم توضیح داد که بلیت را گم کرده بود."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
