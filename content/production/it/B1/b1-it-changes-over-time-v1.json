    {
      "kind": "dialogue",
      "external_id": "d_changes_over_time_02",
      "data": {
        "lesson_key": "b1-it-changes-over-time-02",
        "title": "Prima e adesso",
        "setting": "item",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "elena",
          "davide"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "elena",
            "text": "Vai ancora in palestra la sera?",
            "translation_fa": "هنوز عصرها باشگاه می‌روی؟"
          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "Molto meno. Da quando corro al mattino, preferisco allenarmi presto.",
            "translation_fa": "خیلی کمتر. از وقتی صبح‌ها می‌دوم، ترجیح می‌دهم زود ورزش کنم."
          },
          {
            "order": 3,
            "speaker": "elena",
            "text": "Ti sei già abituato?",
            "translation_fa": "دیگر عادت کرده‌ای؟"
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Sì, ormai mi viene naturale.",
            "translation_fa": "بله، دیگر برایم طبیعی شده."
          }
        ],
