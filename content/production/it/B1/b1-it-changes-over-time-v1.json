    {
      "kind": "grammar_point",
      "external_id": "g_changes_over_time_core",
      "data": {
        "lesson_key": "b1-it-changes-over-time-01",
        "slug": "b1-it-changes-over-time-grammar",
        "title": "Da quando + presente / passato e contrasto prima-adesso",
        "rule_summary": "Use da quando to mark the starting point of a change that still matters now. Italian often keeps the present for situations continuing from that point.",
        "explanation": {
          "fa": "برای تغییری که از گذشته شروع شده و هنوز به زمان حال مربوط است، da quando بسیار طبیعی است. برای وضعیت ادامه‌دار، ایتالیایی اغلب از زمان حال استفاده می‌کند."
        },
        "examples": [
          {
            "it": "Da quando vivo qui, cammino di più.",
            "fa": "از وقتی اینجا زندگی می‌کنم، بیشتر پیاده‌روی می‌کنم."
          },
          {
            "it": "Prima guidavo, adesso vado in bici.",
            "fa": "قبلاً رانندگی می‌کردم، حالا با دوچرخه می‌روم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_changes_over_time_01",
      "data": {
        "lesson_key": "b1-it-changes-over-time-01",
        "title": "Nuove abitudini",
        "setting": "item",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "chiara",
          "matteo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "chiara",
            "text": "Ti trovi bene a lavorare da casa?",
            "translation_fa": "از کار کردن در خانه راضی هستی؟"
          },
          {
            "order": 2,
            "speaker": "matteo",
            "text": "Sì, anche se all'inizio è stato difficile organizzarmi.",
            "translation_fa": "بله، هرچند اوایل سازماندهی خودم سخت بود."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Che cosa è cambiato di più?",
            "translation_fa": "بیشتر از همه چه چیزی تغییر کرده؟"
          },
          {
            "order": 4,
            "speaker": "matteo",
            "text": "Ormai gestisco gli orari con molta più calma.",
            "translation_fa": "الان دیگر زمان‌بندی را خیلی آرام‌تر مدیریت می‌کنم."
          }
        ],
        "qa": {
