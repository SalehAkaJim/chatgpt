    {
      "kind": "grammar_point",
      "external_id": "g_stories_and_background_core",
      "data": {
        "lesson_key": "b1-it-stories-and-background-01",
        "slug": "b1-it-stories-and-background-grammar",
        "title": "Imperfetto e passato prossimo nella narrazione",
        "rule_summary": "Use the imperfetto for background, ongoing states and repeated circumstances; use the passato prossimo for bounded events that move the story forward.",
        "explanation": {
          "fa": "در روایت، imperfetto معمولاً پس‌زمینه، وضعیت یا کارِ در جریان را می‌سازد؛ passato prossimo رویداد مشخص و تمام‌شده‌ای را بیان می‌کند که داستان را جلو می‌برد."
        },
        "examples": [
          {
            "it": "Mentre aspettavo, è arrivato Luca.",
            "fa": "وقتی منتظر بودم، لوکا رسید."
          },
          {
            "it": "Pioveva quando siamo usciti.",
            "fa": "وقتی بیرون رفتیم باران می‌بارید."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_stories_and_background_01",
      "data": {
        "lesson_key": "b1-it-stories-and-background-01",
        "title": "Una serata complicata",
        "setting": "item",
        "cefr": "B1",
        "topic": "common-actions",
        "characters": [
          "giulia",
          "marco"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "giulia",
            "text": "Com'è andata ieri sera?",
            "translation_fa": "دیشب چطور گذشت؟"
          },
          {
            "order": 2,
            "speaker": "marco",
            "text": "Mentre tornavo a casa, mi sono accorto che non avevo il portafoglio.",
            "translation_fa": "وقتی داشتم برمی‌گشتم خانه، فهمیدم کیف پولم همراهم نیست."
          },
          {
            "order": 3,
            "speaker": "giulia",
            "text": "E poi che cosa hai fatto?",
            "translation_fa": "بعد چه کار کردی؟"
          },
          {
            "order": 4,
            "speaker": "marco",
            "text": "Sono tornato al bar e per fortuna era ancora lì.",
            "translation_fa": "به کافه برگشتم و خوشبختانه هنوز آنجا بود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_stories_and_background_02",
      "data": {
        "lesson_key": "b1-it-stories-and-background-02",
        "title": "Sotto la pioggia",
        "setting": "item",
        "cefr": "B1",
        "topic": "common-actions",
        "characters": [
          "sofia",
          "luca"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "sofia",
            "text": "Perché sei arrivato così tardi?",
            "translation_fa": "چرا این‌قدر دیر رسیدی؟"
          },
          {
            "order": 2,
            "speaker": "luca",
            "text": "Ha cominciato a piovere e ho incontrato Paolo alla fermata.",
            "translation_fa": "باران شروع شد و در ایستگاه به پائولو برخوردم."
          },
          {
            "order": 3,
            "speaker": "sofia",
            "text": "Non lo vedevi da tanto?",
            "translation_fa": "مدت زیادی بود ندیده بودیش؟"
          },
          {
            "order": 4,
            "speaker": "luca",
            "text": "Da quasi cinque anni.",
            "translation_fa": "نزدیک پنج سال بود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
