        "characters": [
          "giulia",
          "davide"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "giulia",
            "text": "Riesci a passare in banca oggi?",
            "translation_fa": "می‌توانی امروز به بانک سر بزنی؟"
          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "Se finisco la riunione in tempo, sì.",
            "translation_fa": "اگر جلسه را به‌موقع تمام کنم، بله."
          },
          {
            "order": 3,
            "speaker": "giulia",
            "text": "Altrimenti ci vado io domani.",
            "translation_fa": "وگرنه خودم فردا می‌روم."
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Ti avviso appena finisco.",
            "translation_fa": "به‌محض اینکه تمام کنم خبرت می‌کنم."
          }
        ],
        "qa": {
