    {
      "kind": "dialogue",
      "external_id": "d_real_conditions_02",
      "data": {
        "lesson_key": "b1-it-real-conditions-02",
        "title": "Un piano B",
        "setting": "item",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "sofia",
          "matteo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "sofia",
            "text": "Che facciamo se piove sabato?",
            "translation_fa": "اگر شنبه باران بیاید چه کار کنیم؟"
          },
          {
            "order": 2,
            "speaker": "matteo",
            "text": "Possiamo rimandare la gita e andare al museo.",
            "translation_fa": "می‌توانیم گردش را عقب بیندازیم و به موزه برویم."
          },
          {
            "order": 3,
            "speaker": "sofia",
            "text": "Se i biglietti sono disponibili, per me va bene.",
            "translation_fa": "اگر بلیت‌ها موجود باشند، برای من خوب است."
          },
          {
            "order": 4,
            "speaker": "matteo",
            "text": "Controllo stasera.",
            "translation_fa": "امشب بررسی می‌کنم."
          }
        ],
        "qa": {
