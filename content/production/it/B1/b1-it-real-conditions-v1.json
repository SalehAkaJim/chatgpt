    {
      "kind": "grammar_point",
      "external_id": "g_real_conditions_core",
      "data": {
        "lesson_key": "b1-it-real-conditions-01",
        "slug": "b1-it-real-conditions-grammar",
        "title": "Periodo ipotetico della realtà",
        "rule_summary": "For realistic present or future conditions, Italian commonly uses se + present, with present or future meaning in the main clause. Dopo appena, the present often refers naturally to a future event.",
        "explanation": {
          "fa": "برای شرط واقعی و محتمل، se + زمان حال بسیار رایج است؛ جمله اصلی هم می‌تواند معنای حال یا آینده داشته باشد. بعد از appena نیز برای رویداد آینده اغلب زمان حال می‌آید."
        },
        "examples": [
          {
            "it": "Se ho tempo, passo da te.",
            "fa": "اگر وقت داشته باشم، بهت سر می‌زنم."
          },
          {
            "it": "Appena arrivo, ti scrivo.",
            "fa": "به‌محض اینکه برسم، برایت می‌نویسم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
