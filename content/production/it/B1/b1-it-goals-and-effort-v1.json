    {
      "kind": "grammar_point",
      "external_id": "g_goals_and_effort_core",
      "data": {
        "lesson_key": "b1-it-goals-and-effort-01",
        "slug": "b1-it-goals-and-effort-grammar",
        "title": "Cercare di, riuscire a, continuare a + infinito",
        "rule_summary": "Italian selects different prepositions after common effort and progress verbs: cercare di fare, riuscire a fare, continuare a fare.",
        "explanation": {
          "fa": "بعد از بعضی فعل‌های پرکاربردِ تلاش و پیشرفت، حرف اضافه ثابت است: cercare di + مصدر، riuscire a + مصدر و continuare a + مصدر. بهتر است این ترکیب‌ها به‌صورت الگو یاد گرفته شوند."
        },
        "examples": [
          {
            "it": "Cerco di parlare di più.",
            "fa": "سعی می‌کنم بیشتر حرف بزنم."
          },
          {
            "it": "Riesco a capire quasi tutto.",
            "fa": "می‌توانم تقریباً همه‌چیز را بفهمم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
