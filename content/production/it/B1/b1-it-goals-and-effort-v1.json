        "turns": [
          {
            "order": 1,
            "speaker": "chiara",
            "text": "Qual è il tuo obiettivo per questo mese?",
            "translation_fa": "هدفت برای این ماه چیست؟"
          },
          {
            "order": 2,
            "speaker": "marco",
            "text": "Sto cercando di parlare italiano ogni giorno.",
            "translation_fa": "دارم سعی می‌کنم هر روز ایتالیایی حرف بزنم."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Riesci a essere costante?",
