        "characters": [
          "elena",
          "luca"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "elena",
            "text": "Ti sembra di migliorare?",
            "translation_fa": "فکر می‌کنی داری بهتر می‌شوی؟"
          },
          {
            "order": 2,
            "speaker": "luca",
            "text": "Sì, soprattutto quando continuo a esercitarmi con calma.",
            "translation_fa": "بله، مخصوصاً وقتی با آرامش به تمرین ادامه می‌دهم."
