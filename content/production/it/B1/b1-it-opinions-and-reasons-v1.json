    {
      "kind": "grammar_point",
      "external_id": "g_opinions_and_reasons_core",
      "data": {
        "lesson_key": "b1-it-opinions-and-reasons-01",
        "slug": "b1-it-opinions-and-reasons-grammar",
        "title": "Esprimere e qualificare un'opinione",
        "rule_summary": "At B1, connect an opinion to a reason or limitation with structures such as secondo me, il vantaggio è che, dipende da and comunque.",
        "explanation": {
          "fa": "در B1 فقط گفتن «به نظرم» کافی نیست؛ نظر را با دلیل، مزیت/عیب یا محدودیت کامل می‌کنیم. عبارت‌هایی مثل dipende da و comunque کمک می‌کنند نظر مطلق و خشک نباشد."
        },
        "examples": [
          {
            "it": "Secondo me è utile perché fa risparmiare tempo.",
            "fa": "به نظرم مفید است چون باعث صرفه‌جویی در زمان می‌شود."
          },
          {
            "it": "Dipende da quanto lo usi.",
            "fa": "بستگی دارد چقدر از آن استفاده کنی."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_opinions_and_reasons_01",
      "data": {
        "lesson_key": "b1-it-opinions-and-reasons-01",
        "title": "Lavorare in presenza",
        "setting": "item",
        "cefr": "B1",
        "topic": "likes-dislikes",
        "characters": [
          "giulia",
          "matteo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "giulia",
            "text": "Preferisci lavorare da casa o in ufficio?",
            "translation_fa": "ترجیح می‌دهی خانه کار کنی یا اداره؟"
          },
          {
            "order": 2,
            "speaker": "matteo",
            "text": "In ufficio. Il vantaggio è che parli subito con i colleghi.",
            "translation_fa": "اداره. مزیتش این است که فوراً با همکارها حرف می‌زنی."
          },
          {
            "order": 3,
            "speaker": "giulia",
            "text": "Io invece risparmio molto tempo a casa.",
            "translation_fa": "من برعکس، در خانه کلی وقت ذخیره می‌کنم."
          },
          {
            "order": 4,
            "speaker": "matteo",
            "text": "È vero, dipende anche dal tipo di lavoro.",
            "translation_fa": "درست است، به نوع کار هم بستگی دارد."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
