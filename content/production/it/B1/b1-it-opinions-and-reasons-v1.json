    {
      "kind": "dialogue",
      "external_id": "d_opinions_and_reasons_02",
      "data": {
        "lesson_key": "b1-it-opinions-and-reasons-02",
        "title": "Una scelta difficile",
        "setting": "item",
        "cefr": "B1",
        "topic": "likes-dislikes",
        "characters": [
          "sofia",
          "davide"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "sofia",
            "text": "Io toglierei tutte le auto dal centro.",
            "translation_fa": "من همه خودروها را از مرکز شهر حذف می‌کردم."
          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "Capisco l'idea, ma non mi convince del tutto.",
            "translation_fa": "ایده را می‌فهمم، ولی کاملاً قانعم نمی‌کند."
          },
          {
            "order": 3,
            "speaker": "sofia",
            "text": "Per quale motivo?",
            "translation_fa": "به چه دلیل؟"
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Perché alcune persone non hanno alternative pratiche.",
            "translation_fa": "چون بعضی آدم‌ها جایگزین عملی ندارند."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
