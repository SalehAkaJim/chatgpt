      "data": {
        "lesson_key": "prea1-it-alphabet-01",
        "slug": "prea1-it-alphabet-grammar",
        "title": "Lettere e suoni",
        "rule_summary": "Italian spelling is relatively regular. The letters c and g change before e/i, while h is often used to keep a hard sound in combinations such as che and ghi.",
        "explanation": {
          "fa": "املای ایتالیایی نسبتاً منظم است. مهم‌ترین نکتهٔ اولیه این است که c و g قبل از e و i عوض می‌شوند و h می‌تواند صدای سخت را حفظ کند."
        },
        "examples": [
          {
            "it": "casa",
            "fa": "خانه"
          },
          {
            "it": "cinema",
            "fa": "سینما"
          }
        ],
        "cefr": "Pre-A1",
