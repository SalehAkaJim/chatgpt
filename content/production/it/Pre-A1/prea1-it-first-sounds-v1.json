    {
      "kind": "grammar_point",
      "external_id": "g_first_sounds_core",
      "data": {
        "lesson_key": "prea1-it-first-sounds-01",
        "slug": "prea1-it-first-sounds-grammar",
        "title": "C, G e H",
        "rule_summary": "Before a, o, u, c/g are usually hard; before e, i they are usually soft. Adding h in che/chi and ghe/ghi keeps the hard sound.",
        "explanation": {
          "fa": "برای شروع: c و g قبل از a/o/u معمولاً سخت‌اند و قبل از e/i نرم می‌شوند. در che/chi و ghe/ghi حرف h کمک می‌کند صدای سخت بماند."
        },
        "examples": [
          {
            "it": "casa / ciao",
            "fa": "کازا / چائو"
          },
          {
            "it": "gatto / gelato",
            "fa": "گاتّو / جلاتو"
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
