    {
      "kind": "grammar_point",
      "external_id": "g_my_name_core",
      "data": {
        "lesson_key": "prea1-it-my-name-01",
        "slug": "prea1-it-my-name-grammar",
        "title": "Mi chiamo… / Sono…",
        "rule_summary": "Italian commonly uses Mi chiamo… or Sono… for a simple introduction; the subject pronoun io is normally unnecessary.",
        "explanation": {
          "fa": "در ایتالیایی معمولاً لازم نیست «io» را بگویی؛ خود شکل فعل شخص را نشان می‌دهد. برای شروع «Mi chiamo…» و «Sono…» را الگوهای آماده یاد بگیر."
        },
        "examples": [
          {
            "it": "Mi chiamo Sofia.",
            "fa": "اسمم سوفیاست."
          },
          {
            "it": "Sono Matteo.",
            "fa": "من ماتئو هستم."
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
