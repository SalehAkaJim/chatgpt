      "data": {
        "lesson_key": "prea1-it-first-greetings-01",
        "slug": "prea1-it-first-greetings-grammar",
        "title": "Ciao / buongiorno",
        "rule_summary": "Italian greetings depend on familiarity and time of day. Ciao is informal; buongiorno is a safe neutral greeting during the day.",
        "explanation": {
          "fa": "«Ciao» برای موقعیت خودمانی است. برای شروعِ امن‌تر با فرد ناآشنا در روز، «Buongiorno» طبیعی‌تر است."
        },
        "examples": [
          {
            "it": "Ciao, Marco!",
            "fa": "سلام مارکو!"
          },
          {
            "it": "Buongiorno, signora.",
            "fa": "روز بخیر خانم."
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
