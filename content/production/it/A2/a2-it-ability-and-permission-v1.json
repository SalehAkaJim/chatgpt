    {
      "kind": "grammar_point",
      "external_id": "g_ability_and_permission_core",
      "data": {
        "lesson_key": "a2-it-ability-and-permission-01",
        "slug": "a2-it-ability-and-permission-grammar",
        "title": "Potere e dovere + infinito",
        "rule_summary": "Potere expresses ability or permission; dovere expresses necessity or obligation.",
        "explanation": {
          "fa": "potere برای توانایی یا اجازه و dovere برای الزام استفاده می‌شود. بعد از هر دو، مصدر بدون حرف اضافه می‌آید: posso entrare، devo aspettare."
        },
        "examples": [
          {
            "it": "Posso entrare?",
            "fa": "می‌توانم داخل بیایم؟"
          },
          {
            "it": "Devo aspettare.",
            "fa": "باید منتظر بمانم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
