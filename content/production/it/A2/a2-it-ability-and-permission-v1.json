          "matteo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "giulia",
            "text": "Buongiorno, posso entrare adesso?",
            "translation_fa": "سلام، می‌توانم الان داخل بروم؟"
          },
          {
            "order": 2,
            "speaker": "matteo",
            "text": "Un momento, deve aspettare qui.",
            "translation_fa": "یک لحظه، باید اینجا منتظر بمانید."
          },
          {
            "order": 3,
            "speaker": "giulia",
            "text": "Va bene. Quanto tempo?",
            "translation_fa": "باشه. چقدر؟"
          },
          {
            "order": 4,
            "speaker": "matteo",
            "text": "Solo cinque minuti.",
            "translation_fa": "فقط پنج دقیقه."
