      "data": {
        "lesson_key": "a2-it-health-and-advice-01",
        "slug": "a2-it-health-and-advice-grammar",
        "title": "Consiglio con dovresti",
        "rule_summary": "Dovresti + infinitive is a common polite way to give personal advice.",
        "explanation": {
          "fa": "برای پیشنهاد دوستانه و نه دستور مستقیم، dovresti + مصدر بسیار رایج است؛ مثل dovresti riposare یعنی «بهتر است استراحت کنی»."
        },
        "examples": [
          {
            "it": "Dovresti riposare.",
            "fa": "بهتر است استراحت کنی."
          },
          {
            "it": "Dovresti bere acqua.",
            "fa": "بهتر است آب بنوشی."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
