    {
      "kind": "dialogue",
      "external_id": "d_health_and_advice_01",
      "data": {
        "lesson_key": "a2-it-health-and-advice-01",
        "title": "Non sto bene",
        "setting": "item",
        "cefr": "A2",
        "topic": "basic-health",
        "characters": [
          "chiara",
          "marco"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "chiara",
            "text": "Come ti senti?",
            "translation_fa": "چه حالی داری؟"
          },
          {
            "order": 2,
            "speaker": "marco",
            "text": "Mi fa male la gola e ho un po' di febbre.",
            "translation_fa": "گلویم درد می‌کند و کمی تب دارم."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Dovresti riposare oggi.",
            "translation_fa": "بهتر است امروز استراحت کنی."
          },
          {
            "order": 4,
            "speaker": "marco",
            "text": "Sì, resto a casa.",
            "translation_fa": "بله، خانه می‌مانم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_health_and_advice_02",
      "data": {
        "lesson_key": "a2-it-health-and-advice-02",
        "title": "Dal farmacista",
        "setting": "item",
        "cefr": "A2",
        "topic": "basic-health",
        "characters": [
          "elena",
          "luca"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "elena",
            "text": "Buongiorno, ha qualcosa per il mal di gola?",
            "translation_fa": "سلام، چیزی برای گلودرد دارید؟"
          },
          {
            "order": 2,
            "speaker": "luca",
            "text": "Sì. Ha anche la febbre?",
            "translation_fa": "بله. تب هم دارید؟"
          },
          {
            "order": 3,
            "speaker": "elena",
            "text": "No, e oggi mi sento già meglio.",
            "translation_fa": "نه، و امروز حالم بهتر است."
          },
          {
            "order": 4,
            "speaker": "luca",
            "text": "Bene, allora provi questo.",
            "translation_fa": "خوب است، پس این را امتحان کنید."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
