    {
      "kind": "grammar_point",
      "external_id": "g_past_experiences_core",
      "data": {
        "lesson_key": "a2-it-past-experiences-01",
        "slug": "a2-it-past-experiences-grammar",
        "title": "Passato prossimo: avere o essere + participio",
        "rule_summary": "Use the passato prossimo for completed past events. Movement verbs such as partire and tornare commonly use essere.",
        "explanation": {
          "fa": "برای رویداد تمام‌شده در گذشته از passato prossimo استفاده می‌کنیم. بسیاری از فعل‌های حرکتی مثل partire و tornare با essere می‌آیند و اسم مفعول با فاعل هماهنگ می‌شود."
        },
        "examples": [
          {
            "it": "Ho visitato Firenze.",
            "fa": "از فلورانس دیدن کردم."
          },
          {
            "it": "Siamo partiti alle otto.",
            "fa": "ساعت هشت راه افتادیم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
