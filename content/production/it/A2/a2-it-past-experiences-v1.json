          },
          {
            "order": 3,
            "speaker": "giulia",
            "text": "Hai visto gli Uffizi?",
            "translation_fa": "اوفیتزی را دیدی؟"
          },
          {
            "order": 4,
            "speaker": "marco",
            "text": "Sì, finalmente!",
            "translation_fa": "بله، بالاخره!"
          }
