        "characters": [
          "giulia",
          "sofia"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "giulia",
            "text": "Che ne pensi di questo ristorante?",
            "translation_fa": "درباره این رستوران چه فکر می‌کنی؟"
          },
          {
            "order": 2,
            "speaker": "sofia",
            "text": "Mi sembra interessante, ma forse è un po' caro.",
            "translation_fa": "جالب به نظر می‌رسد، ولی شاید کمی گران باشد."
          },
          {
            "order": 3,
            "speaker": "giulia",
