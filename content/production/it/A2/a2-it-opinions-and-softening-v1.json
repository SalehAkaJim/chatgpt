      "external_id": "g_opinions_and_softening_core",
      "data": {
        "lesson_key": "a2-it-opinions-and-softening-01",
        "slug": "a2-it-opinions-and-softening-grammar",
        "title": "Secondo me / mi sembra / forse",
        "rule_summary": "These expressions let you give an opinion without sounding too absolute.",
        "explanation": {
          "fa": "برای بیان نظر با لحن نرم‌تر، second me، mi sembra و forse بسیار رایج‌اند. این عبارت‌ها کمک می‌کنند مخالفت یا ارزیابی قطعی و تند به نظر نرسد."
        },
        "examples": [
          {
            "it": "Secondo me va bene.",
            "fa": "به نظر من خوب است."
          },
          {
            "it": "Forse è troppo caro.",
            "fa": "شاید خیلی گران باشد."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
