    {
      "kind": "grammar_point",
      "external_id": "g_plans_and_intentions_core",
      "data": {
        "lesson_key": "a2-it-plans-and-intentions-01",
        "slug": "a2-it-plans-and-intentions-grammar",
        "title": "Decidere di / sperare di + infinito",
        "rule_summary": "When the subject stays the same, common planning verbs can be followed by di + infinitive.",
        "explanation": {
          "fa": "وقتی فاعل همان فرد است، بعد از فعل‌هایی مثل decidere و sperare معمولاً di + مصدر می‌آید: ho deciso di partire، spero di venire."
        },
        "examples": [
          {
            "it": "Ho deciso di partire.",
            "fa": "تصمیم گرفته‌ام بروم."
          },
          {
            "it": "Spero di venire.",
            "fa": "امیدوارم بیایم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
