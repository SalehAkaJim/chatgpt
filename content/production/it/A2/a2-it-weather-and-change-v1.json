    {
      "kind": "grammar_point",
      "external_id": "g_weather_and_change_core",
      "data": {
        "lesson_key": "a2-it-weather-and-change-01",
        "slug": "a2-it-weather-and-change-grammar",
        "title": "Stare + gerundio per un cambiamento in corso",
        "rule_summary": "Stare + gerund describes an action or change in progress; diventare describes a resulting change of state.",
        "explanation": {
          "fa": "برای کاری که همین حالا در جریان است از stare + gerundio استفاده می‌شود: sta cambiando. برای «شدن» و رسیدن به حالت جدید از diventare استفاده می‌کنیم."
        },
        "examples": [
          {
            "it": "Sta cambiando.",
            "fa": "دارد تغییر می‌کند."
          },
          {
            "it": "È diventato freddo.",
            "fa": "سرد شده است."
          }
        ],
        "cefr": "A2",
