      "data": {
        "lesson_key": "a2-it-reasons-and-results-01",
        "slug": "a2-it-reasons-and-results-grammar",
        "title": "Perché e quindi",
        "rule_summary": "Perché introduces a reason; quindi introduces a consequence or result.",
        "explanation": {
          "fa": "perché دلیل را معرفی می‌کند و quindi نتیجه را. در مکالمه روزمره این دو رابط برای توضیح کوتاه اتفاق‌ها بسیار پرکاربردند."
        },
        "examples": [
          {
            "it": "Sono tardi perché c'è traffico.",
            "fa": "دیرم چون ترافیک است."
          },
          {
            "it": "Piove, quindi resto a casa.",
            "fa": "باران می‌بارد، پس خانه می‌مانم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
