      "data": {
        "lesson_key": "a2-it-comparisons-and-choice-01",
        "slug": "a2-it-comparisons-and-choice-grammar",
        "title": "Più / meno + aggettivo",
        "rule_summary": "Italian forms basic comparisons with più or meno before an adjective.",
        "explanation": {
          "fa": "برای مقایسه ساده، più + صفت یعنی «...تر» و meno + صفت یعنی «کمتر ...». برای بیان ترجیح می‌توان از preferisco استفاده کرد."
        },
        "examples": [
          {
            "it": "È più leggero.",
            "fa": "سبک‌تر است."
          },
          {
            "it": "È meno caro.",
            "fa": "کمتر گران است."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
