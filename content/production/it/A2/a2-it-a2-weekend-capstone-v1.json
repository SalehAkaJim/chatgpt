      "data": {
        "lesson_key": "a2-it-a2-weekend-capstone-01",
        "slug": "a2-it-a2-weekend-capstone-grammar",
        "title": "Se + presente, presente",
        "rule_summary": "For realistic near-term conditions, Italian often uses the present in both the if-clause and the result.",
        "explanation": {
          "fa": "برای شرط واقعی و محتمل در زمان حال یا آینده نزدیک، در ایتالیایی می‌توان در هر دو بخش از حال ساده استفاده کرد: se piove, restiamo a casa."
        },
        "examples": [
          {
            "it": "Se piove, restiamo a casa.",
            "fa": "اگر باران ببارد، خانه می‌مانیم."
          },
          {
            "it": "Se cambia il tempo, cerchiamo un'alternativa.",
            "fa": "اگر هوا عوض شود، دنبال گزینه دیگری می‌گردیم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_weekend_capstone_01",
      "data": {
        "lesson_key": "a2-it-a2-weekend-capstone-01",
        "title": "Il piano finale",
        "setting": "item",
        "cefr": "A2",
        "topic": "future-plans",
        "characters": [
          "chiara",
          "elena"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "chiara",
            "text": "Abbiamo confermato l'hotel?",
            "translation_fa": "هتل را تأیید کرده‌ایم؟"
          },
          {
            "order": 2,
            "speaker": "elena",
            "text": "Sì, e ho anche controllato il treno.",
            "translation_fa": "بله، و قطار را هم بررسی کردم."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Perfetto. Se cambia il tempo?",
            "translation_fa": "عالی. اگر هوا عوض شد؟"
          },
          {
            "order": 4,
            "speaker": "elena",
            "text": "Andiamo al museo invece che al lago.",
            "translation_fa": "به جای دریاچه می‌رویم موزه."
          }
        ],
        "qa": {
