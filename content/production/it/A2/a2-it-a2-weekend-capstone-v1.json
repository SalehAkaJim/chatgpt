    {
      "kind": "dialogue",
      "external_id": "d_a2_weekend_capstone_02",
      "data": {
        "lesson_key": "a2-it-a2-weekend-capstone-02",
        "title": "Un piccolo imprevisto",
        "setting": "item",
        "cefr": "A2",
        "topic": "future-plans",
        "characters": [
          "luca",
          "marco"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "luca",
            "text": "Il treno ha trenta minuti di ritardo.",
            "translation_fa": "قطار سی دقیقه تأخیر دارد."
          },
          {
            "order": 2,
            "speaker": "marco",
            "text": "Non è un problema. Possiamo prendere quello successivo.",
            "translation_fa": "مشکلی نیست. می‌توانیم قطار بعدی را بگیریم."
          },
          {
            "order": 3,
            "speaker": "luca",
            "text": "Secondo me è la soluzione migliore.",
            "translation_fa": "به نظر من بهترین راه‌حل است."
          },
          {
            "order": 4,
            "speaker": "marco",
            "text": "D'accordo, cambio la prenotazione.",
            "translation_fa": "موافقم، رزرو را عوض می‌کنم."
          }
        ],
        "qa": {
