    {
      "kind": "dialogue",
      "external_id": "d_strategic_ambiguity_01",
      "data": {
        "lesson_key": "c2-it-strategic-ambiguity-01",
        "title": "È una promessa?",
        "setting": "item",
        "cefr": "C2",
        "topic": "requests",
        "characters": [
          "chiara",
          "matteo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "chiara",
            "text": "Valuteremo favorevolmente significa che accetteranno?",
            "translation_fa": "«مثبت بررسی می‌کنیم» یعنی خواهند پذیرفت؟"
          },
          {
            "order": 2,
            "speaker": "matteo",
            "text": "No, segnala apertura ma non obbligo.",
            "translation_fa": "نه، آمادگی را نشان می‌دهد نه تعهد."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Quindi la formula è non vincolante.",
            "translation_fa": "پس عبارت الزام‌آور نیست."
          },
          {
            "order": 4,
            "speaker": "matteo",
            "text": "Esatto, è normale nella fase preliminare.",
            "translation_fa": "دقیقاً، در مرحله مقدماتی طبیعی است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_strategic_ambiguity_02",
      "data": {
        "lesson_key": "c2-it-strategic-ambiguity-02",
        "title": "Rispondere senza chiudere",
        "setting": "item",
        "cefr": "C2",
        "topic": "requests",
        "characters": [
          "elena",
          "davide"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "elena",
            "text": "Ci chiedono una data definitiva.",
            "translation_fa": "از ما تاریخ قطعی می‌خواهند."
          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "Diamo una finestra senza impegnarci sul giorno.",
            "translation_fa": "یک بازه می‌دهیم بدون تعهد به روز مشخص."
          },
          {
            "order": 3,
            "speaker": "elena",
            "text": "Così non fingiamo una certezza.",
            "translation_fa": "این‌طور قطعیت دروغین نمی‌سازیم."
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Esatto: precisione anche nell’incertezza.",
            "translation_fa": "دقیقاً؛ حتی در عدم قطعیت هم دقیق باشیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
