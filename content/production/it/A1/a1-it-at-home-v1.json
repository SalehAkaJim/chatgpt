    {
      "kind": "grammar_point",
      "external_id": "g_at_home_core",
      "data": {
        "lesson_key": "a1-it-at-home-01",
        "slug": "a1-it-at-home-grammar",
        "title": "C'è / ci sono",
        "rule_summary": "Use c'è for one thing and ci sono for more than one.",
        "explanation": {
          "fa": "برای گفتن «هست» با یک چیز از c'è و برای چند چیز از ci sono استفاده می‌شود: c'è una cucina، ci sono due camere."
        },
        "examples": [
          {
            "it": "C'è una cucina.",
            "fa": "یک آشپزخانه هست."
          },
          {
            "it": "Ci sono due camere.",
            "fa": "دو اتاق خواب هست."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_at_home_01",
      "data": {
        "lesson_key": "a1-it-at-home-01",
        "title": "La nuova casa",
        "setting": "item",
        "cefr": "A1",
