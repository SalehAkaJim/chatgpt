          },
          {
            "order": 2,
            "speaker": "davide",
            "text": "È lì, a destra.",
            "translation_fa": "آنجاست، سمت راست."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Grazie mille.",
            "translation_fa": "خیلی ممنون."
          },
          {
            "order": 4,
            "speaker": "davide",
            "text": "Prego.",
            "translation_fa": "خواهش می‌کنم."
