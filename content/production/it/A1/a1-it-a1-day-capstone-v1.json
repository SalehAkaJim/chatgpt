        "characters": [
          "elena",
          "luca"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "elena",
            "text": "A che ora ti svegli?",
            "translation_fa": "چه ساعتی بیدار می‌شوی؟"
          },
          {
            "order": 2,
            "speaker": "luca",
            "text": "Alle sette. Poi faccio colazione.",
            "translation_fa": "هفت. بعد صبحانه می‌خورم."
          },
          {
            "order": 3,
            "speaker": "elena",
            "text": "Io esco di casa alle otto.",
            "translation_fa": "من ساعت هشت از خانه بیرون می‌روم."
          },
          {
            "order": 4,
            "speaker": "luca",
            "text": "Anch'io.",
            "translation_fa": "من هم."
          }
