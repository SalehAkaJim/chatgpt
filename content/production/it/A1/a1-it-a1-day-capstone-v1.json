          },
          {
            "order": 2,
            "speaker": "marco",
            "text": "Incontro un amico in centro.",
            "translation_fa": "یک دوست را در مرکز شهر می‌بینم."
          },
          {
            "order": 3,
            "speaker": "chiara",
            "text": "Poi torni a casa?",
