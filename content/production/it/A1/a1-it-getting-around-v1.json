      "data": {
        "lesson_key": "a1-it-getting-around-01",
        "slug": "a1-it-getting-around-grammar",
        "title": "Vado a / in...",
        "rule_summary": "With andare, Italian commonly uses a with cities and in with many countries, regions and certain places.",
        "explanation": {
          "fa": "با andare برای شهرها معمولاً a می‌آید: vado a Roma. برای کشورها و بعضی مکان‌ها in رایج است: vado in Italia، vado in centro."
        },
        "examples": [
          {
            "it": "Vado a Roma.",
            "fa": "به رم می‌روم."
          },
          {
            "it": "Vado in centro.",
            "fa": "به مرکز شهر می‌روم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
