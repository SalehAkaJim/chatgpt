    {"kind":"grammar_point","external_id":"g_plan_going_to","data":{"lesson_key":"a1-plans-01","slug":"a1-going-to-plans","title":"be going to for simple plans","rule_summary":"Use am/is/are going to + base verb to talk about a simple future plan or intention.","explanation":{"fa":"برای بیان یک برنامه یا قصد ساده در آینده از am/is/are going to + شکل پایه فعل استفاده می‌کنیم."},"examples":[{"en":"I'm going to study tonight.","fa":"قرار است امشب درس بخوانم."},{"en":"We're going to visit Ali on Sunday.","fa":"قرار است یکشنبه علی را ببینیم."}],"cefr":"A1","status":"approved"}},
    {"kind":"grammar_point","external_id":"g_plan_want_to","data":{"lesson_key":"a1-plans-02","slug":"a1-want-to-invitations","title":"Do you want to ...?","rule_summary":"Use Do you want to + base verb for a simple informal invitation.","explanation":{"fa":"برای دعوت ساده و خودمانی می‌توانیم از Do you want to + شکل پایه فعل استفاده کنیم."},"examples":[{"en":"Do you want to eat out?","fa":"می‌خواهی بیرون غذا بخوریم؟"},{"en":"Do you want to come with us?","fa":"می‌خواهی با ما بیایی؟"}],"cefr":"A1","status":"approved"}},

    {"kind":"dialogue","external_id":"d_plan_evening","data":{"lesson_key":"a1-plans-01","title":"Tonight's plan","setting":"office exit","cefr":"A1","topic":"future-plans","characters":["Ava","Jon"],"turns":[{"order":1,"speaker":"Jon","text":"What are you doing tonight?","translation_fa":"امشب چه کار می‌کنی؟"},{"order":2,"speaker":"Ava","text":"I'm going to watch a movie.","translation_fa":"قرار است فیلم ببینم."},{"order":3,"speaker":"Jon","text":"Nice. I'm going to meet some friends.","translation_fa":"خوبه. قرار است چند تا از دوستانم را ببینم."},{"order":4,"speaker":"Ava","text":"Have fun!","translation_fa":"خوش بگذره!"}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_plan_invite","data":{"lesson_key":"a1-plans-02","title":"Coffee tomorrow","setting":"school hallway","cefr":"A1","topic":"future-plans","characters":["Priya","Leo"],"turns":[{"order":1,"speaker":"Priya","text":"Do you want to get coffee tomorrow?","translation_fa":"می‌خواهی فردا قهوه بخوریم؟"},{"order":2,"speaker":"Leo","text":"Sure. Sounds good.","translation_fa":"حتماً. خوبه."},{"order":3,"speaker":"Priya","text":"How about three o'clock?","translation_fa":"ساعت سه چطوره؟"},{"order":4,"speaker":"Leo","text":"Perfect. See you then.","translation_fa":"عالیه. پس می‌بینمت."}],"status":"approved"}},

