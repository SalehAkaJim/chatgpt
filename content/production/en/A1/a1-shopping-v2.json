    {"kind":"dialogue","external_id":"d_shop_clothes","data":{"lesson_key":"a1-shopping-01","title":"Looking for a shirt","setting":"clothing store","cefr":"A1","topic":"shopping","characters":["Sara","Ben"],"turns":[{"order":1,"speaker":"Ben","text":"Can I help you?","translation_fa":"می‌توانم کمکتان کنم؟"},{"order":2,"speaker":"Sara","text":"Yes. I'm looking for a blue shirt.","translation_fa":"بله. دنبال یک پیراهن آبی هستم."},{"order":3,"speaker":"Ben","text":"What size do you need?","translation_fa":"چه سایزی لازم دارید؟"},{"order":4,"speaker":"Sara","text":"Medium, please.","translation_fa":"متوسط، لطفاً."}],"status":"approved"}},
