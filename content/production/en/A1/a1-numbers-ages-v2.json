    {
      "kind": "grammar_point",
      "external_id": "g_age_be",
      "data": {
        "lesson_key": "a1-numbers-02",
        "slug": "a1-age-with-be",
        "title": "Age with be",
        "rule_summary": "English normally uses be to state age: I'm twenty-five, not I have twenty-five years.",
        "explanation": {
          "fa": "در انگلیسی برای بیان سن از فعل be استفاده می‌شود: I'm twenty-five."
