    {"kind":"dialogue","external_id":"d_spell_name","data":{"lesson_key":"a1-introductions-02","title":"Spell your name","setting":"front desk","cefr":"A1","topic":"introductions","characters":["Priya","Tom"],"turns":[{"order":1,"speaker":"Tom","text":"What's your name?","translation_fa":"اسمت چیه؟"},{"order":2,"speaker":"Priya","text":"Priya.","translation_fa":"پریا."},{"order":3,"speaker":"Tom","text":"How do you spell that?","translation_fa":"آن را چطور هجی می‌کنی؟"},{"order":4,"speaker":"Priya","text":"P-R-I-Y-A.","translation_fa":"P-R-I-Y-A"}],"status":"approved","qa":{"character_pair_unique_within_unit":true,"naturalness":"passed","single_situation":true}}},
