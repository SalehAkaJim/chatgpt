    {"kind":"dialogue","external_id":"d_meet_at_class","data":{"lesson_key":"a1-introductions-01","title":"Meet at class","setting":"classroom","cefr":"A1","topic":"introductions","characters":["Amir","Ella"],"turns":[{"order":1,"speaker":"Amir","text":"Hi! I'm Amir.","translation_fa":"سلام! من امیر هستم."},{"order":2,"speaker":"Ella","text":"Hi, Amir. My name is Ella.","translation_fa":"سلام امیر. اسم من الا است."},{"order":3,"speaker":"Amir","text":"Nice to meet you, Ella.","translation_fa":"از آشنایی با تو خوشحالم، الا."},{"order":4,"speaker":"Ella","text":"Nice to meet you too.","translation_fa":"من هم از آشنایی با تو خوشحالم."}],"status":"approved","qa":{"character_pair_unique_within_unit":true,"naturalness":"passed","single_situation":true}}},
