    {
      "kind": "grammar_point",
      "external_id": "g_have_has",
      "data": {
        "lesson_key": "a1-possessions-02",
        "slug": "a1-have-has",
        "title": "have and has",
        "rule_summary": "Use have with I, you, we, and they; use has with he, she, and it.",
        "explanation": {
          "fa": "با I, you, we, they از have و با he, she, it از has استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I have a ticket.",
            "fa": "من بلیت دارم."
          },
          {
            "en": "She has a backpack.",
            "fa": "او کوله‌پشتی دارد."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_do_have_questions",
      "data": {
        "lesson_key": "a1-possessions-01",
        "slug": "a1-do-you-have",
        "title": "Do you have ...?",
        "rule_summary": "Use Do you have ...? to ask about possession in the present simple.",
        "explanation": {
          "fa": "برای پرسیدن اینکه کسی چیزی دارد از Do you have ...? استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Do you have a ticket?",
            "fa": "بلیت داری؟"
          },
          {
            "en": "Do you have your keys?",
            "fa": "کلیدهایت را داری؟"
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
    {
