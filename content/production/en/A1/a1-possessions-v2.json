    {
      "kind": "exercise",
      "external_id": "ex_have_question",
      "data": {
        "lesson_key": "a1-possessions-01",
        "exercise_type": "multiple_choice",
        "prompt": {
          "fa": "«چتر داری؟» کدام است؟"
