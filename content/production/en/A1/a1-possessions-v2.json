        "answer": {
          "value": "Do you have an umbrella?"
        },
        "difficulty": 1,
        "cefr": "A1",
        "status": "validated",
        "feedback": {
          "explanation_fa": "معنی جمله: چتر داری؟\nنکتهٔ واژگانی: «do you have»: «... داری؟»؛ «umbrella»: «چتر»",
          "model_answer": "Do you have an umbrella?",
          "retry_tip_fa": "ابتدا مدل و توضیح را مرور کن؛ سپس بدون نگاه‌کردن دوباره پاسخ بده."
        }
