            "fa": "کشتی؛ /ʃɪp/"
          },
          {
            "en": "chip",
            "fa": "تکهٔ کوچک؛ /tʃɪp/"
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated",
        "audio_examples": true
      }
    },
    {
