          "Noura"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ben",
            "text": "I'd prefer the cafe on King Street.",
            "translation_fa": "کافه خیابان کینگ رو ترجیح می‌دم."
          },
          {
            "order": 2,
            "speaker": "Noura",
            "text": "I don't really agree. It's always crowded.",
            "translation_fa": "خیلی موافق نیستم. همیشه شلوغه."
          },
          {
            "order": 3,
            "speaker": "Ben",
            "text": "That's true, but the coffee is better.",
            "translation_fa": "درسته، ولی قهوه‌اش بهتره."
          },
          {
            "order": 4,
            "speaker": "Noura",
            "text": "Okay. That's a good reason.",
            "translation_fa": "باشه. دلیل خوبیه."
