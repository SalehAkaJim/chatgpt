        "turns": [
          {
            "order": 1,
            "speaker": "Ravi",
            "text": "I think the comedy looks better.",
            "translation_fa": "فکر می‌کنم فیلم کمدی بهتره."
          },
          {
            "order": 2,
            "speaker": "Priya",
            "text": "I agree. The other one looks too serious.",
            "translation_fa": "موافقم. اون یکی خیلی جدی به نظر می‌رسه."
          },
          {
            "order": 3,
            "speaker": "Ravi",
            "text": "And this one starts earlier.",
            "translation_fa": "این یکی هم زودتر شروع می‌شه."
          },
          {
            "order": 4,
            "speaker": "Priya",
            "text": "Good. Let's watch it.",
            "translation_fa": "خوبه. همین رو ببینیم."
          }
        ],
        "status": "approved"
      }
