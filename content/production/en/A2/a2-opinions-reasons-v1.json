    {
      "kind": "dialogue",
      "external_id": "d_a2_opinions_reasons_cafe",
      "data": {
        "lesson_key": "a2-opinions-reasons-02",
        "title": "Different opinions",
        "setting": "street",
        "cefr": "A2",
        "topic": "likes-dislikes",
        "characters": [
