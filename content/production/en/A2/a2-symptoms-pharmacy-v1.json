        "turns": [
          {
            "order": 1,
            "speaker": "Zoe",
            "text": "Hi. Do you have something for a sore throat?",
            "translation_fa": "سلام. چیزی برای گلودرد دارید؟"
          },
          {
            "order": 2,
            "speaker": "Drake",
            "text": "Do you have a fever too?",
            "translation_fa": "تب هم دارید؟"
          },
          {
            "order": 3,
            "speaker": "Zoe",
            "text": "A little, but mostly my throat hurts.",
            "translation_fa": "یه کم، ولی بیشتر گلو درد دارم."
          },
          {
            "order": 4,
            "speaker": "Drake",
            "text": "This may help. Follow the directions on the label.",
