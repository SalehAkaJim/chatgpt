    {
      "kind": "grammar_point",
      "external_id": "g_a2_present_now_usual",
      "data": {
        "lesson_key": "a2-catching-up-01",
        "slug": "a2-present-usual-vs-now",
        "title": "Usual life vs. life now",
        "rule_summary": "Use the present simple for usual situations and the present continuous for activities happening around now.",
        "explanation": {
          "fa": "برای وضعیت‌ها و کارهای معمول از حال ساده و برای کاری که این روزها یا همین حوالی زمان حال در جریان است از حال استمراری استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I work downtown.",
            "fa": "من مرکز شهر کار می‌کنم."
          },
          {
            "en": "I'm working on a new project this month.",
            "fa": "این ماه دارم روی یک پروژه جدید کار می‌کنم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_follow_up",
      "data": {
        "lesson_key": "a2-catching-up-02",
        "slug": "a2-short-follow-up-questions",
        "title": "Keep the conversation going",
        "rule_summary": "Short follow-up questions such as How about you?, Really?, and Anything new? help continue an everyday conversation.",
        "explanation": {
          "fa": "سؤال‌های کوتاه مثل How about you?، Really? و Anything new? کمک می‌کنند مکالمه طبیعی ادامه پیدا کند."
        },
        "examples": [
          {
            "en": "I'm busy these days. How about you?",
            "fa": "این روزها سرم شلوغه. تو چطور؟"
          },
          {
            "en": "I started a new job. Really?",
            "fa": "یک کار جدید شروع کردم. واقعاً؟"
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_catchup_cafe",
      "data": {
        "lesson_key": "a2-catching-up-01",
        "title": "A quick catch-up",
        "setting": "cafe",
        "cefr": "A2",
        "topic": "polite-language",
        "characters": [
          "Maya",
          "Leo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Maya",
            "text": "Hey, Leo! Nice to see you again.",
            "translation_fa": "هی لئو! خوشحالم دوباره می‌بینمت."
          },
          {
            "order": 2,
            "speaker": "Leo",
            "text": "You too! How are things?",
            "translation_fa": "من هم همین‌طور! اوضاع چطوره؟"
          },
          {
            "order": 3,
            "speaker": "Maya",
            "text": "Pretty good. I'm busy with work these days.",
            "translation_fa": "بد نیست. این روزها سرم با کار شلوغه."
          },
          {
            "order": 4,
            "speaker": "Leo",
            "text": "Same here. I'm working on a new project.",
            "translation_fa": "من هم همین‌طور. دارم روی یک پروژه جدید کار می‌کنم."
          },
          {
            "order": 5,
            "speaker": "Maya",
            "text": "Sounds interesting. How's your family?",
            "translation_fa": "جالب به نظر میاد. خانواده‌ات چطورن؟"
          },
          {
            "order": 6,
            "speaker": "Leo",
            "text": "They're good, thanks. How about yours?",
            "translation_fa": "خوبن، ممنون. خانواده تو چطور؟"
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_catchup_street",
      "data": {
        "lesson_key": "a2-catching-up-02",
        "title": "Running into a friend",
        "setting": "street",
        "cefr": "A2",
        "topic": "polite-language",
        "characters": [
          "Priya",
          "Tom"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Priya",
            "text": "Tom! Good to see you again.",
            "translation_fa": "تام! خوشحالم دوباره می‌بینمت."
          },
          {
            "order": 2,
            "speaker": "Tom",
            "text": "You too! What are you doing these days?",
            "translation_fa": "من هم همین‌طور! این روزها مشغول چه کاری هستی؟"
          },
          {
            "order": 3,
            "speaker": "Priya",
            "text": "I'm taking an evening class and working a lot.",
            "translation_fa": "دارم یک کلاس عصر می‌رم و خیلی کار می‌کنم."
          },
          {
            "order": 4,
            "speaker": "Tom",
            "text": "Busy! I'm working a lot too.",
            "translation_fa": "سرت شلوغه! من هم خیلی کار می‌کنم."
          },
          {
            "order": 5,
            "speaker": "Priya",
            "text": "We should catch up again soon.",
            "translation_fa": "بهتره به‌زودی دوباره با هم گپ بزنیم."
          },
          {
            "order": 6,
            "speaker": "Tom",
            "text": "Definitely. Text me this weekend.",
            "translation_fa": "حتماً. آخر هفته بهم پیام بده."
          }
        ],
        "status": "approved"
      }
    },
