    {
      "kind": "grammar_point",
      "external_id": "g_a2_work_duties_have_to",
      "data": {
        "lesson_key": "a2-work-duties-02",
        "slug": "a2-work-duties-have-to",
        "title": "have to / don't have to",
        "rule_summary": "Use have to for a requirement and don't have to when something is not necessary.",
        "explanation": {
          "fa": "برای الزام از have to و برای کاری که لازم نیست از don't have to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I have to arrive by eight.",
            "fa": "باید تا هشت برسم."
          },
          {
            "en": "You don't have to wear a tie.",
            "fa": "لازم نیست کراوات بزنی."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_work_duties_can_rules",
      "data": {
        "lesson_key": "a2-work-duties-03",
        "slug": "a2-work-duties-can-rules",
        "title": "can / can't at work",
        "rule_summary": "Use can and can't for permission or workplace rules.",
        "explanation": {
          "fa": "برای اجازه یا محدودیت‌های محیط کار از can و can't استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "You can take your break now.",
            "fa": "الان می‌تونی استراحت کنی."
          },
          {
            "en": "Staff can't use this door.",
            "fa": "کارکنان نمی‌توانند از این در استفاده کنند."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_work_duties_first_day",
      "data": {
        "lesson_key": "a2-work-duties-01",
        "title": "A first day at work",
        "setting": "office",
        "cefr": "A2",
        "topic": "jobs",
        "characters": [
          "Mei",
          "David"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mei",
            "text": "What time does my shift start tomorrow?",
            "translation_fa": "شیفتم فردا چه ساعتی شروع می‌شه؟"
          },
          {
            "order": 2,
            "speaker": "David",
            "text": "At eight. Please arrive ten minutes early.",
            "translation_fa": "ساعت هشت. لطفاً ده دقیقه زودتر برس."
          },
          {
            "order": 3,
            "speaker": "Mei",
            "text": "Do I have to wear a uniform?",
            "translation_fa": "باید لباس فرم بپوشم؟"
          },
          {
            "order": 4,
            "speaker": "David",
            "text": "No, but you have to wear your ID badge.",
            "translation_fa": "نه، ولی باید کارت شناسایی‌ات را داشته باشی."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_work_duties_duties",
      "data": {
        "lesson_key": "a2-work-duties-03",
        "title": "Talking about duties",
        "setting": "break room",
        "cefr": "A2",
        "topic": "jobs",
        "characters": [
          "Iris",
          "Theo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Iris",
            "text": "What do you usually do in the afternoon?",
            "translation_fa": "معمولاً بعدازظهرها چه کار می‌کنی؟"
          },
          {
            "order": 2,
            "speaker": "Theo",
            "text": "I check orders and answer customer emails.",
            "translation_fa": "سفارش‌ها را بررسی می‌کنم و ایمیل مشتری‌ها را جواب می‌دهم."
          },
          {
            "order": 3,
            "speaker": "Iris",
            "text": "Do you have to write reports too?",
            "translation_fa": "باید گزارش هم بنویسی؟"
          },
          {
            "order": 4,
            "speaker": "Theo",
            "text": "Only on Fridays.",
            "translation_fa": "فقط جمعه‌ها."
          }
        ],
        "status": "approved"
      }
    },
