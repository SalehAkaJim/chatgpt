    {
      "kind": "dialogue",
      "external_id": "d_a2_event_bad_morning",
      "data": {
        "lesson_key": "a2-past-events-01",
        "title": "A bad morning",
        "setting": "office",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Sara",
          "Jon"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Sara",
            "text": "You look tired. What happened?",
            "translation_fa": "خسته به نظر میای. چی شد؟"
          },
          {
            "order": 2,
            "speaker": "Jon",
            "text": "First, I missed my bus. Then my taxi got stuck in traffic.",
            "translation_fa": "اول اتوبوسم را از دست دادم. بعد تاکسی‌ام در ترافیک گیر کرد."
          },
          {
            "order": 3,
            "speaker": "Sara",
            "text": "Oh no. What happened next?",
            "translation_fa": "ای وای. بعدش چی شد؟"
          },
          {
            "order": 4,
            "speaker": "Jon",
            "text": "I got to work twenty minutes late.",
            "translation_fa": "بیست دقیقه دیر به محل کار رسیدم."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_event_day_trip",
      "data": {
        "lesson_key": "a2-past-events-02",
        "title": "A day trip",
        "setting": "train station",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Noor",
          "Theo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Noor",
            "text": "How was your day trip?",
            "translation_fa": "گردش یک‌روزه‌ات چطور بود؟"
          },
          {
            "order": 2,
            "speaker": "Theo",
            "text": "Great. First, we walked around the old town. After that, we had lunch by the river.",
            "translation_fa": "عالی. اول در بخش قدیمی شهر قدم زدیم. بعد از آن کنار رودخانه ناهار خوردیم."
          },
          {
            "order": 3,
            "speaker": "Noor",
            "text": "Sounds nice.",
            "translation_fa": "خوب به نظر میاد."
          },
          {
            "order": 4,
            "speaker": "Theo",
            "text": "Yeah. Finally, we took the six o'clock train home.",
            "translation_fa": "آره. در آخر با قطار ساعت شش برگشتیم خانه."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_event_rain",
      "data": {
        "lesson_key": "a2-past-events-03",
        "title": "Caught in the rain",
        "setting": "home",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Dina",
          "Chris"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Chris",
            "text": "Why are your shoes wet?",
            "translation_fa": "چرا کفش‌هات خیسه؟"
          },
          {
            "order": 2,
            "speaker": "Dina",
            "text": "I walked home from the store, and suddenly it started to rain.",
            "translation_fa": "از فروشگاه پیاده به خانه می‌آمدم که ناگهان باران شروع شد."
          },
          {
            "order": 3,
            "speaker": "Chris",
            "text": "Didn't you have an umbrella?",
            "translation_fa": "چتر نداشتی؟"
          },
          {
            "order": 4,
            "speaker": "Dina",
            "text": "No. I got wet because I had nothing with me.",
            "translation_fa": "نه. خیس شدم چون چیزی همراهم نبود."
          }
        ],
        "status": "validated"
      }
    },
