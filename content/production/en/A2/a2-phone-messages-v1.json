    {
      "kind": "dialogue",
      "external_id": "d_a2_phone_messages_office",
      "data": {
        "lesson_key": "a2-phone-messages-02",
        "title": "Taking a message",
        "setting": "office phone",
        "cefr": "A2",
        "topic": "simple-messages",
        "characters": [
          "Rosa",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Rosa",
            "text": "Hello, could I speak to Mr. Green?",
            "translation_fa": "سلام، می‌تونم با آقای گرین صحبت کنم؟"
          },
          {
            "order": 2,
            "speaker": "Daniel",
            "text": "I'm sorry, he's in a meeting.",
            "translation_fa": "متأسفم، جلسه است."
          },
          {
            "order": 3,
            "speaker": "Rosa",
            "text": "Can I leave a message?",
            "translation_fa": "می‌تونم پیام بذارم؟"
          },
          {
            "order": 4,
            "speaker": "Daniel",
            "text": "Of course. What's your name?",
            "translation_fa": "حتماً. اسمتون چیه؟"
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_phone_messages_connection",
      "data": {
        "lesson_key": "a2-phone-messages-01",
        "title": "A difficult phone connection",
        "setting": "phone call",
        "cefr": "A2",
        "topic": "simple-messages",
        "characters": [
          "Lina",
          "Tom"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Lina",
            "text": "Hello? Tom? The line is really bad.",
            "translation_fa": "الو؟ تام؟ خط خیلی بده."
          },
          {
            "order": 2,
            "speaker": "Tom",
            "text": "I can hear you now.",
            "translation_fa": "الان صدات رو می‌شنوم."
          },
          {
            "order": 3,
            "speaker": "Lina",
            "text": "Could you say the address again?",
            "translation_fa": "می‌شه آدرس رو دوباره بگی؟"
          },
          {
            "order": 4,
            "speaker": "Tom",
            "text": "Sure. It's 214 Pine Street.",
            "translation_fa": "حتماً. ۲۱۴ پاین استریت."
          }
        ],
        "status": "approved"
      }
