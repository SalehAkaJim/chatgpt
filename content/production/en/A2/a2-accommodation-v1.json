      "data": {
        "lesson_key": "a2-accommodation-03",
        "slug": "a2-accommodation-could-i",
        "title": "Could I ...? for polite requests",
        "rule_summary": "Use Could I ...? to make a polite request at a hotel.",
        "explanation": {
          "fa": "برای درخواست مؤدبانه در هتل از Could I ...? استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Could I get another towel?",
            "fa": "می‌شود یک حوله دیگر بگیرم؟"
          },
          {
