      "data": {
        "lesson_key": "a2-accommodation-02",
        "slug": "a2-accommodation-is-there",
        "title": "Is there / Are there",
        "rule_summary": "Use Is there or Are there to ask about hotel facilities.",
        "explanation": {
          "fa": "برای پرسیدن درباره امکانات محل اقامت از Is there یا Are there استفاده می‌کنیم."
        },
        "examples": [
          {
