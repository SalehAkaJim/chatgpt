    {
      "kind": "dialogue",
      "external_id": "d_a2_accommodation_checkin",
      "data": {
        "lesson_key": "a2-accommodation-01",
        "title": "Hotel check-in",
        "setting": "hotel reception",
        "cefr": "A2",
        "topic": "places-town",
        "characters": [
          "Priya",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Priya",
            "text": "Hi, I have a reservation under Patel.",
            "translation_fa": "سلام، یک رزرو به نام پاتل دارم."
          },
          {
            "order": 2,
            "speaker": "Daniel",
            "text": "Yes, I found it. May I see your ID?",
            "translation_fa": "بله، پیداش کردم. می‌توانم کارت شناسایی‌تان را ببینم؟"
          },
          {
            "order": 3,
            "speaker": "Priya",
            "text": "Sure. Is breakfast included?",
            "translation_fa": "حتماً. صبحانه شامل می‌شود؟"
          },
          {
            "order": 4,
            "speaker": "Daniel",
            "text": "Yes, from seven to ten.",
            "translation_fa": "بله، از هفت تا ده."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_accommodation_problem",
      "data": {
        "lesson_key": "a2-accommodation-03",
        "title": "A room request",
        "setting": "hotel reception",
        "cefr": "A2",
        "topic": "places-town",
        "characters": [
          "Fatima",
          "Marco"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Fatima",
            "text": "My key card isn't working.",
            "translation_fa": "کارت اتاقم کار نمی‌کند."
          },
          {
            "order": 2,
            "speaker": "Marco",
            "text": "I'm sorry. I'll make you a new one.",
            "translation_fa": "متأسفم. یک کارت جدید براتون می‌سازم."
          },
          {
            "order": 3,
            "speaker": "Fatima",
            "text": "Thanks. Could I also get an extra towel?",
            "translation_fa": "ممنون. می‌شود یک حوله اضافه هم بگیرم؟"
          },
          {
            "order": 4,
            "speaker": "Marco",
            "text": "Of course.",
            "translation_fa": "حتماً."
          }
        ],
        "status": "approved"
      }
    },
