    {
      "kind": "grammar_point",
      "external_id": "g_a2_online_communication_tense_review",
      "data": {
        "lesson_key": "a2-online-communication-02",
        "slug": "a2-online-communication-tense-review",
        "title": "Tense choice in practical messages",
        "rule_summary": "Use present for current facts, past for completed reasons, and future forms for later actions.",
        "explanation": {
          "fa": "در پیام‌های کاربردی برای وضعیت فعلی از حال، برای دلیل تمام‌شده از گذشته و برای کار بعدی از آینده استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'm at the station now.",
            "fa": "الان ایستگاهم."
          },
          {
            "en": "I'll send the link tonight.",
            "fa": "امشب لینک رو می‌فرستم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_online_communication_linkers",
      "data": {
        "lesson_key": "a2-online-communication-02",
        "slug": "a2-online-communication-linkers",
        "title": "Short linking words",
        "rule_summary": "Use and, but, so, and because to make short messages clearer.",
        "explanation": {
          "fa": "برای وصل کردن اطلاعات کوتاه در پیام از and، but، so و because استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'm late because the bus stopped.",
            "fa": "دیرم شده چون اتوبوس توقف کرد."
          },
          {
            "en": "The cafe is full, so let's meet outside.",
            "fa": "کافه پره، پس بیرون همدیگه رو ببینیم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_online_communication_group",
      "data": {
        "lesson_key": "a2-online-communication-01",
        "title": "A group chat update",
        "setting": "group chat",
        "cefr": "A2",
        "topic": "simple-messages",
        "characters": [
          "Ivy",
          "Sam"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ivy",
            "text": "Quick update: the meeting room changed.",
            "translation_fa": "یک خبر سریع: اتاق جلسه عوض شد."
          },
          {
            "order": 2,
            "speaker": "Sam",
            "text": "Thanks. Which room is it now?",
            "translation_fa": "ممنون. الان کدام اتاقه؟"
          },
          {
            "order": 3,
            "speaker": "Ivy",
            "text": "Room 204. I'll send the map link too.",
            "translation_fa": "اتاق ۲۰۴. لینک نقشه رو هم می‌فرستم."
          },
          {
            "order": 4,
            "speaker": "Sam",
            "text": "Perfect. See you there.",
            "translation_fa": "عالیه. اونجا می‌بینمت."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_online_communication_file",
      "data": {
        "lesson_key": "a2-online-communication-02",
        "title": "Sending a file",
        "setting": "direct message",
        "cefr": "A2",
        "topic": "simple-messages",
        "characters": [
          "Mei",
          "Owen"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mei",
            "text": "Did you get my email?",
            "translation_fa": "ایمیلم رو گرفتی؟"
          },
          {
            "order": 2,
            "speaker": "Owen",
            "text": "Yes, but I don't see the attachment.",
            "translation_fa": "بله، ولی فایل پیوست رو نمی‌بینم."
          },
          {
            "order": 3,
            "speaker": "Mei",
            "text": "Sorry! I'll send it again now.",
            "translation_fa": "ببخشید! الان دوباره می‌فرستمش."
          },
          {
            "order": 4,
            "speaker": "Owen",
            "text": "No problem. Thanks.",
            "translation_fa": "مشکلی نیست. ممنون."
          }
        ],
        "status": "approved"
      }
    },
