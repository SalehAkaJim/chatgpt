    {"kind":"grammar_point","external_id":"g_a2_some_any","data":{"lesson_key":"a2-food-quantities-01","slug":"a2-some-any-quantities","title":"some and any","rule_summary":"Use some commonly in positive statements and offers/requests; use any commonly in negatives and questions.","explanation":{"fa":"some معمولاً در جمله مثبت و بعضی درخواست‌ها یا پیشنهادها می‌آید؛ any بیشتر در سؤال و جمله منفی استفاده می‌شود."},"examples":[{"en":"We need some rice.","fa":"کمی برنج لازم داریم."},{"en":"Do we have any eggs?","fa":"تخم‌مرغ داریم؟"}],"cefr":"A2","status":"approved"}},
    {"kind":"grammar_point","external_id":"g_a2_much_many","data":{"lesson_key":"a2-food-quantities-03","slug":"a2-much-many","title":"How much? / How many?","rule_summary":"Use how many with countable plural nouns and how much with uncountable nouns.","explanation":{"fa":"برای اسم‌های قابل‌شمارش جمع از how many و برای اسم‌های غیرقابل‌شمارش از how much استفاده می‌کنیم."},"examples":[{"en":"How many tomatoes do we need?","fa":"چند تا گوجه لازم داریم؟"},{"en":"How much water do you drink?","fa":"چقدر آب می‌نوشی؟"}],"cefr":"A2","status":"approved"}},
    {"kind":"grammar_point","external_id":"g_a2_few_little","data":{"lesson_key":"a2-food-quantities-02","slug":"a2-a-few-a-little","title":"a few and a little","rule_summary":"Use a few with countable plural nouns and a little with uncountable nouns for a small positive amount.","explanation":{"fa":"a few با اسم قابل‌شمارش جمع و a little با اسم غیرقابل‌شمارش می‌آید و هر دو مقدار کم اما موجود را نشان می‌دهند."},"examples":[{"en":"a few apples","fa":"چند تا سیب"},{"en":"a little sugar","fa":"کمی شکر"}],"cefr":"A2","status":"approved"}},

    {"kind":"dialogue","external_id":"d_a2_food_shopping_list","data":{"lesson_key":"a2-food-quantities-01","title":"Making a shopping list","setting":"home","cefr":"A2","topic":"food-basics","characters":["Hana","Noah"],"turns":[{"order":1,"speaker":"Hana","text":"Do we have any bread?","translation_fa":"نان داریم؟"},{"order":2,"speaker":"Noah","text":"Not much. Let's get a loaf of bread.","translation_fa":"زیاد نه. یک قرص نان بگیریم."},{"order":3,"speaker":"Hana","text":"Okay. We also need two bottles of water.","translation_fa":"باشه. دو بطری آب هم لازم داریم."},{"order":4,"speaker":"Noah","text":"And some fruit.","translation_fa":"و کمی میوه."}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_food_fridge","data":{"lesson_key":"a2-food-quantities-02","title":"What's left?","setting":"kitchen","cefr":"A2","topic":"food-basics","characters":["Amir","Ella"],"turns":[{"order":1,"speaker":"Amir","text":"Do we need to go shopping?","translation_fa":"لازمه بریم خرید؟"},{"order":2,"speaker":"Ella","text":"Probably. We only have a few apples and a little milk.","translation_fa":"احتمالاً. فقط چند تا سیب و کمی شیر داریم."},{"order":3,"speaker":"Amir","text":"Any eggs?","translation_fa":"تخم‌مرغ داریم؟"},{"order":4,"speaker":"Ella","text":"No, none.","translation_fa":"نه، هیچی."}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_food_cooking_amount","data":{"lesson_key":"a2-food-quantities-03","title":"Cooking for friends","setting":"kitchen","cefr":"A2","topic":"food-basics","characters":["Maya","Leo"],"turns":[{"order":1,"speaker":"Maya","text":"How much rice should I cook?","translation_fa":"چقدر برنج بپزم؟"},{"order":2,"speaker":"Leo","text":"There are six of us, so maybe three cups.","translation_fa":"شش نفریم، پس شاید سه پیمانه."},{"order":3,"speaker":"Maya","text":"Do we have enough vegetables?","translation_fa":"سبزیجات کافی داریم؟"},{"order":4,"speaker":"Leo","text":"Yes, we have plenty.","translation_fa":"بله، زیاد داریم."}],"status":"approved"}},

