    {"kind":"grammar_point","external_id":"g_a2_could_i_restaurant","data":{"lesson_key":"a2-restaurant-service-01","slug":"a2-could-i-restaurant","title":"Polite restaurant requests","rule_summary":"Use Could I …? or Could we …? for polite requests in a restaurant.","explanation":{"fa":"برای درخواست مؤدبانه در رستوران از Could I …? یا Could we …? استفاده می‌کنیم."},"examples":[{"en":"Could I have some water?","fa":"می‌شه کمی آب داشته باشم؟"},{"en":"Could we get the check?","fa":"می‌شه صورتحساب رو بیارید؟"}],"cefr":"A2","status":"approved"}},
    {"kind":"grammar_point","external_id":"g_a2_something_anything","data":{"lesson_key":"a2-restaurant-service-02","slug":"a2-something-anything-service","title":"something and anything","rule_summary":"Use something for an unspecified thing in many positive statements/offers; anything is common in questions and negatives.","explanation":{"fa":"something معمولاً برای یک چیز نامشخص در جمله مثبت و پیشنهادها می‌آید؛ anything بیشتر در سؤال و منفی استفاده می‌شود."},"examples":[{"en":"Would you like something to drink?","fa":"چیزی برای نوشیدن می‌خوای؟"},{"en":"Do you need anything else?","fa":"چیز دیگه‌ای لازم داری؟"}],"cefr":"A2","status":"approved"}},

    {"kind":"dialogue","external_id":"d_a2_restaurant_menu","data":{"lesson_key":"a2-restaurant-service-01","title":"Questions about the menu","setting":"restaurant","cefr":"A2","topic":"restaurants","characters":["Mina","Jonas"],"turns":[{"order":1,"speaker":"Mina","text":"What does the grilled chicken come with?","translation_fa":"مرغ گریل‌شده با چی سرو می‌شه؟"},{"order":2,"speaker":"Jonas","text":"It comes with rice and a side salad.","translation_fa":"با برنج و سالاد جانبی سرو می‌شه."},{"order":3,"speaker":"Mina","text":"Great. I'll have that, please.","translation_fa":"عالیه. همون رو می‌گیرم، لطفاً."},{"order":4,"speaker":"Jonas","text":"Anything to drink?","translation_fa":"چیزی برای نوشیدن؟"}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_restaurant_change","data":{"lesson_key":"a2-restaurant-service-02","title":"Changing a side","setting":"restaurant","cefr":"A2","topic":"restaurants","characters":["Priya","Tom"],"turns":[{"order":1,"speaker":"Priya","text":"Could I get the burger without onions?","translation_fa":"می‌شه برگر رو بدون پیاز بگیرم؟"},{"order":2,"speaker":"Tom","text":"Of course.","translation_fa":"حتماً."},{"order":3,"speaker":"Priya","text":"And can I have salad instead of fries?","translation_fa":"و می‌شه به‌جای سیب‌زمینی سالاد بگیرم؟"},{"order":4,"speaker":"Tom","text":"Sure, no problem.","translation_fa":"حتماً، مشکلی نیست."}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_restaurant_problem","data":{"lesson_key":"a2-restaurant-service-03","title":"The wrong order","setting":"restaurant","cefr":"A2","topic":"restaurants","characters":["Sofia","Omar"],"turns":[{"order":1,"speaker":"Sofia","text":"Excuse me. I think this is the wrong order.","translation_fa":"ببخشید. فکر کنم این سفارش اشتباهه."},{"order":2,"speaker":"Omar","text":"I'm sorry. What did you order?","translation_fa":"متأسفم. چی سفارش داده بودید؟"},{"order":3,"speaker":"Sofia","text":"I ordered the vegetable pasta, not the chicken pasta.","translation_fa":"پاستای سبزیجات سفارش دادم، نه پاستای مرغ."},{"order":4,"speaker":"Omar","text":"I'll fix that right away.","translation_fa":"همین الان درستش می‌کنم."},{"order":5,"speaker":"Sofia","text":"Thank you.","translation_fa":"ممنون."}],"status":"approved"}},

