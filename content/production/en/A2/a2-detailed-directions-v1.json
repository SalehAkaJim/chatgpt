    {
      "kind": "dialogue",
      "external_id": "d_a2_detailed_directions_museum",
      "data": {
        "lesson_key": "a2-detailed-directions-01",
        "title": "Finding the museum",
        "setting": "street corner",
        "cefr": "A2",
        "topic": "directions",
        "characters": [
          "Ava",
          "Jon"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ava",
            "text": "Excuse me, how do I get to the city museum?",
            "translation_fa": "ببخشید، چطور به موزه شهر برسم؟"
          },
          {
            "order": 2,
            "speaker": "Jon",
            "text": "Go straight for two blocks, then turn left at the intersection.",
            "translation_fa": "دو بلوک مستقیم برو، بعد در تقاطع به چپ بپیچ."
          },
          {
            "order": 3,
            "speaker": "Ava",
            "text": "Is it far from there?",
            "translation_fa": "از آنجا دوره؟"
          },
          {
            "order": 4,
            "speaker": "Jon",
            "text": "No. It's across from the public library.",
            "translation_fa": "نه. روبروی کتابخانه عمومی است."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_detailed_directions_subway",
      "data": {
