        "title": "Using the subway",
        "setting": "subway entrance",
        "cefr": "A2",
        "topic": "directions",
        "characters": [
          "Yuki",
          "Owen"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Yuki",
            "text": "Can I take this line to Harbor Station?",
            "translation_fa": "می‌تونم با این خط به ایستگاه هاربر برم؟"
          },
          {
            "order": 2,
            "speaker": "Owen",
            "text": "Not directly. Stay on until Park Street.",
            "translation_fa": "مستقیم نه. تا پارک استریت ادامه بده."
          },
          {
            "order": 3,
            "speaker": "Yuki",
            "text": "Then what?",
            "translation_fa": "بعدش چی؟"
          },
          {
            "order": 4,
            "speaker": "Owen",
            "text": "Transfer to the green line.",
            "translation_fa": "به خط سبز عوض کن."
          }
