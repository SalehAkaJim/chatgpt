    {"kind":"grammar_point","external_id":"g_a2_was_were_background","data":{"lesson_key":"a2-personal-background-01","slug":"a2-was-were-background","title":"was / were for background","rule_summary":"Use was and were to give simple past information about identity, age, place, or situation.","explanation":{"fa":"برای گفتن اطلاعات ساده درباره گذشته از was و were استفاده می‌کنیم؛ مثلاً محل تولد یا وضعیت گذشته."},"examples":[{"en":"I was born in Tabriz.","fa":"من در تبریز به دنیا آمدم."},{"en":"We were students then.","fa":"آن زمان دانشجو بودیم."}],"cefr":"A2","status":"approved"}},
    {"kind":"grammar_point","external_id":"g_a2_past_background","data":{"lesson_key":"a2-personal-background-02","slug":"a2-past-background-verbs","title":"Past actions in your background","rule_summary":"Use the past simple for completed background events such as moving, starting school, or growing up somewhere.","explanation":{"fa":"برای اتفاق‌های تمام‌شده در پیشینه شخصی، مثل نقل مکان یا بزرگ شدن در یک شهر، از گذشته ساده استفاده می‌کنیم."},"examples":[{"en":"I moved here in 2024.","fa":"من در سال ۲۰۲۴ به اینجا نقل مکان کردم."},{"en":"She grew up in a small town.","fa":"او در یک شهر کوچک بزرگ شد."}],"cefr":"A2","status":"approved"}},

    {"kind":"dialogue","external_id":"d_a2_background_class","data":{"lesson_key":"a2-personal-background-01","title":"Talking after class","setting":"language school","cefr":"A2","topic":"introductions","characters":["Hana","Noah"],"turns":[{"order":1,"speaker":"Hana","text":"Where did you grow up?","translation_fa":"کجا بزرگ شدی؟"},{"order":2,"speaker":"Noah","text":"I grew up in a small town near Denver. How about you?","translation_fa":"در یک شهر کوچک نزدیک دنور بزرگ شدم. تو چطور؟"},{"order":3,"speaker":"Hana","text":"I was born in Seoul, but my family moved to California when I was ten.","translation_fa":"در سئول به دنیا آمدم، ولی وقتی ده سالم بود خانواده‌ام به کالیفرنیا نقل مکان کردند."},{"order":4,"speaker":"Noah","text":"Do you still have family in Seoul?","translation_fa":"هنوز در سئول خانواده داری؟"},{"order":5,"speaker":"Hana","text":"Yes, my aunt and uncle live there.","translation_fa":"بله، خاله و شوهرخاله‌ام آنجا زندگی می‌کنند."}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_background_work","data":{"lesson_key":"a2-personal-background-02","title":"New coworkers","setting":"office break room","cefr":"A2","topic":"introductions","characters":["Amir","Ella"],"turns":[{"order":1,"speaker":"Ella","text":"So, are you new to this city?","translation_fa":"خب، تازه به این شهر اومدی؟"},{"order":2,"speaker":"Amir","text":"Pretty new. I moved here two years ago.","translation_fa":"نسبتاً تازه. دو سال پیش به اینجا اومدم."},{"order":3,"speaker":"Ella","text":"Where do you live now?","translation_fa":"الان کجا زندگی می‌کنی؟"},{"order":4,"speaker":"Amir","text":"I currently live downtown with a roommate.","translation_fa":"در حال حاضر مرکز شهر با یک هم‌خانه زندگی می‌کنم."},{"order":5,"speaker":"Ella","text":"Nice. My apartment is downtown too.","translation_fa":"خوبه. آپارتمان من هم مرکز شهره."}],"status":"approved"}},

