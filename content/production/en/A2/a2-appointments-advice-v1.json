    {
      "kind": "dialogue",
      "external_id": "d_a2_appointments_advice_make",
      "data": {
        "lesson_key": "a2-appointments-advice-01",
        "title": "Making an appointment",
        "setting": "clinic phone call",
        "cefr": "A2",
        "topic": "basic-health",
        "characters": [
          "Hana",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Hana",
            "text": "Hi, I'd like to make an appointment with Dr. Lee.",
            "translation_fa": "سلام، می‌خواهم با دکتر لی وقت بگیرم."
          },
          {
            "order": 2,
            "speaker": "Daniel",
            "text": "She's available Thursday afternoon or Friday morning.",
            "translation_fa": "پنجشنبه بعدازظهر یا جمعه صبح وقت دارد."
          },
          {
            "order": 3,
            "speaker": "Hana",
            "text": "Friday morning works better for me.",
            "translation_fa": "جمعه صبح برای من بهتره."
          },
          {
            "order": 4,
            "speaker": "Daniel",
            "text": "How about 9:30?",
            "translation_fa": "ساعت ۹:۳۰ چطوره؟"
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_appointments_advice_change",
      "data": {
        "lesson_key": "a2-appointments-advice-02",
        "title": "Changing an appointment",
        "setting": "clinic phone call",
        "cefr": "A2",
        "topic": "basic-health",
        "characters": [
          "Noor",
          "David"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Noor",
            "text": "I need to reschedule my appointment tomorrow.",
            "translation_fa": "باید وقت فردام رو عوض کنم."
          },
          {
            "order": 2,
            "speaker": "David",
            "text": "No problem. Is next Monday okay?",
            "translation_fa": "مشکلی نیست. دوشنبه بعد خوبه؟"
          },
          {
            "order": 3,
            "speaker": "Noor",
            "text": "Yes. Do I have to come at the same time?",
            "translation_fa": "بله. باید همان ساعت بیام؟"
          },
          {
            "order": 4,
            "speaker": "David",
            "text": "No, we also have an afternoon time available.",
            "translation_fa": "نه، بعدازظهر هم وقت خالی داریم."
          }
        ],
        "status": "validated"
      }
    },
