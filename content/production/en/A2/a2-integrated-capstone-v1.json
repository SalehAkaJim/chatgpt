    {
      "kind": "grammar_point",
      "external_id": "g_a2_integrated_capstone_past_present",
      "data": {
        "lesson_key": "a2-integrated-capstone-01",
        "slug": "a2-integrated-capstone-past-present",
        "title": "Past event + present need",
        "rule_summary": "Connect a completed past event to a present situation using simple linking words.",
        "explanation": {
          "fa": "یک اتفاق تمام‌شده گذشته را با وضعیت فعلی با کلمات ربط ساده وصل می‌کنیم."
        },
        "examples": [
          {
            "en": "The bus was late, so I'm still at the station.",
            "fa": "اتوبوس دیر کرد، پس هنوز ایستگاهم."
          },
          {
            "en": "I lost my key, so I need help.",
            "fa": "کلیدم رو گم کردم، پس کمک لازم دارم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_integrated_capstone_compare_plan",
      "data": {
        "lesson_key": "a2-integrated-capstone-02",
        "slug": "a2-integrated-capstone-compare-plan",
        "title": "Compare choices before a plan",
        "rule_summary": "Use comparatives plus because/but/so to choose between familiar options.",
        "explanation": {
          "fa": "برای انتخاب بین گزینه‌های آشنا از مقایسه همراه because، but یا so استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The train is faster, but the bus is cheaper.",
            "fa": "قطار سریع‌تره ولی اتوبوس ارزون‌تره."
          },
          {
            "en": "This route is easier, so let's take it.",
            "fa": "این مسیر راحت‌تره، پس همین رو بریم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_integrated_capstone_if_backup",
      "data": {
        "lesson_key": "a2-integrated-capstone-04",
        "slug": "a2-integrated-capstone-if-backup",
        "title": "if + could for a backup solution",
        "rule_summary": "Use if for a simple possible problem and could for an alternative solution.",
        "explanation": {
          "fa": "برای یک مشکل احتمالی ساده از if و برای راه‌حل جایگزین از could استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If it's full, we could try the cafe next door.",
            "fa": "اگر پر بود، می‌تونیم کافه کناری رو امتحان کنیم."
          },
          {
            "en": "If we miss the bus, we could take a taxi.",
            "fa": "اگر اتوبوس رو از دست دادیم، می‌تونیم تاکسی بگیریم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_integrated_capstone_arrival",
      "data": {
        "lesson_key": "a2-integrated-capstone-01",
        "title": "Late arrival",
        "setting": "hotel reception",
        "cefr": "A2",
        "topic": "simple-messages",
        "characters": [
          "Maya",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Maya",
            "text": "Hi. My train was delayed, so I'm checking in later than planned.",
            "translation_fa": "سلام. قطارم تأخیر داشت، برای همین دیرتر از برنامه اتاق رو تحویل می‌گیرم."
          },
          {
            "order": 2,
            "speaker": "Daniel",
            "text": "No problem. What's the name on the reservation?",
            "translation_fa": "مشکلی نیست. رزرو به چه نامیه؟"
          },
          {
            "order": 3,
            "speaker": "Maya",
            "text": "Maya Chen.",
            "translation_fa": "مایا چن."
          },
          {
            "order": 4,
            "speaker": "Daniel",
            "text": "I found it. Your room is ready.",
            "translation_fa": "پیداش کردم. اتاقتون آماده‌ست."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_integrated_capstone_city",
      "data": {
        "lesson_key": "a2-integrated-capstone-02",
        "title": "Choosing how to get there",
        "setting": "hotel lobby",
        "cefr": "A2",
        "topic": "simple-messages",
        "characters": [
          "Maya",
          "Leo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Maya",
            "text": "The museum is three miles away. Should we take the bus?",
            "translation_fa": "موزه سه مایل فاصله داره. اتوبوس بگیریم؟"
          },
          {
            "order": 2,
            "speaker": "Leo",
            "text": "The bus is cheaper, but the subway is faster.",
            "translation_fa": "اتوبوس ارزون‌تره، ولی مترو سریع‌تره."
          },
          {
            "order": 3,
            "speaker": "Maya",
            "text": "Let's take the subway, then.",
            "translation_fa": "پس مترو بریم."
          },
          {
            "order": 4,
            "speaker": "Leo",
            "text": "Okay. We need to transfer at Central Station.",
            "translation_fa": "باشه. باید ایستگاه مرکزی خط عوض کنیم."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_integrated_capstone_backup",
      "data": {
        "lesson_key": "a2-integrated-capstone-04",
        "title": "Changing the afternoon plan",
        "setting": "text messages",
        "cefr": "A2",
        "topic": "simple-messages",
        "characters": [
          "Maya",
          "Priya"
        ],
        "turns": [
          {
            "order": 1,
