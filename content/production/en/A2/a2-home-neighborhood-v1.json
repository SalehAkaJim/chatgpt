    {
      "kind": "grammar_point",
      "external_id": "g_a2_too_enough",
      "data": {
        "lesson_key": "a2-home-neighborhood-02",
        "slug": "a2-too-and-enough",
        "title": "too and enough",
        "rule_summary": "Use too + adjective for more than wanted, adjective/adverb + enough for a sufficient degree, and enough + noun for a sufficient amount.",
        "explanation": {
          "fa": "too + صفت یعنی چیزی بیشتر از حد مطلوب است. enough یعنی مقدار کافی؛ مثل quiet enough یا enough space."
        },
        "examples": [
          {
            "en": "The street is too noisy.",
            "fa": "خیابان بیش از حد پرسروصداست."
          },
          {
            "en": "The room is big enough.",
            "fa": "اتاق به اندازه کافی بزرگ است."
          },
          {
            "en": "There isn't enough space.",
            "fa": "فضای کافی نیست."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_there_home",
      "data": {
        "lesson_key": "a2-home-neighborhood-03",
        "slug": "a2-there-is-are-expanded",
        "title": "there is / there are for details",
        "rule_summary": "Use there is/are and their negative forms to describe available or missing places and features.",
        "explanation": {
          "fa": "برای گفتن اینکه چیزی در یک مکان وجود دارد یا ندارد از there is/are و شکل منفی آن استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "There's a park nearby.",
            "fa": "یک پارک همین نزدیکی هست."
          },
          {
            "en": "There aren't any stores on this street.",
            "fa": "در این خیابان هیچ فروشگاهی نیست."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_neighborhood_move",
      "data": {
        "lesson_key": "a2-home-neighborhood-01",
        "title": "A new neighborhood",
        "setting": "office",
        "cefr": "A2",
        "topic": "home",
        "characters": [
          "Claire",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Claire",
            "text": "How do you like your new neighborhood?",
            "translation_fa": "محله جدیدت را دوست داری؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "A lot. It's really convenient.",
            "translation_fa": "خیلی. واقعاً محله راحت و مناسبیه."
          },
          {
            "order": 3,
            "speaker": "Claire",
            "text": "What's nearby?",
            "translation_fa": "چه چیزهایی نزدیکه؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "There's a grocery store, a gym, and two bus stops.",
            "translation_fa": "یک فروشگاه مواد غذایی، یک باشگاه و دو ایستگاه اتوبوس هست."
          },
          {
            "order": 5,
            "speaker": "Claire",
            "text": "That sounds great.",
            "translation_fa": "عالی به نظر میاد."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_apartment_tradeoff",
      "data": {
        "lesson_key": "a2-home-neighborhood-02",
        "title": "The good and the bad",
        "setting": "apartment",
        "cefr": "A2",
        "topic": "home",
        "characters": [
          "Yuki",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Daniel",
            "text": "Do you like the apartment?",
            "translation_fa": "آپارتمان را دوست داری؟"
          },
          {
            "order": 2,
            "speaker": "Yuki",
            "text": "Mostly. The rent is reasonable, and the rooms are nice.",
            "translation_fa": "بیشتر مواقع بله. اجاره منطقیه و اتاق‌ها خوبن."
          },
          {
            "order": 3,
            "speaker": "Daniel",
            "text": "Any problems?",
            "translation_fa": "مشکلی هم داره؟"
          },
          {
            "order": 4,
            "speaker": "Yuki",
            "text": "The street is too noisy at night.",
            "translation_fa": "خیابان شب‌ها بیش از حد پرسروصداست."
          },
          {
            "order": 5,
            "speaker": "Daniel",
            "text": "Yeah, this area gets busy in the evening.",
            "translation_fa": "آره، این منطقه عصرها شلوغ می‌شه."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_apartment_features",
      "data": {
        "lesson_key": "a2-home-neighborhood-03",
        "title": "Looking at an apartment",
        "setting": "apartment viewing",
        "cefr": "A2",
        "topic": "home",
        "characters": [
          "Ravi",
          "Mina"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mina",
            "text": "The living room is nice and bright.",
            "translation_fa": "اتاق نشیمن خوب و روشنه."
          },
          {
            "order": 2,
            "speaker": "Ravi",
            "text": "Yeah, and there's a small balcony.",
            "translation_fa": "آره، و یک بالکن کوچک هم هست."
          },
          {
            "order": 3,
            "speaker": "Mina",
            "text": "Is there an elevator?",
            "translation_fa": "آسانسور هست؟"
          },
          {
            "order": 4,
            "speaker": "Ravi",
            "text": "No, there isn't. The apartment is on the third floor.",
            "translation_fa": "نه، نیست. آپارتمان طبقه سومه."
          },
          {
            "order": 5,
            "speaker": "Mina",
            "text": "Hmm. That's not very convenient.",
            "translation_fa": "هوم. خیلی راحت نیست."
          }
        ],
        "status": "validated"
      }
    },
