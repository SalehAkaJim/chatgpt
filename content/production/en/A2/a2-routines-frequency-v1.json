    {"kind":"grammar_point","external_id":"g_a2_adverb_position","data":{"lesson_key":"a2-routines-frequency-01","slug":"a2-frequency-adverb-position","title":"Where frequency adverbs go","rule_summary":"Frequency adverbs usually come before the main verb but after be.","explanation":{"fa":"قیدهای تکرار معمولاً قبل از فعل اصلی می‌آیند، اما بعد از فعل be قرار می‌گیرند."},"examples":[{"en":"I usually take the bus.","fa":"معمولاً با اتوبوس می‌روم."},{"en":"She's often busy in the morning.","fa":"او صبح‌ها اغلب سرش شلوغ است."}],"cefr":"A2","status":"approved"}},
    {"kind":"grammar_point","external_id":"g_a2_times_frequency","data":{"lesson_key":"a2-routines-frequency-02","slug":"a2-times-per-period","title":"once, twice, three times","rule_summary":"Use once, twice, or a number + times with a time period to say exactly how often something happens.","explanation":{"fa":"برای گفتن تعداد دقیق دفعات از once، twice یا عدد + times همراه با بازه زمانی استفاده می‌کنیم."},"examples":[{"en":"I exercise twice a week.","fa":"هفته‌ای دو بار ورزش می‌کنم."},{"en":"We call them three times a month.","fa":"ماهی سه بار به آن‌ها زنگ می‌زنیم."}],"cefr":"A2","status":"approved"}},

    {"kind":"dialogue","external_id":"d_a2_routine_morning","data":{"lesson_key":"a2-routines-frequency-01","title":"A weekday morning","setting":"office kitchen","cefr":"A2","topic":"daily-routine","characters":["Nora","Adam"],"turns":[{"order":1,"speaker":"Nora","text":"Do you always get here this early?","translation_fa":"همیشه این‌قدر زود می‌رسی اینجا؟"},{"order":2,"speaker":"Adam","text":"Almost always. I start at eight every weekday.","translation_fa":"تقریباً همیشه. هر روز کاری ساعت هشت شروع می‌کنم."},{"order":3,"speaker":"Nora","text":"How do you get to work?","translation_fa":"چطور به محل کار میای؟"},{"order":4,"speaker":"Adam","text":"I usually commute by train. It takes about thirty minutes.","translation_fa":"معمولاً با قطار رفت‌وآمد می‌کنم. حدود سی دقیقه طول می‌کشه."},{"order":5,"speaker":"Nora","text":"That's not bad.","translation_fa":"بد نیست."}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_frequency_free_time","data":{"lesson_key":"a2-routines-frequency-02","title":"Free-time habits","setting":"cafe","cefr":"A2","topic":"daily-routine","characters":["Ivy","Jack"],"turns":[{"order":1,"speaker":"Ivy","text":"How often do you go to the gym?","translation_fa":"هر چند وقت یک بار باشگاه می‌ری؟"},{"order":2,"speaker":"Jack","text":"Usually twice a week. What about you?","translation_fa":"معمولاً هفته‌ای دو بار. تو چطور؟"},{"order":3,"speaker":"Ivy","text":"Hardly ever. I prefer swimming.","translation_fa":"تقریباً هیچ‌وقت. شنا را ترجیح می‌دم."},{"order":4,"speaker":"Jack","text":"How often do you swim?","translation_fa":"هر چند وقت یک بار شنا می‌کنی؟"},{"order":5,"speaker":"Ivy","text":"Once a week, usually on Sunday.","translation_fa":"هفته‌ای یک بار، معمولاً یکشنبه‌ها."}],"status":"approved"}},

