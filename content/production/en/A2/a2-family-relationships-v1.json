    {
      "kind": "grammar_point",
      "external_id": "g_a2_both_family",
      "data": {
        "lesson_key": "a2-family-relationships-01",
        "slug": "a2-both-family",
        "title": "both for two people or things",
        "rule_summary": "Use both when the same statement is true for two people or things.",
        "explanation": {
          "fa": "وقتی یک ویژگی یا وضعیت درباره هر دو نفر یا چیز درست است از both استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "We both work from home.",
            "fa": "هر دوی ما از خانه کار می‌کنیم."
          },
          {
            "en": "Both of my parents are teachers.",
            "fa": "هر دوی والدینم معلم هستند."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_family_comparison",
      "data": {
        "lesson_key": "a2-family-relationships-02",
        "slug": "a2-family-comparisons",
        "title": "Simple family comparisons",
        "rule_summary": "Use comparative adjectives with than to compare two people or things.",
        "explanation": {
          "fa": "برای مقایسه دو نفر یا چیز از صفت تفضیلی و than استفاده می‌کنیم."
