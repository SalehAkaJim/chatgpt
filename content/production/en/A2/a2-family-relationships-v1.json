    {
      "kind": "dialogue",
      "external_id": "d_a2_family_photo",
      "data": {
        "lesson_key": "a2-family-relationships-01",
        "title": "Looking at a family photo",
        "setting": "home",
        "cefr": "A2",
        "topic": "family",
        "characters": [
          "Sofia",
          "Omar"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Omar",
            "text": "Is that your sister?",
            "translation_fa": "اون خواهرت هست؟"
          },
          {
            "order": 2,
            "speaker": "Sofia",
            "text": "Yes. She's three years older than me.",
            "translation_fa": "بله. سه سال از من بزرگ‌تره."
          },
          {
            "order": 3,
            "speaker": "Omar",
            "text": "Do you have any other brothers or sisters?",
            "translation_fa": "برادر یا خواهر دیگه‌ای هم داری؟"
          },
          {
            "order": 4,
            "speaker": "Sofia",
            "text": "No, just one sister. She's married and has a little boy.",
            "translation_fa": "نه، فقط یک خواهر دارم. متأهله و یک پسر کوچیک داره."
          },
          {
            "order": 5,
            "speaker": "Omar",
            "text": "You look a little similar.",
            "translation_fa": "یک کم شبیه هم هستین."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_family_relationship",
      "data": {
        "lesson_key": "a2-family-relationships-02",
        "title": "Talking about siblings",
        "setting": "park",
        "cefr": "A2",
        "topic": "family",
        "characters": [
          "Lina",
          "Ben"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Lina",
            "text": "Are you close to your brother?",
            "translation_fa": "با برادرت صمیمی هستی؟"
          },
          {
            "order": 2,
            "speaker": "Ben",
            "text": "Yeah, we get along really well.",
            "translation_fa": "آره، خیلی خوب با هم کنار می‌آییم."
          },
          {
            "order": 3,
            "speaker": "Lina",
            "text": "Are you similar?",
            "translation_fa": "شبیه هم هستین؟"
          },
          {
            "order": 4,
            "speaker": "Ben",
            "text": "Not really. He's more outgoing, and I'm quieter.",
            "translation_fa": "نه خیلی. او اجتماعی‌تره و من ساکت‌ترم."
          },
          {
            "order": 5,
            "speaker": "Lina",
            "text": "That sounds like me and my sister.",
            "translation_fa": "شبیه من و خواهرمه."
          }
        ],
        "status": "approved"
      }
    },
