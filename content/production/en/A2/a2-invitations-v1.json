    {"kind":"grammar_point","external_id":"g_a2_would_like_invitation","data":{"lesson_key":"a2-invitations-01","slug":"a2-would-you-like-invitations","title":"Would you like to …?","rule_summary":"Use Would you like to + base verb for a friendly, polite invitation.","explanation":{"fa":"برای دعوت دوستانه و مؤدبانه از Would you like to + شکل ساده فعل استفاده می‌کنیم."},"examples":[{"en":"Would you like to come with us?","fa":"دوست داری با ما بیای؟"},{"en":"Would you like to have coffee?","fa":"دوست داری قهوه بخوریم؟"}],"cefr":"A2","status":"approved"}},
    {"kind":"grammar_point","external_id":"g_a2_suggest_alternative","data":{"lesson_key":"a2-invitations-03","slug":"a2-how-about-alternative","title":"Suggest an alternative","rule_summary":"Use How about + noun/time or How about + -ing to offer another option.","explanation":{"fa":"برای پیشنهاد گزینه دیگر از How about + اسم/زمان یا How about + فعل ing استفاده می‌کنیم."},"examples":[{"en":"How about Saturday?","fa":"شنبه چطوره؟"},{"en":"How about meeting at six?","fa":"ساعت شش همدیگه را ببینیم چطوره؟"}],"cefr":"A2","status":"approved"}},

    {"kind":"dialogue","external_id":"d_a2_invitation_dinner","data":{"lesson_key":"a2-invitations-01","title":"Friday dinner","setting":"office","cefr":"A2","topic":"polite-language","characters":["Nina","Omid"],"turns":[{"order":1,"speaker":"Nina","text":"Would you like to have dinner on Friday?","translation_fa":"دوست داری جمعه شام با هم بخوریم؟"},{"order":2,"speaker":"Omid","text":"Sounds good. What time?","translation_fa":"خوبه. چه ساعتی؟"},{"order":3,"speaker":"Nina","text":"How about seven?","translation_fa":"ساعت هفت چطوره؟"},{"order":4,"speaker":"Omid","text":"Perfect. See you then.","translation_fa":"عالیه. پس می‌بینمت."}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_invitation_decline","data":{"lesson_key":"a2-invitations-02","title":"Can't make it","setting":"text conversation","cefr":"A2","topic":"polite-language","characters":["Arman","Ava"],"turns":[{"order":1,"speaker":"Arman","text":"We're going bowling Friday night. Want to come?","translation_fa":"جمعه شب می‌ریم بولینگ. میای؟"},{"order":2,"speaker":"Ava","text":"I'd love to, but I can't make it Friday.","translation_fa":"خیلی دوست دارم، ولی جمعه نمی‌تونم بیام."},{"order":3,"speaker":"Arman","text":"No problem. Maybe another time.","translation_fa":"اشکالی نداره. شاید یک وقت دیگه."},{"order":4,"speaker":"Ava","text":"Definitely.","translation_fa":"حتماً."}],"status":"approved"}},
    {"kind":"dialogue","external_id":"d_a2_invitation_change","data":{"lesson_key":"a2-invitations-03","title":"Changing the day","setting":"phone call","cefr":"A2","topic":"polite-language","characters":["Jae","Rita"],"turns":[{"order":1,"speaker":"Jae","text":"Saturday is difficult for me now.","translation_fa":"شنبه الان برای من سخته."},{"order":2,"speaker":"Rita","text":"Okay. How about Sunday afternoon instead?","translation_fa":"باشه. یکشنبه بعدازظهر به جاش چطوره؟"},{"order":3,"speaker":"Jae","text":"Sunday works for me.","translation_fa":"یکشنبه برای من مناسبه."},{"order":4,"speaker":"Rita","text":"Great. Let's meet at three.","translation_fa":"عالی. ساعت سه همدیگه رو ببینیم."}],"status":"approved"}},

