    {
      "kind": "dialogue",
      "external_id": "d_a2_weekend_monday",
      "data": {
        "lesson_key": "a2-last-weekend-01",
        "title": "Monday morning",
        "setting": "office",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Kate",
          "Owen"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Kate",
            "text": "How was your weekend?",
            "translation_fa": "آخر هفته‌ات چطور بود؟"
          },
          {
            "order": 2,
            "speaker": "Owen",
            "text": "Good. I visited my parents on Saturday.",
            "translation_fa": "خوب بود. شنبه به دیدن پدر و مادرم رفتم."
          },
          {
            "order": 3,
            "speaker": "Kate",
            "text": "Nice. Did you stay there all day?",
            "translation_fa": "خوبه. تمام روز آنجا ماندی؟"
          },
          {
            "order": 4,
            "speaker": "Owen",
            "text": "Yeah, and we had dinner together.",
            "translation_fa": "آره، و با هم شام خوردیم."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_weekend_friends",
      "data": {
        "lesson_key": "a2-last-weekend-02",
        "title": "A busy Saturday",
        "setting": "cafe",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Mei",
          "Liam"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mei",
            "text": "What did you do on Saturday?",
            "translation_fa": "شنبه چه کار کردی؟"
          },
          {
            "order": 2,
            "speaker": "Liam",
            "text": "I met a friend downtown, and then we went out for dinner.",
            "translation_fa": "مرکز شهر یک دوستم را دیدم و بعد برای شام بیرون رفتیم."
          },
          {
            "order": 3,
            "speaker": "Mei",
            "text": "Where did you go?",
            "translation_fa": "کجا رفتین؟"
          },
          {
            "order": 4,
            "speaker": "Liam",
            "text": "A little Italian place near the station.",
            "translation_fa": "یک رستوران ایتالیایی کوچک نزدیک ایستگاه."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_weekend_movie",
      "data": {
        "lesson_key": "a2-last-weekend-03",
        "title": "Talking about a movie",
        "setting": "classroom",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Rosa",
          "Paul"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Rosa",
            "text": "Did you see the new movie this weekend?",
            "translation_fa": "این آخر هفته فیلم جدید را دیدی؟"
          },
          {
            "order": 2,
            "speaker": "Paul",
            "text": "Yes, I saw it on Sunday.",
            "translation_fa": "بله، یکشنبه دیدمش."
          },
          {
            "order": 3,
            "speaker": "Rosa",
            "text": "Did you like it?",
            "translation_fa": "دوستش داشتی؟"
          },
          {
            "order": 4,
            "speaker": "Paul",
            "text": "Yeah, it was really funny.",
            "translation_fa": "آره، واقعاً خنده‌دار بود."
          }
        ],
        "status": "validated"
      }
    },
