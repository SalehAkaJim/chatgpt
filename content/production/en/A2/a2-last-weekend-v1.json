    {
      "kind": "grammar_point",
      "external_id": "g_a2_regular_past",
      "data": {
        "lesson_key": "a2-last-weekend-01",
        "slug": "a2-regular-past-ed",
        "title": "Regular past with -ed",
        "rule_summary": "Many regular verbs form the past with -ed, with spelling changes in some verbs.",
        "explanation": {
          "fa": "بسیاری از فعل‌های باقاعده در گذشته با -ed ساخته می‌شوند؛ گاهی شکل نوشتن فعل کمی تغییر می‌کند."
        },
        "examples": [
          {
            "en": "visit → visited",
            "fa": "دیدن → دید"
          },
          {
            "en": "stay → stayed",
            "fa": "ماندن → ماند"
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_irregular_past",
      "data": {
        "lesson_key": "a2-last-weekend-02",
        "slug": "a2-common-irregular-past",
        "title": "Common irregular past forms",
        "rule_summary": "Some high-frequency verbs have irregular past forms that need to be learned as whole forms.",
        "explanation": {
          "fa": "بعضی فعل‌های پرکاربرد شکل گذشته بی‌قاعده دارند و باید شکل گذشته آن‌ها را جدا یاد گرفت."
        },
        "examples": [
          {
            "en": "go → went",
            "fa": "رفتن → رفت"
          },
          {
            "en": "meet → met",
            "fa": "ملاقات کردن → ملاقات کرد"
          },
          {
            "en": "see → saw",
            "fa": "دیدن → دید"
          },
          {
