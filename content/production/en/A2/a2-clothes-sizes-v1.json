      "data": {
        "lesson_key": "a2-clothes-sizes-01",
        "slug": "a2-too-adjective-clothing",
        "title": "too + adjective for fit problems",
        "rule_summary": "Use too + adjective when clothing has more of a quality than you want, such as too tight or too loose.",
        "explanation": {
          "fa": "برای گفتن اینکه یک لباس بیش از حد تنگ، گشاد یا بلند است از too + صفت استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "These shoes are too small.",
            "fa": "این کفش‌ها خیلی کوچکند."
          },
          {
