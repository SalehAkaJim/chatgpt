    {
      "kind": "dialogue",
      "external_id": "d_a2_travel_problems_connection",
      "data": {
        "lesson_key": "a2-travel-problems-01",
        "title": "A missed connection",
        "setting": "airport service desk",
        "cefr": "A2",
        "topic": "transport",
        "characters": [
          "Dina",
          "Adam"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Dina",
            "text": "My first flight was late, and I missed my connection.",
            "translation_fa": "پرواز اولم دیر بود و به پرواز بعدی نرسیدم."
          },
          {
            "order": 2,
            "speaker": "Adam",
            "text": "Let me check the next available flight.",
            "translation_fa": "بذارید پرواز بعدی موجود رو چک کنم."
          },
          {
            "order": 3,
            "speaker": "Dina",
            "text": "Do I have to pay for a new ticket?",
            "translation_fa": "باید برای بلیت جدید پول بدم؟"
          },
          {
            "order": 4,
            "speaker": "Adam",
            "text": "No, we'll move you to the next flight.",
            "translation_fa": "نه، شما را به پرواز بعدی منتقل می‌کنیم."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_travel_problems_lost_bag",
      "data": {
        "lesson_key": "a2-travel-problems-02",
        "title": "A lost bag",
        "setting": "bus terminal",
        "cefr": "A2",
        "topic": "transport",
        "characters": [
          "Roya",
          "Sam"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Roya",
            "text": "I think I left my bag on bus 24.",
            "translation_fa": "فکر کنم کیفم رو اتوبوس ۲۴ جا گذاشتم."
          },
          {
            "order": 2,
            "speaker": "Sam",
            "text": "When did you get off the bus?",
            "translation_fa": "کی از اتوبوس پیاده شدی؟"
          },
          {
            "order": 3,
            "speaker": "Roya",
            "text": "About twenty minutes ago.",
            "translation_fa": "حدود بیست دقیقه پیش."
          },
          {
            "order": 4,
            "speaker": "Sam",
            "text": "You should report it at the help desk.",
            "translation_fa": "بهتره در بخش راهنمایی گزارشش بدی."
          }
        ],
        "status": "validated"
      }
