    {
      "kind": "dialogue",
      "external_id": "d_a2_abilities_skills_skills",
      "data": {
        "lesson_key": "a2-abilities-skills-01",
        "title": "Talking about skills",
        "setting": "community center",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Sora",
          "Jack"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Sora",
            "text": "Can you fix a bike?",
            "translation_fa": "می‌تونی دوچرخه تعمیر کنی؟"
          },
          {
            "order": 2,
            "speaker": "Jack",
            "text": "A little. I can change a tire, but that's about it.",
            "translation_fa": "یه کم. می‌تونم لاستیک عوض کنم، ولی تقریباً همین."
          },
          {
            "order": 3,
            "speaker": "Sora",
            "text": "That's more than I can do.",
            "translation_fa": "همین هم بیشتر از چیزیه که من بلدم."
          },
          {
            "order": 4,
            "speaker": "Jack",
            "text": "I learned from my dad.",
            "translation_fa": "از پدرم یاد گرفتم."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_abilities_skills_past",
      "data": {
        "lesson_key": "a2-abilities-skills-02",
        "title": "Skills then and now",
        "setting": "office",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "Kate",
          "Jae"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Kate",
            "text": "Could you use spreadsheets before this job?",
            "translation_fa": "قبل از این کار بلد بودی با صفحه‌گسترده کار کنی؟"
          },
          {
            "order": 2,
            "speaker": "Jae",
            "text": "Not very well.",
            "translation_fa": "نه خیلی خوب."
          },
          {
            "order": 3,
            "speaker": "Kate",
            "text": "You're much faster now.",
            "translation_fa": "الان خیلی سریع‌تر شدی."
          },
          {
            "order": 4,
            "speaker": "Jae",
            "text": "I've practiced a lot.",
            "translation_fa": "خیلی تمرین کردم."
          }
        ],
        "status": "approved"
      }
