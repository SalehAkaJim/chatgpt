      "data": {
        "lesson_key": "a2-abilities-skills-01",
        "slug": "a2-abilities-skills-can-could",
        "title": "can and could for ability",
        "rule_summary": "Use can for present ability and could for general ability in the past.",
        "explanation": {
          "fa": "برای توانایی حال از can و برای توانایی کلی در گذشته از could استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I can drive.",
            "fa": "می‌تونم رانندگی کنم."
          },
          {
            "en": "I could read when I was five.",
            "fa": "وقتی پنج سالم بود می‌تونستم بخونم."
          }
