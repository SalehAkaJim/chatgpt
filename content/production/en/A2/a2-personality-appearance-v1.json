    {
      "kind": "dialogue",
      "external_id": "d_a2_personality_appearance_manager",
      "data": {
        "lesson_key": "a2-personality-appearance-01",
        "title": "The new manager",
        "setting": "office kitchen",
        "cefr": "A2",
        "topic": "people",
        "characters": [
          "Claire",
          "Jonas"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Claire",
            "text": "Have you met our new manager?",
            "translation_fa": "مدیر جدیدمون رو دیدی؟"
          },
          {
            "order": 2,
            "speaker": "Jonas",
            "text": "Not yet. What does she look like?",
            "translation_fa": "هنوز نه. چه شکلیه؟"
          },
          {
            "order": 3,
            "speaker": "Claire",
            "text": "She's tall, with curly dark hair.",
            "translation_fa": "قدبلنده و موهای تیره و فر داره."
          },
          {
            "order": 4,
            "speaker": "Jonas",
            "text": "What's she like?",
            "translation_fa": "اخلاقش چطوره؟"
          },
          {
            "order": 5,
            "speaker": "Claire",
            "text": "Very friendly and patient.",
            "translation_fa": "خیلی خوش‌برخورد و صبوره."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_personality_appearance_siblings",
      "data": {
        "lesson_key": "a2-personality-appearance-03",
        "title": "Comparing siblings",
        "setting": "family dinner",
        "cefr": "A2",
        "topic": "people",
        "characters": [
          "Lena",
          "Lucas"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Lena",
            "text": "You and your brother look very different.",
            "translation_fa": "تو و برادرت خیلی متفاوت به نظر می‌رسید."
          },
          {
            "order": 2,
            "speaker": "Lucas",
            "text": "Yeah. He's taller and has a beard.",
            "translation_fa": "آره. اون قدبلندتره و ریش داره."
          },
          {
            "order": 3,
            "speaker": "Lena",
            "text": "Are you similar in personality?",
            "translation_fa": "از نظر شخصیت شبیهید؟"
          },
          {
            "order": 4,
            "speaker": "Lucas",
            "text": "A little. I'm quieter, but we're both friendly.",
            "translation_fa": "یه کم. من کم‌حرف‌ترم، ولی هر دومون خوش‌برخوردیم."
          }
        ],
        "status": "approved"
      }
