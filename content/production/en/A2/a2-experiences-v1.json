    {
      "kind": "grammar_point",
      "external_id": "g_a2_experiences_present_perfect",
      "data": {
        "lesson_key": "a2-experiences-01",
        "slug": "a2-experiences-present-perfect",
        "title": "Present perfect for life experience",
        "rule_summary": "Use have/has + past participle to ask or state whether an experience has happened at any time up to now.",
        "explanation": {
          "fa": "برای پرسیدن یا گفتن تجربه‌های زندگی تا زمان حال از have/has + قسمت سوم فعل استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Have you ever seen snow?",
            "fa": "تا حالا برف دیدی؟"
          },
          {
            "en": "I've never flown alone.",
            "fa": "هیچ‌وقت تنها پرواز نکردم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_a2_experiences_past_followup",
      "data": {
        "lesson_key": "a2-experiences-02",
        "slug": "a2-experiences-past-followup",
        "title": "Past simple for details",
        "rule_summary": "After mentioning an experience, use past simple to ask or give details about a finished time.",
        "explanation": {
          "fa": "بعد از اشاره به تجربه، برای جزئیات مربوط به زمان تمام‌شده از گذشته ساده استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "When did you go?",
            "fa": "کی رفتی؟"
          },
          {
            "en": "I went in 2024.",
            "fa": "سال ۲۰۲۴ رفتم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
    },
