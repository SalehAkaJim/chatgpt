    {
      "kind": "grammar_point",
      "external_id": "g_a2_going_to_intention",
      "data": {
        "lesson_key": "a2-going-to-plans-01",
        "slug": "a2-going-to-intentions",
        "title": "be going to for intentions",
        "rule_summary": "Use be going to + base verb for intentions and plans you have already decided on.",
        "explanation": {
          "fa": "برای تصمیم‌ها و قصدهایی که از قبل گرفته‌ایم از be going to + شکل ساده فعل استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'm going to study tonight.",
            "fa": "امشب می‌خوام درس بخونم."
          },
          {
            "en": "We're going to visit them next week.",
            "fa": "هفته آینده می‌خوایم به دیدنشان برویم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
      }
