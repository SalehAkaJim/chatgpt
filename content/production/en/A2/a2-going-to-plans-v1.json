    {
      "kind": "grammar_point",
      "external_id": "g_a2_probability_words",
      "data": {
        "lesson_key": "a2-going-to-plans-02",
        "slug": "a2-probably-maybe",
        "title": "probably and maybe",
        "rule_summary": "Use probably for a likely possibility and maybe for a less certain possibility.",
        "explanation": {
          "fa": "probably برای چیزی استفاده می‌شود که احتمال آن بیشتر است؛ maybe یعنی شاید و عدم قطعیت بیشتری دارد."
        },
        "examples": [
          {
            "en": "I'll probably go.",
            "fa": "احتمالاً می‌رم."
          },
          {
            "en": "Maybe I'll go.",
            "fa": "شاید برم."
          }
        ],
        "cefr": "A2",
        "status": "approved"
