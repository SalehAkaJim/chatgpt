    {
      "kind": "dialogue",
      "external_id": "d_a2_recipe_soup",
      "data": {
        "lesson_key": "a2-cooking-recipes-01",
        "title": "Making soup",
        "setting": "kitchen",
        "cefr": "A2",
        "topic": "food-basics",
        "characters": [
          "Noura",
          "Alex"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Noura",
            "text": "What do I do first?",
            "translation_fa": "اول باید چی کار کنم؟"
          },
          {
            "order": 2,
            "speaker": "Alex",
            "text": "Chop the onion and carrots into small pieces.",
            "translation_fa": "پیاز و هویج را به تکه‌های کوچک خرد کن."
          },
          {
            "order": 3,
            "speaker": "Noura",
            "text": "Then what?",
            "translation_fa": "بعدش چی؟"
          },
          {
            "order": 4,
            "speaker": "Alex",
            "text": "Add them to the pot with a little oil.",
            "translation_fa": "با کمی روغن به قابلمه اضافه‌شون کن."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_recipe_pasta",
      "data": {
        "lesson_key": "a2-cooking-recipes-02",
        "title": "Simple pasta",
        "setting": "kitchen",
        "cefr": "A2",
        "topic": "food-basics",
        "characters": [
          "Yuki",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Yuki",
            "text": "Is the water ready?",
            "translation_fa": "آب آماده‌ست؟"
          },
          {
            "order": 2,
            "speaker": "Daniel",
            "text": "Yes, it's boiling. Put the pasta in now.",
            "translation_fa": "بله، داره می‌جوشه. الان پاستا رو بریز داخلش."
          },
          {
            "order": 3,
            "speaker": "Yuki",
            "text": "How long should I cook it?",
            "translation_fa": "چقدر باید بپزمش؟"
          },
          {
            "order": 4,
            "speaker": "Daniel",
            "text": "About ten minutes. Then mix it with the sauce.",
            "translation_fa": "حدود ده دقیقه. بعد با سس مخلوطش کن."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_recipe_heat",
      "data": {
        "lesson_key": "a2-cooking-recipes-03",
        "title": "Too much heat",
        "setting": "kitchen",
        "cefr": "A2",
        "topic": "food-basics",
        "characters": [
          "Lina",
          "Ben"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Lina",
            "text": "The sauce is cooking too fast.",
            "translation_fa": "سس خیلی سریع داره می‌پزه."
          },
          {
            "order": 2,
            "speaker": "Ben",
            "text": "Turn the heat down. Cook it on low heat.",
            "translation_fa": "حرارت رو کم کن. با حرارت کم بپزش."
          },
          {
            "order": 3,
            "speaker": "Lina",
            "text": "Should I add more salt?",
            "translation_fa": "نمک بیشتری اضافه کنم؟"
          },
          {
            "order": 4,
            "speaker": "Ben",
            "text": "Taste it first, then decide.",
            "translation_fa": "اول مزه‌اش کن، بعد تصمیم بگیر."
          }
        ],
        "status": "approved"
      }
    },
