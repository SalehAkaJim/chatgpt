    {
      "kind": "dialogue",
      "external_id": "d_a2_study_habits_exam",
      "data": {
        "lesson_key": "a2-study-habits-02",
        "title": "Preparing for an exam",
        "setting": "library",
        "cefr": "A2",
        "topic": "school-study",
        "characters": [
          "Noura",
          "Luca"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Noura",
            "text": "I have an exam on Monday, but I can't concentrate.",
            "translation_fa": "دوشنبه امتحان دارم ولی نمی‌تونم تمرکز کنم."
          },
          {
            "order": 2,
            "speaker": "Luca",
            "text": "You should put your phone away for thirty minutes.",
            "translation_fa": "بهتره سی دقیقه گوشیت رو کنار بذاری."
          },
          {
            "order": 3,
            "speaker": "Noura",
            "text": "Good idea. I also need to review my notes.",
            "translation_fa": "فکر خوبیه. باید یادداشت‌هام رو هم مرور کنم."
          },
          {
            "order": 4,
            "speaker": "Luca",
            "text": "Start with the hardest chapter.",
            "translation_fa": "از سخت‌ترین فصل شروع کن."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_study_habits_speaking",
      "data": {
        "lesson_key": "a2-study-habits-03",
        "title": "Improving speaking",
        "setting": "classroom",
        "cefr": "A2",
        "topic": "school-study",
        "characters": [
          "Ari",
          "Paul"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ari",
            "text": "How can I improve my speaking?",
            "translation_fa": "چطور می‌تونم مکالمه‌ام رو بهتر کنم؟"
          },
          {
            "order": 2,
            "speaker": "Paul",
            "text": "Try to practice a little every day.",
            "translation_fa": "سعی کن هر روز کمی تمرین کنی."
          },
          {
            "order": 3,
            "speaker": "Ari",
            "text": "Should I record myself?",
            "translation_fa": "بهتره صدای خودم رو ضبط کنم؟"
          },
          {
            "order": 4,
            "speaker": "Paul",
            "text": "Yes. That can help a lot.",
            "translation_fa": "بله. خیلی می‌تونه کمک کنه."
          }
        ],
        "status": "approved"
