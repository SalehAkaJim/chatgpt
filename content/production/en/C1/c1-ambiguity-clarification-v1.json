      "data": {
        "lesson_key": "c1-ambiguity-clarification-03",
        "text": {
          "en": "We can probably resolve most of this by agreeing on the definition before debating the conclusion."
        },
        "translations": {
          "fa": "احتمالاً می‌تونیم بیشتر این اختلاف رو با توافق روی تعریف، قبل از بحث روی نتیجه، حل کنیم."
        },
        "intent": "propose_resolution",
        "concept_refs": [
