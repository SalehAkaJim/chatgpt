    {
      "kind": "grammar_point",
      "external_id": "g_c1_ambiguity_clarification_advanced_hedging",
      "data": {
        "lesson_key": "c1-ambiguity-clarification-01",
        "slug": "c1-ambiguity-clarification-advanced-hedging",
        "title": "Advanced hedging and calibration",
        "rule_summary": "Calibrate certainty with expressions such as arguably, broadly speaking, tends to, appears to, and cannot entirely be ruled out.",
        "explanation": {
          "fa": "در C1 میزان قطعیت را با عبارت‌هایی مثل arguably، broadly speaking، tends to، appears to و cannot entirely be ruled out دقیق تنظیم می‌کنیم."
        },
        "examples": [
          {
            "en": "The change appears to have improved access, although the evidence is still limited.",
            "fa": "به نظر می‌رسد این تغییر دسترسی را بهتر کرده، هرچند شواهد هنوز محدود است."
          },
          {
            "en": "That explanation cannot entirely be ruled out.",
            "fa": "نمی‌توان آن توضیح را کاملاً منتفی دانست."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_ambiguity_clarification_reformulation",
      "data": {
        "lesson_key": "c1-ambiguity-clarification-02",
        "slug": "c1-ambiguity-clarification-reformulation",
        "title": "Reformulation and precision",
        "rule_summary": "Use in other words, more precisely, what I mean is, or rather to refine a statement when the first wording is incomplete or misleading.",
        "explanation": {
          "fa": "با in other words، more precisely، what I mean is و or rather جمله را اصلاح یا دقیق‌تر می‌کنیم."
        },
        "examples": [
          {
            "en": "The system is inefficient—or rather, inefficient under peak demand.",
            "fa": "سیستم ناکارآمد است؛ یا دقیق‌تر بگویم، در اوج تقاضا ناکارآمد است."
          },
          {
            "en": "What I mean is that the risk is concentrated, not universal.",
            "fa": "منظورم این است که ریسک متمرکز است، نه همگانی."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_ambiguity_clarification_complex_prepositions",
      "data": {
        "lesson_key": "c1-ambiguity-clarification-03",
        "slug": "c1-ambiguity-clarification-complex-prepositions",
        "title": "Complex prepositional phrases",
        "rule_summary": "Use in light of, with regard to, in the absence of, by virtue of, and at the expense of to express precise logical relations.",
        "explanation": {
          "fa": "برای بیان روابط منطقی دقیق از in light of، with regard to، in the absence of، by virtue of و at the expense of استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "In light of the new evidence, the recommendation should be revised.",
            "fa": "با توجه به شواهد جدید، توصیه باید بازبینی شود."
          },
          {
            "en": "Efficiency should not come at the expense of accessibility.",
            "fa": "کارایی نباید به قیمت دسترسی‌پذیری تمام شود."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_c1_ambiguity_clarification_scene_1",
      "data": {
        "lesson_key": "c1-ambiguity-clarification-01",
        "title": "Ambiguity & Clarification: part 1",
        "setting": "project review",
        "cefr": "C1",
        "topic": "questions",
        "characters": [
          "Ivy",
          "David"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ivy",
            "text": "How would you put that more precisely?",
            "translation_fa": "چطور اون نکته رو دقیق‌تر بیان می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "David",
            "text": "The wording is ambiguous enough that two reasonable people could walk away with different interpretations.",
            "translation_fa": "عبارت اون‌قدر مبهمه که دو آدم منطقی می‌تونن دو برداشت متفاوت ازش داشته باشن."
          },
          {
            "order": 3,
            "speaker": "Ivy",
            "text": "What distinction matters most here?",
            "translation_fa": "مهم‌ترین تمایز اینجا چیه؟"
          },
