    {
      "kind": "utterance",
      "external_id": "u_c1_ambiguity_clarification_explicit",
      "data": {
        "lesson_key": "c1-ambiguity-clarification-03",
        "text": {
          "en": "Could we make the criterion explicit rather than relying on everyone to interpret 'high quality' in the same way?"
        },
        "translations": {
          "fa": "می‌شه معیار رو صریح کنیم به‌جای اینکه فرض کنیم همه «کیفیت بالا» رو یک‌جور تفسیر می‌کنن؟"
        },
        "intent": "request_explicitness",
        "concept_refs": [
          "c1_ambiguity_clarification_explicit",
