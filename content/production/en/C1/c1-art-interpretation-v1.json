    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_reading",
      "data": {
        "lesson_key": "c1-art-interpretation-01",
        "text": {
          "en": "My reading of the film is shaped less by the plot than by the repeated images of doors, borders, and interrupted journeys."
        },
        "translations": {
          "fa": "برداشت من از فیلم کمتر از داستان و بیشتر از تصویرهای تکراری در، مرز و سفرهای قطع‌شده میاد."
        },
        "intent": "offer_interpretation",
        "concept_refs": [
          "c1_art_interpretation_reading",
          "c1_art_interpretation_symbolism"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_ambiguous",
      "data": {
        "lesson_key": "c1-art-interpretation-01",
        "text": {
          "en": "The ending is deliberately ambiguous enough to support several interpretations without making every interpretation equally convincing."
        },
        "translations": {
          "fa": "پایان عمداً اون‌قدر چندپهلوئه که چند تفسیر رو ممکن می‌کنه، بدون اینکه همه تفسیرها به یک اندازه قانع‌کننده باشن."
        },
        "intent": "analyze_ambiguity",
        "concept_refs": [
          "c1_art_interpretation_ambiguous",
          "c1_art_interpretation_interpretation"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_composition",
      "data": {
        "lesson_key": "c1-art-interpretation-02",
        "text": {
          "en": "The composition draws attention away from the central figure, which makes the empty space feel unusually important."
        },
        "translations": {
          "fa": "ترکیب‌بندی توجه رو از شخصیت مرکزی دور می‌کنه و باعث می‌شه فضای خالی به شکل غیرعادی مهم بشه."
        },
        "intent": "analyze_composition",
        "concept_refs": [
          "c1_art_interpretation_composition",
          "c1_art_interpretation_evoke"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_context",
      "data": {
        "lesson_key": "c1-art-interpretation-02",
        "text": {
          "en": "Knowing the historical context changes the significance of the image, but the work still communicates something without that knowledge."
        },
        "translations": {
          "fa": "دانستن زمینه تاریخی اهمیت تصویر رو عوض می‌کنه، ولی اثر بدون اون دانش هم چیزی منتقل می‌کنه."
        },
        "intent": "use_context",
        "concept_refs": [
          "c1_art_interpretation_context",
          "c1_art_interpretation_interpretation"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_intent",
      "data": {
        "lesson_key": "c1-art-interpretation-03",
        "text": {
          "en": "The artist's stated intent is relevant, but I would not treat it as the only legitimate guide to meaning."
        },
        "translations": {
          "fa": "نیت اعلام‌شده هنرمند مهمه، ولی اون رو تنها راهنمای معتبر معنا نمی‌دونم."
        },
        "intent": "weigh_artist_intent",
        "concept_refs": [
          "c1_art_interpretation_intent",
          "c1_art_interpretation_reading"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_symbol",
      "data": {
        "lesson_key": "c1-art-interpretation-03",
        "text": {
          "en": "The symbolism works partly because the object is ordinary enough to carry several associations at once."
        },
        "translations": {
          "fa": "نمادپردازی تا حدی جواب می‌ده چون شیء اون‌قدر عادیه که چند تداعی رو هم‌زمان حمل کنه."
        },
        "intent": "analyze_symbolism",
        "concept_refs": [
          "c1_art_interpretation_symbolism",
          "c1_art_interpretation_ambiguous"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_evoke",
      "data": {
        "lesson_key": "c1-art-interpretation-03",
        "text": {
          "en": "For me, the final scene evokes unease rather than sadness, although I can see why another viewer might read it differently."
        },
        "translations": {
          "fa": "برای من صحنه آخر بیشتر اضطراب ایجاد می‌کنه تا غم، هرچند می‌فهمم چرا بیننده دیگه می‌تونه متفاوت برداشت کنه."
        },
        "intent": "describe_response",
        "concept_refs": [
          "c1_art_interpretation_evoke",
          "c1_art_interpretation_reading"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_art_interpretation_close",
      "data": {
        "lesson_key": "c1-art-interpretation-03",
        "text": {
          "en": "A strong interpretation should remain accountable to details in the work even when meaning is not fixed."
        },
        "translations": {
          "fa": "تفسیر قوی حتی وقتی معنا ثابت نیست باید همچنان به جزئیات خود اثر پاسخ‌گو بمونه."
        },
        "intent": "justify_interpretation",
        "concept_refs": [
          "c1_art_interpretation_interpretation",
          "c1_art_interpretation_context"
        ],
        "cefr": "C1",
        "topic": "hobbies",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_art_interpretation_advanced_hedging",
      "data": {
        "lesson_key": "c1-art-interpretation-01",
        "slug": "c1-art-interpretation-advanced-hedging",
        "title": "Advanced hedging and calibration",
        "rule_summary": "Calibrate certainty with expressions such as arguably, broadly speaking, tends to, appears to, and cannot entirely be ruled out.",
        "explanation": {
          "fa": "در C1 میزان قطعیت را با عبارت‌هایی مثل arguably، broadly speaking، tends to، appears to و cannot entirely be ruled out دقیق تنظیم می‌کنیم."
        },
        "examples": [
          {
            "en": "The change appears to have improved access, although the evidence is still limited.",
            "fa": "به نظر می‌رسد این تغییر دسترسی را بهتر کرده، هرچند شواهد هنوز محدود است."
          },
          {
            "en": "That explanation cannot entirely be ruled out.",
            "fa": "نمی‌توان آن توضیح را کاملاً منتفی دانست."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_art_interpretation_cleft_sentences",
      "data": {
        "lesson_key": "c1-art-interpretation-02",
        "slug": "c1-art-interpretation-cleft-sentences",
        "title": "Cleft sentences for focus",
        "rule_summary": "Use what-clauses and it-clefts to place deliberate emphasis on the most important part of a message.",
        "explanation": {
          "fa": "با what-clause و it-cleft بخش مهم پیام را برجسته می‌کنیم."
        },
        "examples": [
          {
            "en": "What concerns me most is the lack of independent oversight.",
            "fa": "چیزی که بیشتر نگرانم می‌کند نبود نظارت مستقل است."
          },
          {
            "en": "It was the timing, rather than the decision itself, that caused the problem.",
            "fa": "زمان‌بندی بود، نه خود تصمیم، که مشکل را ایجاد کرد."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_art_interpretation_concession_rebuttal",
      "data": {
        "lesson_key": "c1-art-interpretation-03",
        "slug": "c1-art-interpretation-concession-rebuttal",
        "title": "Concession followed by rebuttal",
        "rule_summary": "Acknowledge a reasonable opposing point before limiting it or presenting a stronger counterargument.",
        "explanation": {
          "fa": "ابتدا یک نکته منطقی از طرف مقابل را می‌پذیریم و سپس دامنه آن را محدود می‌کنیم یا پاسخ قوی‌تری می‌دهیم."
        },
        "examples": [
          {
            "en": "Granted, the process is faster; that does not necessarily make it fairer.",
            "fa": "درست است که روند سریع‌تر است؛ اما لزوماً عادلانه‌تر نیست."
          },
          {
            "en": "While that concern is valid, it overlooks the cost of doing nothing.",
            "fa": "با اینکه آن نگرانی معتبر است، هزینه هیچ کاری نکردن را نادیده می‌گیرد."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_c1_art_interpretation_scene_1",
      "data": {
        "lesson_key": "c1-art-interpretation-01",
        "title": "Art & Interpretation: part 1",
        "setting": "podcast planning call",
        "cefr": "C1",
        "topic": "hobbies",
        "characters": [
          "Ivy",
          "David"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ivy",
            "text": "Where do you think the strongest part of the case is?",
            "translation_fa": "فکر می‌کنی قوی‌ترین بخش استدلال کجاست؟"
          },
          {
            "order": 2,
            "speaker": "David",
            "text": "My reading of the film is shaped less by the plot than by the repeated images of doors, borders, and interrupted journeys.",
            "translation_fa": "برداشت من از فیلم کمتر از داستان و بیشتر از تصویرهای تکراری در، مرز و سفرهای قطع‌شده میاد."
          },
          {
            "order": 3,
            "speaker": "Ivy",
            "text": "And where would you qualify it?",
            "translation_fa": "و کجاش رو با احتیاط یا قید بیشتری بیان می‌کردی؟"
          },
          {
            "order": 4,
            "speaker": "David",
            "text": "The ending is deliberately ambiguous enough to support several interpretations without making every interpretation equally convincing.",
