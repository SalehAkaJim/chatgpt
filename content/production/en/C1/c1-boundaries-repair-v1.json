    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_boundary",
      "data": {
        "lesson_key": "c1-boundaries-repair-01",
        "text": {
          "en": "A boundary is clearer when it describes what you will do, not only what you want the other person to stop doing."
        },
        "translations": {
          "fa": "مرز وقتی روشن‌تره که بگه خودت چه کاری می‌کنی، نه فقط اینکه طرف مقابل چه کاری رو متوقف کنه."
        },
        "intent": "state_boundary",
        "concept_refs": [
          "c1_boundaries_repair_boundary"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_breach",
      "data": {
        "lesson_key": "c1-boundaries-repair-01",
        "text": {
          "en": "The breach of trust was not just the mistake itself; it was the decision to hide it after being asked directly."
        },
        "translations": {
          "fa": "نقض اعتماد فقط خود اشتباه نبود؛ تصمیم به پنهان کردنش بعد از سؤال مستقیم بود."
        },
        "intent": "identify_trust_breach",
        "concept_refs": [
          "c1_boundaries_repair_breach",
          "c1_boundaries_repair_trust"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_repair",
      "data": {
        "lesson_key": "c1-boundaries-repair-02",
        "text": {
          "en": "Repair requires more than an apology if the behavior that caused the problem is likely to recur."
        },
        "translations": {
          "fa": "اگر رفتاری که مشکل ساخته احتمالاً تکرار می‌شه، ترمیم بیشتر از یک عذرخواهی می‌خواد."
        },
        "intent": "define_repair",
        "concept_refs": [
          "c1_boundaries_repair_repair",
          "c1_boundaries_repair_accountability"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_account",
      "data": {
        "lesson_key": "c1-boundaries-repair-02",
        "text": {
          "en": "Taking accountability means naming your part accurately without turning the conversation into self-punishment."
        },
        "translations": {
          "fa": "پاسخ‌گویی یعنی سهم خودت رو دقیق نام ببری بدون اینکه گفتگو رو تبدیل به خودسرزنشی کنی."
        },
        "intent": "take_accountability",
        "concept_refs": [
          "c1_boundaries_repair_accountability",
          "c1_boundaries_repair_repair"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_resent",
      "data": {
        "lesson_key": "c1-boundaries-repair-03",
        "text": {
          "en": "Unspoken resentment can make a minor disagreement carry the weight of several older ones."
        },
        "translations": {
          "fa": "دلخوری ناگفته می‌تونه باعث بشه یک اختلاف کوچک وزن چند اختلاف قدیمی رو هم حمل کنه."
        },
        "intent": "identify_accumulated_resentment",
        "concept_refs": [
          "c1_boundaries_repair_resentment",
          "c1_boundaries_repair_trust"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_reassure",
      "data": {
        "lesson_key": "c1-boundaries-repair-03",
        "text": {
          "en": "Reassurance is credible when it is tied to a concrete change rather than a promise that the problem will never happen again."
        },
        "translations": {
          "fa": "اطمینان دادن وقتی معتبره که به تغییر مشخص وصل باشه، نه قول اینکه مشکل هیچ‌وقت تکرار نمی‌شه."
        },
        "intent": "reassure_credibly",
        "concept_refs": [
          "c1_boundaries_repair_reassure",
          "c1_boundaries_repair_repair"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_reciprocal",
      "data": {
        "lesson_key": "c1-boundaries-repair-03",
        "text": {
          "en": "Healthy repair is reciprocal in the sense that both people can state needs, even if responsibility for the original harm is unequal."
        },
        "translations": {
          "fa": "ترمیم سالم از این نظر دوطرفه‌ست که هر دو نفر می‌تونن نیازهاشون رو بگن، حتی اگر مسئولیت آسیب اولیه برابر نباشه."
        },
        "intent": "describe_reciprocal_repair",
        "concept_refs": [
          "c1_boundaries_repair_reciprocal",
          "c1_boundaries_repair_accountability"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_boundaries_repair_close",
      "data": {
        "lesson_key": "c1-boundaries-repair-03",
        "text": {
          "en": "Restoring trust is usually a pattern of reliable behavior over time, not one perfect conversation."
        },
        "translations": {
          "fa": "برگردوندن اعتماد معمولاً الگویی از رفتار قابل اتکا در طول زمانه، نه یک گفتگوی بی‌نقص."
        },
        "intent": "summarize_trust_repair",
        "concept_refs": [
          "c1_boundaries_repair_trust",
          "c1_boundaries_repair_repair"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
