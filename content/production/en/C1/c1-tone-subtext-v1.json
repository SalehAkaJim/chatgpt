      "data": {
        "lesson_key": "c1-tone-subtext-03",
        "text": {
          "en": "Whatever the original intent, we need to respond to how the message is likely to be received."
        },
        "translations": {
          "fa": "هر نیتی که پشت پیام بوده، باید به اثری که احتمالاً روی مخاطب می‌ذاره پاسخ بدیم."
        },
        "intent": "prioritize_reception",
        "concept_refs": [
          "c1_tone_subtext_intent",
