        "translations": {
          "fa": "عبارت قرار بوده اطمینان‌بخش باشه، ولی توی این زمینه ممکنه به‌جای حمایت، از بالا به پایین به نظر بیاد."
        },
        "intent": "evaluate_tone_risk",
        "concept_refs": [
