    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tone_subtext_context",
      "data": {
        "lesson_key": "c1-tone-subtext-03",
        "text": {
          "en": "A sentence that sounds neutral among close colleagues may come across as abrupt in a formal exchange."
        },
        "translations": {
          "fa": "جمله‌ای که بین همکارهای نزدیک خنثی به نظر میاد ممکنه در یک مکاتبه رسمی تند برداشت بشه."
        },
        "intent": "compare_contexts",
        "concept_refs": [
          "c1_tone_subtext_come_across",
          "c1_tone_subtext_wording"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tone_subtext_summary",
      "data": {
        "lesson_key": "c1-tone-subtext-03",
        "text": {
          "en": "The problem is less the content than the undertone created by the sequence and wording."
        },
        "translations": {
          "fa": "مشکل کمتر خود محتواست و بیشتر لحن پنهانیه که ترتیب و نحوه بیان ایجاد کرده."
        },
        "intent": "summarize_tone_issue",
