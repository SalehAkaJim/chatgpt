        "cefr": "C1",
        "topic": "questions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_synth",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-02",
        "text": {
          "en": "Synthesizing the evidence reveals that the cheapest option solves the technical fault but leaves the highest-impact customer problem unresolved."
        },
        "translations": {
          "fa": "ترکیب شواهد نشون می‌ده ارزان‌ترین گزینه مشکل فنی رو حل می‌کنه ولی مهم‌ترین مشکل مشتری رو باز می‌ذاره."
        },
        "intent": "synthesize_problem",
        "concept_refs": [
