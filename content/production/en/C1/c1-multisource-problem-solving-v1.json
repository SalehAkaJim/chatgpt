        "topic": "questions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_assumption",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-02",
        "text": {
          "en": "The proposed plan assumes demand will remain stable; if that assumption fails, the capacity calculation changes completely."
        },
        "translations": {
          "fa": "برنامه پیشنهادی فرض می‌کنه تقاضا ثابت می‌مونه؛ اگر این فرض غلط باشه محاسبه ظرفیت کامل عوض می‌شه."
        },
        "intent": "test_assumption",
        "concept_refs": [
          "c1_multisource_problem_solving_assumption",
          "c1_multisource_problem_solving_scenario"
        ],
        "cefr": "C1",
        "topic": "questions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_scenario",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-03",
        "text": {
          "en": "I would compare a base scenario with one credible downside scenario rather than model every imaginable outcome."
        },
        "translations": {
          "fa": "یک سناریوی پایه رو با یک سناریوی منفی معتبر مقایسه می‌کنم، نه اینکه هر نتیجه قابل تصور رو مدل کنم."
        },
        "intent": "compare_scenarios",
        "concept_refs": [
          "c1_multisource_problem_solving_scenario",
          "c1_multisource_problem_solving_constraint"
        ],
        "cefr": "C1",
        "topic": "questions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_priority",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-03",
        "text": {
          "en": "The priority should be the failure mode with the greatest combined impact and likelihood, not the most visible complaint."
        },
        "translations": {
          "fa": "اولویت باید حالتی باشه که ترکیب اثر و احتمال بالاتری داره، نه پرصداترین شکایت."
        },
        "intent": "set_problem_priority",
        "concept_refs": [
          "c1_multisource_problem_solving_priority",
          "c1_multisource_problem_solving_recommendation"
        ],
        "cefr": "C1",
        "topic": "questions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_recommend",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-03",
        "text": {
          "en": "My recommendation is conditional: proceed with the faster option only if the supplier confirms the fallback capacity in writing."
        },
        "translations": {
          "fa": "توصیه من مشروطه: فقط وقتی با گزینه سریع‌تر جلو بریم که تأمین‌کننده ظرفیت پشتیبان رو کتبی تأیید کنه."
        },
        "intent": "make_conditional_recommendation",
        "concept_refs": [
          "c1_multisource_problem_solving_recommendation",
          "c1_multisource_problem_solving_constraint"
        ],
        "cefr": "C1",
