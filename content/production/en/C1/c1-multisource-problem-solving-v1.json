    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_sources",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-01",
        "text": {
          "en": "No single source contains the full problem: the customer data show impact, the technical report shows cause, and the budget sets the constraint."
        },
        "translations": {
          "fa": "هیچ منبعی کل مسئله رو نداره: داده مشتری اثر رو نشون می‌ده، گزارش فنی علت رو و بودجه محدودیت رو."
        },
        "intent": "map_sources",
        "concept_refs": [
          "c1_multisource_problem_solving_source",
          "c1_multisource_problem_solving_constraint"
        ],
        "cefr": "C1",
        "topic": "questions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_conflict",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-01",
        "text": {
          "en": "The sources conflict on timing, so I would not build the recommendation around a deadline that only one source supports."
        },
        "translations": {
          "fa": "منابع درباره زمان‌بندی تعارض دارن، پس توصیه رو حول موعدی که فقط یک منبع تأیید می‌کنه نمی‌سازم."
        },
        "intent": "handle_source_conflict",
        "concept_refs": [
          "c1_multisource_problem_solving_conflict",
          "c1_multisource_problem_solving_source",
          "c1_multisource_problem_solving_recommendation"
