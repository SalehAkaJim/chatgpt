        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_multisource_problem_solving_close",
      "data": {
        "lesson_key": "c1-multisource-problem-solving-03",
        "text": {
          "en": "The solution is credible because each major decision can be traced back to evidence, a stated assumption, or an explicit constraint."
