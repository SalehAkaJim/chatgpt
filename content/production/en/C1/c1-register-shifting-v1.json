      "kind": "utterance",
      "external_id": "u_c1_register_shifting_informal",
      "data": {
        "lesson_key": "c1-register-shifting-02",
        "text": {
          "en": "An informal message can be concise and warm without becoming vague about what is actually needed."
        },
        "translations": {
          "fa": "پیام خودمانی می‌تونه کوتاه و گرم باشه بدون اینکه درباره نیاز واقعی مبهم بشه."
