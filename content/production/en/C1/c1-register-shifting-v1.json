      "data": {
        "lesson_key": "c1-register-shifting-03",
        "text": {
          "en": "I would rewrite the sentence for the audience, not merely replace casual words with longer formal ones."
        },
        "translations": {
          "fa": "جمله رو برای مخاطب بازنویسی می‌کنم، نه اینکه فقط کلمه‌های خودمانی رو با واژه‌های رسمی طولانی عوض کنم."
        },
        "intent": "adapt_to_audience",
