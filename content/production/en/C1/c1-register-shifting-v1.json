      "data": {
        "lesson_key": "c1-register-shifting-01",
        "text": {
          "en": "With a close colleague, 'Can you fix this today?' may be appropriately direct; with a new client, it may sound abrupt."
        },
        "translations": {
          "fa": "با همکار نزدیک «می‌تونی امروز درستش کنی؟» می‌تونه مستقیم و مناسب باشه؛ با مشتری جدید شاید تند به نظر بیاد."
        },
        "intent": "compare_directness",
        "concept_refs": [
          "c1_register_shifting_direct",
          "c1_register_shifting_audience"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
