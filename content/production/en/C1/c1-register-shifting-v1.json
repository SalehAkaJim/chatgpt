      "data": {
        "lesson_key": "c1-register-shifting-03",
        "text": {
          "en": "Strong communicators adapt register without sounding like a different person in every context."
        },
        "translations": {
          "fa": "ارتباط‌گرهای قوی سطح رسمیت رو سازگار می‌کنن بدون اینکه در هر زمینه مثل یک آدم کاملاً متفاوت به نظر بیان."
        },
        "intent": "adapt_register",
