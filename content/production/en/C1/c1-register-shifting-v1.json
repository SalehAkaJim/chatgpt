      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_register_shifting_formal",
      "data": {
        "lesson_key": "c1-register-shifting-02",
        "text": {
          "en": "In a formal complaint, I would make the requested action explicit while avoiding emotional language that weakens the case."
        },
        "translations": {
          "fa": "در شکایت رسمی، اقدام درخواستی رو صریح می‌کنم و از زبان احساسی که پرونده رو ضعیف می‌کنه دوری می‌کنم."
        },
        "intent": "use_formal_register",
        "concept_refs": [
          "c1_register_shifting_formal",
          "c1_register_shifting_concise"
        ],
        "cefr": "C1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
