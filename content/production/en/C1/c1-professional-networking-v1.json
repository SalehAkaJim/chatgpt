          "Chris"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Fatima",
            "text": "Which assumption is doing most of the work here?",
            "translation_fa": "کدوم فرض بیشترین نقش رو در این استدلال داره؟"
          },
          {
            "order": 2,
            "speaker": "Chris",
            "text": "A brief follow-up works better when it refers to something specific from the conversation rather than sounding automated.",
            "translation_fa": "پیگیری کوتاه وقتی بهتر جواب می‌ده که به نکته مشخصی از گفتگو اشاره کنه، نه اینکه خودکار به نظر بیاد."
          },
          {
            "order": 3,
            "speaker": "Fatima",
            "text": "How would the conclusion change if that assumption failed?",
            "translation_fa": "اگر اون فرض برقرار نباشه نتیجه چطور عوض می‌شه؟"
          },
          {
            "order": 4,
            "speaker": "Chris",
            "text": "I would ask for a referral only when the person has enough knowledge of my work to make the introduction credible.",
            "translation_fa": "فقط وقتی درخواست معرفی حرفه‌ای می‌کنم که طرف به اندازه کافی کارم رو بشناسه تا معرفی‌اش معتبر باشه."
          }
        ],
        "status": "approved"
      }
    },
