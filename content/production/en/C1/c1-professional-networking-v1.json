    {
      "kind": "dialogue",
      "external_id": "d_c1_professional_networking_scene_2",
      "data": {
        "lesson_key": "c1-professional-networking-02",
        "title": "Professional Networking: part 2",
        "setting": "seminar break",
        "cefr": "C1",
        "topic": "jobs",
        "characters": [
