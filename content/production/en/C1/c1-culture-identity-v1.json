        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_culture_identity_close",
      "data": {
        "lesson_key": "c1-culture-identity-03",
        "text": {
          "en": "I would avoid talking about culture as if every member experiences it in the same way."
        },
        "translations": {
          "fa": "درباره فرهنگ طوری حرف نمی‌زنم که انگار همه اعضاش دقیقاً یک تجربه دارن."
        },
        "intent": "avoid_cultural_generalization",
