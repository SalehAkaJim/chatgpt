    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_disruption",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-01",
        "text": {
          "en": "The initial delay became a complex disruption because the replacement route caused us to miss the final connection."
        },
        "translations": {
          "fa": "تأخیر اولیه تبدیل به اختلال پیچیده شد چون مسیر جایگزین باعث شد اتصال آخر رو از دست بدیم."
        },
        "intent": "explain_disruption_chain",
        "concept_refs": [
          "c1_complex_travel_resolution_disruption",
          "c1_complex_travel_resolution_reroute"
        ],
        "cefr": "C1",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_reroute",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-01",
        "text": {
          "en": "I am happy to be rerouted, provided the new itinerary gets me to the destination today rather than tomorrow morning."
        },
        "translations": {
          "fa": "با تغییر مسیر مشکلی ندارم، به شرطی که برنامه جدید امروز منو برسونه نه فردا صبح."
        },
        "intent": "negotiate_reroute",
        "concept_refs": [
          "c1_complex_travel_resolution_reroute",
          "c1_complex_travel_resolution_alternative"
        ],
        "cefr": "C1",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_entitlement",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-02",
        "text": {
          "en": "Before accepting the voucher, I would like to clarify whether doing so affects my entitlement to reimbursement."
        },
        "translations": {
          "fa": "قبل از قبول ووچر می‌خوام روشن کنم آیا این کار روی حق بازپرداختم اثر می‌ذاره یا نه."
        },
        "intent": "clarify_entitlement",
        "concept_refs": [
          "c1_complex_travel_resolution_entitlement",
          "c1_complex_travel_resolution_reimbursement"
        ],
        "cefr": "C1",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_liability",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-02",
        "text": {
          "en": "I understand the weather was outside the airline's control, but I am asking about its liability for the accommodation arranged afterward."
        },
        "translations": {
          "fa": "می‌فهمم هوا خارج از کنترل شرکت بوده، ولی سؤالم درباره مسئولیت هزینه اقامتیه که بعدش ترتیب داده شد."
        },
        "intent": "separate_liability",
        "concept_refs": [
          "c1_complex_travel_resolution_liability",
          "c1_complex_travel_resolution_disruption"
        ],
        "cefr": "C1",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_document",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-03",
        "text": {
          "en": "I have documented the original booking, the cancellation notice, the replacement route, and the additional expenses."
        },
        "translations": {
          "fa": "رزرو اصلی، اطلاع لغو، مسیر جایگزین و هزینه‌های اضافه رو مستند کردم."
        },
        "intent": "document_case",
        "concept_refs": [
          "c1_complex_travel_resolution_document",
          "c1_complex_travel_resolution_reimbursement"
        ],
        "cefr": "C1",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_escalate",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-03",
        "text": {
          "en": "If the desk cannot resolve the reimbursement question, could you escalate it to someone who can confirm the policy in writing?"
        },
        "translations": {
          "fa": "اگر این میز نمی‌تونه موضوع بازپرداخت رو حل کنه، می‌شه به کسی ارجاعش بدید که سیاست رو کتبی تأیید کنه؟"
        },
        "intent": "escalate_case",
        "concept_refs": [
          "c1_complex_travel_resolution_escalate",
          "c1_complex_travel_resolution_reimbursement"
        ],
        "cefr": "C1",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_alternative",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-03",
        "text": {
          "en": "A workable alternative would be a later direct flight plus tonight's accommodation rather than three uncertain connections."
        },
        "translations": {
          "fa": "گزینه عملی می‌تونه پرواز مستقیم دیرتر به‌علاوه اقامت امشب باشه، نه سه اتصال نامطمئن."
        },
        "intent": "propose_alternative",
        "concept_refs": [
          "c1_complex_travel_resolution_alternative",
          "c1_complex_travel_resolution_reroute"
        ],
        "cefr": "C1",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_complex_travel_resolution_close",
      "data": {
        "lesson_key": "c1-complex-travel-resolution-03",
        "text": {
          "en": "I am trying to resolve the journey first and preserve the documentation needed for any reimbursement claim afterward."
        },
        "translations": {
          "fa": "اول می‌خوام سفر حل بشه و بعد مدارک لازم برای درخواست بازپرداخت رو حفظ کنم."
        },
        "intent": "prioritize_resolution",
        "concept_refs": [
