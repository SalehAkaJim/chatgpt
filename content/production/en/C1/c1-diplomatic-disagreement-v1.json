      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_diplomatic_disagreement_close",
      "data": {
        "lesson_key": "c1-diplomatic-disagreement-03",
        "text": {
          "en": "If we separate the points we agree on from the points still disputed, we may be able to move the discussion forward."
        },
        "translations": {
          "fa": "اگر بخش‌های مورد توافق رو از بخش‌های مورد اختلاف جدا کنیم، شاید بتونیم بحث رو جلو ببریم."
        },
        "intent": "move_discussion_forward",
