    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_ethical",
      "data": {
        "lesson_key": "c1-tech-ethics-01",
        "text": {
          "en": "The ethical question is not simply whether the system works, but who carries the risk when it fails."
        },
        "translations": {
          "fa": "سؤال اخلاقی فقط این نیست که سیستم کار می‌کنه یا نه؛ اینه که وقتی خراب می‌شه چه کسی ریسک رو تحمل می‌کنه."
        },
        "intent": "frame_ethics_question",
        "concept_refs": [
          "c1_tech_ethics_ethical",
          "c1_tech_ethics_accountability"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_consent",
      "data": {
        "lesson_key": "c1-tech-ethics-01",
        "text": {
          "en": "Consent is weak if people technically agree without understanding what data will be collected or how it may be used."
        },
        "translations": {
          "fa": "رضایت وقتی ضعیفه که افراد فنی موافقت کنن ولی نفهمن چه داده‌ای جمع می‌شه یا چطور استفاده می‌شه."
        },
        "intent": "evaluate_consent",
        "concept_refs": [
          "c1_tech_ethics_consent",
          "c1_tech_ethics_transparency"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_automate",
      "data": {
        "lesson_key": "c1-tech-ethics-02",
        "text": {
          "en": "Automating a decision can improve consistency while making individual exceptions harder to notice."
        },
        "translations": {
          "fa": "خودکار کردن تصمیم می‌تونه یکدستی رو بهتر کنه ولی دیدن استثناهای فردی رو سخت‌تر کنه."
        },
        "intent": "evaluate_automation",
        "concept_refs": [
          "c1_tech_ethics_automate",
          "c1_tech_ethics_tradeoff"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_bias",
      "data": {
        "lesson_key": "c1-tech-ethics-02",
        "text": {
          "en": "A system can reproduce bias even when no individual developer intends to discriminate."
        },
        "translations": {
          "fa": "سیستم می‌تونه سوگیری رو بازتولید کنه حتی وقتی هیچ توسعه‌دهنده‌ای قصد تبعیض نداره."
        },
        "intent": "explain_systemic_bias",
        "concept_refs": [
          "c1_tech_ethics_bias",
          "c1_tech_ethics_ethical"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_oversight",
      "data": {
        "lesson_key": "c1-tech-ethics-03",
        "text": {
          "en": "Independent oversight matters most where the affected person cannot easily understand or challenge the decision."
        },
        "translations": {
          "fa": "نظارت مستقل جایی مهم‌تره که فرد تحت‌تأثیر نتونه راحت تصمیم رو بفهمه یا بهش اعتراض کنه."
        },
        "intent": "justify_oversight",
        "concept_refs": [
          "c1_tech_ethics_oversight",
          "c1_tech_ethics_accountability"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_transparency",
      "data": {
        "lesson_key": "c1-tech-ethics-03",
        "text": {
          "en": "Transparency should make meaningful scrutiny possible; publishing a thousand pages nobody can interpret is not enough."
        },
        "translations": {
          "fa": "شفافیت باید بررسی معنادار رو ممکن کنه؛ انتشار هزار صفحه‌ای که کسی نمی‌فهمه کافی نیست."
        },
        "intent": "define_transparency",
        "concept_refs": [
          "c1_tech_ethics_transparency",
          "c1_tech_ethics_oversight"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_tradeoff",
      "data": {
        "lesson_key": "c1-tech-ethics-03",
        "text": {
          "en": "The trade-off is not privacy versus innovation in the abstract; it depends on which data are necessary for which benefit."
        },
        "translations": {
          "fa": "بده‌بستان به‌صورت کلی حریم خصوصی در برابر نوآوری نیست؛ بستگی داره کدوم داده برای کدوم فایده واقعاً لازمه."
        },
        "intent": "specify_tradeoff",
        "concept_refs": [
          "c1_tech_ethics_tradeoff",
          "c1_tech_ethics_consent"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_tech_ethics_close",
      "data": {
        "lesson_key": "c1-tech-ethics-03",
        "text": {
          "en": "Accountability requires a route for correcting harmful decisions, not merely an explanation of how they were produced."
        },
        "translations": {
          "fa": "پاسخ‌گویی مسیر اصلاح تصمیم آسیب‌زا می‌خواد، نه فقط توضیح اینکه چطور تولید شده."
        },
        "intent": "define_accountability",
        "concept_refs": [
          "c1_tech_ethics_accountability",
          "c1_tech_ethics_oversight"
        ],
        "cefr": "C1",
        "topic": "common-actions",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_tech_ethics_cleft_sentences",
      "data": {
        "lesson_key": "c1-tech-ethics-01",
        "slug": "c1-tech-ethics-cleft-sentences",
        "title": "Cleft sentences for focus",
        "rule_summary": "Use what-clauses and it-clefts to place deliberate emphasis on the most important part of a message.",
        "explanation": {
          "fa": "با what-clause و it-cleft بخش مهم پیام را برجسته می‌کنیم."
        },
        "examples": [
          {
            "en": "What concerns me most is the lack of independent oversight.",
            "fa": "چیزی که بیشتر نگرانم می‌کند نبود نظارت مستقل است."
          },
          {
            "en": "It was the timing, rather than the decision itself, that caused the problem.",
            "fa": "زمان‌بندی بود، نه خود تصمیم، که مشکل را ایجاد کرد."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_tech_ethics_nominalisation",
      "data": {
        "lesson_key": "c1-tech-ethics-02",
        "slug": "c1-tech-ethics-nominalisation",
        "title": "Nominalisation in formal discourse",
        "rule_summary": "Turn verbs or adjectives into noun phrases to make formal arguments more compact and abstract when appropriate.",
        "explanation": {
          "fa": "در گفتار و نوشتار رسمی، در صورت مناسب بودن فعل یا صفت را به عبارت اسمی تبدیل می‌کنیم تا استدلال فشرده‌تر و انتزاعی‌تر شود."
        },
        "examples": [
          {
            "en": "The rapid expansion of the service created new risks.",
            "fa": "گسترش سریع سرویس ریسک‌های جدیدی ایجاد کرد."
          },
          {
            "en": "A reduction in waiting times would benefit everyone.",
            "fa": "کاهش زمان انتظار به نفع همه خواهد بود."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_tech_ethics_formal_subjunctive",
      "data": {
        "lesson_key": "c1-tech-ethics-03",
        "slug": "c1-tech-ethics-formal-subjunctive",
        "title": "Formal mandative structures",
        "rule_summary": "In formal recommendations and requirements, use structures such as it is essential that ... be and they recommended that ... be.",
        "explanation": {
          "fa": "در توصیه‌ها و الزامات رسمی می‌توان از ساختارهایی مثل it is essential that ... be و they recommended that ... be استفاده کرد."
        },
        "examples": [
          {
            "en": "It is essential that every applicant be given the same information.",
            "fa": "ضروری است به هر متقاضی اطلاعات یکسان داده شود."
          },
          {
            "en": "The committee recommended that the proposal be revised.",
            "fa": "کمیته توصیه کرد پیشنهاد بازبینی شود."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_c1_tech_ethics_scene_1",
      "data": {
        "lesson_key": "c1-tech-ethics-01",
        "title": "Technology & Ethics: part 1",
        "setting": "quiet cafe",
        "cefr": "C1",
        "topic": "common-actions",
        "characters": [
          "Ivy",
          "David"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ivy",
            "text": "What is the practical implication of that point?",
            "translation_fa": "پیامد عملی اون نکته چیه؟"
          },
          {
            "order": 2,
            "speaker": "David",
            "text": "The ethical question is not simply whether the system works, but who carries the risk when it fails.",
            "translation_fa": "سؤال اخلاقی فقط این نیست که سیستم کار می‌کنه یا نه؛ اینه که وقتی خراب می‌شه چه کسی ریسک رو تحمل می‌کنه."
          },
          {
            "order": 3,
            "speaker": "Ivy",
            "text": "Does the evidence justify going that far?",
            "translation_fa": "آیا شواهد واقعاً چنین نتیجه‌ای رو توجیه می‌کنه؟"
          },
          {
            "order": 4,
            "speaker": "David",
            "text": "Consent is weak if people technically agree without understanding what data will be collected or how it may be used.",
