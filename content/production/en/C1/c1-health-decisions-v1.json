    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_balance",
      "data": {
        "lesson_key": "c1-health-decisions-01",
        "text": {
          "en": "A health decision may involve balancing a modest likely benefit against a small but serious risk."
        },
        "translations": {
          "fa": "تصمیم سلامتی ممکنه شامل سنجیدن یک فایده نسبتاً محتمل در برابر ریسکی کم‌احتمال ولی جدی باشه."
        },
        "intent": "weigh_health_tradeoff",
        "concept_refs": [
          "c1_health_decisions_benefit",
          "c1_health_decisions_risk"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_evidence",
      "data": {
        "lesson_key": "c1-health-decisions-01",
        "text": {
          "en": "The evidence can tell us average outcomes, but it cannot decide how an individual should value each outcome."
        },
        "translations": {
          "fa": "شواهد می‌تونن نتیجه‌های متوسط رو بگن، ولی نمی‌تونن تصمیم بگیرن هر فرد باید چقدر برای هر نتیجه ارزش قائل بشه."
        },
        "intent": "separate_evidence_values",
        "concept_refs": [
          "c1_health_decisions_evidence",
          "c1_health_decisions_preference"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_uncertainty",
      "data": {
        "lesson_key": "c1-health-decisions-02",
        "text": {
          "en": "Uncertainty should be explained clearly rather than hidden behind a single precise-looking number."
        },
        "translations": {
          "fa": "عدم قطعیت باید روشن توضیح داده بشه، نه اینکه پشت یک عدد ظاهراً دقیق پنهان بشه."
        },
        "intent": "communicate_uncertainty",
        "concept_refs": [
          "c1_health_decisions_uncertainty",
          "c1_health_decisions_evidence"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_screening",
      "data": {
        "lesson_key": "c1-health-decisions-02",
        "text": {
          "en": "Screening can identify problems earlier, but it can also detect findings that would never have caused harm."
        },
        "translations": {
          "fa": "غربالگری می‌تونه مشکل رو زودتر پیدا کنه، ولی ممکنه چیزهایی رو هم پیدا کنه که هیچ‌وقت آسیب ایجاد نمی‌کردن."
        },
        "intent": "evaluate_screening",
        "concept_refs": [
          "c1_health_decisions_screening",
          "c1_health_decisions_benefit",
          "c1_health_decisions_risk"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_informed",
      "data": {
        "lesson_key": "c1-health-decisions-03",
        "text": {
          "en": "An informed choice requires understanding the realistic options, including the option of waiting or doing nothing for now."
        },
        "translations": {
          "fa": "انتخاب آگاهانه نیاز داره گزینه‌های واقعی رو بفهمیم، از جمله صبر کردن یا فعلاً کاری نکردن."
        },
        "intent": "define_informed_choice",
        "concept_refs": [
          "c1_health_decisions_informed",
          "c1_health_decisions_preference"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_intervention",
      "data": {
        "lesson_key": "c1-health-decisions-03",
        "text": {
          "en": "A more intensive intervention is not automatically better if the additional benefit is small and the burden is substantial."
        },
        "translations": {
          "fa": "مداخله شدیدتر لزوماً بهتر نیست اگر فایده اضافه کم و بارش زیاد باشه."
        },
        "intent": "compare_interventions",
        "concept_refs": [
          "c1_health_decisions_intervention",
          "c1_health_decisions_benefit",
          "c1_health_decisions_risk"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_preference",
      "data": {
        "lesson_key": "c1-health-decisions-03",
        "text": {
          "en": "Two well-informed people can reasonably make different choices because their preferences and tolerance for risk differ."
        },
        "translations": {
          "fa": "دو آدم کاملاً آگاه می‌تونن منطقی تصمیم‌های متفاوت بگیرن چون ترجیح‌ها و تحمل ریسک‌شون فرق داره."
        },
        "intent": "normalize_preference_sensitive_choice",
        "concept_refs": [
          "c1_health_decisions_informed",
          "c1_health_decisions_preference",
          "c1_health_decisions_risk"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c1_health_decisions_close",
      "data": {
        "lesson_key": "c1-health-decisions-03",
        "text": {
          "en": "The aim is not false certainty but a decision that remains reasonable given the evidence, uncertainty, and person's priorities."
        },
        "translations": {
          "fa": "هدف اطمینان مصنوعی نیست؛ تصمیمیه که با توجه به شواهد، عدم قطعیت و اولویت‌های فرد منطقی بمونه."
        },
        "intent": "summarize_health_decision",
        "concept_refs": [
          "c1_health_decisions_evidence",
          "c1_health_decisions_uncertainty",
          "c1_health_decisions_preference"
        ],
        "cefr": "C1",
        "topic": "basic-health",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_health_decisions_advanced_hedging",
      "data": {
        "lesson_key": "c1-health-decisions-01",
        "slug": "c1-health-decisions-advanced-hedging",
        "title": "Advanced hedging and calibration",
        "rule_summary": "Calibrate certainty with expressions such as arguably, broadly speaking, tends to, appears to, and cannot entirely be ruled out.",
        "explanation": {
          "fa": "در C1 میزان قطعیت را با عبارت‌هایی مثل arguably، broadly speaking، tends to، appears to و cannot entirely be ruled out دقیق تنظیم می‌کنیم."
        },
        "examples": [
          {
            "en": "The change appears to have improved access, although the evidence is still limited.",
            "fa": "به نظر می‌رسد این تغییر دسترسی را بهتر کرده، هرچند شواهد هنوز محدود است."
          },
          {
            "en": "That explanation cannot entirely be ruled out.",
            "fa": "نمی‌توان آن توضیح را کاملاً منتفی دانست."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_health_decisions_concession_rebuttal",
      "data": {
        "lesson_key": "c1-health-decisions-02",
        "slug": "c1-health-decisions-concession-rebuttal",
        "title": "Concession followed by rebuttal",
        "rule_summary": "Acknowledge a reasonable opposing point before limiting it or presenting a stronger counterargument.",
        "explanation": {
          "fa": "ابتدا یک نکته منطقی از طرف مقابل را می‌پذیریم و سپس دامنه آن را محدود می‌کنیم یا پاسخ قوی‌تری می‌دهیم."
        },
        "examples": [
          {
            "en": "Granted, the process is faster; that does not necessarily make it fairer.",
            "fa": "درست است که روند سریع‌تر است؛ اما لزوماً عادلانه‌تر نیست."
          },
          {
            "en": "While that concern is valid, it overlooks the cost of doing nothing.",
            "fa": "با اینکه آن نگرانی معتبر است، هزینه هیچ کاری نکردن را نادیده می‌گیرد."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c1_health_decisions_nominalisation",
      "data": {
        "lesson_key": "c1-health-decisions-03",
        "slug": "c1-health-decisions-nominalisation",
        "title": "Nominalisation in formal discourse",
        "rule_summary": "Turn verbs or adjectives into noun phrases to make formal arguments more compact and abstract when appropriate.",
        "explanation": {
          "fa": "در گفتار و نوشتار رسمی، در صورت مناسب بودن فعل یا صفت را به عبارت اسمی تبدیل می‌کنیم تا استدلال فشرده‌تر و انتزاعی‌تر شود."
        },
        "examples": [
          {
            "en": "The rapid expansion of the service created new risks.",
            "fa": "گسترش سریع سرویس ریسک‌های جدیدی ایجاد کرد."
          },
          {
            "en": "A reduction in waiting times would benefit everyone.",
            "fa": "کاهش زمان انتظار به نفع همه خواهد بود."
          }
        ],
        "cefr": "C1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_c1_health_decisions_scene_1",
      "data": {
        "lesson_key": "c1-health-decisions-01",
        "title": "Health Decisions: part 1",
        "setting": "project review",
        "cefr": "C1",
        "topic": "basic-health",
        "characters": [
          "Ivy",
          "David"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ivy",
            "text": "How would you put that more precisely?",
            "translation_fa": "چطور اون نکته رو دقیق‌تر بیان می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "David",
            "text": "A health decision may involve balancing a modest likely benefit against a small but serious risk.",
            "translation_fa": "تصمیم سلامتی ممکنه شامل سنجیدن یک فایده نسبتاً محتمل در برابر ریسکی کم‌احتمال ولی جدی باشه."
          },
          {
            "order": 3,
            "speaker": "Ivy",
            "text": "What distinction matters most here?",
