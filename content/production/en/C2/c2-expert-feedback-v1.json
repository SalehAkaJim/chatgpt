        "characters": [
          "Nora",
          "Samir"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Nora",
            "text": "How would you put that more precisely?",
            "translation_fa": "چطور اون نکته رو دقیق‌تر بیان می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "Samir",
            "text": "My feedback is tied to one criterion: can a reader identify the recommendation before reaching the second paragraph?",
            "translation_fa": "بازخورد من به یک معیار مشخص وصله: آیا خواننده قبل از رسیدن به پاراگراف دوم توصیه اصلی رو پیدا می‌کنه؟"
          },
          {
            "order": 3,
            "speaker": "Nora",
            "text": "What distinction matters most here?",
            "translation_fa": "مهم‌ترین تمایز اینجا چیه؟"
          },
          {
            "order": 4,
            "speaker": "Samir",
            "text": "The problem is diagnostic rather than cosmetic: the structure reflects uncertainty about the argument, not merely weak wording.",
            "translation_fa": "مشکل تشخیصیه نه ظاهری: ساختار نشون می‌ده خود استدلال هنوز روشن نیست، نه اینکه فقط عبارت‌بندی ضعیفه."
          }
        ],
        "status": "approved"
      }
    },
