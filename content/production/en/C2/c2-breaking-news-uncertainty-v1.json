      "kind": "utterance",
      "external_id": "u_c2_breaking_news_uncertainty_corroborate",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-02",
        "text": {
          "en": "We should wait for an independent source to corroborate the location before building further conclusions on it."
        },
        "translations": {
          "fa": "قبل از اینکه نتیجه‌های بیشتری روی مکان بنا کنیم باید صبر کنیم یک منبع مستقل اون رو تأیید کنه."
        },
        "intent": "seek_corroboration",
