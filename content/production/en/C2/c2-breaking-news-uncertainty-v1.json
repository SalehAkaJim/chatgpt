    {
      "kind": "utterance",
      "external_id": "u_c2_breaking_news_uncertainty_eyewitness",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-02",
        "text": {
          "en": "Eyewitness evidence can be valuable for immediate detail while remaining unreliable on scale, sequence or motive."
        },
        "translations": {
          "fa": "شهادت عینی برای جزئیات فوری می‌تونه ارزشمند باشه ولی درباره اندازه، توالی یا انگیزه همچنان ممکنه قابل اتکا نباشه."
        },
        "intent": "qualify_eyewitness",
