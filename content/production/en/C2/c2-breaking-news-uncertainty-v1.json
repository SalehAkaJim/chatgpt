      "kind": "utterance",
      "external_id": "u_c2_breaking_news_uncertainty_timeline",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-03",
        "text": {
          "en": "The timeline has changed twice, which means earlier causal interpretations should be revisited rather than quietly retained."
        },
        "translations": {
          "fa": "خط زمانی دوبار عوض شده، یعنی تفسیرهای علّی قبلی باید دوباره بررسی بشن نه اینکه بی‌صدا حفظ بشن."
        },
        "intent": "revise_with_timeline",
