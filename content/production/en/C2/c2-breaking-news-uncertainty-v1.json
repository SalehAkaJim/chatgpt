    {
      "kind": "grammar_point",
      "external_id": "g_c2_breaking_news_uncertainty_reporting_passive",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-01",
        "slug": "c2-breaking-news-uncertainty-reporting-passive",
        "title": "Impersonal reporting structures",
        "rule_summary": "Use structures such as is thought to, is believed to, and has been reported to when the source is general or deliberately backgrounded.",
        "explanation": {
          "fa": "وقتی منبع عمومی است یا عمداً در پس‌زمینه قرار می‌گیرد از ساختارهایی مثل is thought to، is believed to و has been reported to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The policy is thought to have reduced short-term demand.",
            "fa": "گمان می‌رود این سیاست تقاضای کوتاه‌مدت را کاهش داده باشد."
          },
          {
            "en": "The company is reported to be reconsidering the plan.",
            "fa": "گزارش شده شرکت در حال بازنگری برنامه است."
          }
        ],
        "cefr": "C2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c2_breaking_news_uncertainty_distancing",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-02",
        "slug": "c2-breaking-news-uncertainty-distancing",
        "title": "Distancing from claims",
        "rule_summary": "Use apparently, reportedly, according to, it would seem, and claims that to avoid presenting uncertain information as your own fact.",
        "explanation": {
          "fa": "برای اینکه اطلاعات نامطمئن را واقعیت قطعی خودمان نشان ندهیم از apparently، reportedly، according to، it would seem و claims that استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "According to the review, the benefits were unevenly distributed.",
            "fa": "طبق بررسی، مزایا به‌طور نابرابر توزیع شده بود."
          },
          {
            "en": "It would seem that the original estimate was too optimistic.",
            "fa": "به نظر می‌رسد برآورد اولیه بیش از حد خوش‌بینانه بوده است."
          }
        ],
        "cefr": "C2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c2_breaking_news_uncertainty_advanced_hedging",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-03",
        "slug": "c2-breaking-news-uncertainty-advanced-hedging",
        "title": "Advanced hedging and calibration",
        "rule_summary": "Calibrate certainty with expressions such as arguably, broadly speaking, tends to, appears to, and cannot entirely be ruled out.",
        "explanation": {
          "fa": "در C1 میزان قطعیت را با عبارت‌هایی مثل arguably، broadly speaking، tends to، appears to و cannot entirely be ruled out دقیق تنظیم می‌کنیم."
        },
        "examples": [
          {
            "en": "The change appears to have improved access, although the evidence is still limited.",
            "fa": "به نظر می‌رسد این تغییر دسترسی را بهتر کرده، هرچند شواهد هنوز محدود است."
          },
          {
            "en": "That explanation cannot entirely be ruled out.",
            "fa": "نمی‌توان آن توضیح را کاملاً منتفی دانست."
