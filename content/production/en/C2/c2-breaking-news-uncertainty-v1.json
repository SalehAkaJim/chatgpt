    {
      "kind": "utterance",
      "external_id": "u_c2_breaking_news_uncertainty_retract",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-03",
        "text": {
          "en": "A correction updates a detail; a retraction withdraws the claim itself. We should be precise about which has happened."
        },
        "translations": {
          "fa": "اصلاح یک جزئیات رو تغییر می‌ده؛ پس‌گرفتن ادعا خود ادعا رو کنار می‌ذاره. باید دقیق بگیم کدوم اتفاق افتاده."
        },
        "intent": "distinguish_retraction",
        "concept_refs": [
          "c2_breaking_news_uncertainty_retract",
          "c2_breaking_news_uncertainty_verification"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_breaking_news_uncertainty_provisional",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-03",
        "text": {
          "en": "My current interpretation is provisional because the strongest evidence concerns what happened, not yet why it happened."
        },
        "translations": {
          "fa": "برداشت فعلیم موقته چون قوی‌ترین شواهد درباره اینه که چه اتفاقی افتاده، نه هنوز چرا اتفاق افتاده."
        },
        "intent": "calibrate_news_inference",
