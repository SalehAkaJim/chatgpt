    {
      "kind": "utterance",
      "external_id": "u_c2_breaking_news_uncertainty_summary",
      "data": {
        "lesson_key": "c2-breaking-news-uncertainty-03",
        "text": {
          "en": "In fast-moving news, accuracy includes the discipline to update, retract and leave uncertainty visible as evidence changes."
        },
        "translations": {
          "fa": "در خبر سریع، دقت یعنی انضباط برای به‌روزرسانی، پس گرفتن ادعا و آشکار نگه داشتن عدم قطعیت وقتی شواهد عوض می‌شن."
        },
        "intent": "summarize_news_verification",
