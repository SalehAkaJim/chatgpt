    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_rapport",
      "data": {
        "lesson_key": "c2-executive-networking-01",
        "text": {
          "en": "I would start with genuine rapport rather than the request; otherwise the interaction becomes transactional immediately."
        },
        "translations": {
          "fa": "با ارتباط واقعی شروع می‌کنم نه با درخواست؛ وگرنه تعامل از همون اول کاملاً معامله‌ای می‌شه."
        },
        "intent": "build_network_rapport",
        "concept_refs": [
          "c2_executive_networking_rapport",
          "c2_executive_networking_transactional"
        ],
        "cefr": "C2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_position",
      "data": {
        "lesson_key": "c2-executive-networking-01",
        "text": {
          "en": "Effective positioning is not self-promotion alone; it is making your relevance legible without overstating it."
        },
        "translations": {
          "fa": "جایگاه‌سازی مؤثر فقط خودتبلیغی نیست؛ یعنی ارتباط و ارزش خودت رو روشن کنی بدون اغراق."
        },
        "intent": "position_professionally",
        "concept_refs": [
          "c2_executive_networking_positioning",
          "c2_executive_networking_credibility"
        ],
        "cefr": "C2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_context",
      "data": {
        "lesson_key": "c2-executive-networking-02",
        "text": {
          "en": "Let me contextualize the introduction: you are both working on the same problem from different sides, so the connection may be useful to each of you."
        },
        "translations": {
          "fa": "بذار معرفی رو زمینه‌دار کنم: هر دوتون روی یک مسئله از دو سمت مختلف کار می‌کنید، پس این ارتباط ممکنه برای هر دو مفید باشه."
        },
        "intent": "make_relevant_introduction",
        "concept_refs": [
          "c2_executive_networking_contextualize",
          "c2_executive_networking_mutual"
        ],
        "cefr": "C2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_reciprocity",
      "data": {
        "lesson_key": "c2-executive-networking-02",
        "text": {
          "en": "Reciprocity accumulates over time; one useful introduction can matter more than repeatedly asking for small favors."
        },
        "translations": {
          "fa": "تعامل دوطرفه در طول زمان ساخته می‌شه؛ یک معرفی مفید می‌تونه از چندین درخواست کوچک ارزشمندتر باشه."
        },
        "intent": "build_reciprocity",
        "concept_refs": [
          "c2_executive_networking_reciprocity",
          "c2_executive_networking_referral"
        ],
        "cefr": "C2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_referral",
      "data": {
        "lesson_key": "c2-executive-networking-03",
        "text": {
          "en": "A referral carries borrowed credibility, so I would never ask someone to make one before they understand the fit."
        },
        "translations": {
          "fa": "معرفی بخشی از اعتبار معرف رو منتقل می‌کنه، پس قبل از اینکه طرف تناسب رو بفهمه ازش چنین درخواستی نمی‌کنم."
        },
        "intent": "handle_referral_ethically",
        "concept_refs": [
          "c2_executive_networking_referral",
          "c2_executive_networking_credibility"
        ],
        "cefr": "C2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_mutual",
      "data": {
        "lesson_key": "c2-executive-networking-03",
        "text": {
          "en": "The strongest relationships are mutual without being mechanically balanced; value can move in different forms at different times."
        },
        "translations": {
          "fa": "قوی‌ترین رابطه‌ها دوطرفه‌ان بدون اینکه مکانیکی و حسابداری‌شده باشن؛ ارزش می‌تونه در زمان‌های مختلف شکل‌های متفاوتی داشته باشه."
        },
        "intent": "explain_mutuality",
        "concept_refs": [
          "c2_executive_networking_mutual",
          "c2_executive_networking_reciprocity"
        ],
        "cefr": "C2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_follow",
      "data": {
        "lesson_key": "c2-executive-networking-03",
        "text": {
          "en": "I would follow up with one specific reference to the conversation rather than a generic 'great to connect' message."
        },
        "translations": {
          "fa": "برای پیگیری به یک نکته مشخص از گفتگو اشاره می‌کنم نه یک پیام کلی مثل great to connect."
        },
        "intent": "follow_up_meaningfully",
        "concept_refs": [
          "c2_executive_networking_rapport",
          "c2_executive_networking_contextualize"
        ],
        "cefr": "C2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_executive_networking_summary",
      "data": {
        "lesson_key": "c2-executive-networking-03",
        "text": {
          "en": "Sophisticated networking makes relevance, reciprocity and boundaries visible while keeping the relationship human rather than purely instrumental."
        },
        "translations": {
          "fa": "شبکه‌سازی پخته ارتباط، تعامل دوطرفه و مرزها رو روشن می‌کنه و رابطه رو انسانی نگه می‌داره نه صرفاً ابزاری."
        },
        "intent": "summarize_networking",
        "concept_refs": [
          "c2_executive_networking_reciprocity",
