    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_metaphor",
      "data": {
        "lesson_key": "c2-figurative-language-01",
        "text": {
          "en": "Calling the reform a 'bridge' frames it as a temporary connection between two states rather than a destination in itself."
        },
        "translations": {
          "fa": "اینکه اصلاحات رو bridge بنامیم اون رو به‌عنوان اتصال موقت بین دو وضعیت قاب‌بندی می‌کنه نه مقصد نهایی."
        },
        "intent": "analyze_conceptual_metaphor",
        "concept_refs": [
          "c2_figurative_language_metaphor",
          "c2_figurative_language_figurative"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_literal",
      "data": {
        "lesson_key": "c2-figurative-language-01",
        "text": {
          "en": "A literal paraphrase preserves the basic information but often loses the emotional and evaluative work done by the original image."
        },
        "translations": {
          "fa": "بازگویی لفظی اطلاعات اصلی رو نگه می‌داره ولی اغلب کار احساسی و ارزشی تصویر اصلی رو از دست می‌ده."
        },
        "intent": "compare_literal_figurative",
        "concept_refs": [
          "c2_figurative_language_literal",
          "c2_figurative_language_resonance"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_connotation",
      "data": {
        "lesson_key": "c2-figurative-language-02",
        "text": {
          "en": "The phrase 'tighten the net' carries a connotation of pursuit and restriction that 'improve enforcement' does not."
        },
        "translations": {
          "fa": "عبارت tighten the net بار معنایی تعقیب و محدودیت داره که improve enforcement نداره."
        },
        "intent": "analyze_connotation",
        "concept_refs": [
          "c2_figurative_language_connotation",
          "c2_figurative_language_evoke"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_schema",
      "data": {
        "lesson_key": "c2-figurative-language-02",
        "text": {
          "en": "The argument repeatedly uses an image schema of upward movement, which subtly associates progress with height and decline with descent."
        },
        "translations": {
          "fa": "استدلال بارها از الگوی تصویری حرکت رو به بالا استفاده می‌کنه و ظریفاً پیشرفت رو با ارتفاع و پسرفت رو با پایین رفتن پیوند می‌ده."
        },
        "intent": "analyze_image_schema",
        "concept_refs": [
          "c2_figurative_language_image_schema",
          "c2_figurative_language_metaphor"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_idiom",
      "data": {
        "lesson_key": "c2-figurative-language-03",
        "text": {
          "en": "An idiom may be fully conventional for native speakers while remaining opaque to a learner who knows every individual word."
        },
        "translations": {
          "fa": "یک اصطلاح ممکنه برای گوینده بومی کاملاً عادی باشه ولی برای زبان‌آموزی که تک‌تک واژه‌ها رو می‌دونه همچنان نامفهوم بمونه."
        },
        "intent": "explain_idiom_opacity",
        "concept_refs": [
          "c2_figurative_language_idiom",
          "c2_figurative_language_literal"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_evoke",
      "data": {
        "lesson_key": "c2-figurative-language-03",
        "text": {
          "en": "The writer chooses 'drift' rather than 'change' because it evokes movement without deliberate control."
        },
        "translations": {
          "fa": "نویسنده drift رو به‌جای change انتخاب می‌کنه چون حرکت بدون کنترل آگاهانه رو تداعی می‌کنه."
        },
        "intent": "interpret_word_image",
        "concept_refs": [
          "c2_figurative_language_evoke",
          "c2_figurative_language_connotation"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_resonance",
      "data": {
        "lesson_key": "c2-figurative-language-03",
        "text": {
          "en": "The metaphor gains resonance later when the same image returns in a different emotional context."
        },
        "translations": {
          "fa": "استعاره بعداً وقتی همون تصویر در زمینه احساسی متفاوت برمی‌گرده طنین بیشتری پیدا می‌کنه."
        },
        "intent": "track_metaphor_resonance",
        "concept_refs": [
          "c2_figurative_language_resonance",
          "c2_figurative_language_metaphor"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_figurative_language_summary",
      "data": {
        "lesson_key": "c2-figurative-language-03",
        "text": {
          "en": "Advanced figurative comprehension asks what an image selects, what it hides, what it evokes and why that framing matters in context."
        },
        "translations": {
          "fa": "فهم پیشرفته زبان تصویری می‌پرسه یک تصویر چی رو انتخاب می‌کنه، چی رو پنهان می‌کنه، چی رو تداعی می‌کنه و چرا این قاب‌بندی در اون زمینه مهمه."
        },
        "intent": "summarize_figurative_analysis",
        "concept_refs": [
          "c2_figurative_language_figurative",
          "c2_figurative_language_connotation",
          "c2_figurative_language_metaphor"
        ],
        "cefr": "C2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
