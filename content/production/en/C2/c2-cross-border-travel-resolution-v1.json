    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_route",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-01",
        "text": {
          "en": "The fastest rerouting is not useful if the operating carrier cannot honor the ticket under the current agreement."
        },
        "translations": {
          "fa": "سریع‌ترین مسیر جایگزین وقتی فایده نداره که شرکت اجراکننده طبق توافق فعلی نتونه بلیت رو قبول کنه."
        },
        "intent": "evaluate_rerouting",
        "concept_refs": [
          "c2_cross_border_travel_resolution_rerouting",
          "c2_cross_border_travel_resolution_interline"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_liability",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-01",
        "text": {
          "en": "I need to separate operational help from liability; the desk assisting me may not be the party responsible for reimbursement."
        },
        "translations": {
          "fa": "باید کمک عملیاتی رو از مسئولیت مالی جدا کنم؛ میزی که کمکم می‌کنه شاید مسئول بازپرداخت نباشه."
        },
        "intent": "separate_help_liability",
        "concept_refs": [
          "c2_cross_border_travel_resolution_liability",
          "c2_cross_border_travel_resolution_reimbursement"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_docs",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-02",
        "text": {
          "en": "I am keeping every receipt and written refusal because documentation matters if the claim later moves to formal review."
        },
        "translations": {
          "fa": "همه رسیدها و ردهای کتبی رو نگه می‌دارم چون اگر پرونده به بازبینی رسمی برسه مدارک مهم می‌شن."
        },
        "intent": "preserve_documentation",
        "concept_refs": [
          "c2_cross_border_travel_resolution_documentation",
          "c2_cross_border_travel_resolution_reimbursement"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_entitlement",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-02",
        "text": {
          "en": "My entitlement may depend on the cause of the disruption, the route and which carrier actually operated the affected segment."
        },
        "translations": {
          "fa": "حق من ممکنه به علت اختلال، مسیر و اینکه کدوم شرکت واقعاً بخش آسیب‌دیده رو اجرا کرده بستگی داشته باشه."
        },
        "intent": "scope_entitlement",
        "concept_refs": [
          "c2_cross_border_travel_resolution_entitlement",
          "c2_cross_border_travel_resolution_disruption"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_jurisdiction",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-03",
        "text": {
          "en": "Because the itinerary crosses jurisdictions, the applicable passenger rights may not be determined by the departure country alone."
        },
        "translations": {
          "fa": "چون مسیر از چند حوزه قضایی رد می‌شه، حقوق مسافر لزوماً فقط با کشور مبدأ تعیین نمی‌شه."
        },
        "intent": "consider_jurisdiction",
        "concept_refs": [
          "c2_cross_border_travel_resolution_jurisdiction",
          "c2_cross_border_travel_resolution_entitlement"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_interline",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-03",
        "text": {
          "en": "An interline agreement can solve ticketing logistics without making the second carrier responsible for the original delay."
        },
        "translations": {
          "fa": "توافق بین شرکت‌ها می‌تونه مشکل بلیت رو حل کنه بدون اینکه شرکت دوم مسئول تأخیر اولیه بشه."
        },
        "intent": "distinguish_interline_responsibility",
        "concept_refs": [
          "c2_cross_border_travel_resolution_interline",
          "c2_cross_border_travel_resolution_liability"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_escalate",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-03",
        "text": {
          "en": "I would ask for the decision and policy basis in writing before escalating; that makes the next review much more efficient."
        },
        "translations": {
          "fa": "قبل از ارجاع بالاتر، تصمیم و مبنای سیاست رو کتبی می‌خوام؛ این بازبینی بعدی رو خیلی مؤثرتر می‌کنه."
        },
        "intent": "prepare_travel_escalation",
        "concept_refs": [
          "c2_cross_border_travel_resolution_documentation",
          "c2_cross_border_travel_resolution_entitlement"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_c2_cross_border_travel_resolution_summary",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-03",
        "text": {
          "en": "Complex travel resolution depends on mapping the disruption, carrier roles, contractual rights, jurisdiction and evidence before choosing the escalation route."
        },
        "translations": {
          "fa": "حل اختلال پیچیده سفر به این بستگی داره که اختلال، نقش شرکت‌ها، حقوق قراردادی، حوزه قضایی و مدارک رو قبل از انتخاب مسیر اعتراض مشخص کنیم."
        },
        "intent": "summarize_travel_resolution",
        "concept_refs": [
          "c2_cross_border_travel_resolution_disruption",
          "c2_cross_border_travel_resolution_liability",
          "c2_cross_border_travel_resolution_jurisdiction"
        ],
        "cefr": "C2",
        "topic": "transport",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c2_cross_border_travel_resolution_diplomatic_language",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-01",
        "slug": "c2-cross-border-travel-resolution-diplomatic-language",
        "title": "Diplomatic challenge and disagreement",
        "rule_summary": "Challenge an idea rather than a person, acknowledge intent, and soften direct negatives while keeping the substantive point clear.",
        "explanation": {
          "fa": "به‌جای شخص، ایده را به چالش می‌کشیم؛ نیت را می‌پذیریم و بدون مبهم کردن اصل پیام، منفی مستقیم را نرم‌تر می‌کنیم."
        },
        "examples": [
          {
            "en": "I see the logic, though I'm not convinced the assumption holds in this case.",
            "fa": "منطقش را می‌بینم، هرچند قانع نشده‌ام این فرض در این مورد برقرار باشد."
          },
          {
            "en": "That may be true in principle, but the practical constraints are different.",
            "fa": "در اصل شاید درست باشد، اما محدودیت‌های عملی متفاوت‌اند."
          }
        ],
        "cefr": "C2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c2_cross_border_travel_resolution_complex_prepositions",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-02",
        "slug": "c2-cross-border-travel-resolution-complex-prepositions",
        "title": "Complex prepositional phrases",
        "rule_summary": "Use in light of, with regard to, in the absence of, by virtue of, and at the expense of to express precise logical relations.",
        "explanation": {
          "fa": "برای بیان روابط منطقی دقیق از in light of، with regard to، in the absence of، by virtue of و at the expense of استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "In light of the new evidence, the recommendation should be revised.",
            "fa": "با توجه به شواهد جدید، توصیه باید بازبینی شود."
          },
          {
            "en": "Efficiency should not come at the expense of accessibility.",
            "fa": "کارایی نباید به قیمت دسترسی‌پذیری تمام شود."
          }
        ],
        "cefr": "C2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_c2_cross_border_travel_resolution_reporting_passive",
      "data": {
        "lesson_key": "c2-cross-border-travel-resolution-03",
        "slug": "c2-cross-border-travel-resolution-reporting-passive",
        "title": "Impersonal reporting structures",
        "rule_summary": "Use structures such as is thought to, is believed to, and has been reported to when the source is general or deliberately backgrounded.",
        "explanation": {
          "fa": "وقتی منبع عمومی است یا عمداً در پس‌زمینه قرار می‌گیرد از ساختارهایی مثل is thought to، is believed to و has been reported to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The policy is thought to have reduced short-term demand.",
            "fa": "گمان می‌رود این سیاست تقاضای کوتاه‌مدت را کاهش داده باشد."
          },
          {
            "en": "The company is reported to be reconsidering the plan.",
            "fa": "گزارش شده شرکت در حال بازنگری برنامه است."
          }
        ],
