    },
    {
      "kind": "utterance",
      "external_id": "u_b2_projects_deadlines_scope",
      "data": {
        "lesson_key": "b2-projects-deadlines-02",
        "text": {
          "en": "If we keep the current scope, we'll probably need either more time or another developer."
        },
        "translations": {
          "fa": "اگر دامنه فعلی رو نگه داریم احتمالاً یا زمان بیشتر لازم داریم یا یک توسعه‌دهنده دیگه."
        },
        "intent": "connect_scope_resources",
        "concept_refs": [
          "b2_projects_deadlines_scope"
        ],
        "cefr": "B2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_projects_deadlines_risk",
      "data": {
        "lesson_key": "b2-projects-deadlines-02",
        "text": {
          "en": "The main risk is discovering a technical problem too late to change the design safely."
        },
        "translations": {
          "fa": "ریسک اصلی اینه که مشکل فنی رو اون‌قدر دیر پیدا کنیم که تغییر امن طراحی سخت بشه."
        },
        "intent": "identify_project_risk",
        "concept_refs": [
          "b2_projects_deadlines_risk"
        ],
        "cefr": "B2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_projects_deadlines_delay",
      "data": {
        "lesson_key": "b2-projects-deadlines-03",
        "text": {
          "en": "The delay was caused by a supplier issue, so the testing window has been shortened."
        },
        "translations": {
          "fa": "تأخیر به خاطر مشکل تأمین‌کننده بود، برای همین بازه تست کوتاه شده."
        },
        "intent": "explain_delay",
        "concept_refs": [
          "b2_projects_deadlines_delay"
        ],
        "cefr": "B2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_projects_deadlines_contingency",
      "data": {
        "lesson_key": "b2-projects-deadlines-03",
        "text": {
          "en": "Our contingency is to deliver the core feature first and move the optional part to the next release."
        },
        "translations": {
          "fa": "برنامه جایگزینمون اینه که اول قابلیت اصلی رو تحویل بدیم و بخش اختیاری رو به انتشار بعدی منتقل کنیم."
        },
        "intent": "describe_contingency",
        "concept_refs": [
          "b2_projects_deadlines_contingency",
          "b2_projects_deadlines_delivery"
        ],
        "cefr": "B2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_projects_deadlines_forecast",
      "data": {
        "lesson_key": "b2-projects-deadlines-03",
        "text": {
          "en": "At the moment, I expect a three-day delay unless the dependency is cleared by Wednesday."
        },
        "translations": {
          "fa": "فعلاً انتظار دارم سه روز تأخیر داشته باشیم مگر اینکه وابستگی تا چهارشنبه رفع بشه."
        },
        "intent": "forecast_deadline",
        "concept_refs": [
          "b2_projects_deadlines_delay",
          "b2_projects_deadlines_dependency"
        ],
        "cefr": "B2",
        "topic": "jobs",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_projects_deadlines_decision",
      "data": {
        "lesson_key": "b2-projects-deadlines-03",
        "text": {
          "en": "I'd rather reset the deadline now than protect an unrealistic date and reduce quality later."
        },
        "translations": {
          "fa": "ترجیح می‌دم الان موعد رو اصلاح کنیم تا اینکه از تاریخ غیرواقعی دفاع کنیم و بعداً کیفیت رو پایین بیاریم."
        },
        "intent": "recommend_deadline_change",
        "concept_refs": [
          "b2_projects_deadlines_delivery",
          "b2_projects_deadlines_risk"
        ],
        "cefr": "B2",
