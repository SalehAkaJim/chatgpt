      "data": {
        "lesson_key": "b2-projects-deadlines-01",
        "text": {
          "en": "The biggest dependency is an external approval that we don't control directly."
        },
        "translations": {
          "fa": "بزرگ‌ترین وابستگی یک تأیید بیرونیه که مستقیم کنترلش نمی‌کنیم."
