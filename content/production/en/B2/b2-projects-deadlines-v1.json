    {
      "kind": "grammar_point",
      "external_id": "g_b2_projects_deadlines_future_forms",
      "data": {
        "lesson_key": "b2-projects-deadlines-01",
        "slug": "b2-projects-deadlines-future-forms",
        "title": "Choosing future forms",
        "rule_summary": "Use will for decisions and predictions, be going to for intentions, and present continuous for fixed arrangements.",
        "explanation": {
          "fa": "از will برای تصمیم و پیش‌بینی، be going to برای قصد و present continuous برای برنامه قطعی استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'll check the later train.",
            "fa": "قطار بعدی را بررسی می‌کنم."
          },
          {
            "en": "We're meeting the guide at nine.",
            "fa": "ساعت نه راهنما را می‌بینیم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_projects_deadlines_passive",
      "data": {
        "lesson_key": "b2-projects-deadlines-02",
        "slug": "b2-projects-deadlines-passive",
        "title": "Passive voice",
        "rule_summary": "Use the passive when the action or result matters more than who performed it.",
        "explanation": {
          "fa": "وقتی خود عمل یا نتیجه مهم‌تر از انجام‌دهنده است از مجهول استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The booking was changed without notice.",
            "fa": "رزرو بدون اطلاع تغییر داده شد."
          },
          {
            "en": "The device should be checked by a technician.",
            "fa": "دستگاه باید توسط تکنسین بررسی شود."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_projects_deadlines_cause_result",
      "data": {
        "lesson_key": "b2-projects-deadlines-03",
        "slug": "b2-projects-deadlines-cause-result",
        "title": "Cause and result connectors",
        "rule_summary": "Use because of and due to before noun phrases, and therefore, so, or as a result to introduce consequences.",
        "explanation": {
          "fa": "before اسم از because of و due to و برای نتیجه از therefore، so یا as a result استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The event was moved due to the weather.",
            "fa": "برنامه به دلیل هوا جابه‌جا شد."
          },
          {
            "en": "Demand increased; as a result, prices rose.",
            "fa": "تقاضا بالا رفت؛ در نتیجه قیمت‌ها افزایش پیدا کرد."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_projects_deadlines_scene_1",
      "data": {
        "lesson_key": "b2-projects-deadlines-01",
        "title": "Projects & Deadlines: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "jobs",
        "characters": [
          "Mei",
          "Omar"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mei",
            "text": "How would you handle this situation?",
            "translation_fa": "تو این موقعیت رو چطور مدیریت می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "Omar",
            "text": "We're on track for the first milestone, but the final delivery date is becoming less certain.",
            "translation_fa": "برای نقطه عطف اول طبق برنامه‌ایم، ولی تاریخ تحویل نهایی داره نامطمئن‌تر می‌شه."
          },
          {
            "order": 3,
            "speaker": "Mei",
            "text": "What would you consider before deciding?",
            "translation_fa": "قبل از تصمیم گرفتن چه چیزی رو در نظر می‌گرفتی؟"
          },
          {
            "order": 4,
            "speaker": "Omar",
            "text": "The biggest dependency is an external approval that we don't control directly.",
            "translation_fa": "بزرگ‌ترین وابستگی یک تأیید بیرونیه که مستقیم کنترلش نمی‌کنیم."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_projects_deadlines_scene_2",
      "data": {
        "lesson_key": "b2-projects-deadlines-02",
        "title": "Projects & Deadlines: part 2",
        "setting": "video call",
        "cefr": "B2",
        "topic": "jobs",
        "characters": [
          "Ava",
          "Ben"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ava",
            "text": "What's changed compared with before?",
            "translation_fa": "نسبت به قبل چی تغییر کرده؟"
          },
          {
