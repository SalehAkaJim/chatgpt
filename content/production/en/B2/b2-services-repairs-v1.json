    {
      "kind": "grammar_point",
      "external_id": "g_b2_services_repairs_causative",
      "data": {
        "lesson_key": "b2-services-repairs-01",
        "slug": "b2-services-repairs-causative",
        "title": "have / get something done",
        "rule_summary": "Use have or get + object + past participle when another person performs a service for you.",
        "explanation": {
          "fa": "وقتی شخص دیگری کاری خدماتی را برای ما انجام می‌دهد از have/get + object + past participle استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I had the screen replaced last week.",
            "fa": "هفته پیش صفحه را عوض کردم/دادم عوض کنند."
          },
          {
            "en": "We need to get the brakes checked.",
            "fa": "باید ترمزها را بدهیم بررسی کنند."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_services_repairs_passive",
      "data": {
        "lesson_key": "b2-services-repairs-02",
        "slug": "b2-services-repairs-passive",
        "title": "Passive voice",
        "rule_summary": "Use the passive when the action or result matters more than who performed it.",
        "explanation": {
          "fa": "وقتی خود عمل یا نتیجه مهم‌تر از انجام‌دهنده است از مجهول استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The booking was changed without notice.",
            "fa": "رزرو بدون اطلاع تغییر داده شد."
          },
          {
            "en": "The device should be checked by a technician.",
            "fa": "دستگاه باید توسط تکنسین بررسی شود."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_services_repairs_reported_speech",
      "data": {
        "lesson_key": "b2-services-repairs-03",
        "slug": "b2-services-repairs-reported-speech",
        "title": "Reported speech",
        "rule_summary": "Use reported speech to relay what someone said, asked, or promised while adjusting pronouns and time references when needed.",
        "explanation": {
          "fa": "برای انتقال حرف، سؤال یا قول دیگران از reported speech استفاده می‌کنیم و در صورت نیاز ضمیر و زمان را تغییر می‌دهیم."
        },
        "examples": [
          {
            "en": "She said the repair would take two days.",
            "fa": "گفت تعمیر دو روز طول می‌کشد."
          },
          {
            "en": "They asked whether I had the receipt.",
            "fa": "پرسیدند آیا رسید را دارم یا نه."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_services_repairs_scene_1",
      "data": {
        "lesson_key": "b2-services-repairs-01",
        "title": "Services, Repairs & Follow-up: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "shopping",
        "characters": [
          "Ella",
          "Amir"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ella",
            "text": "What's changed compared with before?",
            "translation_fa": "نسبت به قبل چی تغییر کرده؟"
          },
          {
            "order": 2,
            "speaker": "Amir",
            "text": "The fault only appears after the device has been running for about twenty minutes.",
            "translation_fa": "ایراد فقط بعد از حدود بیست دقیقه روشن بودن دستگاه ظاهر می‌شه."
          },
          {
            "order": 3,
            "speaker": "Ella",
            "text": "And what effect has that had?",
            "translation_fa": "و این چه اثری داشته؟"
          },
          {
            "order": 4,
            "speaker": "Amir",
            "text": "The technician said they needed another day to diagnose the cause properly.",
            "translation_fa": "تکنسین گفت برای عیب‌یابی درست علت یک روز دیگه زمان لازم داره."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_services_repairs_scene_2",
      "data": {
        "lesson_key": "b2-services-repairs-02",
        "title": "Services, Repairs & Follow-up: part 2",
        "setting": "video call",
        "cefr": "B2",
        "topic": "shopping",
        "characters": [
          "Emma",
          "Kai"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Emma",
            "text": "Which option seems more realistic to you?",
            "translation_fa": "کدوم گزینه به نظرت واقع‌بینانه‌تره؟"
          },
          {
            "order": 2,
