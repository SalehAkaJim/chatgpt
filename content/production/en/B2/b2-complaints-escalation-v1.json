    {
      "kind": "grammar_point",
      "external_id": "g_b2_complaints_escalation_present_perfect",
      "data": {
        "lesson_key": "b2-complaints-escalation-01",
        "slug": "b2-complaints-escalation-present-perfect",
        "title": "Present perfect for unresolved situations",
        "rule_summary": "Use the present perfect for actions or situations connected to now, especially previous attempts, progress, and recent changes.",
        "explanation": {
          "fa": "برای کارها یا وضعیت‌هایی که به حال مربوط‌اند، مخصوصاً تلاش‌های قبلی و تغییرات اخیر، از present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've contacted support twice.",
            "fa": "دو بار با پشتیبانی تماس گرفته‌ام."
          },
          {
            "en": "The problem has become more frequent.",
            "fa": "مشکل بیشتر شده است."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_complaints_escalation_passive",
      "data": {
        "lesson_key": "b2-complaints-escalation-02",
        "slug": "b2-complaints-escalation-passive",
        "title": "Passive voice",
        "rule_summary": "Use the passive when the action or result matters more than who performed it.",
        "explanation": {
          "fa": "وقتی خود عمل یا نتیجه مهم‌تر از انجام‌دهنده است از مجهول استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The booking was changed without notice.",
            "fa": "رزرو بدون اطلاع تغییر داده شد."
          },
          {
            "en": "The device should be checked by a technician.",
            "fa": "دستگاه باید توسط تکنسین بررسی شود."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_complaints_escalation_formal_requests",
      "data": {
        "lesson_key": "b2-complaints-escalation-03",
        "slug": "b2-complaints-escalation-formal-requests",
        "title": "Firm but polite formal requests",
        "rule_summary": "Use would like, could you, and I would appreciate it if to make clear requests without sounding aggressive.",
        "explanation": {
          "fa": "برای درخواست روشن ولی محترمانه از would like، could you و I would appreciate it if استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I would like this issue reviewed today.",
            "fa": "می‌خواهم این مشکل امروز بررسی شود."
          },
          {
            "en": "I would appreciate it if you could confirm the refund.",
            "fa": "ممنون می‌شوم اگر بازپرداخت را تأیید کنید."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_complaints_escalation_scene_1",
      "data": {
        "lesson_key": "b2-complaints-escalation-01",
        "title": "Complaints & Escalation: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "Nora",
          "Samir"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Nora",
            "text": "What do you think is the main issue here?",
            "translation_fa": "فکر می‌کنی مسئله اصلی اینجا چیه؟"
          },
          {
            "order": 2,
            "speaker": "Samir",
            "text": "I've contacted support twice already, but the issue is still unresolved.",
            "translation_fa": "تا حالا دو بار با پشتیبانی تماس گرفته‌ام، ولی مشکل هنوز حل نشده."
          },
          {
            "order": 3,
            "speaker": "Nora",
            "text": "What makes that the most important point?",
            "translation_fa": "چی باعث می‌شه این مهم‌ترین نکته باشه؟"
          },
          {
            "order": 4,
            "speaker": "Samir",
            "text": "The repeated cancellations have caused significant inconvenience because I rearranged my schedule each time.",
            "translation_fa": "لغوهای تکراری دردسر زیادی ایجاد کرده چون هر بار برنامه‌ام رو جابه‌جا کردم."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
