    {
      "kind": "grammar_point",
      "external_id": "g_b2_future_possibilities_probability_modals",
      "data": {
        "lesson_key": "b2-future-possibilities-01",
        "slug": "b2-future-possibilities-probability-modals",
        "title": "Degrees of future probability",
        "rule_summary": "Use will for confident predictions and may, might, or could for less certain possibilities.",
        "explanation": {
          "fa": "برای پیش‌بینی مطمئن‌تر از will و برای احتمال کمتر از may، might یا could استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The plan will probably change.",
            "fa": "احتمالاً برنامه تغییر می‌کند."
          },
          {
            "en": "We might need more time.",
            "fa": "ممکن است به زمان بیشتری نیاز داشته باشیم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_future_possibilities_future_time",
      "data": {
        "lesson_key": "b2-future-possibilities-02",
        "slug": "b2-future-possibilities-future-time",
        "title": "Future time clauses",
        "rule_summary": "After when, as soon as, before, and until, use a present form to refer to the future.",
        "explanation": {
          "fa": "بعد از when، as soon as، before و until برای اشاره به آینده معمولاً از زمان حال استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'll call you when I arrive.",
            "fa": "وقتی برسم بهت زنگ می‌زنم."
          },
          {
            "en": "We'll decide after we hear back.",
            "fa": "بعد از اینکه جواب بگیریم تصمیم می‌گیریم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_future_possibilities_hedging",
      "data": {
        "lesson_key": "b2-future-possibilities-03",
        "slug": "b2-future-possibilities-hedging",
        "title": "Hedging opinions",
        "rule_summary": "Use phrases such as I tend to think, it seems to me, and to some extent to avoid sounding absolute.",
        "explanation": {
          "fa": "برای قطعی و مطلق به نظر نرسیدن از عبارت‌هایی مثل I tend to think، it seems to me و to some extent استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I tend to think the benefits outweigh the risks.",
            "fa": "فکر می‌کنم معمولاً مزایا بیشتر از ریسک‌هاست."
          },
          {
            "en": "To some extent, I agree.",
            "fa": "تا حدی موافقم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
