    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_setup",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-01",
        "text": {
          "en": "I had planned everything carefully, but one small mistake changed the whole day."
        },
        "translations": {
          "fa": "همه‌چیز را با دقت برنامه‌ریزی کرده بودم، ولی یک اشتباه کوچک کل روز را عوض کرد."
        },
        "intent": "set_up_story",
        "concept_refs": [
          "b2_detailed_personal_stories_overlook"
        ],
        "cefr": "B2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_earlier",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-01",
        "text": {
          "en": "By the time I reached the station, the train had already left."
        },
        "translations": {
          "fa": "تا وقتی به ایستگاه رسیدم، قطار قبلاً رفته بود."
        },
        "intent": "show_earlier_past",
        "concept_refs": [
          "b2_detailed_personal_stories_delay"
        ],
        "cefr": "B2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_assumption",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-01",
        "text": {
          "en": "I'd assumed the departure time was the same as usual, which turned out to be wrong."
        },
        "translations": {
          "fa": "فرض کرده بودم زمان حرکت مثل همیشه است، که معلوم شد اشتباه بوده."
        },
        "intent": "explain_mistaken_assumption",
        "concept_refs": [
          "b2_detailed_personal_stories_assume"
        ],
        "cefr": "B2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_meanwhile",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-02",
        "text": {
          "en": "Meanwhile, my friends were waiting at the next station and had no idea what had happened."
        },
        "translations": {
          "fa": "در همین حین، دوست‌هام در ایستگاه بعدی منتظر بودند و اصلاً نمی‌دانستند چه اتفاقی افتاده."
        },
        "intent": "add_parallel_event",
        "concept_refs": [
          "b2_detailed_personal_stories_meanwhile"
        ],
        "cefr": "B2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_rush",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-02",
        "text": {
          "en": "I rushed to find another route, but every option involved at least an hour's delay."
        },
        "translations": {
          "fa": "با عجله دنبال مسیر دیگری گشتم، ولی هر گزینه حداقل یک ساعت تأخیر داشت."
        },
        "intent": "develop_story",
        "concept_refs": [
          "b2_detailed_personal_stories_rush",
          "b2_detailed_personal_stories_delay"
        ],
        "cefr": "B2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_fortunate",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-02",
        "text": {
          "en": "Fortunately, a staff member suggested a bus connection I hadn't noticed."
        },
        "translations": {
          "fa": "خوشبختانه یکی از کارکنان یک اتصال اتوبوسی پیشنهاد داد که من ندیده بودم."
        },
        "intent": "introduce_solution",
        "concept_refs": [
          "b2_detailed_personal_stories_fortunately",
          "b2_detailed_personal_stories_overlook"
        ],
        "cefr": "B2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_ending",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-03",
        "text": {
          "en": "Eventually, I arrived just before the event started, exhausted but relieved."
        },
        "translations": {
          "fa": "در نهایت درست قبل از شروع برنامه رسیدم؛ خسته ولی خیالم راحت بود."
        },
        "intent": "close_story",
        "concept_refs": [
          "b2_detailed_personal_stories_eventually"
        ],
        "cefr": "B2",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_detailed_personal_stories_reflection",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-03",
        "text": {
          "en": "In hindsight, the real turning point was asking for help instead of trying to solve everything alone."
        },
        "translations": {
          "fa": "حالا که به گذشته نگاه می‌کنم، نقطه عطف واقعی این بود که به‌جای حل کردن همه‌چیز به‌تنهایی کمک خواستم."
        },
        "intent": "reflect_on_story",
