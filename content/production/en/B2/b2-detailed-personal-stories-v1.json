    {
      "kind": "grammar_point",
      "external_id": "g_b2_detailed_personal_stories_past_perfect",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-01",
        "slug": "b2-detailed-personal-stories-past-perfect",
        "title": "Past perfect for earlier past events",
        "rule_summary": "Use had + past participle to make clear that one past event happened before another past reference point.",
        "explanation": {
          "fa": "از had + شکل سوم فعل استفاده می‌کنیم تا روشن کنیم یک اتفاق قبل از اتفاق دیگری در گذشته رخ داده است."
        },
        "examples": [
          {
            "en": "The train had left before I reached the platform.",
            "fa": "قطار قبل از اینکه به سکو برسم رفته بود."
          },
          {
            "en": "I realized I'd read the wrong time.",
            "fa": "فهمیدم ساعت اشتباهی را خوانده بودم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_detailed_personal_stories_narrative_contrast",
      "data": {
        "lesson_key": "b2-detailed-personal-stories-02",
        "slug": "b2-detailed-personal-stories-narrative-contrast",
        "title": "Past simple, continuous, and perfect together",
        "rule_summary": "Combine narrative tenses to distinguish the main events, background actions, and events that happened even earlier.",
