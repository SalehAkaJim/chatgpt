    {
      "kind": "grammar_point",
      "external_id": "g_b2_wellbeing_lifestyle_gerunds_infinitives",
      "data": {
        "lesson_key": "b2-wellbeing-lifestyle-01",
        "slug": "b2-wellbeing-lifestyle-gerunds-infinitives",
        "title": "Gerunds and infinitives",
        "rule_summary": "Use common verb patterns such as avoid doing, consider doing, decide to do, and aim to do accurately.",
        "explanation": {
          "fa": "الگوهای رایج فعل مثل avoid doing، consider doing، decide to do و aim to do را درست به کار می‌بریم."
        },
        "examples": [
          {
            "en": "I'm trying to improve my sleep.",
            "fa": "دارم سعی می‌کنم خوابم را بهتر کنم."
          },
          {
            "en": "I've considered reducing my screen time.",
            "fa": "به کم کردن زمان صفحه فکر کرده‌ام."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_wellbeing_lifestyle_conditionals",
      "data": {
        "lesson_key": "b2-wellbeing-lifestyle-02",
        "slug": "b2-wellbeing-lifestyle-conditionals",
        "title": "Conditionals for consequences",
        "rule_summary": "Use conditional clauses to connect a possible action with its likely or imagined consequence.",
        "explanation": {
          "fa": "با جمله‌های شرطی یک اقدام احتمالی را به نتیجه واقعی یا فرضی آن وصل می‌کنیم."
        },
        "examples": [
          {
            "en": "If we leave earlier, we'll avoid traffic.",
            "fa": "اگر زودتر راه بیفتیم از ترافیک دور می‌مانیم."
          },
          {
            "en": "If I had a larger budget, I'd choose the faster option.",
            "fa": "اگر بودجه بیشتری داشتم گزینه سریع‌تر را انتخاب می‌کردم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_wellbeing_lifestyle_cause_result",
      "data": {
        "lesson_key": "b2-wellbeing-lifestyle-03",
        "slug": "b2-wellbeing-lifestyle-cause-result",
        "title": "Cause and result connectors",
        "rule_summary": "Use because of and due to before noun phrases, and therefore, so, or as a result to introduce consequences.",
        "explanation": {
          "fa": "before اسم از because of و due to و برای نتیجه از therefore، so یا as a result استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The event was moved due to the weather.",
            "fa": "برنامه به دلیل هوا جابه‌جا شد."
          },
          {
            "en": "Demand increased; as a result, prices rose.",
            "fa": "تقاضا بالا رفت؛ در نتیجه قیمت‌ها افزایش پیدا کرد."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_wellbeing_lifestyle_scene_1",
      "data": {
        "lesson_key": "b2-wellbeing-lifestyle-01",
        "title": "Wellbeing & Lifestyle: part 1",
        "setting": "coffee break",
        "cefr": "B2",
