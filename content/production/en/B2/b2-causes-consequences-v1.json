    {
      "kind": "grammar_point",
      "external_id": "g_b2_causes_consequences_cause_forms",
      "data": {
        "lesson_key": "b2-causes-consequences-01",
        "slug": "b2-causes-consequences-cause-forms",
        "title": "because, because of, and due to",
        "rule_summary": "Use because before a clause, and because of or due to before a noun phrase.",
        "explanation": {
          "fa": "قبل از جمله کامل از because و قبل از عبارت اسمی از because of یا due to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The site failed because traffic increased.",
            "fa": "سایت از کار افتاد چون ترافیک زیاد شد."
          },
          {
            "en": "The delay was due to a server problem.",
            "fa": "تأخیر به دلیل مشکل سرور بود."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_causes_consequences_result_connectors",
      "data": {
        "lesson_key": "b2-causes-consequences-02",
        "slug": "b2-causes-consequences-result-connectors",
        "title": "therefore and as a result",
        "rule_summary": "Use result connectors to make the consequence of the previous idea explicit. Therefore is typically more formal than so.",
        "explanation": {
          "fa": "از connectorهای نتیجه برای روشن کردن پیامد نکته قبلی استفاده می‌کنیم. therefore معمولاً رسمی‌تر از so است."
        },
        "examples": [
          {
            "en": "Traffic doubled; as a result, the system slowed down.",
            "fa": "ترافیک دو برابر شد؛ در نتیجه سیستم کند شد."
          },
          {
            "en": "The backup failed; therefore, recovery took longer.",
            "fa": "سیستم پشتیبان از کار افتاد؛ بنابراین بازیابی بیشتر طول کشید."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_causes_consequences_multiple_causes",
      "data": {
        "lesson_key": "b2-causes-consequences-03",
