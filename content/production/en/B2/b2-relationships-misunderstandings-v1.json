    {
      "kind": "grammar_point",
      "external_id": "g_b2_relationships_misunderstandings_reported_speech",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-01",
        "slug": "b2-relationships-misunderstandings-reported-speech",
        "title": "Reported speech",
        "rule_summary": "Use reported speech to relay what someone said, asked, or promised while adjusting pronouns and time references when needed.",
        "explanation": {
          "fa": "برای انتقال حرف، سؤال یا قول دیگران از reported speech استفاده می‌کنیم و در صورت نیاز ضمیر و زمان را تغییر می‌دهیم."
        },
        "examples": [
          {
            "en": "She said the repair would take two days.",
            "fa": "گفت تعمیر دو روز طول می‌کشد."
          },
          {
            "en": "They asked whether I had the receipt.",
            "fa": "پرسیدند آیا رسید را دارم یا نه."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_relationships_misunderstandings_modal_deduction",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-02",
        "slug": "b2-relationships-misunderstandings-modal-deduction",
        "title": "Modal deduction",
        "rule_summary": "Use must, might, could, and can't to make different-strength deductions from available evidence.",
        "explanation": {
          "fa": "برای نتیجه‌گیری با درجه اطمینان متفاوت از must، might، could و can't استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "She must have misunderstood the message.",
            "fa": "حتماً پیام را اشتباه فهمیده."
          },
          {
            "en": "He might not have seen the update.",
            "fa": "شاید به‌روزرسانی را ندیده باشد."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_relationships_misunderstandings_conditionals",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-03",
        "slug": "b2-relationships-misunderstandings-conditionals",
        "title": "Conditionals for consequences",
        "rule_summary": "Use conditional clauses to connect a possible action with its likely or imagined consequence.",
        "explanation": {
          "fa": "با جمله‌های شرطی یک اقدام احتمالی را به نتیجه واقعی یا فرضی آن وصل می‌کنیم."
        },
        "examples": [
          {
            "en": "If we leave earlier, we'll avoid traffic.",
            "fa": "اگر زودتر راه بیفتیم از ترافیک دور می‌مانیم."
          },
          {
            "en": "If I had a larger budget, I'd choose the faster option.",
            "fa": "اگر بودجه بیشتری داشتم گزینه سریع‌تر را انتخاب می‌کردم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_relationships_misunderstandings_scene_1",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-01",
        "title": "Relationships & Misunderstandings: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "polite-language",
        "characters": [
          "Nora",
          "Samir"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Nora",
            "text": "What do you think is the main issue here?",
            "translation_fa": "فکر می‌کنی مسئله اصلی اینجا چیه؟"
          },
          {
            "order": 2,
            "speaker": "Samir",
            "text": "From my perspective, the message sounded final, but I can see why you read it differently.",
            "translation_fa": "از دید من پیام قطعی به نظر می‌رسید، ولی می‌فهمم چرا تو متفاوت برداشت کردی."
          },
          {
            "order": 3,
            "speaker": "Nora",
            "text": "What makes that the most important point?",
            "translation_fa": "چی باعث می‌شه این مهم‌ترین نکته باشه؟"
          },
          {
