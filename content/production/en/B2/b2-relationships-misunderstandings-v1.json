    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_perspective",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-01",
        "text": {
          "en": "From my perspective, the message sounded final, but I can see why you read it differently."
        },
        "translations": {
          "fa": "از دید من پیام قطعی به نظر می‌رسید، ولی می‌فهمم چرا تو متفاوت برداشت کردی."
        },
        "intent": "compare_perspectives",
        "concept_refs": [
          "b2_relationships_misunderstandings_perspective",
          "b2_relationships_misunderstandings_misunderstanding"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_intention",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-01",
        "text": {
          "en": "My intention was to save time, not to make the decision without you."
        },
        "translations": {
          "fa": "قصدم صرفه‌جویی در زمان بود، نه اینکه بدون تو تصمیم بگیرم."
        },
        "intent": "clarify_intention",
        "concept_refs": [
          "b2_relationships_misunderstandings_intention",
          "b2_relationships_misunderstandings_clarify"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_assume",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-02",
        "text": {
          "en": "I assumed you were busy because you didn't reply, but I should have checked instead of guessing."
        },
        "translations": {
          "fa": "فکر کردم سرت شلوغه چون جواب ندادی، ولی باید به‌جای حدس زدن می‌پرسیدم."
        },
        "intent": "recognize_assumption",
        "concept_refs": [
          "b2_relationships_misunderstandings_assume"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_reported",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-02",
        "text": {
          "en": "You said you needed space, and I understood that as not wanting to discuss it at all."
        },
        "translations": {
          "fa": "گفتی فضا لازم داری و من این رو این‌طور فهمیدم که اصلاً نمی‌خوای درباره‌اش حرف بزنی."
        },
        "intent": "relay_misunderstood_message",
        "concept_refs": [
          "b2_relationships_misunderstandings_misunderstanding"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_deduce",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-03",
        "text": {
          "en": "She might not have realized how abrupt the message sounded after such a stressful day."
        },
        "translations": {
          "fa": "شاید متوجه نشده پیام بعد از اون روز پراسترس چقدر تند به نظر می‌رسه."
        },
        "intent": "consider_alternative_explanation",
        "concept_refs": [
          "b2_relationships_misunderstandings_perspective"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_apologize",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-03",
        "text": {
          "en": "I want to apologize for the tone, even though I didn't mean to upset you."
        },
        "translations": {
          "fa": "می‌خوام بابت لحن عذرخواهی کنم، حتی اگر قصد ناراحت کردنت رو نداشتم."
        },
        "intent": "apologize_tactfully",
        "concept_refs": [
          "b2_relationships_misunderstandings_apologize",
          "b2_relationships_misunderstandings_intention"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_repair",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-03",
        "text": {
          "en": "If we clarify expectations now, we can probably prevent the same tension from building again."
        },
        "translations": {
          "fa": "اگر الان انتظارها رو روشن کنیم، احتمالاً می‌تونیم جلوی شکل گرفتن دوباره همین تنش رو بگیریم."
        },
        "intent": "repair_communication",
        "concept_refs": [
          "b2_relationships_misunderstandings_clarify",
          "b2_relationships_misunderstandings_repair",
          "b2_relationships_misunderstandings_tension"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_relationships_misunderstandings_close",
      "data": {
        "lesson_key": "b2-relationships-misunderstandings-03",
        "text": {
          "en": "We don't have to agree on every detail, but I do want us to understand what each person meant."
        },
        "translations": {
          "fa": "لازم نیست روی همه جزئیات موافق باشیم، ولی می‌خوام بفهمیم هر کدوم واقعاً چه منظوری داشتیم."
        },
        "intent": "restore_understanding",
        "concept_refs": [
          "b2_relationships_misunderstandings_perspective",
