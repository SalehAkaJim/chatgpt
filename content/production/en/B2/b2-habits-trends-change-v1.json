    {
      "kind": "grammar_point",
      "external_id": "g_b2_habits_trends_change_used_to_would",
      "data": {
        "lesson_key": "b2-habits-trends-change-01",
        "slug": "b2-habits-trends-change-used-to-would",
        "title": "used to and would for past habits",
        "rule_summary": "Use used to for past states or repeated habits. Would can describe repeated past actions, but not normally past states.",
        "explanation": {
          "fa": "used to هم برای حالت‌ها و هم عادت‌های تکراری گذشته استفاده می‌شود. would بیشتر برای کارهای تکراری گذشته است و معمولاً برای حالت‌ها به کار نمی‌رود."
        },
        "examples": [
          {
            "en": "I used to work downtown.",
            "fa": "قبلاً مرکز شهر کار می‌کردم."
          },
          {
            "en": "On Fridays, we'd finish early.",
            "fa": "جمعه‌ها زودتر کار را تمام می‌کردیم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
