    {
      "kind": "grammar_point",
      "external_id": "g_b2_relaying_information_reported_speech",
      "data": {
        "lesson_key": "b2-relaying-information-01",
        "slug": "b2-relaying-information-reported-speech",
        "title": "Reported speech",
        "rule_summary": "Use reported speech to relay what someone said, asked, or promised while adjusting pronouns and time references when needed.",
        "explanation": {
          "fa": "برای انتقال حرف، سؤال یا قول دیگران از reported speech استفاده می‌کنیم و در صورت نیاز ضمیر و زمان را تغییر می‌دهیم."
        },
        "examples": [
          {
            "en": "She said the repair would take two days.",
            "fa": "گفت تعمیر دو روز طول می‌کشد."
          },
          {
            "en": "They asked whether I had the receipt.",
            "fa": "پرسیدند آیا رسید را دارم یا نه."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_relaying_information_say_tell_ask",
      "data": {
        "lesson_key": "b2-relaying-information-02",
        "slug": "b2-relaying-information-say-tell-ask",
        "title": "say, tell, and ask",
        "rule_summary": "Use say without a person object, tell with a person object, and ask for questions or requests.",
        "explanation": {
          "fa": "say معمولاً بدون مفعول شخص، tell با مفعول شخص و ask برای سؤال یا درخواست می‌آید."
        },
        "examples": [
          {
            "en": "She said the meeting was moved.",
            "fa": "گفت جلسه جابه‌جا شده."
          },
          {
            "en": "She told me to arrive early.",
            "fa": "به من گفت زود برسم."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_relaying_information_shifts",
      "data": {
        "lesson_key": "b2-relaying-information-03",
        "slug": "b2-relaying-information-shifts",
        "title": "Time and pronoun shifts in reporting",
        "rule_summary": "When the reporting viewpoint changes, adjust pronouns and time expressions so the relayed message remains clear.",
        "explanation": {
          "fa": "وقتی زاویه گزارش تغییر می‌کند، ضمیر و عبارت زمانی را طوری تغییر می‌دهیم که پیام روشن بماند."
        },
        "examples": [
          {
            "en": "'I'll call tomorrow.' → He said he'd call the next day.",
            "fa": "«فردا زنگ می‌زنم.» → گفت روز بعد زنگ می‌زند."
          },
          {
            "en": "'My file is here.' → She said her file was there.",
            "fa": "«فایلم اینجاست.» → گفت فایلش آنجا بود."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_relaying_information_scene_1",
      "data": {
        "lesson_key": "b2-relaying-information-01",
        "title": "Relaying Information Accurately: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Mei",
          "Omar"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mei",
            "text": "How would you handle this situation?",
            "translation_fa": "تو این موقعیت رو چطور مدیریت می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "Omar",
            "text": "Sara said the meeting had moved to Thursday, but the start time was unchanged.",
            "translation_fa": "سارا گفت جلسه به پنجشنبه منتقل شده، ولی ساعت شروع همونه."
          },
          {
            "order": 3,
            "speaker": "Mei",
            "text": "What would you consider before deciding?",
            "translation_fa": "قبل از تصمیم گرفتن چه چیزی رو در نظر می‌گرفتی؟"
          },
          {
            "order": 4,
            "speaker": "Omar",
            "text": "She asked me to tell everyone to read the revised document before the meeting.",
            "translation_fa": "ازم خواست به همه بگم قبل از جلسه سند اصلاح‌شده رو بخونن."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_relaying_information_scene_2",
      "data": {
        "lesson_key": "b2-relaying-information-02",
        "title": "Relaying Information Accurately: part 2",
        "setting": "video call",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Ava",
          "Ben"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ava",
            "text": "What's changed compared with before?",
