    {
      "kind": "grammar_point",
      "external_id": "g_b2_practical_writing_register",
      "data": {
        "lesson_key": "b2-practical-writing-01",
        "slug": "b2-practical-writing-register",
        "title": "Choosing an appropriate register",
        "rule_summary": "Match formality to the relationship and purpose: use concise friendly language with peers and more explicit polite wording in formal messages.",
        "explanation": {
          "fa": "رسمیت را با رابطه و هدف هماهنگ می‌کنیم: با همکار نزدیک کوتاه‌تر و دوستانه‌تر، در پیام رسمی روشن‌تر و مؤدبانه‌تر."
        },
        "examples": [
          {
            "en": "Can you send me the file when you get a chance?",
            "fa": "هر وقت فرصت داشتی فایل را می‌فرستی؟"
          },
          {
            "en": "Could you please confirm receipt of the attached document?",
            "fa": "لطفاً دریافت فایل پیوست را تأیید می‌کنید؟"
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_practical_writing_linking_devices",
      "data": {
        "lesson_key": "b2-practical-writing-02",
        "slug": "b2-practical-writing-linking-devices",
        "title": "Cohesive linking devices",
        "rule_summary": "Use however, therefore, in addition, as a result, and meanwhile to make relationships between sentences explicit.",
        "explanation": {
          "fa": "با however، therefore، in addition، as a result و meanwhile رابطه بین جمله‌ها را روشن می‌کنیم."
        },
        "examples": [
          {
            "en": "The first option is cheaper. However, it takes longer.",
            "fa": "گزینه اول ارزان‌تر است؛ با این حال بیشتر طول می‌کشد."
          },
          {
            "en": "The deadline moved; therefore, we revised the plan.",
            "fa": "موعد تغییر کرد؛ بنابراین برنامه را بازبینی کردیم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_practical_writing_indirect_requests",
      "data": {
        "lesson_key": "b2-practical-writing-03",
        "slug": "b2-practical-writing-indirect-requests",
        "title": "Indirect requests",
        "rule_summary": "Use could you, would it be possible, and I was wondering if to make practical requests appropriately polite.",
        "explanation": {
          "fa": "برای درخواست مؤدبانه از could you، would it be possible و I was wondering if استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Would it be possible to move the appointment?",
            "fa": "امکانش هست وقت را جابه‌جا کنیم؟"
          },
          {
            "en": "I was wondering if you could send the revised version.",
            "fa": "می‌خواستم ببینم می‌توانید نسخه اصلاح‌شده را بفرستید؟"
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_practical_writing_scene_1",
      "data": {
        "lesson_key": "b2-practical-writing-01",
        "title": "Practical Messages & Emails: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Ella",
          "Amir"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ella",
            "text": "What's changed compared with before?",
            "translation_fa": "نسبت به قبل چی تغییر کرده؟"
          },
          {
            "order": 2,
            "speaker": "Amir",
            "text": "A clear subject line should tell the reader what the message is about before they open it.",
            "translation_fa": "عنوان روشن باید قبل از باز کردن ایمیل به خواننده بگه پیام درباره چیه."
          },
          {
            "order": 3,
            "speaker": "Ella",
            "text": "And what effect has that had?",
            "translation_fa": "و این چه اثری داشته؟"
          },
          {
            "order": 4,
            "speaker": "Amir",
            "text": "I'll give one sentence of context before making the request so the reader understands why it matters.",
            "translation_fa": "قبل از درخواست یک جمله زمینه می‌دم تا خواننده بفهمه چرا مهمه."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_practical_writing_scene_2",
      "data": {
        "lesson_key": "b2-practical-writing-02",
        "title": "Practical Messages & Emails: part 2",
        "setting": "video call",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Emma",
          "Kai"
        ],
        "turns": [
          {
            "order": 1,
