      "data": {
        "lesson_key": "b2-practical-writing-03",
        "text": {
          "en": "I'm following up on my message from Monday because I need confirmation before tomorrow afternoon."
        },
        "translations": {
          "fa": "دارم پیام دوشنبه رو پیگیری می‌کنم چون قبل از فردا بعدازظهر تأیید لازم دارم."
        },
        "intent": "write_followup",
        "concept_refs": [
