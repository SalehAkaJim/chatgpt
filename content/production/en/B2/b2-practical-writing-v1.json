      "external_id": "u_b2_practical_writing_concise",
      "data": {
        "lesson_key": "b2-practical-writing-03",
        "text": {
          "en": "I'm keeping the message concise because the recipient only needs the decision and the next action."
        },
        "translations": {
          "fa": "پیام رو مختصر نگه می‌دارم چون گیرنده فقط تصمیم و اقدام بعدی رو لازم داره."
