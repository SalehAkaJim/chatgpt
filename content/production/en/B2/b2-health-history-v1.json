    {
      "kind": "grammar_point",
      "external_id": "g_b2_health_history_present_perfect_continuous",
      "data": {
        "lesson_key": "b2-health-history-01",
        "slug": "b2-health-history-present-perfect-continuous",
        "title": "Present perfect continuous",
        "rule_summary": "Use have/has been + -ing to emphasize duration or repeated activity continuing up to now.",
        "explanation": {
          "fa": "برای تأکید روی مدت یا فعالیت تکراری که تا حال ادامه داشته از have/has been + ing استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've been sleeping badly for a week.",
            "fa": "یک هفته است بد می‌خوابم."
          },
          {
            "en": "We've been comparing prices since Monday.",
            "fa": "از دوشنبه داریم قیمت‌ها را مقایسه می‌کنیم."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_health_history_for_since",
      "data": {
        "lesson_key": "b2-health-history-02",
        "slug": "b2-health-history-for-since",
        "title": "for and since",
        "rule_summary": "Use for with a duration and since with a starting point when describing situations that continue to now.",
        "explanation": {
          "fa": "برای مدت از for و برای نقطه شروع از since استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've had the symptoms for three days.",
            "fa": "سه روز است این علائم را دارم."
          },
          {
            "en": "I've felt better since Tuesday.",
            "fa": "از سه‌شنبه حالم بهتر شده است."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_health_history_present_perfect",
      "data": {
        "lesson_key": "b2-health-history-03",
        "slug": "b2-health-history-present-perfect",
        "title": "Present perfect for unresolved situations",
        "rule_summary": "Use the present perfect for actions or situations connected to now, especially previous attempts, progress, and recent changes.",
        "explanation": {
          "fa": "برای کارها یا وضعیت‌هایی که به حال مربوط‌اند، مخصوصاً تلاش‌های قبلی و تغییرات اخیر، از present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've contacted support twice.",
            "fa": "دو بار با پشتیبانی تماس گرفته‌ام."
          },
          {
            "en": "The problem has become more frequent.",
            "fa": "مشکل بیشتر شده است."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_health_history_scene_1",
      "data": {
        "lesson_key": "b2-health-history-01",
        "title": "Symptoms & Health History: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "basic-health",
        "characters": [
          "Mei",
          "Omar"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mei",
            "text": "How would you handle this situation?",
            "translation_fa": "تو این موقعیت رو چطور مدیریت می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "Omar",
            "text": "I've been having the same symptom for about ten days, although it comes and goes.",
            "translation_fa": "حدود ده روزه همین علامت رو دارم، هرچند میاد و می‌ره."
          },
          {
            "order": 3,
            "speaker": "Mei",
            "text": "What would you consider before deciding?",
            "translation_fa": "قبل از تصمیم گرفتن چه چیزی رو در نظر می‌گرفتی؟"
          },
          {
            "order": 4,
            "speaker": "Omar",
            "text": "It started mildly, but it has gradually become more noticeable in the evenings.",
            "translation_fa": "اول خفیف بود، ولی کم‌کم عصرها محسوس‌تر شده."
          }
        ],
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_health_history_scene_2",
      "data": {
        "lesson_key": "b2-health-history-02",
        "title": "Symptoms & Health History: part 2",
        "setting": "video call",
        "cefr": "B2",
        "topic": "basic-health",
        "characters": [
          "Ava",
          "Ben"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Ava",
            "text": "What's changed compared with before?",
            "translation_fa": "نسبت به قبل چی تغییر کرده؟"
          },
          {
            "order": 2,
            "speaker": "Ben",
            "text": "I've had a similar problem once before, but that episode only lasted two days.",
            "translation_fa": "یک بار قبلاً مشکل مشابه داشتم، ولی اون دفعه فقط دو روز طول کشید."
          },
          {
            "order": 3,
            "speaker": "Ava",
            "text": "And what effect has that had?",
            "translation_fa": "و این چه اثری داشته؟"
          },
          {
            "order": 4,
