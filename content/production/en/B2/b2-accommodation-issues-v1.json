    {
      "kind": "grammar_point",
      "external_id": "g_b2_accommodation_issues_reported_speech",
      "data": {
        "lesson_key": "b2-accommodation-issues-01",
        "slug": "b2-accommodation-issues-reported-speech",
        "title": "Reported speech",
        "rule_summary": "Use reported speech to relay what someone said, asked, or promised while adjusting pronouns and time references when needed.",
        "explanation": {
          "fa": "برای انتقال حرف، سؤال یا قول دیگران از reported speech استفاده می‌کنیم و در صورت نیاز ضمیر و زمان را تغییر می‌دهیم."
        },
        "examples": [
          {
            "en": "She said the repair would take two days.",
            "fa": "گفت تعمیر دو روز طول می‌کشد."
          },
          {
            "en": "They asked whether I had the receipt.",
            "fa": "پرسیدند آیا رسید را دارم یا نه."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_accommodation_issues_present_perfect",
      "data": {
        "lesson_key": "b2-accommodation-issues-02",
        "slug": "b2-accommodation-issues-present-perfect",
        "title": "Present perfect for unresolved situations",
        "rule_summary": "Use the present perfect for actions or situations connected to now, especially previous attempts, progress, and recent changes.",
        "explanation": {
          "fa": "برای کارها یا وضعیت‌هایی که به حال مربوط‌اند، مخصوصاً تلاش‌های قبلی و تغییرات اخیر، از present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've contacted support twice.",
            "fa": "دو بار با پشتیبانی تماس گرفته‌ام."
          },
          {
            "en": "The problem has become more frequent.",
            "fa": "مشکل بیشتر شده است."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_accommodation_issues_polite_insistence",
      "data": {
        "lesson_key": "b2-accommodation-issues-03",
        "slug": "b2-accommodation-issues-polite-insistence",
        "title": "Polite insistence",
        "rule_summary": "Acknowledge the other person's position, then restate the unresolved need or promised outcome clearly.",
        "explanation": {
          "fa": "اول موضع طرف مقابل را می‌پذیریم و بعد نیاز حل‌نشده یا نتیجه وعده‌داده‌شده را روشن تکرار می‌کنیم."
        },
        "examples": [
          {
            "en": "I understand that, but the room I booked is still unavailable.",
            "fa": "متوجه‌ام، اما اتاقی که رزرو کردم هنوز در دسترس نیست."
          },
          {
            "en": "I appreciate the offer; however, I still need a written confirmation.",
            "fa": "از پیشنهاد ممنونم؛ با این حال هنوز تأیید کتبی لازم دارم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b2_accommodation_issues_scene_1",
      "data": {
        "lesson_key": "b2-accommodation-issues-01",
        "title": "Accommodation Issues: part 1",
        "setting": "coffee break",
        "cefr": "B2",
        "topic": "places-town",
        "characters": [
          "Mei",
          "Omar"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mei",
            "text": "How would you handle this situation?",
            "translation_fa": "تو این موقعیت رو چطور مدیریت می‌کردی؟"
          },
          {
            "order": 2,
            "speaker": "Omar",
            "text": "My booking confirmation shows a quiet double room, but I've been given a room next to the elevator.",
            "translation_fa": "تأییدیه رزرو من اتاق دونفره آروم نشون می‌ده، ولی اتاق کنار آسانسور بهم داده شده."
          },
          {
            "order": 3,
            "speaker": "Mei",
            "text": "What would you consider before deciding?",
            "translation_fa": "قبل از تصمیم گرفتن چه چیزی رو در نظر می‌گرفتی؟"
          },
          {
            "order": 4,
