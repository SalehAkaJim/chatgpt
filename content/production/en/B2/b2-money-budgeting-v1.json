    {
      "kind": "grammar_point",
      "external_id": "g_b2_money_budgeting_quantifiers",
      "data": {
        "lesson_key": "b2-money-budgeting-01",
        "slug": "b2-money-budgeting-quantifiers",
        "title": "Quantifiers and approximation",
        "rule_summary": "Use roughly, about, nearly, a little, far more, and far less to discuss amounts without false precision.",
        "explanation": {
          "fa": "برای مقدارهای تقریبی از roughly، about، nearly و برای مقایسه مقدار از far more/far less استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Rent takes roughly a third of my income.",
            "fa": "اجاره تقریباً یک‌سوم درآمدم را می‌گیرد."
          },
          {
            "en": "We spend far less on transport now.",
            "fa": "الان خیلی کمتر برای رفت‌وآمد هزینه می‌کنیم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_money_budgeting_conditionals",
      "data": {
        "lesson_key": "b2-money-budgeting-02",
        "slug": "b2-money-budgeting-conditionals",
        "title": "Conditionals for consequences",
        "rule_summary": "Use conditional clauses to connect a possible action with its likely or imagined consequence.",
        "explanation": {
          "fa": "با جمله‌های شرطی یک اقدام احتمالی را به نتیجه واقعی یا فرضی آن وصل می‌کنیم."
        },
        "examples": [
          {
            "en": "If we leave earlier, we'll avoid traffic.",
            "fa": "اگر زودتر راه بیفتیم از ترافیک دور می‌مانیم."
          },
          {
            "en": "If I had a larger budget, I'd choose the faster option.",
            "fa": "اگر بودجه بیشتری داشتم گزینه سریع‌تر را انتخاب می‌کردم."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_money_budgeting_comparatives",
      "data": {
        "lesson_key": "b2-money-budgeting-03",
        "slug": "b2-money-budgeting-comparatives",
        "title": "Complex comparison",
        "rule_summary": "Use comparatives, less/more, and structures such as not as ... as to compare several criteria precisely.",
        "explanation": {
          "fa": "برای مقایسه دقیق چند معیار از comparative، less/more و not as ... as استفاده می‌کنیم."
