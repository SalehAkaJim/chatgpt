        "turns": [
          {
            "order": 1,
            "speaker": "Ivy",
            "text": "Which option seems more realistic to you?",
            "translation_fa": "کدوم گزینه به نظرت واقع‌بینانه‌تره؟"
          },
          {
            "order": 2,
            "speaker": "David",
            "text": "I try to build my budget around fixed expenses first and treat optional spending separately.",
            "translation_fa": "سعی می‌کنم اول بودجه رو بر اساس هزینه‌های ثابت بچینم و خرج اختیاری رو جدا حساب کنم."
          },
          {
            "order": 3,
            "speaker": "Ivy",
            "text": "Why does that option work better?",
            "translation_fa": "چرا اون گزینه بهتر جواب می‌ده؟"
          },
          {
            "order": 4,
            "speaker": "David",
            "text": "Recurring costs are easy to ignore because each one looks small on its own.",
            "translation_fa": "هزینه‌های تکرارشونده رو راحت می‌شه نادیده گرفت چون هر کدوم جداگانه کم به نظر می‌رسه."
          }
