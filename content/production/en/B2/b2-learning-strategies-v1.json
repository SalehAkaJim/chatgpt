    {
      "kind": "utterance",
      "external_id": "u_b2_learning_strategies_monitor",
      "data": {
        "lesson_key": "b2-learning-strategies-02",
        "text": {
          "en": "I monitor which mistakes keep returning instead of treating every error as equally important."
        },
        "translations": {
          "fa": "بررسی می‌کنم کدوم اشتباه‌ها مدام برمی‌گردن به‌جای اینکه همه خطاها رو یکسان مهم بدونم."
        },
        "intent": "monitor_learning",
        "concept_refs": [
          "b2_learning_strategies_monitor"
        ],
        "cefr": "B2",
        "topic": "school-study",
        "register": "neutral",
        "status": "approved"
      }
