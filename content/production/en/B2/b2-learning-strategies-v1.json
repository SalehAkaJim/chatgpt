    {
      "kind": "grammar_point",
      "external_id": "g_b2_learning_strategies_comparatives",
      "data": {
        "lesson_key": "b2-learning-strategies-01",
        "slug": "b2-learning-strategies-comparatives",
        "title": "Complex comparison",
        "rule_summary": "Use comparatives, less/more, and structures such as not as ... as to compare several criteria precisely.",
        "explanation": {
          "fa": "برای مقایسه دقیق چند معیار از comparative، less/more و not as ... as استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "It's slightly more expensive but much more reliable.",
            "fa": "کمی گران‌تر ولی خیلی قابل‌اعتمادتر است."
          },
          {
            "en": "The cheaper route isn't as flexible.",
            "fa": "مسیر ارزان‌تر به همان اندازه انعطاف‌پذیر نیست."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_learning_strategies_gerunds_infinitives",
      "data": {
        "lesson_key": "b2-learning-strategies-02",
        "slug": "b2-learning-strategies-gerunds-infinitives",
        "title": "Gerunds and infinitives",
        "rule_summary": "Use common verb patterns such as avoid doing, consider doing, decide to do, and aim to do accurately.",
        "explanation": {
          "fa": "الگوهای رایج فعل مثل avoid doing، consider doing، decide to do و aim to do را درست به کار می‌بریم."
        },
        "examples": [
          {
            "en": "I'm trying to improve my sleep.",
            "fa": "دارم سعی می‌کنم خوابم را بهتر کنم."
          },
          {
            "en": "I've considered reducing my screen time.",
            "fa": "به کم کردن زمان صفحه فکر کرده‌ام."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b2_learning_strategies_cause_result",
      "data": {
        "lesson_key": "b2-learning-strategies-03",
        "slug": "b2-learning-strategies-cause-result",
        "title": "Cause and result connectors",
        "rule_summary": "Use because of and due to before noun phrases, and therefore, so, or as a result to introduce consequences.",
        "explanation": {
          "fa": "before اسم از because of و due to و برای نتیجه از therefore، so یا as a result استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The event was moved due to the weather.",
            "fa": "برنامه به دلیل هوا جابه‌جا شد."
          },
          {
            "en": "Demand increased; as a result, prices rose.",
            "fa": "تقاضا بالا رفت؛ در نتیجه قیمت‌ها افزایش پیدا کرد."
          }
        ],
        "cefr": "B2",
        "status": "approved"
      }
    },
