    {
      "kind": "utterance",
      "external_id": "u_b2_learning_strategies_distraction",
      "data": {
        "lesson_key": "b2-learning-strategies-03",
        "text": {
          "en": "Removing one major distraction has improved my concentration more than adding another study app."
        },
        "translations": {
          "fa": "حذف یک حواس‌پرتی اصلی بیشتر از اضافه کردن یک اپ مطالعه دیگه تمرکزم رو بهتر کرده."
        },
        "intent": "reduce_distraction",
        "concept_refs": [
          "b2_learning_strategies_distraction"
        ],
        "cefr": "B2",
        "topic": "school-study",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_learning_strategies_retain",
      "data": {
        "lesson_key": "b2-learning-strategies-03",
        "text": {
          "en": "I retain new expressions longer when I use them in my own examples rather than only recognizing them."
        },
        "translations": {
          "fa": "عبارت‌های جدید رو وقتی در مثال‌های خودم استفاده می‌کنم طولانی‌تر نگه می‌دارم تا فقط بشناسمشون."
        },
        "intent": "explain_retention",
