    {
      "kind": "utterance",
      "external_id": "u_b2_learning_strategies_retrieve",
      "data": {
        "lesson_key": "b2-learning-strategies-01",
        "text": {
          "en": "I remember vocabulary better when I try to retrieve it before looking at the answer."
        },
        "translations": {
          "fa": "واژگان رو بهتر یادم می‌مونه وقتی قبل از دیدن جواب سعی می‌کنم خودم به یادش بیارم."
