    {
      "kind": "utterance",
      "external_id": "u_b2_learning_strategies_adjust",
      "data": {
        "lesson_key": "b2-learning-strategies-02",
        "text": {
          "en": "If a method stops helping, I adjust it rather than continuing just because it is familiar."
        },
        "translations": {
          "fa": "اگر روشی دیگه کمک نکنه، تنظیمش می‌کنم به‌جای اینکه فقط چون آشناست ادامه بدم."
        },
        "intent": "adjust_strategy",
        "concept_refs": [
