      "data": {
        "lesson_key": "b2-learning-strategies-01",
        "text": {
          "en": "For me, short daily review is more effective than one long session at the end of the week."
        },
        "translations": {
          "fa": "برای من مرور کوتاه روزانه مؤثرتر از یک جلسه طولانی آخر هفته‌ست."
