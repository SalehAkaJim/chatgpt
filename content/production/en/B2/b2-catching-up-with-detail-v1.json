    {
      "kind": "grammar_point",
      "external_id": "g_b2_catching_up_with_detail_perfect_simple_continuous",
      "data": {
        "lesson_key": "b2-catching-up-with-detail-01",
        "slug": "b2-catching-up-with-detail-perfect-simple-continuous",
        "title": "Present perfect simple vs continuous",
        "rule_summary": "Use the present perfect simple to focus on a result or completed change and the present perfect continuous to focus on duration or ongoing activity.",
        "explanation": {
          "fa": "برای تأکید روی نتیجه یا تغییر کامل‌شده از present perfect simple و برای تأکید روی مدت یا فعالیت در جریان از present perfect continuous استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "My workload has become easier to manage.",
            "fa": "حجم کارم قابل‌کنترل‌تر شده."
          },
          {
            "en": "I've been working longer hours lately.",
            "fa": "این اواخر ساعت‌های بیشتری کار می‌کردم."
