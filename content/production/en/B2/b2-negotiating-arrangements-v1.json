      "external_id": "u_b2_negotiating_arrangements_constraint",
      "data": {
        "lesson_key": "b2-negotiating-arrangements-01",
        "text": {
          "en": "I can move the meeting, but I have a hard constraint after three o'clock."
        },
        "translations": {
          "fa": "می‌تونم جلسه رو جابه‌جا کنم، ولی بعد از ساعت سه یک محدودیت قطعی دارم."
        },
        "intent": "state_constraint",
        "concept_refs": [
          "b2_negotiating_arrangements_constraint",
          "b2_negotiating_arrangements_reschedule"
        ],
        "cefr": "B2",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b2_negotiating_arrangements_alternative",
      "data": {
        "lesson_key": "b2-negotiating-arrangements-01",
        "text": {
          "en": "Would two thirty work for you, or would tomorrow morning be easier?"
        },
        "translations": {
          "fa": "دو و نیم برات مناسبه یا فردا صبح راحت‌تری؟"
        },
        "intent": "offer_alternatives",
        "concept_refs": [
          "b2_negotiating_arrangements_available"
        ],
        "cefr": "B2",
        "topic": "polite-language",
