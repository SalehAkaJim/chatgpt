        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_news_stories_source",
      "data": {
        "lesson_key": "b1-news-stories-01",
        "text": {
          "en": "According to the transport department, the route will serve three new neighborhoods."
        },
        "translations": {
          "fa": "طبق اداره حمل‌ونقل، مسیر سه محله جدید رو پوشش می‌ده."
        },
        "intent": "cite_source",
