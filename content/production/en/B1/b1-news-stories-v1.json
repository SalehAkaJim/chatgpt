      "external_id": "u_b1_news_stories_main",
      "data": {
        "lesson_key": "b1-news-stories-01",
        "text": {
          "en": "The main point is that the city has announced a new bus route starting next month."
        },
        "translations": {
          "fa": "نکته اصلی اینه که شهر یک مسیر اتوبوس جدید از ماه بعد اعلام کرده."
        },
        "intent": "summarize_main_point",
        "concept_refs": [
