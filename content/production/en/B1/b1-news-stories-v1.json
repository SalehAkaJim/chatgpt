      "data": {
        "lesson_key": "b1-news-stories-01",
        "text": {
          "en": "The headline makes the story sound dramatic, but the actual report is more balanced."
        },
        "translations": {
          "fa": "تیتر داستان رو خیلی دراماتیک نشون می‌ده، ولی گزارش واقعی متعادل‌تره."
