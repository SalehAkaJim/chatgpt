        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_news_stories_passive",
      "data": {
        "lesson_key": "b1-news-stories-02",
        "text": {
          "en": "Two roads were closed after the incident, but they reopened later that evening."
        },
        "translations": {
          "fa": "دو خیابون بعد حادثه بسته شدند، ولی همون شب دوباره باز شدند."
        },
