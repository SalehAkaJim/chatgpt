    {
      "kind": "grammar_point",
      "external_id": "g_b1_news_stories_passive_news",
      "data": {
        "lesson_key": "b1-news-stories-01",
        "slug": "b1-news-stories-passive-news",
        "title": "Passive voice in news",
        "rule_summary": "Use passive forms when the event or result is more important than the actor.",
        "explanation": {
          "fa": "در خبر وقتی رویداد یا نتیجه مهم‌تر از انجام‌دهنده است از passive استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Two roads were closed.",
            "fa": "دو خیابون بسته شدند."
          },
          {
            "en": "A new service has been announced.",
            "fa": "سرویس جدیدی اعلام شده."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_news_stories_reported_news",
      "data": {
        "lesson_key": "b1-news-stories-02",
        "slug": "b1-news-stories-reported-news",
        "title": "Reported speech introduction",
        "rule_summary": "Use said that / announced that / reported that to relay statements without quoting exactly.",
        "explanation": {
          "fa": "برای انتقال گفته‌ها بدون نقل قول مستقیم از said that، announced that و reported that استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The mayor said the project would help.",
            "fa": "شهردار گفت پروژه کمک می‌کنه."
          },
          {
            "en": "The company announced that prices would rise.",
            "fa": "شرکت اعلام کرد قیمت‌ها بالا می‌ره."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_news_stories_cause_time",
      "data": {
        "lesson_key": "b1-news-stories-03",
        "slug": "b1-news-stories-cause-time",
        "title": "Time and cause links",
        "rule_summary": "Use after, before, while, because, and as a result to connect events in a news summary.",
        "explanation": {
          "fa": "برای وصل کردن رویدادهای خبری از after، before، while، because و as a result استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The road closed after a crash.",
            "fa": "خیابون بعد تصادف بسته شد."
          },
          {
            "en": "Demand increased, so more trains were added.",
            "fa": "تقاضا بالا رفت، پس قطار بیشتری اضافه شد."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_news_stories_transit",
      "data": {
