    {
      "kind": "grammar_point",
      "external_id": "g_b1_catching_up_in_depth_perfect_vs_past",
      "data": {
        "lesson_key": "b1-catching-up-in-depth-01",
        "slug": "b1-catching-up-in-depth-perfect-vs-past",
        "title": "Present perfect vs past simple",
        "rule_summary": "Use the present perfect for a past situation connected to now; use the past simple for a finished event at a finished time.",
        "explanation": {
          "fa": "برای موقعیتی در گذشته که به زمان حال ربط دارد از present perfect و برای اتفاق تمام‌شده در زمان تمام‌شده از past simple استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "A lot has changed since January.",
            "fa": "از ژانویه تا الان خیلی چیزها تغییر کرده."
          },
          {
            "en": "We moved here last January.",
            "fa": "ژانویه گذشته به اینجا اسباب‌کشی کردیم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_catching_up_in_depth_perfect_continuous",
      "data": {
        "lesson_key": "b1-catching-up-in-depth-01",
        "slug": "b1-catching-up-in-depth-perfect-continuous",
        "title": "Present perfect continuous for recent activity",
        "rule_summary": "Use have/has been + -ing to focus on an activity continuing recently or explaining a present result.",
        "explanation": {
