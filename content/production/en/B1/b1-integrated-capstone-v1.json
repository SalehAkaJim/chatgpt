    {
      "kind": "grammar_point",
      "external_id": "g_b1_integrated_capstone_integrated_tenses",
      "data": {
        "lesson_key": "b1-integrated-capstone-01",
        "slug": "b1-integrated-capstone-integrated-tenses",
        "title": "Integrated tense control",
        "rule_summary": "Choose past forms for what happened, present forms for current needs, and future forms for arrangements and decisions.",
        "explanation": {
          "fa": "برای اتفاق افتاده از گذشته، برای نیاز فعلی از حال و برای قرار و تصمیم از آینده مناسب استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The train was cancelled, so we need another route.",
            "fa": "قطار لغو شد، پس مسیر دیگه‌ای لازم داریم."
          },
          {
            "en": "We're meeting Priya at four.",
            "fa": "ساعت چهار با پریا قرار داریم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_integrated_capstone_integrated_conditionals",
      "data": {
        "lesson_key": "b1-integrated-capstone-02",
        "slug": "b1-integrated-capstone-integrated-conditionals",
        "title": "Conditionals for backup plans",
        "rule_summary": "Use if/unless with can/could/will/might to adapt a plan when conditions change.",
        "explanation": {
          "fa": "برای تطبیق برنامه با تغییر شرایط از if/unless همراه can/could/will/might استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If the museum is full, we can visit the market.",
            "fa": "اگر موزه پر باشه، می‌تونیم بازار بریم."
          },
          {
            "en": "We'll walk unless it starts raining.",
            "fa": "مگر اینکه بارون شروع بشه، پیاده می‌ریم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
