      "data": {
        "lesson_key": "b1-job-search-01",
        "slug": "b1-job-search-perfect-experience",
        "title": "Present perfect for experience",
        "rule_summary": "Use present perfect to summarize experience up to now, then past simple for finished examples.",
        "explanation": {
