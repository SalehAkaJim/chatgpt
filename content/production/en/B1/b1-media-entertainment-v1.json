    {
      "kind": "grammar_point",
      "external_id": "g_b1_media_entertainment_relative_media",
      "data": {
        "lesson_key": "b1-media-entertainment-01",
        "slug": "b1-media-entertainment-relative-media",
        "title": "Relative clauses for media",
        "rule_summary": "Use who/that/which to describe characters, stories, and works without repeating nouns.",
        "explanation": {
          "fa": "برای توصیف شخصیت، داستان و اثر بدون تکرار اسم از who/that/which استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "It's a film that makes you think.",
            "fa": "فیلمیه که وادارت می‌کنه فکر کنی."
          },
          {
            "en": "She's the actor who plays the detective.",
            "fa": "اون بازیگریه که نقش کارآگاه رو بازی می‌کنه."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_media_entertainment_ed_ing",
      "data": {
        "lesson_key": "b1-media-entertainment-02",
        "slug": "b1-media-entertainment-ed-ing",
        "title": "-ed / -ing adjectives",
        "rule_summary": "Use -ing adjectives for what causes a feeling and -ed adjectives for how someone feels.",
        "explanation": {
          "fa": "صفت -ing علت احساس و صفت -ed احساس شخص را بیان می‌کند."
        },
        "examples": [
          {
            "en": "The film was moving; I was moved.",
            "fa": "فیلم تأثیرگذار بود؛ من تحت‌تأثیر قرار گرفتم."
          },
          {
            "en": "The ending was surprising; I was surprised.",
            "fa": "پایان غافلگیرکننده بود؛ غافلگیر شدم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_media_entertainment_reported_opinion",
      "data": {
        "lesson_key": "b1-media-entertainment-03",
        "slug": "b1-media-entertainment-reported-opinion",
        "title": "Reported opinions",
        "rule_summary": "Use said/told me/thought that to relay someone else's reaction or recommendation.",
        "explanation": {
          "fa": "برای انتقال نظر یا پیشنهاد دیگری از said، told me یا thought that استفاده می‌کنیم."
        },
