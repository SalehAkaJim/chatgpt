    {
      "kind": "grammar_point",
      "external_id": "g_b1_work_responsibilities_obligation_work",
      "data": {
        "lesson_key": "b1-work-responsibilities-01",
        "slug": "b1-work-responsibilities-obligation-work",
        "title": "have to / need to for responsibilities",
        "rule_summary": "Use have to and need to for work obligations and required next steps.",
        "explanation": {
          "fa": "برای الزام‌های کاری و قدم بعدی لازم از have to و need to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I have to submit it by Friday.",
            "fa": "باید تا جمعه تحویلش بدم."
          },
          {
            "en": "We need to check the numbers again.",
            "fa": "باید اعداد رو دوباره چک کنیم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_work_responsibilities_perfect_progress",
      "data": {
        "lesson_key": "b1-work-responsibilities-02",
        "slug": "b1-work-responsibilities-perfect-progress",
        "title": "Present perfect for progress",
        "rule_summary": "Use present perfect for completed progress that matters to the current task.",
        "explanation": {
          "fa": "برای پیشرفتی که انجام شده و به کار فعلی ربط دارد از present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "We've finished the first phase.",
            "fa": "مرحله اول رو تموم کردیم."
          },
          {
            "en": "I haven't received the data yet.",
            "fa": "هنوز داده رو نگرفتم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_work_responsibilities_deadline_time",
      "data": {
        "lesson_key": "b1-work-responsibilities-03",
        "slug": "b1-work-responsibilities-deadline-time",
        "title": "by / until",
        "rule_summary": "Use by for a deadline before or at a point; use until for an activity continuing up to a point.",
        "explanation": {
          "fa": "برای مهلت از by و برای ادامه کار تا یک زمان از until استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Finish it by Friday.",
            "fa": "تا جمعه تمومش کن."
          },
          {
            "en": "I'll work until six.",
            "fa": "تا شش کار می‌کنم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
