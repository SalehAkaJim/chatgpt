    {
      "kind": "grammar_point",
      "external_id": "g_b1_invitations_hosting_polite_modals",
      "data": {
        "lesson_key": "b1-invitations-hosting-01",
        "slug": "b1-invitations-hosting-polite-modals",
        "title": "Would / could for social politeness",
        "rule_summary": "Use would and could to make invitations, offers, and requests sound less direct.",
        "explanation": {
          "fa": "برای مؤدبانه‌تر کردن دعوت، پیشنهاد و درخواست از would و could استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Would you like another drink?",
            "fa": "نوشیدنی دیگه‌ای می‌خوای؟"
          },
          {
            "en": "Could you pass the bread?",
            "fa": "می‌شه نون رو بدی؟"
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_invitations_hosting_indirect_questions",
      "data": {
        "lesson_key": "b1-invitations-hosting-02",
        "slug": "b1-invitations-hosting-indirect-questions",
        "title": "Indirect questions introduction",
        "rule_summary": "Use phrases such as Do you know…? or Could you tell me…? followed by statement word order.",
        "explanation": {
          "fa": "در سؤال غیرمستقیم از عبارت‌هایی مثل Do you know و Could you tell me استفاده می‌کنیم و بعد ترتیب جمله خبری می‌آید."
        },
        "examples": [
          {
            "en": "Do you know what time Sam is arriving?",
            "fa": "می‌دونی سام چه ساعتی می‌رسه؟"
          },
          {
            "en": "Could you tell me where I should put this?",
            "fa": "می‌شه بگی این رو کجا بذارم؟"
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_invitations_hosting_offers",
      "data": {
        "lesson_key": "b1-invitations-hosting-03",
        "slug": "b1-invitations-hosting-offers",
        "title": "Offers with shall / can / let me",
        "rule_summary": "Use can I, shall I, or let me to offer practical help naturally.",
        "explanation": {
          "fa": "برای پیشنهاد کمک عملی از can I، shall I یا let me استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Can I help with the dishes?",
