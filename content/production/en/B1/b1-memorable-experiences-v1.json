    {
      "kind": "grammar_point",
      "external_id": "g_b1_memorable_experiences_perfect_past",
      "data": {
        "lesson_key": "b1-memorable-experiences-01",
        "slug": "b1-memorable-experiences-perfect-past",
        "title": "Present perfect vs past simple for experiences",
        "rule_summary": "Use present perfect to ask or talk about experience without a finished time; switch to past simple for specific details.",
        "explanation": {
          "fa": "برای تجربه بدون زمان تمام‌شده از present perfect استفاده می‌کنیم و برای جزئیات مشخص گذشته به past simple می‌رویم."
        },
        "examples": [
          {
            "en": "Have you ever seen a whale?",
            "fa": "تا حالا نهنگ دیدی؟"
          },
          {
            "en": "Yes, I saw one in Canada last year.",
            "fa": "آره، پارسال در کانادا یکی دیدم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_memorable_experiences_experience_adverbs",
      "data": {
        "lesson_key": "b1-memorable-experiences-02",
        "slug": "b1-memorable-experiences-experience-adverbs",
        "title": "ever, never, already, yet",
        "rule_summary": "Use ever/never for life experience, already for something completed sooner than expected, and yet in negatives/questions about unfinished experience.",
        "explanation": {
          "fa": "ever و never برای تجربه زندگی، already برای چیزی که انجام شده و yet برای سؤال یا منفیِ چیزی که هنوز انجام نشده استفاده می‌شود."
        },
        "examples": [
          {
            "en": "I've already read it.",
            "fa": "قبلاً خوندمش."
          },
          {
            "en": "Have you tried it yet?",
            "fa": "تا حالا امتحانش کردی؟"
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_memorable_experiences_relative_intro",
      "data": {
        "lesson_key": "b1-memorable-experiences-03",
        "slug": "b1-memorable-experiences-relative-intro",
        "title": "Defining relative clauses",
        "rule_summary": "Use who, that, or which to add essential information about a person or thing.",
        "explanation": {
