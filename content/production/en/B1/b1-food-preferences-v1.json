    {
      "kind": "grammar_point",
      "external_id": "g_b1_food_preferences_relative_food",
      "data": {
        "lesson_key": "b1-food-preferences-01",
        "slug": "b1-food-preferences-relative-food",
        "title": "Relative clauses for food",
        "rule_summary": "Use that/which to add essential information about a dish or ingredient.",
        "explanation": {
          "fa": "برای اضافه کردن اطلاعات ضروری درباره غذا یا ماده غذایی از that/which استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I need a dish that doesn't contain dairy.",
            "fa": "غذایی می‌خوام که لبنیات نداشته باشه."
          },
          {
            "en": "The sauce which comes with it is spicy.",
            "fa": "سس همراهش تنده."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_food_preferences_quantifiers",
      "data": {
        "lesson_key": "b1-food-preferences-02",
        "slug": "b1-food-preferences-quantifiers",
        "title": "Quantifiers review",
        "rule_summary": "Use much/many, a little/a few, enough, and too much/many to talk precisely about amounts.",
        "explanation": {
          "fa": "برای مقدار دقیق‌تر از much/many، a little/a few، enough و too much/many استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "There's too much salt in this.",
            "fa": "این زیادی نمک داره."
          },
          {
            "en": "There are a few vegetarian choices.",
            "fa": "چند گزینه گیاه‌خواری هست."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_food_preferences_preference",
      "data": {
        "lesson_key": "b1-food-preferences-03",
        "slug": "b1-food-preferences-preference",
        "title": "would rather / prefer",
        "rule_summary": "Use would rather + base verb and prefer + noun/-ing to express food preferences.",
        "explanation": {
          "fa": "برای ترجیح غذایی از would rather + فعل پایه و prefer + اسم/ing استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'd rather have soup.",
            "fa": "ترجیح می‌دم سوپ بخورم."
          },
          {
            "en": "I prefer eating lighter meals at night.",
            "fa": "شب‌ها غذای سبک‌تر رو ترجیح می‌دم."
          }
        ],
        "cefr": "B1",
