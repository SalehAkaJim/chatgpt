        "turns": [
          {
            "order": 1,
            "speaker": "Maya",
            "text": "How many people do you expect at the launch?",
            "translation_fa": "برای افتتاحیه چند نفر انتظار داری؟"
          },
          {
            "order": 2,
            "speaker": "Leo",
            "text": "Probably around two hundred.",
            "translation_fa": "احتمالاً حدود دویست نفر."
          },
          {
            "order": 3,
            "speaker": "Maya",
            "text": "That's more than last year.",
            "translation_fa": "از پارسال بیشتره."
          },
          {
            "order": 4,
            "speaker": "Leo",
            "text": "Yes, and I think it'll be even busier online.",
            "translation_fa": "آره، و فکر می‌کنم آنلاین حتی شلوغ‌تر هم باشه."
          }
        ],
        "status": "approved"
      }
