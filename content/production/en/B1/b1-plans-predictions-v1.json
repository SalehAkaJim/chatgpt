      "data": {
        "lesson_key": "b1-plans-predictions-01",
        "title": "Planning a busy week",
        "setting": "office",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "Chloe",
          "Adam"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Chloe",
            "text": "Are you free tomorrow afternoon?",
            "translation_fa": "فردا بعدازظهر آزادی؟"
          },
          {
            "order": 2,
            "speaker": "Adam",
            "text": "I'm meeting a client at two, but I'm free after four.",
            "translation_fa": "ساعت دو با مشتری جلسه دارم، ولی بعد از چهار آزادم."
          },
          {
            "order": 3,
            "speaker": "Chloe",
            "text": "Great. I'm going to review the proposal before then.",
            "translation_fa": "عالیه. قبلش قصد دارم پیشنهاد رو مرور کنم."
          },
          {
            "order": 4,
            "speaker": "Adam",
            "text": "I'll send you my notes this evening.",
            "translation_fa": "امشب یادداشت‌هام رو برات می‌فرستم."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_plans_predictions_weather",
      "data": {
        "lesson_key": "b1-plans-predictions-02",
        "title": "A weekend prediction",
        "setting": "living room",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "Priya",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Priya",
            "text": "Do you think the hike will happen on Sunday?",
            "translation_fa": "فکر می‌کنی یکشنبه برنامه کوه‌پیمایی انجام می‌شه؟"
          },
          {
            "order": 2,
            "speaker": "Daniel",
            "text": "Probably not. Look at the forecast.",
            "translation_fa": "احتمالاً نه. پیش‌بینی هوا رو ببین."
          },
          {
            "order": 3,
            "speaker": "Priya",
            "text": "You're right. It's going to rain all morning.",
            "translation_fa": "درسته. کل صبح بارون میاد."
          },
          {
            "order": 4,
            "speaker": "Daniel",
            "text": "If it clears up later, we could still go for a short walk.",
            "translation_fa": "اگر بعداً هوا باز شد، هنوز می‌تونیم یک پیاده‌روی کوتاه بریم."
          }
        ],
        "status": "approved"
      }
    },
    {
