    {
      "kind": "grammar_point",
      "external_id": "g_b1_life_changes_used_to",
      "data": {
        "lesson_key": "b1-life-changes-01",
        "slug": "b1-life-changes-used-to",
        "title": "used to for past states and habits",
        "rule_summary": "Use used to + base verb for a repeated past habit or state that is different now.",
        "explanation": {
          "fa": "برای عادت یا وضعیت تکراری در گذشته که الان تغییر کرده از used to + فعل ساده استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I used to work weekends.",
            "fa": "قبلاً آخرهفته‌ها کار می‌کردم."
          },
          {
            "en": "We used to live near the station.",
            "fa": "قبلاً نزدیک ایستگاه زندگی می‌کردیم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_life_changes_still_no_longer",
      "data": {
        "lesson_key": "b1-life-changes-02",
        "slug": "b1-life-changes-still-no-longer",
        "title": "still and no longer",
        "rule_summary": "Use still for something that continues and no longer for something that has stopped being true.",
        "explanation": {
          "fa": "برای چیزی که هنوز ادامه دارد از still و برای چیزی که دیگر درست نیست از no longer استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I still take the same train.",
            "fa": "هنوز همان قطار را می‌گیرم."
          },
          {
            "en": "I no longer work nights.",
            "fa": "دیگر شیفت شب کار نمی‌کنم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_life_changes_for_since",
      "data": {
        "lesson_key": "b1-life-changes-03",
        "slug": "b1-life-changes-for-since",
        "title": "Present perfect with for and since",
        "rule_summary": "Use for with a length of time and since with a starting point when a situation continues until now.",
        "explanation": {
          "fa": "برای مدت زمان از for و برای نقطه شروع از since استفاده می‌کنیم وقتی وضعیت تا الان ادامه دارد."
        },
        "examples": [
          {
            "en": "I've worked here for three years.",
            "fa": "سه سال است اینجا کار می‌کنم."
          },
          {
            "en": "I've lived here since 2024.",
            "fa": "از سال ۲۰۲۴ اینجا زندگی می‌کنم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_life_changes_work_change",
      "data": {
