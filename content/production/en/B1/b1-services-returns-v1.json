    {
      "kind": "grammar_point",
      "external_id": "g_b1_services_returns_have_get_done",
      "data": {
        "lesson_key": "b1-services-returns-01",
        "slug": "b1-services-returns-have-get-done",
        "title": "have/get something done",
        "rule_summary": "Use have/get + object + past participle when you arrange for someone else to perform a service.",
        "explanation": {
          "fa": "وقتی ترتیب می‌دیم شخص دیگری کاری را انجام دهد از have/get + مفعول + قسمت سوم فعل استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'm getting my screen replaced.",
            "fa": "دارم صفحه گوشیم رو تعویض می‌کنم."
          },
          {
            "en": "We had the air conditioner serviced.",
            "fa": "کولر رو سرویس کردیم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_services_returns_passive",
      "data": {
        "lesson_key": "b1-services-returns-02",
        "slug": "b1-services-returns-passive",
        "title": "Passive for service processes",
        "rule_summary": "Use the passive when the process matters more than the person doing it.",
        "explanation": {
          "fa": "در توضیح فرایند سرویس وقتی انجام‌دهنده مهم نیست از passive استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The part has been ordered.",
            "fa": "قطعه سفارش داده شده."
          },
          {
            "en": "The device was inspected yesterday.",
            "fa": "دستگاه دیروز بررسی شد."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_services_returns_reported_chunks",
      "data": {
        "lesson_key": "b1-services-returns-03",
        "slug": "b1-services-returns-reported-chunks",
        "title": "Reporting service information",
        "rule_summary": "Use told me / said that / explained that to relay information from staff.",
        "explanation": {
          "fa": "برای انتقال اطلاعات کارکنان از told me، said that و explained that استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "They told me it would take two days.",
            "fa": "گفتند دو روز طول می‌کشه."
          },
          {
            "en": "She explained that labor wasn't covered.",
            "fa": "توضیح داد دستمزد تحت پوشش نیست."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_services_returns_repair",
      "data": {
