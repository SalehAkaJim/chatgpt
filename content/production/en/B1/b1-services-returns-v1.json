        "cefr": "B1",
        "topic": "shopping",
        "characters": [
          "Chloe",
          "Adam"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Chloe",
            "text": "Could you give me an estimate before you repair it?",
