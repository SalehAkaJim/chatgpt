    {
      "kind": "grammar_point",
      "external_id": "g_b1_arrangements_changes_future_arrangements",
      "data": {
        "lesson_key": "b1-arrangements-changes-01",
        "slug": "b1-arrangements-changes-future-arrangements",
        "title": "Future arrangements review",
        "rule_summary": "Use present continuous for arrangements that have been agreed and scheduled.",
        "explanation": {
          "fa": "برای قرارهایی که توافق و زمان‌بندی شده‌اند از present continuous استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "We're meeting at eleven.",
            "fa": "ساعت یازده همدیگه رو می‌بینیم."
          },
          {
            "en": "She's flying in on Friday.",
            "fa": "جمعه با پرواز میاد."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_arrangements_changes_may_might",
      "data": {
        "lesson_key": "b1-arrangements-changes-02",
        "slug": "b1-arrangements-changes-may-might",
        "title": "may / might for uncertain plans",
        "rule_summary": "Use may or might when a future plan or detail is possible but not certain.",
        "explanation": {
          "fa": "وقتی یک برنامه یا جزئیات آینده قطعی نیست از may یا might استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The venue might change.",
            "fa": "ممکنه محل عوض بشه."
          },
          {
            "en": "We may finish earlier than expected.",
            "fa": "شاید زودتر از انتظار تموم کنیم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_arrangements_changes_alternatives",
      "data": {
        "lesson_key": "b1-arrangements-changes-02",
        "slug": "b1-arrangements-changes-alternatives",
        "title": "Conditionals for alternatives",
        "rule_summary": "Use if + present to discuss a possible scheduling problem and an alternative result.",
        "explanation": {
          "fa": "برای مشکل احتمالی در برنامه و گزینه جایگزین از if + present استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If Tuesday doesn't work, we can meet Wednesday.",
            "fa": "اگر سه‌شنبه نشد، چهارشنبه می‌تونیم ببینیم هم."
          },
          {
            "en": "If it rains, we'll move the event inside.",
