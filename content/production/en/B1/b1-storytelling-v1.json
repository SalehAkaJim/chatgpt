    {
      "kind": "grammar_point",
      "external_id": "g_b1_storytelling_narrative_review",
      "data": {
        "lesson_key": "b1-storytelling-01",
        "slug": "b1-storytelling-narrative-review",
        "title": "Narrative tenses review",
        "rule_summary": "Combine past simple for main events, past continuous for background, and past perfect when an earlier past event matters.",
        "explanation": {
          "fa": "برای روایت منسجم، از past simple برای اتفاق اصلی، past continuous برای پس‌زمینه و past perfect برای اتفاقی که قبل‌تر رخ داده استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "We were driving when the engine stopped.",
            "fa": "داشتیم رانندگی می‌کردیم که موتور خاموش شد."
          },
          {
            "en": "I realized I had left the map at home.",
            "fa": "فهمیدم نقشه را خانه جا گذاشته بودم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_storytelling_linkers",
      "data": {
        "lesson_key": "b1-storytelling-02",
        "slug": "b1-storytelling-linkers",
        "title": "Story linkers",
        "rule_summary": "Use meanwhile, by the time, eventually, and in the end to guide the listener through a story.",
        "explanation": {
          "fa": "برای هدایت شنونده در داستان از meanwhile، by the time، eventually و in the end استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Meanwhile, the rain got heavier.",
            "fa": "در همین حین باران شدیدتر شد."
          },
          {
            "en": "In the end, everyone laughed about it.",
            "fa": "در نهایت همه بهش خندیدند."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_storytelling_so_such",
      "data": {
        "lesson_key": "b1-storytelling-03",
        "slug": "b1-storytelling-so-such",
        "title": "so / such for emphasis",
        "rule_summary": "Use so + adjective/adverb and such + noun phrase to emphasize a strong result.",
        "explanation": {
          "fa": "برای تأکید از so + صفت/قید و such + گروه اسمی استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "It was so cold that we went back.",
            "fa": "آن‌قدر سرد بود که برگشتیم."
          },
          {
            "en": "It was such a long day that I fell asleep immediately.",
            "fa": "آن‌قدر روز طولانی‌ای بود که فوراً خوابم برد."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_storytelling_camping",
      "data": {
        "lesson_key": "b1-storytelling-01",
        "title": "A camping story",
        "setting": "kitchen",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Maya",
          "Leo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Maya",
