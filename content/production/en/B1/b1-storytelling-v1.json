      "data": {
        "lesson_key": "b1-storytelling-01",
        "text": {
          "en": "Meanwhile, our friends were waiting for us at the cabin."
        },
        "translations": {
          "fa": "در همین حین، دوستانمون در کلبه منتظر ما بودند."
        },
        "intent": "add_parallel_event",
        "concept_refs": [
