      "external_id": "u_b1_storytelling_notice",
      "data": {
        "lesson_key": "b1-storytelling-02",
        "text": {
          "en": "I didn't notice that my phone battery was almost dead until we got lost."
        },
        "translations": {
          "fa": "تا وقتی گم شدیم متوجه نشدم باتری گوشیم تقریباً تموم شده."
        },
        "intent": "add_detail",
        "concept_refs": [
          "b1_storytelling_notice"
