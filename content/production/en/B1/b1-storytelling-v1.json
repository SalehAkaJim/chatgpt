      "data": {
        "lesson_key": "b1-storytelling-01",
        "text": {
          "en": "It started as a normal Saturday, but it turned out to be anything but normal."
        },
        "translations": {
          "fa": "مثل یک شنبه معمولی شروع شد، ولی آخرش اصلاً معمولی از آب درنیومد."
