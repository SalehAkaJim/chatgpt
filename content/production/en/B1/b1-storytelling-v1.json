      "data": {
        "lesson_key": "b1-storytelling-01",
        "text": {
          "en": "We were hiking when an unexpected storm moved in."
        },
        "translations": {
          "fa": "داشتیم کوه‌پیمایی می‌کردیم که یک طوفان غیرمنتظره رسید."
