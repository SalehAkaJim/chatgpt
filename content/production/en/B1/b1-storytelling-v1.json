      "data": {
        "lesson_key": "b1-storytelling-02",
        "text": {
          "en": "By the time we found the trail again, we were completely soaked."
        },
        "translations": {
          "fa": "تا وقتی دوباره مسیر رو پیدا کردیم، خیسِ خیس شده بودیم."
