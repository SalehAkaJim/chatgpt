    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_start",
      "data": {
        "lesson_key": "b1-personal-stories-01",
        "text": {
          "en": "Something really embarrassing happened to me on Monday."
        },
        "translations": {
          "fa": "دوشنبه یک اتفاق واقعاً خجالت‌آور برام افتاد."
        },
        "intent": "open_story",
        "concept_refs": [
          "b1_personal_stories_embarrassing"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_background",
      "data": {
        "lesson_key": "b1-personal-stories-01",
        "text": {
          "en": "I was rushing to work while I was answering a message."
        },
        "translations": {
          "fa": "داشتم با عجله می‌رفتم سر کار و هم‌زمان جواب یک پیام را می‌دادم."
        },
        "intent": "set_story_background",
        "concept_refs": [
          "b1_personal_stories_while"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_drop",
      "data": {
        "lesson_key": "b1-personal-stories-01",
        "text": {
          "en": "Suddenly, I dropped my coffee right outside the elevator."
        },
        "translations": {
          "fa": "ناگهان درست جلوی آسانسور قهوه‌ام از دستم افتاد."
        },
        "intent": "describe_key_event",
        "concept_refs": [
          "b1_personal_stories_suddenly",
          "b1_personal_stories_drop"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_wrong_floor",
      "data": {
        "lesson_key": "b1-personal-stories-02",
        "text": {
          "en": "Then I realized I'd gotten off on the wrong floor."
        },
        "translations": {
          "fa": "بعد متوجه شدم در طبقه اشتباهی از آسانسور پیاده شده بودم."
        },
        "intent": "describe_realization",
        "concept_refs": [
          "b1_personal_stories_realize",
          "b1_personal_stories_mistake"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_help",
      "data": {
        "lesson_key": "b1-personal-stories-02",
        "text": {
          "en": "Luckily, a stranger showed me where the meeting room was."
        },
        "translations": {
          "fa": "خوشبختانه یک غریبه نشانم داد اتاق جلسه کجاست."
        },
        "intent": "describe_help",
        "concept_refs": [
          "b1_personal_stories_luckily",
          "b1_personal_stories_stranger"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_reaction",
      "data": {
        "lesson_key": "b1-personal-stories-02",
        "text": {
          "en": "At first I wanted to disappear, but then I started laughing."
        },
        "translations": {
          "fa": "اولش دلم می‌خواست آب بشم برم تو زمین، ولی بعد خودم زدم زیر خنده."
        },
        "intent": "describe_reaction",
        "concept_refs": [
          "b1_personal_stories_laugh"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_ending",
      "data": {
        "lesson_key": "b1-personal-stories-03",
        "text": {
          "en": "Eventually, I made it to the meeting only five minutes late."
        },
        "translations": {
          "fa": "در نهایت فقط با پنج دقیقه تأخیر به جلسه رسیدم."
        },
        "intent": "close_story",
