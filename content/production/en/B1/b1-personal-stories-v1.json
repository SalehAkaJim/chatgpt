    {
      "kind": "utterance",
      "external_id": "u_b1_personal_stories_lesson",
      "data": {
        "lesson_key": "b1-personal-stories-03",
        "text": {
          "en": "Now I never text while I'm walking with a full cup of coffee."
        },
        "translations": {
          "fa": "حالا دیگر وقتی با یک لیوان پر قهوه راه می‌روم پیام نمی‌دهم."
        },
        "intent": "reflect_on_story",
        "concept_refs": [
          "b1_personal_stories_while"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_personal_stories_past_background",
      "data": {
        "lesson_key": "b1-personal-stories-01",
        "slug": "b1-personal-stories-past-background",
        "title": "Past simple and past continuous",
        "rule_summary": "Use the past continuous for background actions and the past simple for completed events that move the story forward.",
        "explanation": {
          "fa": "برای کارهای در حال انجام در پس‌زمینه از past continuous و برای اتفاق‌های کامل‌شده‌ای که داستان را جلو می‌برند از past simple استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I was walking home when it started to rain.",
            "fa": "داشتم به خانه می‌رفتم که باران شروع شد."
          },
          {
            "en": "She called while I was cooking.",
            "fa": "وقتی داشتم آشپزی می‌کردم زنگ زد."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_personal_stories_sequence",
      "data": {
        "lesson_key": "b1-personal-stories-02",
        "slug": "b1-personal-stories-sequence",
        "title": "Narrative sequence markers",
        "rule_summary": "Use expressions such as at first, then, after that, and eventually to make the order of events clear.",
        "explanation": {
          "fa": "برای روشن کردن ترتیب اتفاق‌ها از عباراتی مثل at first، then، after that و eventually استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "At first, I didn't notice the problem.",
            "fa": "اولش متوجه مشکل نشدم."
          },
          {
            "en": "Eventually, we found the right address.",
            "fa": "در نهایت آدرس درست را پیدا کردیم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_personal_stories_narrative_adverbs",
      "data": {
        "lesson_key": "b1-personal-stories-03",
        "slug": "b1-personal-stories-narrative-adverbs",
        "title": "Narrative adverbs",
        "rule_summary": "Adverbs such as suddenly, luckily, and unfortunately help show how an event happened or how the speaker views it.",
        "explanation": {
          "fa": "قیدهایی مثل suddenly، luckily و unfortunately نشان می‌دهند اتفاق چطور افتاده یا گوینده چه برداشتی از آن دارد."
        },
        "examples": [
          {
            "en": "Suddenly, the lights went out.",
            "fa": "ناگهان چراغ‌ها خاموش شدند."
          },
          {
            "en": "Luckily, nobody was hurt.",
            "fa": "خوشبختانه کسی آسیب ندید."
          }
