    {
      "kind": "grammar_point",
      "external_id": "g_b1_local_experiences_indirect_questions",
      "data": {
        "lesson_key": "b1-local-experiences-01",
        "slug": "b1-local-experiences-indirect-questions",
        "title": "Indirect questions",
        "rule_summary": "Use Do you know…? / Could you tell me…? with statement word order for polite information requests.",
        "explanation": {
          "fa": "برای درخواست مؤدبانه اطلاعات از Do you know یا Could you tell me و ترتیب جمله خبری استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Do you know where the station is?",
            "fa": "می‌دونید ایستگاه کجاست؟"
          },
          {
            "en": "Could you tell me when the market closes?",
            "fa": "می‌شه بگید بازار کی بسته می‌شه؟"
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_local_experiences_relative_places",
      "data": {
        "lesson_key": "b1-local-experiences-02",
        "slug": "b1-local-experiences-relative-places",
        "title": "Relative clauses for places",
        "rule_summary": "Use that/which/where to identify or describe places.",
        "explanation": {
          "fa": "برای مشخص کردن یا توصیف مکان از that، which یا where استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "It's a cafe where locals meet after work.",
            "fa": "کافه‌ایه که محلی‌ها بعد کار می‌رن."
          },
          {
            "en": "The museum that opened last year is free.",
            "fa": "موزه‌ای که پارسال باز شد رایگانه."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_local_experiences_recommend_modals",
      "data": {
        "lesson_key": "b1-local-experiences-03",
        "slug": "b1-local-experiences-recommend-modals",
        "title": "Modals for recommendations",
        "rule_summary": "Use should, could, and I'd + base form to recommend with different strength.",
        "explanation": {
          "fa": "برای پیشنهاد با شدت متفاوت از should، could و I'd استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "You should book ahead.",
            "fa": "بهتره از قبل رزرو کنید."
          },
          {
            "en": "You could take the river walk.",
            "fa": "می‌تونید مسیر کنار رودخونه رو برید."
          }
