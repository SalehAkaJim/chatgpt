    {
      "kind": "grammar_point",
      "external_id": "g_b1_digital_life_relative_digital",
      "data": {
        "lesson_key": "b1-digital-life-01",
        "slug": "b1-digital-life-relative-digital",
        "title": "Relative clauses for digital tools",
        "rule_summary": "Use that/which to define apps, settings, or devices by what they do.",
        "explanation": {
          "fa": "برای مشخص کردن اپ، تنظیم یا دستگاه با کارکردش از that/which استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I use an app that blocks distractions.",
            "fa": "از اپی استفاده می‌کنم که حواس‌پرتی رو می‌بنده."
          },
          {
            "en": "The setting which controls notifications is here.",
            "fa": "تنظیمی که اعلان‌ها رو کنترل می‌کنه اینجاست."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_digital_life_passive_digital",
      "data": {
        "lesson_key": "b1-digital-life-02",
        "slug": "b1-digital-life-passive-digital",
        "title": "Passive for technical processes",
        "rule_summary": "Use passive forms when describing updates, backups, or automated processes.",
        "explanation": {
          "fa": "برای توضیح آپدیت، پشتیبان‌گیری و فرایندهای خودکار از passive استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The app was updated yesterday.",
            "fa": "اپ دیروز به‌روزرسانی شد."
          },
          {
            "en": "Your data is backed up automatically.",
            "fa": "داده‌هات خودکار پشتیبان‌گیری می‌شن."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_digital_life_troubleshooting_if",
      "data": {
        "lesson_key": "b1-digital-life-03",
        "slug": "b1-digital-life-troubleshooting-if",
        "title": "Conditionals for troubleshooting",
        "rule_summary": "Use if + present with try/can/may/will to test possible causes and fixes.",
        "explanation": {
          "fa": "برای تست علت و راه‌حل از if + present همراه try/can/may/will استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If it still doesn't sync, restart the app.",
            "fa": "اگر هنوز همگام نشد، اپ رو ری‌استارت کن."
          },
          {
            "en": "If storage is full, the update may fail.",
            "fa": "اگر حافظه پر باشه، ممکنه آپدیت شکست بخوره."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
