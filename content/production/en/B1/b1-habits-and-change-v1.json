    {
      "kind": "grammar_point",
      "external_id": "g_b1_habits_and_change_used_to_variants",
      "data": {
        "lesson_key": "b1-habits-and-change-01",
        "slug": "b1-habits-and-change-used-to-variants",
        "title": "used to, be used to, get used to",
        "rule_summary": "Used to describes a past habit; be used to means something is familiar; get used to describes the process of becoming familiar.",
        "explanation": {
          "fa": "used to برای عادت گذشته است، be used to یعنی چیزی برایمان عادی است و get used to روند عادت کردن را بیان می‌کند."
        },
        "examples": [
          {
            "en": "I used to check my phone in bed.",
            "fa": "قبلاً در تخت گوشی‌ام را چک می‌کردم."
          },
          {
            "en": "I'm getting used to leaving it outside the bedroom.",
            "fa": "دارم عادت می‌کنم گوشی را بیرون اتاق خواب بگذارم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_habits_and_change_gerunds",
      "data": {
        "lesson_key": "b1-habits-and-change-02",
        "slug": "b1-habits-and-change-gerunds",
        "title": "Gerunds after common verbs",
        "rule_summary": "After verbs such as avoid, enjoy, keep, finish, and consider, use the -ing form.",
        "explanation": {
          "fa": "بعد از فعل‌هایی مثل avoid، enjoy، keep، finish و consider از شکل ing استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I avoid checking messages during meals.",
            "fa": "هنگام غذا از چک کردن پیام‌ها خودداری می‌کنم."
          },
          {
