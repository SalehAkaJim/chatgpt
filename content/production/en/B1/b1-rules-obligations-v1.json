    {
      "kind": "grammar_point",
      "external_id": "g_b1_rules_obligations_must_have_to",
      "data": {
        "lesson_key": "b1-rules-obligations-01",
        "slug": "b1-rules-obligations-must-have-to",
        "title": "must vs have to",
        "rule_summary": "Use must for strong rules or speaker authority; have to is common for external rules and obligations.",
        "explanation": {
          "fa": "برای الزام قوی یا قانون مستقیم از must و برای الزام بیرونی و رایج از have to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "You must sign in.",
            "fa": "باید ورودت رو ثبت کنی."
          },
          {
            "en": "We have to wear badges.",
            "fa": "باید کارت شناسایی داشته باشیم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_rules_obligations_prohibition",
      "data": {
        "lesson_key": "b1-rules-obligations-02",
        "slug": "b1-rules-obligations-prohibition",
        "title": "mustn't vs don't have to",
        "rule_summary": "Mustn't means something is prohibited; don't have to means it is not necessary.",
        "explanation": {
          "fa": "mustn't یعنی ممنوع است؛ don't have to یعنی لازم نیست."
        },
        "examples": [
          {
            "en": "You mustn't smoke here.",
            "fa": "اینجا نباید سیگار بکشی."
          },
          {
            "en": "You don't have to stay late.",
            "fa": "لازم نیست دیر بمونی."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_rules_obligations_allowed",
      "data": {
        "lesson_key": "b1-rules-obligations-03",
        "slug": "b1-rules-obligations-allowed",
        "title": "be allowed to",
        "rule_summary": "Use be allowed to for permission in rules and policies.",
        "explanation": {
          "fa": "برای بیان اجازه طبق قانون یا آیین‌نامه از be allowed to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "We're allowed to leave early on Friday.",
            "fa": "جمعه اجازه داریم زودتر بریم."
          },
          {
            "en": "Visitors aren't allowed to enter this area.",
            "fa": "بازدیدکننده‌ها اجازه ورود به این قسمت رو ندارند."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
