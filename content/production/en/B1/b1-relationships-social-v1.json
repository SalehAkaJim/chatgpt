    {
      "kind": "utterance",
      "external_id": "u_b1_relationships_social_suggest",
      "data": {
        "lesson_key": "b1-relationships-social-03",
        "text": {
          "en": "If I were you, I'd explain how you felt instead of guessing what they meant."
        },
        "translations": {
          "fa": "اگر جای تو بودم توضیح می‌دادم چه حسی داشتی به‌جای اینکه حدس بزنی منظورشون چی بوده."
