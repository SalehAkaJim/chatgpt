    {
      "kind": "utterance",
      "external_id": "u_b1_relationships_social_misunderstanding",
      "data": {
        "lesson_key": "b1-relationships-social-01",
        "text": {
          "en": "I think there was a misunderstanding about what time we were supposed to meet."
        },
        "translations": {
          "fa": "فکر می‌کنم درباره ساعتی که قرار بود همدیگه رو ببینیم سوءتفاهم شد."
        },
        "intent": "identify_misunderstanding",
        "concept_refs": [
          "b1_relationships_social_misunderstanding"
        ],
        "cefr": "B1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_relationships_social_assume",
      "data": {
        "lesson_key": "b1-relationships-social-01",
        "text": {
          "en": "I assumed you were busy because you didn't reply, but I should have asked."
        },
        "translations": {
          "fa": "فرض کردم سرت شلوغه چون جواب ندادی، ولی باید می‌پرسیدم."
        },
        "intent": "acknowledge_assumption",
        "concept_refs": [
          "b1_relationships_social_assume"
        ],
        "cefr": "B1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_relationships_social_apology",
      "data": {
        "lesson_key": "b1-relationships-social-01",
        "text": {
          "en": "I'm sorry I sounded annoyed. I was stressed about something else."
        },
        "translations": {
          "fa": "ببخشید عصبانی به نظر رسیدم. درباره چیز دیگه‌ای استرس داشتم."
        },
        "intent": "apologize_explain",
        "concept_refs": [
          "b1_relationships_social_apologize",
          "b1_relationships_social_upset"
        ],
        "cefr": "B1",
        "topic": "polite-language",
        "register": "neutral",
        "status": "approved"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_b1_relationships_social_reported",
      "data": {
        "lesson_key": "b1-relationships-social-02",
        "text": {
          "en": "Maya said she felt left out because nobody told her the plan had changed."
        },
        "translations": {
          "fa": "مایا گفت حس کرده کنار گذاشته شده چون کسی نگفته بود برنامه عوض شده."
        },
        "intent": "report_social_issue",
        "concept_refs": [
          "b1_relationships_social_perspective"
        ],
