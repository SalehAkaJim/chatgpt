    },
    {
      "kind": "utterance",
      "external_id": "u_b1_relationships_social_boundary",
      "data": {
        "lesson_key": "b1-relationships-social-02",
        "text": {
          "en": "It's okay to set a boundary without being rude or unfriendly."
        },
        "translations": {
          "fa": "می‌شه بدون بی‌ادبی یا سرد بودن مرز شخصی تعیین کرد."
