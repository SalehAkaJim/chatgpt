    {
      "kind": "utterance",
      "external_id": "u_b1_relationships_social_resolve",
      "data": {
        "lesson_key": "b1-relationships-social-03",
        "text": {
          "en": "Once we talked about it directly, the misunderstanding was easy to resolve."
        },
        "translations": {
          "fa": "وقتی مستقیم درباره‌اش حرف زدیم، حل سوءتفاهم راحت بود."
