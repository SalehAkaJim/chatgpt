    {
      "kind": "grammar_point",
      "external_id": "g_b1_relationships_social_reported_social",
      "data": {
        "lesson_key": "b1-relationships-social-01",
        "slug": "b1-relationships-social-reported-social",
        "title": "Reported speech for social situations",
        "rule_summary": "Use said/told me/explained that to report what someone communicated without repeating exact words.",
        "explanation": {
          "fa": "برای انتقال حرف دیگران بدون نقل قول مستقیم از said، told me و explained that استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "She said she was upset.",
            "fa": "گفت ناراحت بوده."
          },
          {
            "en": "He told me he needed more time.",
            "fa": "گفت زمان بیشتری لازم داره."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_relationships_social_advice_social",
      "data": {
        "lesson_key": "b1-relationships-social-02",
        "slug": "b1-relationships-social-advice-social",
        "title": "should / could / if I were you",
        "rule_summary": "Use these forms to give tactful suggestions; could is often softer than should.",
        "explanation": {
          "fa": "برای پیشنهاد مؤدبانه از should، could و if I were you استفاده می‌کنیم؛ could معمولاً نرم‌تره."
        },
        "examples": [
          {
            "en": "You could ask what happened.",
            "fa": "می‌تونی بپرسی چی شده."
          },
          {
            "en": "If I were you, I'd talk to her directly.",
            "fa": "اگر جای تو بودم مستقیم باهاش حرف می‌زدم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_relationships_social_conditionals_social",
      "data": {
        "lesson_key": "b1-relationships-social-03",
        "slug": "b1-relationships-social-conditionals-social",
        "title": "Conditionals for social outcomes",
        "rule_summary": "Use first conditional to discuss likely results of possible social actions.",
        "explanation": {
          "fa": "برای نتیجه محتمل رفتار اجتماعی از شرط نوع اول استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If you explain calmly, they'll probably understand.",
            "fa": "اگر آروم توضیح بدی، احتمالاً می‌فهمند."
          },
          {
            "en": "If we don't talk about it, the problem may continue.",
