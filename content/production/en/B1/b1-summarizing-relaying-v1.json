    {
      "kind": "grammar_point",
      "external_id": "g_b1_summarizing_relaying_reported_speech",
      "data": {
        "lesson_key": "b1-summarizing-relaying-01",
        "slug": "b1-summarizing-relaying-reported-speech",
        "title": "Reported speech",
        "rule_summary": "Use said/told/asked to relay the main meaning of someone's message; pronouns and time references may shift.",
        "explanation": {
          "fa": "برای انتقال معنی اصلی پیام از said/told/asked استفاده می‌کنیم؛ ضمیر و زمان ممکنه تغییر کنه."
        },
        "examples": [
          {
            "en": "She said she was running late.",
            "fa": "گفت دیر می‌رسه."
          },
          {
            "en": "He asked me to call him.",
            "fa": "ازم خواست بهش زنگ بزنم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_summarizing_relaying_say_tell",
      "data": {
        "lesson_key": "b1-summarizing-relaying-02",
        "slug": "b1-summarizing-relaying-say-tell",
        "title": "say vs tell",
        "rule_summary": "Use say without a person object or with to; use tell + person.",
        "explanation": {
          "fa": "say معمولاً بدون مفعول شخص میاد یا با to؛ tell مستقیم با شخص میاد."
        },
        "examples": [
          {
            "en": "She said that the time had changed.",
            "fa": "گفت زمان عوض شده."
          },
          {
            "en": "She told me that the time had changed.",
            "fa": "به من گفت زمان عوض شده."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
