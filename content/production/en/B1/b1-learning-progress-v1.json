    {
      "kind": "grammar_point",
      "external_id": "g_b1_learning_progress_perfect_progress",
      "data": {
        "lesson_key": "b1-learning-progress-01",
        "slug": "b1-learning-progress-perfect-progress",
        "title": "Present perfect for learning progress",
        "rule_summary": "Use present perfect to describe changes and achievements from the past up to now.",
        "explanation": {
          "fa": "برای تغییر و دستاورد از گذشته تا الان از present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've improved a lot this year.",
            "fa": "امسال خیلی بهتر شده‌ام."
          },
          {
            "en": "My vocabulary has grown since January.",
            "fa": "دایره واژگانم از ژانویه بیشتر شده."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_learning_progress_comparisons_time",
      "data": {
        "lesson_key": "b1-learning-progress-02",
        "slug": "b1-learning-progress-comparisons-time",
        "title": "Comparing ability over time",
        "rule_summary": "Use comparative forms with now, before, than I used to, and much/a little to describe development.",
        "explanation": {
          "fa": "برای مقایسه توانایی در طول زمان از now، before، than I used to و much/a little استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I speak more confidently now.",
            "fa": "الان با اعتمادبه‌نفس بیشتری صحبت می‌کنم."
          },
          {
            "en": "I make fewer mistakes than I used to.",
            "fa": "کمتر از قبل اشتباه می‌کنم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_learning_progress_yet_already_still",
      "data": {
        "lesson_key": "b1-learning-progress-03",
        "slug": "b1-learning-progress-yet-already-still",
        "title": "yet / already / still",
        "rule_summary": "Use yet, already, and still to show whether expected progress has happened or continues.",
        "explanation": {
          "fa": "برای نشان دادن اتفاق افتادن یا ادامه داشتن پیشرفت مورد انتظار از yet، already و still استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I haven't finished yet.",
            "fa": "هنوز تموم نکردم."
          },
          {
            "en": "I can already understand most of it.",
            "fa": "الان دیگه بیشترش رو می‌فهمم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_learning_progress_review",
      "data": {
