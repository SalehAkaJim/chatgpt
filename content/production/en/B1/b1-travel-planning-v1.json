    {
      "kind": "grammar_point",
      "external_id": "g_b1_travel_planning_future_review",
      "data": {
        "lesson_key": "b1-travel-planning-01",
        "slug": "b1-travel-planning-future-review",
        "title": "Future forms for travel plans",
        "rule_summary": "Use present continuous for fixed bookings, going to for intentions, and will/might for predictions or flexible decisions.",
        "explanation": {
          "fa": "برای رزرو قطعی از present continuous، برای قصد از going to و برای پیش‌بینی یا تصمیم منعطف از will/might استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "We're flying Friday night.",
            "fa": "جمعه شب پرواز داریم."
          },
          {
            "en": "We might stay an extra day.",
            "fa": "شاید یک روز بیشتر بمونیم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_travel_planning_travel_conditionals",
      "data": {
        "lesson_key": "b1-travel-planning-02",
        "slug": "b1-travel-planning-travel-conditionals",
        "title": "Conditionals for travel planning",
        "rule_summary": "Use if/unless to compare practical travel outcomes and backup plans.",
        "explanation": {
          "fa": "برای بررسی نتیجه‌ها و برنامه پشتیبان سفر از if/unless استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If the train is cheaper, we'll take it.",
            "fa": "اگر قطار ارزون‌تر باشه، قطار می‌گیریم."
          },
          {
            "en": "We'll go hiking unless it rains.",
            "fa": "مگر اینکه بارون بیاد، کوه‌پیمایی می‌ریم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_travel_planning_relative_travel",
      "data": {
        "lesson_key": "b1-travel-planning-03",
        "slug": "b1-travel-planning-relative-travel",
        "title": "Relative clauses for travel choices",
        "rule_summary": "Use that/which to identify routes, hotels, or tickets by their features.",
        "explanation": {
          "fa": "برای مشخص کردن مسیر، هتل یا بلیت با ویژگی‌ها از that/which استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I want a ticket that can be changed.",
            "fa": "بلیتی می‌خوام که بشه تغییرش داد."
          },
          {
