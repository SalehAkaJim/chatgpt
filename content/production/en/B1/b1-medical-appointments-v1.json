    {
      "kind": "grammar_point",
      "external_id": "g_b1_medical_appointments_for_since",
      "data": {
        "lesson_key": "b1-medical-appointments-01",
        "slug": "b1-medical-appointments-for-since",
        "title": "Present perfect with for / since",
        "rule_summary": "Use present perfect with for for duration and since for the starting point of a situation continuing now.",
        "explanation": {
          "fa": "برای مدت از for و برای نقطه شروع از since همراه present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've had it for three weeks.",
            "fa": "سه هفته‌ست دارمش."
          },
          {
            "en": "I've felt tired since Monday.",
            "fa": "از دوشنبه خسته‌ام."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_medical_appointments_past_onset",
      "data": {
        "lesson_key": "b1-medical-appointments-02",
        "slug": "b1-medical-appointments-past-onset",
        "title": "Past simple for symptom onset",
        "rule_summary": "Use past simple for the specific time a symptom began or a finished event connected to it.",
        "explanation": {
          "fa": "برای زمان مشخص شروع علامت یا اتفاق تمام‌شده مرتبط از past simple استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The pain started Tuesday night.",
            "fa": "درد سه‌شنبه شب شروع شد."
          },
          {
            "en": "I fell during a run yesterday.",
            "fa": "دیروز هنگام دویدن افتادم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_medical_appointments_reported_advice",
      "data": {
        "lesson_key": "b1-medical-appointments-03",
        "slug": "b1-medical-appointments-reported-advice",
        "title": "Reported medical advice",
        "rule_summary": "Use told me to / asked me to / said I should to report straightforward advice.",
        "explanation": {
          "fa": "برای انتقال توصیه پزشکی از told me to، asked me to یا said I should استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "She told me to rest.",
            "fa": "گفت استراحت کنم."
          },
          {
            "en": "He said I should drink more water.",
            "fa": "گفت بهتره آب بیشتری بخورم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_medical_appointments_doctor",
      "data": {
        "lesson_key": "b1-medical-appointments-01",
        "title": "Explaining symptoms",
        "setting": "clinic",
        "cefr": "B1",
        "topic": "basic-health",
        "characters": [
          "Maya",
          "Drake"
        ],
