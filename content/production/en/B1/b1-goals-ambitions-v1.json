    {
      "kind": "grammar_point",
      "external_id": "g_b1_goals_ambitions_verb_patterns",
      "data": {
        "lesson_key": "b1-goals-ambitions-01",
        "slug": "b1-goals-ambitions-verb-patterns",
        "title": "hope / plan / expect + to",
        "rule_summary": "Use common planning verbs followed by to + infinitive to describe goals and expectations.",
        "explanation": {
          "fa": "برای بیان هدف و انتظار، بسیاری از فعل‌ها مثل hope، plan و expect با to + مصدر می‌آیند."
        },
        "examples": [
          {
            "en": "I hope to finish by June.",
            "fa": "امیدوارم تا ژوئن تمام کنم."
          },
          {
            "en": "We plan to expand next year.",
            "fa": "قصد داریم سال بعد توسعه بدیم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_goals_ambitions_purpose",
      "data": {
        "lesson_key": "b1-goals-ambitions-01",
        "slug": "b1-goals-ambitions-purpose",
        "title": "Purpose with to / in order to",
        "rule_summary": "Use to or in order to to explain the purpose of an action.",
        "explanation": {
          "fa": "برای توضیح هدف یک کار از to یا in order to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'm saving to buy a car.",
            "fa": "دارم پس‌انداز می‌کنم تا ماشین بخرم."
          },
          {
            "en": "She moved closer in order to reduce her commute.",
            "fa": "نزدیک‌تر نقل مکان کرد تا رفت‌وآمدش کمتر بشه."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_goals_ambitions_first_conditional",
      "data": {
        "lesson_key": "b1-goals-ambitions-02",
        "slug": "b1-goals-ambitions-first-conditional",
        "title": "First conditional for goal outcomes",
        "rule_summary": "Use if + present simple and will/can/might to discuss realistic future results.",
        "explanation": {
          "fa": "برای نتیجه‌های واقع‌بینانه آینده از if + present simple و will/can/might استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If I practice regularly, I'll improve.",
            "fa": "اگر منظم تمرین کنم بهتر می‌شم."
          },
