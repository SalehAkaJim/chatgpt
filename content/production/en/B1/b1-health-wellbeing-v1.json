    {
      "kind": "grammar_point",
      "external_id": "g_b1_health_wellbeing_advice",
      "data": {
        "lesson_key": "b1-health-wellbeing-01",
        "slug": "b1-health-wellbeing-advice",
        "title": "should / ought to for wellbeing",
        "rule_summary": "Use should and ought to for practical recommendations rather than medical certainty.",
        "explanation": {
          "fa": "برای توصیه عملی در زمینه سلامت از should و ought to استفاده می‌کنیم، نه برای تشخیص قطعی."
        },
        "examples": [
          {
            "en": "You should take regular breaks.",
            "fa": "بهتره منظم استراحت کنی."
          },
          {
            "en": "You ought to get more sleep.",
            "fa": "بهتره بیشتر بخوابی."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_health_wellbeing_gerund_inf",
      "data": {
        "lesson_key": "b1-health-wellbeing-02",
        "slug": "b1-health-wellbeing-gerund-inf",
        "title": "Gerunds and infinitives",
        "rule_summary": "Some verbs are followed by -ing and others by to + infinitive; common chunks should be learned as patterns.",
        "explanation": {
          "fa": "بعضی فعل‌ها با ing و بعضی با to + مصدر می‌آیند؛ بهتر است به شکل الگو یاد گرفته شوند."
        },
        "examples": [
          {
            "en": "I enjoy walking after work.",
            "fa": "بعد کار پیاده‌روی دوست دارم."
          },
          {
            "en": "I try to sleep eight hours.",
            "fa": "سعی می‌کنم هشت ساعت بخوابم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_health_wellbeing_cause_effect",
      "data": {
        "lesson_key": "b1-health-wellbeing-03",
        "slug": "b1-health-wellbeing-cause-effect",
        "title": "Cause and effect links",
        "rule_summary": "Use because, so, which means, and as a result to connect lifestyle choices and effects.",
        "explanation": {
          "fa": "برای وصل کردن انتخاب سبک زندگی و نتیجه از because، so، which means و as a result استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I sleep badly, so I'm tired.",
            "fa": "بد می‌خوابم، پس خسته‌ام."
          },
          {
            "en": "I changed my routine. As a result, I have more energy.",
            "fa": "روالم رو عوض کردم. در نتیجه انرژی بیشتری دارم."
          }
