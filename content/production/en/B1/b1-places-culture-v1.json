    {
      "kind": "grammar_point",
      "external_id": "g_b1_places_culture_comparison_culture",
      "data": {
        "lesson_key": "b1-places-culture-03",
        "slug": "b1-places-culture-comparison-culture",
        "title": "Comparative structures for cultures",
        "rule_summary": "Use similar to, different from, whereas, and compared with to make respectful comparisons.",
        "explanation": {
          "fa": "برای مقایسه محترمانه فرهنگ‌ها از similar to، different from، whereas و compared with استفاده می‌کنیم."
