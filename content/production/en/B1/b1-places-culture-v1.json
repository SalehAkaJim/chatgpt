        "examples": [
          {
            "en": "The custom is similar to one in my country.",
            "fa": "این رسم شبیه یکی از رسم‌های کشور منه."
          },
          {
            "en": "Compared with my hometown, the festival is much larger.",
            "fa": "در مقایسه با شهر من، جشنواره خیلی بزرگ‌تره."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
