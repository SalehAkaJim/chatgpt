    {
      "kind": "grammar_point",
      "external_id": "g_b1_places_culture_relative_places",
      "data": {
        "lesson_key": "b1-places-culture-01",
        "slug": "b1-places-culture-relative-places",
        "title": "Relative clauses for culture and places",
        "rule_summary": "Use who/that/which/where to connect descriptive information about people, events, and places.",
        "explanation": {
          "fa": "برای وصل کردن اطلاعات توصیفی درباره آدم‌ها، رویدادها و مکان‌ها از who/that/which/where استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "It's a town where artists have lived for generations.",
            "fa": "شهریه که نسل‌ها هنرمندها در اون زندگی کردند."
          },
          {
            "en": "The festival that takes place in June is free.",
            "fa": "جشنواره‌ای که ژوئن برگزار می‌شه رایگانه."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
