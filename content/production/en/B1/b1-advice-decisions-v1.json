    {
      "kind": "grammar_point",
      "external_id": "g_b1_advice_decisions_should_ought",
      "data": {
        "lesson_key": "b1-advice-decisions-01",
        "slug": "b1-advice-decisions-should-ought",
        "title": "should / ought to",
        "rule_summary": "Use should or ought to for advice; ought to is slightly less common and can sound a little more formal.",
        "explanation": {
          "fa": "برای توصیه از should یا ought to استفاده می‌کنیم؛ ought to کمی رسمی‌تر و کم‌کاربردتر است."
        },
        "examples": [
          {
            "en": "You should sleep on it.",
            "fa": "بهتره یک شب روش فکر کنی."
          },
          {
            "en": "You ought to read the contract carefully.",
            "fa": "بهتره قرارداد رو دقیق بخونی."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_advice_decisions_if_i_were",
      "data": {
        "lesson_key": "b1-advice-decisions-02",
        "slug": "b1-advice-decisions-if-i-were",
        "title": "If I were you…",
        "rule_summary": "Use If I were you, I'd… to give advice from another person's perspective.",
        "explanation": {
          "fa": "برای توصیه از دید طرف مقابل از If I were you, I'd… استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If I were you, I'd wait.",
            "fa": "اگر جای تو بودم صبر می‌کردم."
          },
          {
            "en": "If I were you, I wouldn't rush the decision.",
            "fa": "اگر جای تو بودم برای تصمیم عجله نمی‌کردم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_advice_decisions_conditional_result",
      "data": {
        "lesson_key": "b1-advice-decisions-03",
        "slug": "b1-advice-decisions-conditional-result",
        "title": "First conditional for consequences",
        "rule_summary": "Use if + present and will/may/might to discuss likely consequences of a real future choice.",
        "explanation": {
          "fa": "برای پیامدهای محتمل یک تصمیم واقعی آینده از if + present و will/may/might استفاده می‌کنیم."
        },
        "examples": [
