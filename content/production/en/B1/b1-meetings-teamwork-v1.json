    {
      "kind": "grammar_point",
      "external_id": "g_b1_meetings_teamwork_suggestions_meeting",
      "data": {
        "lesson_key": "b1-meetings-teamwork-01",
        "slug": "b1-meetings-teamwork-suggestions-meeting",
        "title": "Meeting suggestion forms",
        "rule_summary": "Use how about + -ing, we could, and I'd suggest + -ing to contribute ideas naturally.",
        "explanation": {
          "fa": "برای پیشنهاد در جلسه از how about + ing، we could و I'd suggest + ing استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "How about moving the deadline?",
            "fa": "چطوره مهلت رو جابه‌جا کنیم؟"
          },
          {
            "en": "I'd suggest testing this first.",
            "fa": "پیشنهاد می‌کنم اول این رو تست کنیم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_meetings_teamwork_reported_points",
      "data": {
        "lesson_key": "b1-meetings-teamwork-02",
        "slug": "b1-meetings-teamwork-reported-points",
        "title": "Reporting meeting points",
        "rule_summary": "Use said that / mentioned that / explained that to relay another person's point.",
        "explanation": {
          "fa": "برای انتقال نکته‌های دیگران در جلسه از said that، mentioned that و explained that استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Maya said that the client had approved it.",
            "fa": "مایا گفت مشتری تأیید کرده."
          },
          {
            "en": "Leo mentioned that testing was delayed.",
            "fa": "لئو گفت تست عقب افتاده."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_meetings_teamwork_conditional_planning",
      "data": {
        "lesson_key": "b1-meetings-teamwork-03",
        "slug": "b1-meetings-teamwork-conditional-planning",
        "title": "Conditionals for team planning",
        "rule_summary": "Use if + present with will/can/could to explore practical team consequences.",
        "explanation": {
          "fa": "برای بررسی پیامدهای عملی برنامه تیم از if + present همراه will/can/could استفاده می‌کنیم."
        },
        "examples": [
