    {
      "kind": "dialogue",
      "external_id": "d_b1_travel_disruptions_cancel",
      "data": {
        "lesson_key": "b1-travel-disruptions-01",
        "title": "Cancelled flight",
        "setting": "airport desk",
        "cefr": "B1",
        "topic": "transport",
        "characters": [
          "Maya",
          "Daniel"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Maya",
            "text": "My flight to Denver has been cancelled. What are my options?",
            "translation_fa": "پروازم به دنور لغو شده. چه گزینه‌هایی دارم؟"
          },
          {
            "order": 2,
            "speaker": "Daniel",
            "text": "We can rebook you tonight with one connection, or tomorrow on a direct flight.",
            "translation_fa": "می‌تونیم امشب با یک توقف رزرو کنیم یا فردا مستقیم."
          },
          {
            "order": 3,
            "speaker": "Maya",
            "text": "I'd prefer tonight if the connection is reasonable.",
            "translation_fa": "امشب رو ترجیح می‌دم اگر توقف منطقی باشه."
          },
          {
            "order": 4,
            "speaker": "Daniel",
            "text": "There's a ninety-minute connection in Chicago.",
            "translation_fa": "در شیکاگو توقف نود دقیقه‌ای هست."
          }
        ],
        "status": "approved"
      }
    },
