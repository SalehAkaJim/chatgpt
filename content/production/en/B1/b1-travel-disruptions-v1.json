    {
      "kind": "grammar_point",
      "external_id": "g_b1_travel_disruptions_passive_travel",
      "data": {
        "lesson_key": "b1-travel-disruptions-01",
        "slug": "b1-travel-disruptions-passive-travel",
        "title": "Passive voice in travel updates",
        "rule_summary": "Travel announcements often use the passive because the event matters more than the actor.",
        "explanation": {
          "fa": "اعلان‌های سفر اغلب passive هستند چون اتفاق مهم‌تر از انجام‌دهنده است."
        },
        "examples": [
          {
            "en": "The flight has been cancelled.",
            "fa": "پرواز لغو شده."
          },
          {
            "en": "Passengers are being rebooked.",
            "fa": "مسافرها دارن دوباره رزرو می‌شن."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_travel_disruptions_present_perfect_problem",
      "data": {
        "lesson_key": "b1-travel-disruptions-02",
        "slug": "b1-travel-disruptions-present-perfect-problem",
        "title": "Present perfect for ongoing disruption",
        "rule_summary": "Use present perfect when a travel problem has happened and still affects the current situation.",
        "explanation": {
          "fa": "برای مشکل سفر که اتفاق افتاده و هنوز اثرش ادامه دارد از present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I've missed my connection.",
            "fa": "پرواز اتصال رو از دست داده‌ام."
          },
          {
            "en": "My bag hasn't arrived.",
            "fa": "چمدونم نرسیده."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_travel_disruptions_conditionals_options",
      "data": {
        "lesson_key": "b1-travel-disruptions-03",
        "slug": "b1-travel-disruptions-conditionals-options",
        "title": "Conditionals for next steps",
        "rule_summary": "Use if + present with can/could/will to discuss practical alternatives.",
        "explanation": {
          "fa": "برای گزینه‌های عملی بعدی از if + present همراه can/could/will استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If there's no flight, could I take the train?",
            "fa": "اگر پرواز نیست، می‌تونم قطار بگیرم؟"
          },
          {
            "en": "If you wait here, we'll call your name.",
