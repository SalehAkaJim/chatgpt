    {
      "kind": "grammar_point",
      "external_id": "g_b1_events_in_progress_past_continuous",
      "data": {
        "lesson_key": "b1-events-in-progress-01",
        "slug": "b1-events-in-progress-past-continuous",
        "title": "Past continuous for background",
        "rule_summary": "Use was/were + -ing for an action that was in progress around a past moment.",
        "explanation": {
          "fa": "برای کاری که در یک لحظه گذشته در حال انجام بوده از was/were + ing استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I was driving home at six.",
            "fa": "ساعت شش داشتم به خانه رانندگی می‌کردم."
          },
          {
            "en": "They were having a meeting.",
            "fa": "آن‌ها در حال جلسه بودند."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_events_in_progress_when_while",
      "data": {
        "lesson_key": "b1-events-in-progress-01",
        "slug": "b1-events-in-progress-when-while",
        "title": "when and while",
        "rule_summary": "Use when commonly with the shorter interrupting event and while with an action that was already in progress.",
        "explanation": {
          "fa": "معمولاً when را با اتفاق کوتاه‌تر و قطع‌کننده و while را با کاری که از قبل در جریان بوده به کار می‌بریم."
        },
        "examples": [
          {
            "en": "I was cooking when the phone rang.",
            "fa": "داشتم آشپزی می‌کردم که تلفن زنگ خورد."
          },
          {
            "en": "The lights went out while we were eating.",
            "fa": "وقتی داشتیم غذا می‌خوردیم چراغ‌ها خاموش شدند."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_events_in_progress_interruption",
      "data": {
        "lesson_key": "b1-events-in-progress-02",
        "slug": "b1-events-in-progress-interruption",
        "title": "Background and interruption",
        "rule_summary": "Combine the past continuous and past simple to show an ongoing situation interrupted by a completed event.",
        "explanation": {
          "fa": "past continuous و past simple را کنار هم می‌آوریم تا نشان دهیم یک وضعیت در حال انجام با یک اتفاق کامل‌شده قطع شده است."
