    {
      "kind": "grammar_point",
      "external_id": "g_b1_everyday_environment_conditionals_env",
      "data": {
        "lesson_key": "b1-everyday-environment-01",
        "slug": "b1-everyday-environment-conditionals-env",
        "title": "Conditionals for environmental choices",
        "rule_summary": "Use first conditional for likely results and second conditional for hypothetical changes.",
        "explanation": {
          "fa": "برای نتیجه‌های محتمل از شرط نوع اول و برای تغییر فرضی از شرط نوع دوم استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "If we recycle more, we'll reduce waste.",
            "fa": "اگر بیشتر بازیافت کنیم زباله کمتر می‌شه."
          },
          {
            "en": "If buses were more frequent, I'd drive less.",
            "fa": "اگر اتوبوس بیشتر بود کمتر رانندگی می‌کردم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
