    {
      "kind": "grammar_point",
      "external_id": "g_b1_agree_disagree_so_neither",
      "data": {
        "lesson_key": "b1-agree-disagree-01",
        "slug": "b1-agree-disagree-so-neither",
        "title": "so / neither for agreement",
        "rule_summary": "Use So + auxiliary + subject to agree with a positive statement and Neither + auxiliary + subject for a negative one.",
        "explanation": {
          "fa": "برای موافقت با جمله مثبت از So + فعل کمکی + فاعل و برای جمله منفی از Neither استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I enjoy it. So do I.",
            "fa": "من دوستش دارم. من هم همین‌طور."
          },
          {
            "en": "I don't drive. Neither do I.",
            "fa": "من رانندگی نمی‌کنم. من هم نمی‌کنم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_agree_disagree_contrast",
      "data": {
        "lesson_key": "b1-agree-disagree-02",
        "slug": "b1-agree-disagree-contrast",
        "title": "Contrast markers",
        "rule_summary": "Use however, whereas, while, and on the other hand to compare opposing points clearly.",
        "explanation": {
          "fa": "برای مقایسه دیدگاه‌های مخالف از however، whereas، while و on the other hand استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "It's cheaper; however, it's less reliable.",
            "fa": "ارزان‌تره؛ با این حال کمتر قابل‌اعتماده."
          },
          {
            "en": "I work early, whereas she works late.",
            "fa": "من زود کار می‌کنم، در حالی که او دیر کار می‌کنه."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_agree_disagree_softening",
      "data": {
        "lesson_key": "b1-agree-disagree-03",
        "slug": "b1-agree-disagree-softening",
        "title": "Softening disagreement",
        "rule_summary": "Use phrases such as I see your point, but…, I'm not sure…, or I may be wrong, but… to disagree politely.",
        "explanation": {
          "fa": "برای مخالفت مؤدبانه از عبارت‌هایی مثل I see your point, but، I'm not sure و I may be wrong, but استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I see your point, but I still disagree.",
            "fa": "حرفت رو می‌فهمم، ولی هنوز مخالفم."
