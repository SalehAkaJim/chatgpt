    {
      "kind": "grammar_point",
      "external_id": "g_b1_complaints_solutions_current_problem",
      "data": {
        "lesson_key": "b1-complaints-solutions-01",
        "slug": "b1-complaints-solutions-current-problem",
        "title": "Present perfect for a current problem",
        "rule_summary": "Use present perfect when a recent problem has a result that is still true now.",
        "explanation": {
          "fa": "وقتی مشکل اخیر نتیجه‌ای دارد که هنوز ادامه دارد از present perfect استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The screen has stopped working.",
            "fa": "صفحه از کار افتاده."
          },
          {
            "en": "I've lost the receipt.",
            "fa": "رسید رو گم کرده‌ام."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_complaints_solutions_polite_requests",
      "data": {
        "lesson_key": "b1-complaints-solutions-02",
        "slug": "b1-complaints-solutions-polite-requests",
        "title": "Polite complaint requests",
        "rule_summary": "Use I'd like…, Could you…?, and Would it be possible…? to request a solution firmly but politely.",
        "explanation": {
          "fa": "برای درخواست راه‌حل مؤدبانه ولی قاطع از I'd like، Could you و Would it be possible استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "I'd like a replacement, please.",
            "fa": "لطفاً جایگزین می‌خوام."
          },
          {
            "en": "Could you check the warranty?",
            "fa": "می‌شه ضمانت رو بررسی کنید؟"
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_complaints_solutions_passive_intro",
      "data": {
        "lesson_key": "b1-complaints-solutions-03",
        "slug": "b1-complaints-solutions-passive-intro",
        "title": "Passive voice introduction",
        "rule_summary": "Use be + past participle when the action or process matters more than who performs it.",
        "explanation": {
          "fa": "وقتی خود فرایند مهم‌تر از انجام‌دهنده است از be + قسمت سوم فعل استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "The item will be collected tomorrow.",
            "fa": "کالا فردا جمع‌آوری می‌شه."
          },
