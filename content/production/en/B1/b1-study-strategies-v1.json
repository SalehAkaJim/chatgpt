    {
      "kind": "dialogue",
      "external_id": "d_b1_study_strategies_revision",
      "data": {
        "lesson_key": "b1-study-strategies-01",
        "title": "Changing a revision strategy",
        "setting": "library",
        "cefr": "B1",
        "topic": "school-study",
        "characters": [
          "Maya",
          "Leo"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Maya",
            "text": "I keep rereading my notes, but I don't remember much later.",
            "translation_fa": "مدام یادداشت‌هام رو دوباره می‌خونم، ولی بعداً زیاد یادم نمی‌مونه."
          },
          {
            "order": 2,
            "speaker": "Leo",
            "text": "Have you tried testing yourself without looking at them?",
            "translation_fa": "سعی کردی بدون نگاه کردن خودت رو امتحان کنی؟"
          },
          {
            "order": 3,
            "speaker": "Maya",
            "text": "Not really.",
            "translation_fa": "نه واقعاً."
          },
          {
            "order": 4,
            "speaker": "Leo",
            "text": "It might feel harder, but it usually shows what you actually know.",
            "translation_fa": "ممکنه سخت‌تر حس بشه، ولی معمولاً نشون می‌ده واقعاً چی بلدی."
          }
        ],
        "status": "approved"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_b1_study_strategies_deadline",
      "data": {
        "lesson_key": "b1-study-strategies-02",
        "title": "Avoiding procrastination",
        "setting": "study room",
        "cefr": "B1",
        "topic": "school-study",
        "characters": [
          "Hana",
          "Noah"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Hana",
            "text": "I have a paper due Friday and I haven't started.",
            "translation_fa": "جمعه مقاله تحویل دارم و هنوز شروع نکردم."
          },
          {
            "order": 2,
            "speaker": "Noah",
            "text": "Break it into three smaller tasks and do the first one tonight.",
            "translation_fa": "به سه کار کوچک تقسیمش کن و اولی رو امشب انجام بده."
          },
          {
            "order": 3,
            "speaker": "Hana",
            "text": "That sounds less overwhelming.",
            "translation_fa": "این کمتر ترسناک به نظر میاد."
          },
          {
            "order": 4,
            "speaker": "Noah",
            "text": "Exactly. Starting is usually the hardest part.",
            "translation_fa": "دقیقاً. شروع کردن معمولاً سخت‌ترین قسمته."
          }
        ],
        "status": "approved"
      }
    },
    {
