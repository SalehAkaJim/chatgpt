    {
      "kind": "grammar_point",
      "external_id": "g_b1_study_strategies_gerund_inf_study",
      "data": {
        "lesson_key": "b1-study-strategies-01",
        "slug": "b1-study-strategies-gerund-inf-study",
        "title": "Gerunds and infinitives in study talk",
        "rule_summary": "Learn common patterns such as avoid doing, keep doing, decide to do, and plan to do.",
        "explanation": {
          "fa": "الگوهای رایج مثل avoid doing، keep doing، decide to do و plan to do را به شکل ترکیب یاد می‌گیریم."
        },
        "examples": [
          {
            "en": "I avoid studying late at night.",
            "fa": "از شب‌دیر درس خوندن پرهیز می‌کنم."
          },
          {
            "en": "I plan to review tomorrow.",
            "fa": "قصد دارم فردا مرور کنم."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_study_strategies_advice_study",
      "data": {
        "lesson_key": "b1-study-strategies-02",
        "slug": "b1-study-strategies-advice-study",
        "title": "Advice language",
        "rule_summary": "Use should, ought to, try + -ing, and it might help to for practical study advice.",
        "explanation": {
          "fa": "برای توصیه مطالعه از should، ought to، try + ing و it might help to استفاده می‌کنیم."
        },
        "examples": [
          {
            "en": "Try testing yourself.",
            "fa": "خودت رو امتحان کن."
          },
          {
            "en": "It might help to study in shorter sessions.",
            "fa": "شاید کمک کنه در جلسه‌های کوتاه‌تر درس بخونی."
          }
        ],
        "cefr": "B1",
        "status": "approved"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_b1_study_strategies_conditional_study",
      "data": {
        "lesson_key": "b1-study-strategies-03",
        "slug": "b1-study-strategies-conditional-study",
        "title": "First conditional for study results",
        "rule_summary": "Use if + present and will/can to connect a realistic study action to a future result.",
        "explanation": {
          "fa": "برای وصل کردن اقدام مطالعه واقعی به نتیجه آینده از شرط نوع اول استفاده می‌کنیم."
