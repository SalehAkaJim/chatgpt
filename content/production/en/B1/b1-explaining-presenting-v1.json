    {
      "kind": "grammar_point",
      "external_id": "g_b1_explaining_presenting_question_handling",
      "data": {
        "lesson_key": "b1-explaining-presenting-03",
        "slug": "b1-explaining-presenting-question-handling",
        "title": "Handling follow-up questions",
