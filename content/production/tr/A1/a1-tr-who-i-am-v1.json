    {
      "kind": "grammar_point",
      "external_id": "g_who_i_am_core",
      "data": {
        "lesson_key": "a1-tr-who-i-am-01",
        "slug": "a1-tr-who-i-am-grammar",
        "title": "Kişi eki: -im / -sin",
        "rule_summary": "In present nominal sentences Turkish usually attaches the person meaning to the predicate: öğrenciyim, öğretmensin.",
        "explanation": {
          "fa": "در جمله‌های اسمیِ زمان حال، معنی «هستم/هستی» معمولاً با پسوند روی خودِ کلمه می‌آید: öğrenciyim یعنی «دانشجو هستم». شکل پسوند با واکهٔ کلمه هماهنگ می‌شود."
        },
        "examples": [
          {
            "tr": "Ben öğrenciyim.",
            "fa": "من دانشجو هستم."
          },
          {
            "tr": "Sen öğretmensin.",
            "fa": "تو معلم هستی."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
