    {
      "kind": "grammar_point",
      "external_id": "g_tickets_and_transfers_core",
      "data": {
        "lesson_key": "a1-tr-tickets-and-transfers-01",
        "slug": "a1-tr-tickets-and-transfers-grammar",
        "title": "Binmek + -e / inmek + -den",
        "rule_summary": "Turkish commonly uses the dative with the vehicle/line you board and the ablative with what you get off: otobüse binmek, otobüsten inmek.",
        "explanation": {
          "fa": "برای «سوار شدن به» معمولاً حالت -e/-a و برای «پیاده شدن از» حالت -den/-dan می‌آید: otobüse binmek، otobüsten inmek. اینجا دو حالت قبلی را کنار هم بازیابی می‌کنی."
        },
        "examples": [
          {
            "tr": "Metroya biniyorum.",
            "fa": "سوار مترو می‌شوم."
          },
          {
            "tr": "Otobüsten iniyorum.",
            "fa": "از اتوبوس پیاده می‌شوم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
