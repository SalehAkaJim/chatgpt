    {
      "kind": "dialogue",
      "external_id": "d_a1_community_capstone_02",
      "data": {
        "lesson_key": "a1-tr-a1-community-capstone-02",
        "title": "Doğru hatta binmek",
        "setting": "",
        "cefr": "A1",
        "topic": "simple-messages",
        "characters": [
          "Burak",
          "Selin"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Burak",
            "text": "Biletini aldın mı?",
            "translation_fa": "بلیطت را گرفتی؟"
          },
          {
            "order": 2,
            "speaker": "Selin",
            "text": "Evet ama hangi hatta bineceğim?",
            "translation_fa": "بله، ولی سوار کدام خط شوم؟"
          },
          {
            "order": 3,
            "speaker": "Burak",
            "text": "İkinci hat. İki durak sonra ineceksin.",
            "translation_fa": "خط دوم. دو ایستگاه بعد پیاده می‌شوی."
          },
          {
            "order": 4,
            "speaker": "Selin",
            "text": "Tamam, şimdi anladım. Teşekkürler.",
            "translation_fa": "باشه، حالا فهمیدم. ممنون."
          }
        ],
        "qa": {
