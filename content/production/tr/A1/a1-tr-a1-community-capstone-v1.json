    {
      "kind": "dialogue",
      "external_id": "d_a1_community_capstone_01",
      "data": {
        "lesson_key": "a1-tr-a1-community-capstone-01",
        "title": "Plan değişti",
        "setting": "",
        "cefr": "A1",
        "topic": "simple-messages",
        "characters": [
          "Mert",
          "Zeynep"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Program değişti. Saat dörtte buluşalım.",
            "translation_fa": "برنامه عوض شد. ساعت چهار همدیگر را ببینیم."
          },
          {
            "order": 2,
            "speaker": "Zeynep",
            "text": "Tamam. Nerede?",
            "translation_fa": "باشه. کجا؟"
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Marketten sonra istasyonda.",
            "translation_fa": "بعد از فروشگاه در ایستگاه."
          },
          {
            "order": 4,
            "speaker": "Zeynep",
            "text": "Adresi mesajla gönderir misin?",
            "translation_fa": "آدرس را با پیام می‌فرستی؟"
          }
        ],
        "qa": {
