        "characters": [
          "Selin",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Randevunuz saat üçte.",
            "translation_fa": "وقت شما ساعت سه است."
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Pardon, anlamadım. Tekrar söyler misiniz?",
            "translation_fa": "ببخشید، نفهمیدم. می‌شود دوباره بگویید؟"
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Tabii. Saat üçte.",
            "translation_fa": "حتماً. ساعت سه."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Teşekkür ederim. Biraz burada bekleyeceğim.",
            "translation_fa": "متشکرم. کمی اینجا منتظر می‌مانم."
          }
        ],
        "qa": {
