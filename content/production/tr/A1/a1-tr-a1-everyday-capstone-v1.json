    {
      "kind": "dialogue",
      "external_id": "d_a1_everyday_capstone_01",
      "data": {
        "lesson_key": "a1-tr-a1-everyday-capstone-01",
        "title": "Randevuya yetişmek",
        "setting": "",
        "cefr": "A1",
        "topic": "simple-messages",
        "characters": [
          "Deniz",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Randevuyu unutmadın, değil mi?",
            "translation_fa": "قرار را فراموش نکردی، نه؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Hayır. Şimdi istasyondan çıkıyorum.",
            "translation_fa": "نه. الان از ایستگاه بیرون می‌آیم."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Tamam, sana adresi mesajla göndereceğim.",
            "translation_fa": "باشه، آدرس را با پیام می‌فرستم."
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Teşekkürler. On dakikaya oradayım.",
            "translation_fa": "ممنون. ده دقیقه دیگر آنجا هستم."
          }
        ],
        "qa": {
