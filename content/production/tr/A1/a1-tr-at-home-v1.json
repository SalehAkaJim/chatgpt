      "data": {
        "lesson_key": "a1-tr-at-home-01",
        "slug": "a1-tr-at-home-grammar",
        "title": "Bulunma: -da / -de",
        "rule_summary": "The locative ending -da/-de expresses being in/at a place: evde, okulda.",
        "explanation": {
          "fa": "برای گفتن «در/داخلِ یک جا» از -da/-de استفاده می‌شود: evde یعنی «در خانه». انتخاب شکل پسوند با هماهنگی واکه انجام می‌شود."
        },
        "examples": [
          {
            "tr": "evde",
            "fa": "در خانه"
          },
          {
            "tr": "okulda",
            "fa": "در مدرسه"
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
