      "data": {
        "lesson_key": "a1-tr-compare-and-choose-01",
        "slug": "a1-tr-compare-and-choose-grammar",
        "title": "daha / en",
        "rule_summary": "A simple comparative uses daha + adjective; a simple superlative uses en + adjective.",
        "explanation": {
          "fa": "برای مقایسهٔ ساده، daha قبل از صفت می‌آید: daha ucuz «ارزان‌تر». برای «ـترین»، en می‌آید: en ucuz «ارزان‌ترین»."
        },
        "examples": [
          {
            "tr": "Bu daha ucuz.",
            "fa": "این ارزان‌تر است."
          },
          {
            "tr": "Bu en ucuz.",
            "fa": "این ارزان‌ترین است."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
