        "topic": "objects",
        "characters": [
          "Selin",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Hangisi daha ucuz?",
            "translation_fa": "کدام ارزان‌تر است؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Mavi çanta daha ucuz.",
            "translation_fa": "کیف آبی ارزان‌تر است."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Ama siyah çanta daha büyük.",
            "translation_fa": "ولی کیف مشکی بزرگ‌تر است."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Hangisini tercih ediyorsun?",
            "translation_fa": "کدام را ترجیح می‌دهی؟"
          }
