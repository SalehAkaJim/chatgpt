    {
      "kind": "grammar_point",
      "external_id": "g_my_family_core",
      "data": {
        "lesson_key": "a1-tr-my-family-01",
        "slug": "a1-tr-my-family-grammar",
        "title": "İyelik: annem, babam",
        "rule_summary": "Possession can be marked on the noun: annem = my mother, babam = my father.",
        "explanation": {
          "fa": "در ترکی «مالِ من» می‌تواند داخل خود اسم بیاید: annem یعنی «مادرم»، babam یعنی «پدرم». این همان الگوی adım از Pre-A1 است که حالا گسترشش می‌دهیم."
        },
        "examples": [
          {
            "tr": "annem",
            "fa": "مادرم"
          },
          {
            "tr": "babam",
            "fa": "پدرم"
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
