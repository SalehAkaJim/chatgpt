    {
      "kind": "grammar_point",
      "external_id": "g_getting_around_core",
      "data": {
        "lesson_key": "a1-tr-getting-around-01",
        "slug": "a1-tr-getting-around-grammar",
        "title": "Yön: -a / -e",
        "rule_summary": "The dative -a/-e often marks movement toward a destination or direction: eve, sağa.",
        "explanation": {
          "fa": "برای حرکت «به سمتِ» یک مقصد یا جهت، -a/-e می‌آید: eve یعنی «به خانه»، sağa یعنی «به راست». شکل پسوند با واکه هماهنگ می‌شود."
        },
        "examples": [
          {
            "tr": "eve gidiyorum",
            "fa": "به خانه می‌روم"
          },
          {
            "tr": "sağa dönün",
            "fa": "به راست بپیچید"
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
