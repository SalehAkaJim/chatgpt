    {
      "kind": "grammar_point",
      "external_id": "g_time_and_plans_core",
      "data": {
        "lesson_key": "a1-tr-time-and-plans-01",
        "slug": "a1-tr-time-and-plans-grammar",
        "title": "Saat üç / saat üçte",
        "rule_summary": "For clock time, saat üç states the time; saat üçte means at three o'clock.",
        "explanation": {
          "fa": "برای گفتن خودِ ساعت می‌گویی saat üç؛ برای «ساعت سه / در ساعت سه» پسوند مکانی/زمانی می‌آید: saat üçte."
        },
        "examples": [
          {
            "tr": "Saat üç.",
            "fa": "ساعت سه است."
          },
          {
            "tr": "Saat üçte.",
            "fa": "ساعت سه / در ساعت سه."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
