      "data": {
        "lesson_key": "a1-tr-short-messages-and-reasons-01",
        "slug": "a1-tr-short-messages-and-reasons-grammar",
        "title": "ve, ama, çünkü",
        "rule_summary": "These high-frequency connectors join short A1 clauses: ve adds information, ama contrasts, çünkü gives a simple reason.",
        "explanation": {
          "fa": "برای وصل کردن جمله‌های کوتاه A1: ve یعنی «و»، ama یعنی «اما»، çünkü دلیل ساده می‌دهد. هدف این است که از جمله‌های جدا به پیام کوتاه و پیوسته برسی."
        },
        "examples": [
          {
            "tr": "Geliyorum ama geç kalacağım.",
            "fa": "می‌آیم اما دیر می‌رسم."
          },
          {
            "tr": "Evdeyim çünkü hastayım.",
            "fa": "خانه‌ام چون مریضم."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
