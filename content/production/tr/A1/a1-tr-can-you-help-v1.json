    {
      "kind": "grammar_point",
      "external_id": "g_can_you_help_core",
      "data": {
        "lesson_key": "a1-tr-can-you-help-01",
        "slug": "a1-tr-can-you-help-grammar",
        "title": "Yeterlik: -(y)Abil",
        "rule_summary": "The -ebil/-abil pattern expresses ability and is very common in polite requests and permission questions.",
        "explanation": {
          "fa": "الگوی -ebil/-abil هم برای «توانستن» و هم در درخواست مؤدبانه به کار می‌رود. edebilir misiniz? از شکل‌های بسیار پرکاربرد و محترمانه است."
        },
        "examples": [
          {
            "tr": "Yardım edebilir misiniz?",
            "fa": "می‌توانید کمک کنید؟"
          },
          {
            "tr": "Burada bekleyebilir miyim?",
            "fa": "می‌توانم اینجا منتظر بمانم؟"
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
