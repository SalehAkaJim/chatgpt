    {
      "kind": "grammar_point",
      "external_id": "g_before_and_after_core",
      "data": {
        "lesson_key": "a1-tr-before-and-after-01",
        "slug": "a1-tr-before-and-after-grammar",
        "title": "Önce / sonra ile zaman sırası",
        "rule_summary": "Before a noun, önce commonly follows -den/-dan; sonra also commonly follows an ablative-marked noun: dersten önce, toplantıdan sonra.",
        "explanation": {
          "fa": "برای گفتن «قبل از/بعد از» معمولاً اسم با حالت -den/-dan می‌آید: dersten önce «قبل از کلاس»، toplantıdan sonra «بعد از جلسه»."
        },
        "examples": [
          {
            "tr": "Dersten önce.",
            "fa": "قبل از کلاس."
          },
          {
            "tr": "Toplantıdan sonra.",
            "fa": "بعد از جلسه."
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
