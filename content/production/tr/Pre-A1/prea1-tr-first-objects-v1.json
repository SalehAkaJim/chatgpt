      "data": {
        "lesson_key": "prea1-tr-first-objects-01",
        "slug": "prea1-tr-first-objects-grammar",
        "title": "Bu ne? / Bu bir…",
        "rule_summary": "Turkish has no grammatical gender and no article system like German der/die/das; bir can mean ‘one/a’ in beginner noun phrases.",
        "explanation": {
          "fa": "در ترکی اسم‌ها جنس دستوری ندارند. برای معرفی سادهٔ یک چیز می‌توانی بگویی «Bu bir kitap» یعنی «این یک کتاب است»."
        },
        "examples": [
          {
            "tr": "Bu ne?",
            "fa": "این چیه؟"
          },
          {
            "tr": "Bu bir kitap.",
            "fa": "این یک کتاب است."
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
