    {
      "kind": "grammar_point",
      "external_id": "g_how_are_you_core",
      "data": {
        "lesson_key": "prea1-tr-how-are-you-01",
        "slug": "prea1-tr-how-are-you-grammar",
        "title": "İyiyim = خوبم",
        "rule_summary": "Turkish often carries the person inside an ending, so a separate pronoun is not always necessary.",
        "explanation": {
          "fa": "در «İyiyim» خودِ پایان واژه معنی «من» را هم می‌رساند؛ به همین دلیل لازم نیست همیشه «Ben» را جدا بگویی. فعلاً این شکل را به‌صورت یک عبارت پرکاربرد یاد بگیر."
        },
        "examples": [
          {
            "tr": "İyiyim.",
            "fa": "خوبم."
          },
          {
            "tr": "Ben iyiyim.",
            "fa": "من خوبم."
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
