    {
      "kind": "grammar_point",
      "external_id": "g_alphabet_core",
      "data": {
        "lesson_key": "prea1-tr-alphabet-01",
        "slug": "prea1-tr-alphabet-grammar",
        "title": "i ≠ ı",
        "rule_summary": "Dotted i/İ and dotless ı/I are separate Turkish letters and must not be normalized into one another.",
        "explanation": {
          "fa": "در ترکی «i» و «ı» دو حرف جدا هستند. حتی در تبدیل حروف بزرگ و کوچک هم جفت‌هایشان فرق دارد: i ↔ İ و ı ↔ I."
        },
        "examples": [
          {
            "tr": "i — İ",
            "fa": "i نقطه‌دار و شکل بزرگ آن İ"
          },
          {
            "tr": "ı — I",
            "fa": "ı بدون نقطه و شکل بزرگ آن I"
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
