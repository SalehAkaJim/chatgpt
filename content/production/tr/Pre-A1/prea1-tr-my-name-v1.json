          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Senin adın Emre, değil mi?",
            "translation_fa": "اسمت امره است، درسته؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Evet.",
            "translation_fa": "بله."
          }
        ],
