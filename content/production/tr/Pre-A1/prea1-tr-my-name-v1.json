    {
      "kind": "grammar_point",
      "external_id": "g_my_name_core",
      "data": {
        "lesson_key": "prea1-tr-my-name-01",
        "slug": "prea1-tr-my-name-grammar",
        "title": "Benim adım…",
        "rule_summary": "Turkish can express possession inside the noun phrase: adım literally carries the meaning ‘my name’.",
        "explanation": {
          "fa": "در «Benim adım» بخش «-ım» داخل خودِ «adım» معنی «اسمِ من» را می‌سازد. در این مرحله فقط الگو را بشناس و استفاده کن؛ تجزیهٔ کامل پسوندها برای A1 می‌ماند."
        },
        "examples": [
          {
            "tr": "Benim adım Elif.",
            "fa": "اسم من الیف است."
          },
          {
            "tr": "Senin adın ne?",
            "fa": "اسم تو چیه؟"
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
