        "characters": [
          "Deniz",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Merhaba. Benim adım Deniz.",
            "translation_fa": "سلام. اسم من دنیز است."
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Merhaba. Ben Emre.",
