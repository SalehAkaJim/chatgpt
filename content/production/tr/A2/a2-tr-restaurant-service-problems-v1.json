    {
      "kind": "dialogue",
      "external_id": "d_restaurant_service_problems_02",
      "data": {
        "lesson_key": "a2-tr-restaurant-service-problems-02",
        "title": "Yanlış sipariş",
        "setting": "item",
        "cefr": "A2",
        "topic": "restaurants",
        "characters": [
          "Elif",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Affedersiniz, bu sipariş yanlış geldi.",
            "translation_fa": "ببخشید، این سفارش اشتباه آمده."
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Ne sipariş ettiniz?",
            "translation_fa": "چه سفارش دادید؟"
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Tavuk istedim, bu balık.",
            "translation_fa": "مرغ سفارش دادم، این ماهی است."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Haklısınız, hemen düzeltiyorum.",
            "translation_fa": "حق با شماست، الان اصلاح می‌کنم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
