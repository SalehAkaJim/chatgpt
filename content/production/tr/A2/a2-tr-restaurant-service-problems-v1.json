      "data": {
        "lesson_key": "a2-tr-restaurant-service-problems-01",
        "title": "Geciken sipariş",
        "setting": "item",
        "cefr": "A2",
        "topic": "restaurants",
        "characters": [
          "Deniz",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Affedersiniz, siparişim henüz gelmedi.",
            "translation_fa": "ببخشید، سفارشم هنوز نرسیده."
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Hemen kontrol edeyim.",
            "translation_fa": "الان بررسی می‌کنم."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Teşekkür ederim.",
            "translation_fa": "ممنونم."
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Birkaç dakika içinde gelecek.",
            "translation_fa": "تا چند دقیقه دیگر می‌آید."
          }
        ],
        "qa": {
