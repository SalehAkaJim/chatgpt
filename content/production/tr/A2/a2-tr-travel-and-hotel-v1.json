    {
      "kind": "dialogue",
      "external_id": "d_travel_and_hotel_02",
      "data": {
        "lesson_key": "a2-tr-travel-and-hotel-02",
        "title": "Oda sorunu",
        "setting": "item",
        "cefr": "A2",
        "topic": "travel",
        "characters": [
          "Burak",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Burak",
            "text": "Affedersiniz, oda anahtarım çalışmıyor.",
            "translation_fa": "ببخشید، کلید اتاقم کار نمی‌کند."
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Kontrol edeyim.",
            "translation_fa": "بگذارید بررسی کنم."
          },
          {
            "order": 3,
            "speaker": "Burak",
            "text": "Teşekkür ederim.",
            "translation_fa": "ممنونم."
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Yeni anahtarınız burada.",
            "translation_fa": "کلید جدیدتان اینجاست."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_travel_and_hotel_03",
      "data": {
        "lesson_key": "a2-tr-travel-and-hotel-03",
        "title": "Otelde sorun çöz",
        "setting": "item",
        "cefr": "A2",
        "topic": "travel",
        "characters": [
          "Selin",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Affedersiniz, odam çok gürültülü.",
            "translation_fa": "ببخشید، اتاقم خیلی پر سر و صداست."
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Üzgünüm. Başka bir oda ister misiniz?",
            "translation_fa": "متأسفم. اتاق دیگری می‌خواهید؟"
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Evet, mümkünse daha sessiz bir oda istiyorum.",
            "translation_fa": "بله، اگر ممکن است اتاق ساکت‌تری می‌خواهم."
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Tabii, on dakika içinde hazırlayabiliriz.",
            "translation_fa": "حتماً، می‌توانیم تا ده دقیقه دیگر آماده‌اش کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
