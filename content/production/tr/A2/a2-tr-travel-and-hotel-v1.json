    {
      "kind": "grammar_point",
      "external_id": "g_travel_and_hotel_core",
      "data": {
        "lesson_key": "a2-tr-travel-and-hotel-01",
        "slug": "a2-tr-travel-and-hotel-grammar",
        "title": "İyelik + durum ekleri",
        "rule_summary": "Turkish can stack possessive and case endings; travel phrases often combine them.",
        "explanation": {
          "fa": "در ترکی پسوندها می‌توانند پشت سر هم بیایند. در موقعیت‌های سفر، مالکیت و حالت دستوری زیاد با هم می‌آیند؛ مثلاً rezervasyonum «رزروِ من»."
        },
        "examples": [
          {
            "tr": "Rezervasyonum var.",
            "fa": "رزرو دارم."
          },
          {
            "tr": "Odanız hazır.",
            "fa": "اتاقتان آماده است."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_travel_and_hotel_01",
      "data": {
        "lesson_key": "a2-tr-travel-and-hotel-01",
        "title": "Otele giriş",
        "setting": "item",
        "cefr": "A2",
        "topic": "travel",
        "characters": [
          "Deniz",
          "Zeynep"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Merhaba, rezervasyonum var.",
            "translation_fa": "سلام، رزرو دارم."
          },
          {
            "order": 2,
            "speaker": "Zeynep",
            "text": "Adınız nedir?",
            "translation_fa": "نامتان چیست؟"
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Deniz Kaya.",
            "translation_fa": "دنیز کایا."
          },
          {
            "order": 4,
            "speaker": "Zeynep",
            "text": "Evet, odanız hazır.",
            "translation_fa": "بله، اتاقتان آماده است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
