    {
      "kind": "grammar_point",
      "external_id": "g_invitations_arrangements_core",
      "data": {
        "lesson_key": "a2-tr-invitations-arrangements-01",
        "slug": "a2-tr-invitations-arrangements-grammar",
        "title": "Öneri: -elim / -alım",
        "rule_summary": "Use the first-person plural suggestion form to propose a shared plan, and combine it with a time expression.",
        "explanation": {
          "fa": "برای پیشنهاد یک کار مشترک از -elim/-alım استفاده می‌کنیم: buluşalım «بیایید همدیگر را ببینیم». اگر نمی‌توانیم، بهتر است یک زمان جایگزین پیشنهاد کنیم."
        },
        "examples": [
          {
            "tr": "Akşam konuşalım.",
            "fa": "عصر صحبت کنیم."
          },
          {
            "tr": "Başka bir gün görüşelim.",
            "fa": "یک روز دیگر همدیگر را ببینیم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
