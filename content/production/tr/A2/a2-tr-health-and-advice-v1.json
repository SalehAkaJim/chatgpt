    {
      "kind": "grammar_point",
      "external_id": "g_health_and_advice_core",
      "data": {
        "lesson_key": "a2-tr-health-and-advice-01",
        "slug": "a2-tr-health-and-advice-grammar",
        "title": "Gereklilik: -meli / -malı",
        "rule_summary": "Use -meli/-malı for necessity and common advice.",
        "explanation": {
          "fa": "برای «باید» و توصیهٔ نسبتاً مستقیم از -meli/-malı استفاده می‌شود: dinlenmelisin یعنی «باید استراحت کنی»."
        },
        "examples": [
          {
            "tr": "Su içmelisin.",
            "fa": "باید آب بنوشی."
          },
          {
            "tr": "Doktora gitmelisin.",
            "fa": "باید پیش پزشک بروی."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_health_and_advice_01",
      "data": {
        "lesson_key": "a2-tr-health-and-advice-01",
        "title": "Kendini iyi hissetmiyorum",
        "setting": "item",
        "cefr": "A2",
        "topic": "health",
        "characters": [
          "Mert",
          "Elif"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "İyi misin?",
            "translation_fa": "خوبی؟"
          },
          {
            "order": 2,
            "speaker": "Elif",
            "text": "Pek değil. Başım ağrıyor.",
            "translation_fa": "نه خیلی. سرم درد می‌کند."
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Biraz dinlenmelisin.",
            "translation_fa": "باید کمی استراحت کنی."
          },
          {
            "order": 4,
            "speaker": "Elif",
            "text": "Haklısın.",
            "translation_fa": "حق با توست."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_health_and_advice_02",
      "data": {
        "lesson_key": "a2-tr-health-and-advice-02",
        "title": "Eczanede",
        "setting": "item",
        "cefr": "A2",
        "topic": "health",
        "characters": [
          "Selin",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Bu ilacı ne zaman almalıyım?",
            "translation_fa": "این دارو را چه زمانی باید بخورم؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Yemekten sonra almalısınız.",
            "translation_fa": "باید بعد از غذا بخورید."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Günde kaç kez?",
            "translation_fa": "روزی چند بار؟"
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "İki kez.",
            "translation_fa": "دو بار."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_health_and_advice_03",
      "data": {
        "lesson_key": "a2-tr-health-and-advice-03",
        "title": "Belirtiyi anlat, öneri al",
        "setting": "item",
        "cefr": "A2",
        "topic": "health",
        "characters": [
          "Elif",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "İyi görünmüyorsun, ne oldu?",
            "translation_fa": "خوب به نظر نمی‌رسی، چه شده؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "İki gündür boğazım ağrıyor.",
            "translation_fa": "دو روز است گلویم درد می‌کند."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Bugün dinlenmelisin ve bol su içmelisin.",
            "translation_fa": "امروز باید استراحت کنی و آب زیاد بنوشی."
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Haklısın. Bugün dinleneceğim. Sonra doktora gidebilirim.",
            "translation_fa": "درست می‌گویی. امروز استراحت می‌کنم. بعد می‌توانم پیش پزشک بروم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
