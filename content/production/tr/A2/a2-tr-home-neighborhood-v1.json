    {
      "kind": "dialogue",
      "external_id": "d_home_neighborhood_02",
      "data": {
        "lesson_key": "a2-tr-home-neighborhood-02",
        "title": "Yakında ne var?",
        "setting": "item",
        "cefr": "A2",
        "topic": "home",
        "characters": [
          "Kaan",
          "Selin"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Kaan",
            "text": "Metro yakın mı?",
            "translation_fa": "مترو نزدیک است؟"
          },
          {
            "order": 2,
            "speaker": "Selin",
            "text": "Evet, beş dakika.",
            "translation_fa": "بله، پنج دقیقه."
          },
          {
            "order": 3,
            "speaker": "Kaan",
            "text": "Market de yakın mı?",
            "translation_fa": "فروشگاه هم نزدیک است؟"
          },
          {
            "order": 4,
            "speaker": "Selin",
            "text": "Küçük market yakın, büyük olan uzak.",
            "translation_fa": "فروشگاه کوچک نزدیک است، بزرگه دور است."
          }
        ],
        "qa": {
