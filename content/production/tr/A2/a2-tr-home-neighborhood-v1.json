    {
      "kind": "grammar_point",
      "external_id": "g_home_neighborhood_core",
      "data": {
        "lesson_key": "a2-tr-home-neighborhood-01",
        "slug": "a2-tr-home-neighborhood-grammar",
        "title": "Yakınlık ve uzaklık",
        "rule_summary": "Use -e yakın for proximity and -den uzak for distance; connect contrasting features with ama.",
        "explanation": {
          "fa": "برای «نزدیک به» از -e yakın و برای «دور از» از -den uzak استفاده می‌کنیم. برای دو ویژگی متضاد ama طبیعی است."
        },
        "examples": [
          {
            "tr": "İşe yakın oturuyorum.",
            "fa": "نزدیک محل کار زندگی می‌کنم."
          },
          {
            "tr": "Ev merkezden uzak ama sessiz.",
            "fa": "خانه از مرکز دور است ولی آرام است."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_home_neighborhood_01",
      "data": {
        "lesson_key": "a2-tr-home-neighborhood-01",
        "title": "Yeni ev",
        "setting": "item",
        "cefr": "A2",
        "topic": "home",
        "characters": [
          "Mert",
          "Elif"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Yeni mahallen nasıl?",
            "translation_fa": "محله جدیدت چطوره؟"
          },
          {
            "order": 2,
            "speaker": "Elif",
            "text": "Sessiz ve oldukça güzel.",
            "translation_fa": "آرام و نسبتاً زیباست."
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Evin büyük mü?",
            "translation_fa": "خانه‌ات بزرگ است؟"
          },
          {
            "order": 4,
            "speaker": "Elif",
            "text": "Hayır, küçük ama rahat.",
            "translation_fa": "نه، کوچک ولی راحت است."
          }
        ],
        "qa": {
