    {
      "kind": "dialogue",
      "external_id": "d_object_description_02",
      "data": {
        "lesson_key": "a2-tr-object-description-02",
        "title": "Renk ve boyut",
        "setting": "item",
        "cefr": "A2",
        "topic": "objects",
        "characters": [
          "Emre",
          "Selin"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Emre",
            "text": "Renkleri farklı mı?",
            "translation_fa": "رنگ‌هایشان فرق دارد؟"
          },
          {
            "order": 2,
            "speaker": "Selin",
            "text": "Evet, biri mavi biri siyah.",
            "translation_fa": "بله، یکی آبی و یکی مشکی است."
          },
          {
            "order": 3,
            "speaker": "Emre",
            "text": "Boyutları?",
            "translation_fa": "اندازه‌ها؟"
          },
          {
            "order": 4,
            "speaker": "Selin",
            "text": "Aynı.",
            "translation_fa": "یکسان است."
          }
        ],
        "qa": {
