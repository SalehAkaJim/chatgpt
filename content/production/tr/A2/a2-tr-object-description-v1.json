      "data": {
        "lesson_key": "a2-tr-object-description-01",
        "slug": "a2-tr-object-description-grammar",
        "title": "Nesneleri karşılaştırmak",
        "rule_summary": "Compare familiar objects with one or two concrete features and state a simple practical preference.",
        "explanation": {
          "fa": "برای مقایسهٔ وسیله‌ها یک یا دو ویژگی ملموس مثل وزن، رنگ یا اندازه را می‌گوییم و ترجیح کوتاه می‌دهیم."
        },
        "examples": [
          {
            "tr": "Mavi çanta daha hafif. Siyah çanta biraz ağır.",
            "fa": "کیف آبی سبک‌تر است. کیف مشکی کمی سنگین است."
          },
          {
            "tr": "Boyutları aynı. Ben maviyi tercih ederim.",
            "fa": "اندازه‌هایشان یکسان است. من آبی را ترجیح می‌دهم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_object_description_01",
      "data": {
        "lesson_key": "a2-tr-object-description-01",
        "title": "Hangisi hafif?",
        "setting": "item",
        "cefr": "A2",
        "topic": "objects",
        "characters": [
          "Elif",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Hangi çanta daha hafif?",
            "translation_fa": "کدام کیف سبک‌تر است؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Mavi olan daha hafif.",
            "translation_fa": "آبی سبک‌تر است."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Siyah nasıl?",
            "translation_fa": "مشکی چطور؟"
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Biraz ağır.",
            "translation_fa": "کمی سنگین است."
          }
        ],
        "qa": {
