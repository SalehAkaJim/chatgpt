        "title": "Başka renk",
        "setting": "item",
        "cefr": "A2",
        "topic": "shopping",
        "characters": [
          "Selin",
          "Deniz"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Bu üründe küçük bir sorun var.",
            "translation_fa": "این کالا یک مشکل کوچک دارد."
          },
          {
            "order": 2,
            "speaker": "Deniz",
            "text": "İsterseniz başka bir tane göstereyim.",
            "translation_fa": "اگر بخواهید یکی دیگر نشان بدهم."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Evet, mavi renk daha uygun.",
            "translation_fa": "بله، رنگ آبی مناسب‌تر است."
          },
          {
            "order": 4,
            "speaker": "Deniz",
