    {
      "kind": "dialogue",
      "external_id": "d_returns_exchanges_02",
      "data": {
        "lesson_key": "a2-tr-returns-exchanges-02",
        "title": "Fişiniz var mı?",
        "setting": "item",
        "cefr": "A2",
        "topic": "shopping",
        "characters": [
          "Elif",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Bu ürünü iade edebilir miyim?",
            "translation_fa": "می‌توانم این کالا را پس بدهم؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Fişiniz var mı?",
            "translation_fa": "رسید دارید؟"
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Evet, yanımda.",
            "translation_fa": "بله، همراهم است."
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Tamam, yardımcı olayım.",
            "translation_fa": "باشه، کمکتان می‌کنم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
