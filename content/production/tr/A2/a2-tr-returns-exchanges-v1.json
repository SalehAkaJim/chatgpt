    {
      "kind": "grammar_point",
      "external_id": "g_returns_exchanges_core",
      "data": {
        "lesson_key": "a2-tr-returns-exchanges-01",
        "slug": "a2-tr-returns-exchanges-grammar",
        "title": "Kibar değişim ve iade isteği",
        "rule_summary": "Use istemek or -ebilir miyim to make a short, polite return or exchange request.",
        "explanation": {
          "fa": "برای درخواست مؤدبانهٔ تعویض یا مرجوعی می‌توانیم از istiyorum یا -ebilir miyim استفاده کنیم و دلیل را در یک جمله ساده بگوییم."
        },
        "examples": [
          {
            "tr": "Bunu değiştirmek istiyorum.",
            "fa": "می‌خواهم این را تعویض کنم."
          },
          {
            "tr": "Başka bir beden alabilir miyim?",
            "fa": "می‌توانم یک سایز دیگر بگیرم؟"
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_returns_exchanges_01",
      "data": {
        "lesson_key": "a2-tr-returns-exchanges-01",
        "title": "Değişim",
        "setting": "item",
        "cefr": "A2",
        "topic": "shopping",
        "characters": [
          "Burak",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Burak",
            "text": "Merhaba, bunu değiştirmek istiyorum.",
            "translation_fa": "سلام، می‌خواهم این را تعویض کنم."
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Tabii. Sorun nedir?",
            "translation_fa": "حتماً. مشکل چیست؟"
          },
          {
            "order": 3,
            "speaker": "Burak",
            "text": "Beden bana küçük geldi.",
            "translation_fa": "سایزش برایم کوچک بود."
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Bir beden büyüğü var.",
            "translation_fa": "یک سایز بزرگ‌تر داریم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
