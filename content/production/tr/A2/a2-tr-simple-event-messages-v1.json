    {
      "kind": "grammar_point",
      "external_id": "g_simple_event_messages_core",
      "data": {
        "lesson_key": "a2-tr-simple-event-messages-01",
        "slug": "a2-tr-simple-event-messages-grammar",
        "title": "Kısa pratik mesajlar",
        "rule_summary": "Keep practical messages short: say the change, the concrete time/place and one simple next action.",
        "explanation": {
          "fa": "برای پیام‌های روزمره، تغییر را کوتاه می‌گوییم، زمان یا مکان را مشخص می‌کنیم و یک کار بعدی ساده اضافه می‌کنیم."
        },
        "examples": [
          {
            "tr": "Biraz geç geleceğim. Saat altıda oradayım.",
            "fa": "کمی دیر می‌آیم. ساعت شش آنجا هستم."
          },
          {
            "tr": "Buluşma yeri aynı. Çıkınca haber vereceğim.",
            "fa": "محل قرار همان است. وقتی راه افتادم خبر می‌دهم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
