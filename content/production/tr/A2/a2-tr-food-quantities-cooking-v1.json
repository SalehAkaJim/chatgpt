    {
      "kind": "grammar_point",
      "external_id": "g_food_quantities_cooking_core",
      "data": {
        "lesson_key": "a2-tr-food-quantities-cooking-01",
        "slug": "a2-tr-food-quantities-cooking-grammar",
        "title": "Miktar + isim ve sıralama",
        "rule_summary": "Put the quantity before the noun and use önce/sonra to make the order of steps clear.",
        "explanation": {
          "fa": "مقدار قبل از اسم می‌آید: iki kaşık yağ. برای مرتب کردن مراحل از önce «اول» و sonra «بعد» استفاده می‌کنیم."
        },
        "examples": [
          {
            "tr": "Bir kilo domates al.",
            "fa": "یک کیلو گوجه بخر."
          },
          {
            "tr": "Önce kes, sonra karıştır.",
            "fa": "اول خرد کن، بعد مخلوط کن."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
