      "data": {
        "lesson_key": "a2-tr-fitness-routines-01",
        "title": "Rutin",
        "setting": "item",
        "cefr": "A2",
        "topic": "health",
        "characters": [
          "Selin",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Ne kadar sık yürüyüş yaparsın?",
            "translation_fa": "هر چند وقت یک بار پیاده‌روی می‌کنی؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Haftada üç gün.",
            "translation_fa": "هفته‌ای سه روز."
