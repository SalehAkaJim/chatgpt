      "data": {
        "lesson_key": "a2-tr-fitness-routines-01",
        "slug": "a2-tr-fitness-routines-grammar",
        "title": "Alışkanlık ve basit tavsiye",
        "rule_summary": "Recycle habitual geniş zaman and -meli to describe a routine and one simple practical health choice.",
        "explanation": {
          "fa": "برای گفتن عادت از geniş zaman و برای یک توصیهٔ ساده از -meli/-malı استفاده می‌کنیم. در A2 توصیه را کوتاه و عملی نگه می‌داریم."
        },
        "examples": [
          {
            "tr": "Her akşam kısa bir yürüyüş yaparım.",
            "fa": "هر شب یک پیاده‌روی کوتاه می‌کنم."
          },
          {
            "tr": "Bugün biraz dinlenmelisin.",
            "fa": "امروز باید کمی استراحت کنی."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
