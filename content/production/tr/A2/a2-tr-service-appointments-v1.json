      "data": {
        "lesson_key": "a2-tr-service-appointments-01",
        "slug": "a2-tr-service-appointments-grammar",
        "title": "Randevu düzenleme",
        "rule_summary": "Use familiar time expressions and polite -ebilir forms to arrange or change a routine appointment.",
        "explanation": {
          "fa": "برای گرفتن یا تغییر نوبت، زمان را روشن می‌گوییم و با -ebilir miyiz / müsait misiniz درخواست مؤدبانه می‌سازیم."
        },
        "examples": [
          {
            "tr": "Yarın saat üçte müsait misiniz?",
            "fa": "فردا ساعت سه وقت دارید؟"
          },
          {
            "tr": "Randevuyu bir saat erteleyebilir miyiz?",
            "fa": "می‌توانیم نوبت را یک ساعت عقب بیندازیم؟"
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
