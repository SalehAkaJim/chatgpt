    {
      "kind": "dialogue",
      "external_id": "d_service_appointments_02",
      "data": {
        "lesson_key": "a2-tr-service-appointments-02",
        "title": "Saati değiştirmek",
        "setting": "item",
        "cefr": "A2",
        "topic": "appointments",
        "characters": [
          "Mert",
          "Selin"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Randevuyu değiştirebilir miyiz?",
            "translation_fa": "می‌توانیم وقت را تغییر بدهیم؟"
          },
          {
            "order": 2,
            "speaker": "Selin",
            "text": "Tabii. Hangi saat uygun?",
            "translation_fa": "حتماً. چه ساعتی مناسب است؟"
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Saat dört daha iyi.",
            "translation_fa": "ساعت چهار بهتر است."
          },
          {
            "order": 4,
            "speaker": "Selin",
            "text": "Tamam, dörde aldım.",
            "translation_fa": "باشه، گذاشتم ساعت چهار."
          }
        ],
