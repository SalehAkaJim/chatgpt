          },
          {
            "order": 2,
            "speaker": "Elif",
            "text": "Evet, uygun.",
            "translation_fa": "بله، مناسب است."
          },
          {
            "order": 3,
            "speaker": "Emre",
            "text": "Randevuyu onaylıyorum.",
