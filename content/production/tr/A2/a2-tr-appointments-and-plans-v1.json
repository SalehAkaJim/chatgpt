    {
      "kind": "grammar_point",
      "external_id": "g_appointments_and_plans_core",
      "data": {
        "lesson_key": "a2-tr-appointments-and-plans-01",
        "slug": "a2-tr-appointments-and-plans-grammar",
        "title": "-ebilir / -abilir ile plan",
        "rule_summary": "Ability forms can soften suggestions and make scheduling language flexible.",
        "explanation": {
          "fa": "ساختار -ebilir/-abilir فقط «توانستن» نیست؛ در برنامه‌ریزی برای پیشنهاد نرم و قابل مذاکره هم می‌آید: Yarın buluşabiliriz «می‌توانیم فردا قرار بگذاریم»."
        },
        "examples": [
          {
            "tr": "Akşam konuşabiliriz.",
            "fa": "می‌توانیم عصر صحبت کنیم."
          },
          {
            "tr": "Saati değiştirebilir miyiz?",
            "fa": "می‌توانیم ساعت را عوض کنیم؟"
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
