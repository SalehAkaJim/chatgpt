    {
      "kind": "grammar_point",
      "external_id": "g_reasons_and_results_core",
      "data": {
        "lesson_key": "a2-tr-reasons-and-results-01",
        "slug": "a2-tr-reasons-and-results-grammar",
        "title": "Neden-sonuç: çünkü / ... için",
        "rule_summary": "Use çünkü to introduce a reason; ... olduğu için and similar forms connect a cause before the result.",
        "explanation": {
          "fa": "برای گفتن دلیل می‌توان از çünkü «چون» استفاده کرد. ساختار ... olduğu için دلیل را قبل از نتیجه می‌آورد و در A2 بسیار پرکاربرد است."
        },
        "examples": [
          {
            "tr": "Çünkü hastaydım.",
            "fa": "چون مریض بودم."
          },
          {
            "tr": "Yağmur olduğu için evde kaldık.",
            "fa": "چون باران بود خانه ماندیم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
