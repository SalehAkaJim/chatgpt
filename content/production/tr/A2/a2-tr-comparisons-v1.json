    {
      "kind": "grammar_point",
      "external_id": "g_comparisons_core",
      "data": {
        "lesson_key": "a2-tr-comparisons-01",
        "slug": "a2-tr-comparisons-grammar",
        "title": "Karşılaştırma: daha ... / ... kadar",
        "rule_summary": "Use daha before an adjective for a simple comparative; kadar can compare degree.",
        "explanation": {
          "fa": "برای مقایسهٔ ساده، daha قبل از صفت می‌آید: daha ucuz «ارزان‌تر». با kadar می‌توان گفت چیزی به اندازهٔ چیز دیگری یک ویژگی را دارد یا ندارد."
        },
        "examples": [
          {
            "tr": "Bu daha hızlı.",
            "fa": "این سریع‌تر است."
          },
          {
            "tr": "O kadar pahalı değil.",
            "fa": "آن‌قدر گران نیست."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
