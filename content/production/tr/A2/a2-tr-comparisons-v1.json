    {
      "kind": "dialogue",
      "external_id": "d_comparisons_02",
      "data": {
        "lesson_key": "a2-tr-comparisons-02",
        "title": "Otel seçimi",
        "setting": "item",
        "cefr": "A2",
        "topic": "shopping",
        "characters": [
          "Mert",
          "Elif"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Bu otel daha pahalı.",
            "translation_fa": "این هتل گران‌تر است."
          },
          {
            "order": 2,
            "speaker": "Elif",
            "text": "Ama merkeze daha yakın.",
            "translation_fa": "اما به مرکز نزدیک‌تر است."
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Diğeri de uygun görünüyor.",
            "translation_fa": "آن یکی هم مناسب به نظر می‌رسد."
          },
          {
            "order": 4,
            "speaker": "Elif",
            "text": "Fiyatlara tekrar bakalım.",
            "translation_fa": "دوباره قیمت‌ها را ببینیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
