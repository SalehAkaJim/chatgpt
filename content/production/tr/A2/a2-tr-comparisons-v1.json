    },
    {
      "kind": "dialogue",
      "external_id": "d_comparisons_03",
      "data": {
        "lesson_key": "a2-tr-comparisons-03",
        "title": "İki seçeneği değerlendir",
        "setting": "item",
        "cefr": "A2",
        "topic": "shopping",
        "characters": [
          "Deniz",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Sence hangisini alalım?",
            "translation_fa": "به نظرت کدام را بخریم؟"
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Bu daha ucuz ama küçük.",
            "translation_fa": "این ارزان‌تر است اما کوچک است."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Diğeri pahalı ama daha kullanışlı.",
            "translation_fa": "آن یکی گران است اما کاربردی‌تر است."
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "O zaman diğeri daha iyi bir seçim.",
            "translation_fa": "پس آن یکی انتخاب بهتری است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
