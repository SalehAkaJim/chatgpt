    {
      "kind": "dialogue",
      "external_id": "d_a2_city_day_capstone_01",
      "data": {
        "lesson_key": "a2-tr-a2-city-day-capstone-01",
        "title": "Şehirde plan değişikliği",
        "setting": "item",
        "cefr": "A2",
        "topic": "travel",
        "characters": [
          "Elif",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Otobüs hâlâ gelmedi.",
            "translation_fa": "اتوبوس هنوز نیامده."
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Trafik olduğu için gecikiyor.",
            "translation_fa": "به خاطر ترافیک دیر کرده."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Planımızı değiştirmeliyiz.",
            "translation_fa": "باید برنامه‌مان را تغییر دهیم."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Bence metro daha uygun.",
            "translation_fa": "به نظرم مترو مناسب‌تر است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_city_day_capstone_02",
      "data": {
        "lesson_key": "a2-tr-a2-city-day-capstone-02",
        "title": "Akşam buluşması",
        "setting": "item",
        "cefr": "A2",
        "topic": "travel",
        "characters": [
          "Selin",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Bugün çok yoruldum.",
            "translation_fa": "امروز خیلی خسته شدم."
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Biraz dinlenmelisin.",
            "translation_fa": "باید کمی استراحت کنی."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Yarın öğleden sonra buluşabilir miyiz?",
            "translation_fa": "می‌توانیم فردا بعدازظهر قرار بگذاریم؟"
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Tabii, benim için uygun.",
            "translation_fa": "حتماً، برای من مناسب است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_a2_city_day_capstone_03",
      "data": {
        "lesson_key": "a2-tr-a2-city-day-capstone-03",
        "title": "Şehir gününü yeniden planla",
        "setting": "item",
        "cefr": "A2",
        "topic": "travel",
        "characters": [
          "Mert",
          "Selin"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Müze bugün kapalıymış. Ne yapalım?",
            "translation_fa": "انگار موزه امروز بسته است. چه کار کنیم؟"
          },
          {
            "order": 2,
            "speaker": "Selin",
            "text": "Önce sahile gidelim, sonra merkezde yemek yiyebiliriz.",
            "translation_fa": "اول به ساحل برویم، بعد می‌توانیم در مرکز غذا بخوریم."
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Saat altıda arkadaşımızla buluşmamız gerekiyor.",
            "translation_fa": "ساعت شش باید دوستمان را ببینیم."
          },
          {
            "order": 4,
            "speaker": "Selin",
            "text": "O zaman yakın bir restoran seçelim; daha kolay olur.",
            "translation_fa": "پس یک رستوران نزدیک انتخاب کنیم؛ راحت‌تر می‌شود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
