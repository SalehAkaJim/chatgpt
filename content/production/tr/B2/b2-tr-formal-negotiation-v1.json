    {
      "kind": "grammar_point",
      "external_id": "g_formal_negotiation_core",
      "data": {
        "lesson_key": "b2-tr-formal-negotiation-01",
        "slug": "b2-tr-formal-negotiation-grammar",
        "title": "Koşullu müzakere",
        "rule_summary": "Frame requests and concessions as conditional exchanges rather than blunt demands.",
        "explanation": {
          "fa": "در مذاکره رسمی، درخواست را با rica etsek یا mümkünse نرم می‌کنیم و امتیاز متقابل را با şartıyla و karşılığında روشن می‌سازیم."
        },
        "examples": [
          {
            "tr": "Mümkünse ayrıntıları bugün paylaşmanızı rica ediyoruz.",
            "fa": "اگر ممکن است خواهش می‌کنیم جزئیات را امروز به اشتراک بگذارید."
          },
          {
            "tr": "Ödeme planı değişmesi şartıyla kabul edebiliriz.",
            "fa": "به شرط تغییر برنامه پرداخت می‌توانیم قبول کنیم."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_formal_negotiation_01",
      "data": {
        "lesson_key": "b2-tr-formal-negotiation-01",
        "title": "Teslim tarihi",
        "setting": "",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "Deniz",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Mevcut tarihe yetişmemiz zor görünüyor.",
            "translation_fa": "رسیدن به تاریخ فعلی دشوار به نظر می‌رسد."
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Ne kadar ek süreye ihtiyacınız var?",
            "translation_fa": "چقدر زمان اضافه نیاز دارید؟"
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Bir hafta uzatma rica ediyoruz.",
            "translation_fa": "یک هفته تمدید درخواست می‌کنیم."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Ara raporu cuma verirseniz bunu kabul edebiliriz.",
            "translation_fa": "اگر گزارش میانی را جمعه بدهید می‌توانیم قبول کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_formal_negotiation_02",
      "data": {
        "lesson_key": "b2-tr-formal-negotiation-02",
        "title": "Karşılıklı taviz",
        "setting": "",
        "cefr": "B2",
        "topic": "requests",
        "characters": [
          "Zeynep",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Zeynep",
            "text": "Bütçeyi artırmamız mümkün değil.",
            "translation_fa": "افزایش بودجه برای ما ممکن نیست."
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "O halde kapsamı biraz daraltmayı öneriyoruz.",
            "translation_fa": "در آن صورت پیشنهاد می‌کنیم دامنه را کمی محدود کنیم."
          },
          {
            "order": 3,
            "speaker": "Zeynep",
            "text": "Destek süresi uzarsa mevcut bütçeyi koruyabiliriz.",
            "translation_fa": "اگر مدت پشتیبانی بیشتر شود می‌توانیم بودجه فعلی را حفظ کنیم."
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Bu uzlaşma bizim için de makul.",
            "translation_fa": "این توافق برای ما هم منطقی است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
