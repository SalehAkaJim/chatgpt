    {
      "kind": "dialogue",
      "external_id": "d_causes_and_consequences_01",
      "data": {
        "lesson_key": "b2-tr-causes-and-consequences-01",
        "title": "Gecikmenin nedeni",
        "setting": "",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Deniz",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Proje neden iki hafta gecikti?",
            "translation_fa": "چرا پروژه دو هفته عقب افتاد؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Tek bir neden yok. Tedarik sorunu ve personel değişikliği birlikte etkiledi.",
            "translation_fa": "یک علت ندارد. مشکل تأمین و تغییر نیروی انسانی با هم اثر گذاشتند."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "En belirleyici etken hangisiydi?",
            "translation_fa": "کدام عامل تعیین‌کننده‌تر بود؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "İlk hafta tedarik sorunu, sonrasında ise planlama hatası.",
            "translation_fa": "هفته اول مشکل تأمین و بعد از آن خطای برنامه‌ریزی."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
