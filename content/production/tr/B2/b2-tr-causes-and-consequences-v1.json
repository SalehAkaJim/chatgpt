    {
      "kind": "dialogue",
      "external_id": "d_causes_and_consequences_02",
      "data": {
        "lesson_key": "b2-tr-causes-and-consequences-02",
        "title": "Beklenmeyen sonuç",
        "setting": "",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Zeynep",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Zeynep",
            "text": "Yeni uygulama trafiği azalttı mı?",
            "translation_fa": "برنامه جدید ترافیک را کم کرد؟"
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Merkezde azalttı ama yan sokaklarda yoğunluğu artırdı.",
            "translation_fa": "در مرکز کم کرد اما در خیابان‌های فرعی شلوغی را بیشتر کرد."
          },
          {
            "order": 3,
            "speaker": "Zeynep",
            "text": "Yani çözüm başka bir sorunu tetikledi.",
            "translation_fa": "یعنی راه‌حل یک مشکل دیگر ایجاد کرد."
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "Evet, sonuç bölgeye göre değişiyor.",
            "translation_fa": "بله، نتیجه بسته به منطقه فرق می‌کند."
          }
        ],
        "qa": {
