        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Aynı kararı bugün yine verir miydin?",
            "translation_fa": "امروز هم همان تصمیم را می‌گرفتی؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Hayır. Daha fazla bilgi toplamış olsaydım acele etmezdim.",
            "translation_fa": "نه. اگر اطلاعات بیشتری جمع کرده بودم عجله نمی‌کردم."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "En çok neyi değiştirirdin?",
            "translation_fa": "بیشتر از همه چه چیزی را عوض می‌کردی؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Tek bir seçeneğe bu kadar erken bağlanmazdım.",
            "translation_fa": "این‌قدر زود به یک گزینه وابسته نمی‌شدم."
          }
        ],
