          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Salon müsait olmasaydı ne yapacaktık?",
            "translation_fa": "اگر سالن در دسترس نبود چه کار می‌کردیم؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Etkinliği iki küçük gruba bölecektik.",
            "translation_fa": "رویداد را به دو گروه کوچک تقسیم می‌کردیم."
