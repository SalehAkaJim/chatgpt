    {
      "kind": "grammar_point",
      "external_id": "g_passive_processes_core",
      "data": {
        "lesson_key": "b2-tr-passive-processes-01",
        "slug": "b2-tr-passive-processes-grammar",
        "title": "Edilgen yapı",
        "rule_summary": "Use passive voice for processes when the action or procedure is more important than the actor; add tarafından when the actor matters.",
        "explanation": {
          "fa": "در توصیف فرایندها وقتی خود عمل مهم‌تر از انجام‌دهنده است از مجهول استفاده می‌کنیم؛ اگر عامل مهم باشد با tarafından می‌آید."
        },
        "examples": [
          {
            "tr": "Başvurular cuma günü değerlendirilecek.",
            "fa": "درخواست‌ها جمعه ارزیابی خواهند شد."
          },
          {
            "tr": "Rapor uzmanlar tarafından hazırlandı.",
            "fa": "گزارش توسط متخصصان آماده شد."
          }
        ],
        "cefr": "B2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_passive_processes_01",
      "data": {
        "lesson_key": "b2-tr-passive-processes-01",
        "title": "Seçim süreci",
        "setting": "",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Kaan",
          "Deniz"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Kaan",
            "text": "Başvurular nasıl değerlendiriliyor?",
            "translation_fa": "درخواست‌ها چطور ارزیابی می‌شوند؟"
          },
          {
            "order": 2,
            "speaker": "Deniz",
            "text": "Önce belgeler kontrol ediliyor, sonra kurul puan veriyor.",
            "translation_fa": "اول مدارک بررسی می‌شوند، بعد هیئت امتیاز می‌دهد."
          },
          {
            "order": 3,
            "speaker": "Kaan",
            "text": "Son karar kim tarafından alınıyor?",
            "translation_fa": "تصمیم نهایی توسط چه کسی گرفته می‌شود؟"
          },
          {
            "order": 4,
            "speaker": "Deniz",
            "text": "Üç kişilik bağımsız kurul tarafından.",
            "translation_fa": "توسط یک هیئت مستقل سه‌نفره."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
