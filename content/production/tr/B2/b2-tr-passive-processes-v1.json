    {
      "kind": "dialogue",
      "external_id": "d_passive_processes_02",
      "data": {
        "lesson_key": "b2-tr-passive-processes-02",
        "title": "Yeni sistem",
        "setting": "",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Selin",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Yeni sistem ne zaman uygulanacak?",
            "translation_fa": "سیستم جدید کی اجرا می‌شود؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Önce iki ekipte denenecek, sonra sonuçlar değerlendirilecek.",
            "translation_fa": "اول در دو تیم آزمایش می‌شود و بعد نتایج ارزیابی می‌شوند."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Çalışanlara bilgi verildi mi?",
            "translation_fa": "به کارکنان اطلاع داده شده؟"
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Evet, ayrıntılar dün paylaşıldı.",
            "translation_fa": "بله، جزئیات دیروز به اشتراک گذاشته شد."
          }
        ],
        "qa": {
