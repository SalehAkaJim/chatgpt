    {
      "kind": "dialogue",
      "external_id": "d_nuanced_stance_01",
      "data": {
        "lesson_key": "b2-tr-nuanced-stance-01",
        "title": "Kısmi uzlaşma",
        "setting": "",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Elif",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Öneriyi tamamen destekliyor musun?",
            "translation_fa": "کاملاً از پیشنهاد حمایت می‌کنی؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Amaç açısından evet, yöntem konusunda çekincelerim var.",
            "translation_fa": "از نظر هدف بله، اما درباره روش ملاحظاتی دارم."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "En büyük çekincen ne?",
            "translation_fa": "بزرگ‌ترین ملاحظه‌ات چیست؟"
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Takvimin gereğinden fazla iyimser olması.",
            "translation_fa": "اینکه زمان‌بندی بیش از حد خوش‌بینانه است."
          }
        ],
