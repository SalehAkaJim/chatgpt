    {
      "kind": "dialogue",
      "external_id": "d_nuanced_stance_02",
      "data": {
        "lesson_key": "b2-tr-nuanced-stance-02",
        "title": "Neyi savunuyoruz?",
        "setting": "",
        "cefr": "B2",
        "topic": "simple-messages",
        "characters": [
          "Selin",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Bu eleştiriye katılıyor musun?",
            "translation_fa": "با این انتقاد موافقی؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Kısmen. Sorunu doğru görüyor ama sonucu fazla genelliyor.",
            "translation_fa": "تا حدی. مشکل را درست می‌بیند اما نتیجه را بیش از حد تعمیم می‌دهد."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "O zaman neyi vurgulayalım?",
            "translation_fa": "پس روی چه چیزی تأکید کنیم؟"
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Koşullara göre değişen kısmı açıkça belirtelim.",
            "translation_fa": "بخش وابسته به شرایط را روشن بیان کنیم."
          }
        ],
        "qa": {
