    {
      "kind": "grammar_point",
      "external_id": "g_digital_support_and_instructions_core",
      "data": {
        "lesson_key": "b1-tr-digital-support-and-instructions-01",
        "slug": "b1-tr-digital-support-and-instructions-grammar",
        "title": "Teknik destek adımlarını aktarmak",
        "rule_summary": "Use simple past to describe the problem, -memi istedi / -eceklerini söylediler to relay support instructions, then explain the result with -ınca/-ince and a realistic follow-up condition.",
        "explanation": {
          "fa": "برای مشکل فنی، مشکل را کوتاه و روشن می‌گوییم، دستور پشتیبانی را منتقل می‌کنیم و نتیجه و قدم بعدی را توضیح می‌دهیم."
        },
        "examples": [
          {
            "tr": "Destek ekibi sayfayı yenilememi istedi.",
            "fa": "پشتیبانی خواست صفحه را تازه‌سازی کنم."
          },
          {
            "tr": "Bağlantıyı açınca sorun çözüldü.",
            "fa": "وقتی لینک را باز کردم مشکل حل شد."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_digital_support_and_instructions_01",
      "data": {
        "lesson_key": "b1-tr-digital-support-and-instructions-01",
        "title": "Sorun ne?",
        "setting": "item",
        "cefr": "B1",
        "topic": "technology",
        "characters": [
          "Elif",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Hesabında ne sorun var?",
            "translation_fa": "حسابت چه مشکلی دارد؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Girebiliyorum ama şifremi değiştiremiyorum.",
            "translation_fa": "می‌توانم وارد شوم اما نمی‌توانم رمز را عوض کنم."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Ne zaman başladı?",
            "translation_fa": "کی شروع شد؟"
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Dün akşam bağlantı kesildikten sonra başladı.",
            "translation_fa": "دیشب بعد از قطع اتصال شروع شد."
          }
        ],
        "qa": {
