    {
      "kind": "dialogue",
      "external_id": "d_media_and_sources_01",
      "data": {
        "lesson_key": "b1-tr-media-and-sources-01",
        "title": "Bir haber gördüm",
        "setting": "",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Deniz",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Bu haberi sen de gördün mü?",
            "translation_fa": "تو هم این خبر را دیدی؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Gördüm ama kaynak güvenilir gelmedi.",
            "translation_fa": "دیدم ولی منبع قابل اعتماد به نظرم نیامد."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Ben de başka sitelerde aradım.",
            "translation_fa": "من هم در سایت‌های دیگر جست‌وجو کردم."
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Doğrulanmadan paylaşmamak daha iyi.",
            "translation_fa": "بهتر است تا تأیید نشده منتشرش نکنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_media_and_sources_02",
      "data": {
        "lesson_key": "b1-tr-media-and-sources-02",
        "title": "Kaynak kontrolü",
        "setting": "",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Zeynep",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Zeynep",
            "text": "Bu rakam nereden geliyor?",
            "translation_fa": "این عدد از کجا آمده؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Bir raporda gördüm.",
            "translation_fa": "در یک گزارش دیدم."
          },
          {
            "order": 3,
            "speaker": "Zeynep",
            "text": "Kaynağı kontrol ettin mi?",
            "translation_fa": "منبع را بررسی کردی؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Evet, resmi verilerle karşılaştırdım.",
            "translation_fa": "بله، با داده‌های رسمی مقایسه کردم."
          }
        ],
        "qa": {
