    {
      "kind": "dialogue",
      "external_id": "d_goals_and_effort_02",
      "data": {
        "lesson_key": "b1-tr-goals-and-effort-02",
        "title": "İlerleme",
        "setting": "",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "Zeynep",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Zeynep",
            "text": "Sence son haftalarda ilerledin mi?",
            "translation_fa": "فکر می‌کنی این چند هفته پیشرفت کردی؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Evet, özellikle dinlemede.",
            "translation_fa": "بله، مخصوصاً در شنیدن."
          },
          {
            "order": 3,
            "speaker": "Zeynep",
            "text": "Ne işe yaradı?",
            "translation_fa": "چه چیزی کمک کرد؟"
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Düzenli çalışmak en çok işe yaradı.",
            "translation_fa": "تمرین منظم بیشتر از همه کمک کرد."
          }
        ],
        "qa": {
