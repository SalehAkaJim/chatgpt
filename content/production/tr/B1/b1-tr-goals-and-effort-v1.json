      "data": {
        "lesson_key": "b1-tr-goals-and-effort-01",
        "slug": "b1-tr-goals-and-effort-grammar",
        "title": "Amaç: -mek için",
        "rule_summary": "Use -mek için to express purpose; combine with -ebilmek for abilities you want to develop.",
        "explanation": {
          "fa": "برای بیان هدف از -mek için استفاده می‌کنیم: konuşabilmek için یعنی «برای اینکه بتوانم صحبت کنم»."
        },
        "examples": [
          {
            "tr": "Sınavı geçmek için çalışıyorum.",
            "fa": "برای قبولی در امتحان درس می‌خوانم."
          },
          {
            "tr": "Daha iyi anlayabilmek için dinliyorum.",
            "fa": "برای اینکه بهتر بفهمم گوش می‌دهم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
