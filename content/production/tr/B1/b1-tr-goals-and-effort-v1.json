    {
      "kind": "dialogue",
      "external_id": "d_goals_and_effort_01",
      "data": {
        "lesson_key": "b1-tr-goals-and-effort-01",
        "title": "Yeni hedef",
        "setting": "",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "Deniz",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Bu dönemki hedefin ne?",
            "translation_fa": "هدفت برای این دوره چیست؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Daha rahat konuşabilmek istiyorum.",
            "translation_fa": "می‌خواهم بتوانم راحت‌تر صحبت کنم."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Bunun için ne yapıyorsun?",
            "translation_fa": "برای این چه کار می‌کنی؟"
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Her gün kısa da olsa pratik yapıyorum.",
            "translation_fa": "هر روز حتی کوتاه تمرین می‌کنم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
