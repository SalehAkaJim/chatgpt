    {
      "kind": "dialogue",
      "external_id": "d_opinions_and_evidence_03",
      "data": {
        "lesson_key": "b1-tr-opinions-and-evidence-03",
        "title": "Görüşünü gerekçelendir",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Deniz",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Sence bu sistem devam etmeli mi?",
            "translation_fa": "به‌نظرت این سیستم باید ادامه پیدا کند؟"
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Bence evet, çünkü bekleme süresi azaldı.",
            "translation_fa": "به‌نظر من بله، چون زمان انتظار کم شده."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Hiç olumsuz yanı yok mu?",
            "translation_fa": "هیچ نکته منفی ندارد؟"
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "Var. Özellikle yaşlı kullanıcılar için kolay olduğundan tam emin değilim.",
            "translation_fa": "دارد. مخصوصاً مطمئن نیستم برای کاربران مسن آسان باشد."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
