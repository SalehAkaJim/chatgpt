        "slug": "b1-tr-opinions-and-evidence-grammar",
        "title": "Görüş ve gerekçe",
        "rule_summary": "Separate opinion from evidence and soften certainty when needed.",
        "explanation": {
          "fa": "نظر را با دلیل جدا می‌کنیم: bence برای نظر، çünkü برای دلیل و emin değilim برای قطعیت کمتر."
        },
        "examples": [
          {
            "tr": "Bence bu daha iyi, çünkü daha ucuz.",
            "fa": "به‌نظر من این بهتر است چون ارزان‌تر است."
          },
          {
            "tr": "Bundan pek emin değilim.",
            "fa": "خیلی از این مطمئن نیستم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
