    {
      "kind": "grammar_point",
      "external_id": "g_opinions_and_evidence_core",
      "data": {
        "lesson_key": "b1-tr-opinions-and-evidence-01",
        "slug": "b1-tr-opinions-and-evidence-grammar",
        "title": "Görüş ve gerekçe",
        "rule_summary": "Separate opinion from evidence and soften certainty when needed.",
        "explanation": {
          "fa": "نظر را با دلیل جدا می‌کنیم: bence برای نظر، çünkü برای دلیل و emin değilim برای قطعیت کمتر."
        },
        "examples": [
          {
            "tr": "Bence bu daha iyi, çünkü daha ucuz.",
            "fa": "به‌نظر من این بهتر است چون ارزان‌تر است."
          },
          {
            "tr": "Bundan pek emin değilim.",
            "fa": "خیلی از این مطمئن نیستم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_opinions_and_evidence_01",
      "data": {
        "lesson_key": "b1-tr-opinions-and-evidence-01",
        "title": "Bir karar",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Elif",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Sence hangi seçenek daha mantıklı?",
            "translation_fa": "به‌نظرت کدام گزینه منطقی‌تر است؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Bence ikinci seçenek daha güvenli.",
            "translation_fa": "به‌نظر من گزینه دوم امن‌تر است."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Neye dayanarak söylüyorsun?",
            "translation_fa": "بر چه اساسی می‌گویی؟"
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Geçen ayki sonuçlar bunu gösteriyor.",
            "translation_fa": "نتایج ماه قبل این را نشان می‌دهد."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
