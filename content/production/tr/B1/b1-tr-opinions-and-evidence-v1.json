    {
      "kind": "dialogue",
      "external_id": "d_opinions_and_evidence_02",
      "data": {
        "lesson_key": "b1-tr-opinions-and-evidence-02",
        "title": "Kesin misin?",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Selin",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Bu haber doğru mu sence?",
            "translation_fa": "فکر می‌کنی این خبر درست است؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Tam emin değilim.",
            "translation_fa": "کاملاً مطمئن نیستم."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Neden şüphelendin?",
            "translation_fa": "چرا شک کردی؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Kaynak güvenilir görünmüyor.",
            "translation_fa": "منبع قابل اعتماد به نظر نمی‌رسد."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
