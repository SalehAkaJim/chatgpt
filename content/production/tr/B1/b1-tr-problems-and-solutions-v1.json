        "lesson_key": "b1-tr-problems-and-solutions-01",
        "text": {
          "tr": "Gerekirse ikinci seçeneği deneyelim."
        },
        "translations": {
          "fa": "اگر لازم شد گزینه دوم را امتحان کنیم."
        },
        "intent": "fallback",
