    {
      "kind": "grammar_point",
      "external_id": "g_problems_and_solutions_core",
      "data": {
        "lesson_key": "b1-tr-problems-and-solutions-01",
        "slug": "b1-tr-problems-and-solutions-grammar",
        "title": "Öneri ve alternatif",
        "rule_summary": "Use -elim/-alım, -ebiliriz and gerekirse to propose and soften solutions.",
        "explanation": {
          "fa": "برای پیشنهاد راه‌حل از -elim/-alım یا -ebiliriz استفاده می‌کنیم؛ gerekirse یعنی «اگر لازم شد»."
        },
        "examples": [
          {
            "tr": "Başka bir yol deneyelim.",
            "fa": "یک راه دیگر امتحان کنیم."
          },
          {
            "tr": "Gerekirse yarın konuşabiliriz.",
            "fa": "اگر لازم شد فردا می‌توانیم صحبت کنیم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_problems_and_solutions_01",
      "data": {
        "lesson_key": "b1-tr-problems-and-solutions-01",
        "title": "Rezervasyon sorunu",
        "setting": "item",
        "cefr": "B1",
        "topic": "requests",
        "characters": [
          "Elif",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Rezervasyonda bir sorun görünüyor.",
            "translation_fa": "به نظر می‌رسد رزرو مشکلی دارد."
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Başka bir oda kontrol edebilirim.",
            "translation_fa": "می‌توانم اتاق دیگری را بررسی کنم."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Aynı fiyattaysa olur.",
            "translation_fa": "اگر همان قیمت باشد خوب است."
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "Hemen alternatiflere bakayım.",
            "translation_fa": "همین الان گزینه‌های جایگزین را بررسی می‌کنم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_problems_and_solutions_02",
      "data": {
        "lesson_key": "b1-tr-problems-and-solutions-02",
        "title": "Plan değişikliği",
        "setting": "item",
        "cefr": "B1",
        "topic": "requests",
        "characters": [
          "Selin",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Cumartesi herkes müsait değil.",
            "translation_fa": "شنبه همه وقت ندارند."
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "O zaman pazar gününü deneyelim.",
            "translation_fa": "پس یکشنبه را امتحان کنیم."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Zeynep pazar da çalışıyor.",
            "translation_fa": "زینب یکشنبه هم کار می‌کند."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Gerekirse akşam buluşabiliriz.",
            "translation_fa": "اگر لازم شد عصر همدیگر را ببینیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_problems_and_solutions_03",
      "data": {
        "lesson_key": "b1-tr-problems-and-solutions-03",
        "title": "Çözüm üzerinde anlaş",
        "setting": "item",
        "cefr": "B1",
        "topic": "requests",
        "characters": [
          "Deniz",
          "Zeynep"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Teslimatı bugün yapamıyoruz. Ne önerirsin?",
            "translation_fa": "امروز نمی‌توانیم تحویل بدهیم. چه پیشنهاد می‌کنی؟"
          },
          {
            "order": 2,
            "speaker": "Zeynep",
            "text": "Müşteriye iki seçenek sunalım: yarın teslimat ya da mağazadan teslim alma.",
            "translation_fa": "دو گزینه به مشتری بدهیم: تحویل فردا یا تحویل گرفتن از فروشگاه."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Sence hangisi daha uygun?",
            "translation_fa": "به‌نظرت کدام مناسب‌تر است؟"
          },
          {
            "order": 4,
            "speaker": "Zeynep",
            "text": "Önce müşterinin tercihine göre karar verelim.",
            "translation_fa": "اول بر اساس ترجیح مشتری تصمیم بگیریم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
