    {
      "kind": "grammar_point",
      "external_id": "g_social_nuance_core",
      "data": {
        "lesson_key": "b1-tr-social-nuance-01",
        "slug": "b1-tr-social-nuance-grammar",
        "title": "İletişim onarma",
        "rule_summary": "Use yanlış anlama, aslında and demek istediğim to repair meaning without escalating disagreement.",
        "explanation": {
          "fa": "برای اصلاح سوءبرداشت از yanlış anlama، aslında و demek istediğim استفاده می‌کنیم."
        },
        "examples": [
          {
            "tr": "Yanlış anlama, sana kızgın değilim.",
            "fa": "بد برداشت نکن، از تو عصبانی نیستم."
          },
          {
            "tr": "Demek istediğim bu değildi.",
            "fa": "منظورم این نبود."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_social_nuance_01",
      "data": {
        "lesson_key": "b1-tr-social-nuance-01",
        "title": "Yanlış anlaşılma",
        "setting": "item",
        "cefr": "B1",
        "topic": "likes-dislikes",
        "characters": [
          "Elif",
          "Zeynep"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Sanki fikrimi hiç beğenmedin.",
            "translation_fa": "انگار اصلاً نظرم را نپسندیدی."
          },
          {
            "order": 2,
            "speaker": "Zeynep",
            "text": "Yanlış anlama, fikrine karşı değilim.",
            "translation_fa": "بد برداشت نکن، با نظرت مخالف نیستم."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Peki ne demek istedin?",
            "translation_fa": "پس منظورت چه بود؟"
          },
          {
            "order": 4,
            "speaker": "Zeynep",
            "text": "Sadece daha fazla bilgiye ihtiyacımız olduğunu söyledim.",
            "translation_fa": "فقط گفتم اطلاعات بیشتری لازم داریم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_social_nuance_02",
      "data": {
        "lesson_key": "b1-tr-social-nuance-02",
        "title": "Niyetini açıklamak",
        "setting": "item",
        "cefr": "B1",
        "topic": "likes-dislikes",
        "characters": [
          "Mert",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Dünkü sözün biraz sert geldi.",
            "translation_fa": "حرفت دیروز کمی تند به نظر رسید."
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Haklısın, aslında öyle kastetmedim.",
            "translation_fa": "حق داری، واقعاً منظورم آن نبود."
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Ne demek istemiştin?",
            "translation_fa": "چه منظوری داشتی؟"
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "Süreyi değil, planı eleştiriyordum.",
            "translation_fa": "از زمان‌بندی نه، از برنامه انتقاد داشتم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_social_nuance_03",
      "data": {
        "lesson_key": "b1-tr-social-nuance-03",
        "title": "Yanlış anlamayı düzelt",
        "setting": "item",
        "cefr": "B1",
        "topic": "likes-dislikes",
        "characters": [
          "Deniz",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Sanırım önerimi gereksiz buldun.",
            "translation_fa": "فکر کنم پیشنهادم را غیرضروری دانستی."
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Hayır, öyle demek istemedim. Sadece zamanlamayı sormak istedim.",
            "translation_fa": "نه، منظورم این نبود. فقط می‌خواستم درباره زمان‌بندی بپرسم."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Tamam, ben yanlış anlamışım.",
            "translation_fa": "باشه، من بد فهمیده بودم."
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Sorun değil. İstersen neyi kastettiğimi tekrar açıklayayım.",
            "translation_fa": "اشکالی ندارد. اگر بخواهی دوباره منظورم را توضیح می‌دهم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
