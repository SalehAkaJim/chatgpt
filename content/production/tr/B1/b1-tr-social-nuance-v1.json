      "data": {
        "lesson_key": "b1-tr-social-nuance-01",
        "text": {
          "tr": "Demek istediğim şu: biraz daha zamana ihtiyacımız var."
        },
        "translations": {
          "fa": "منظورم این است: کمی زمان بیشتری لازم داریم."
        },
        "intent": "clarify",
