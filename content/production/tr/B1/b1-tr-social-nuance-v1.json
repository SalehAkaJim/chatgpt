    {
      "kind": "dialogue",
      "external_id": "d_social_nuance_01",
      "data": {
        "lesson_key": "b1-tr-social-nuance-01",
        "title": "Yanlış anlaşılma",
        "setting": "",
        "cefr": "B1",
        "topic": "likes-dislikes",
        "characters": [
          "Elif",
          "Zeynep"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Sanki fikrimi hiç beğenmedin.",
            "translation_fa": "انگار اصلاً نظرم را نپسندیدی."
          },
          {
            "order": 2,
            "speaker": "Zeynep",
            "text": "Yanlış anlama, fikrine karşı değilim.",
            "translation_fa": "بد برداشت نکن، با نظرت مخالف نیستم."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Peki ne demek istedin?",
            "translation_fa": "پس منظورت چه بود؟"
          },
          {
            "order": 4,
            "speaker": "Zeynep",
            "text": "Sadece daha fazla bilgiye ihtiyacımız olduğunu söyledim.",
            "translation_fa": "فقط گفتم اطلاعات بیشتری لازم داریم."
          }
        ],
