        "characters": [
          "Mert",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Dünkü sözün biraz sert geldi.",
            "translation_fa": "حرفت دیروز کمی تند به نظر رسید."
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Haklısın, aslında öyle kastetmedim.",
            "translation_fa": "حق داری، واقعاً منظورم آن نبود."
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Ne demek istemiştin?",
            "translation_fa": "چه منظوری داشتی؟"
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "Süreyi değil, planı eleştiriyordum.",
            "translation_fa": "از زمان‌بندی نه، از برنامه انتقاد داشتم."
