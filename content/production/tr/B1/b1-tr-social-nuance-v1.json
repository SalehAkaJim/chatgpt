    {
      "kind": "utterance",
      "external_id": "u_social_nuance_05",
      "data": {
        "lesson_key": "b1-tr-social-nuance-03",
        "text": {
          "tr": "Seni yanlış anladıysam özür dilerim; ne demek istediğini tekrar açıklar mısın?"
        },
        "translations": {
          "fa": "اگر بد فهمیدم عذر می‌خواهم؛ می‌توانی دوباره منظورت را توضیح بدهی؟"
        },
        "intent": "repair_interaction",
        "concept_refs": [],
