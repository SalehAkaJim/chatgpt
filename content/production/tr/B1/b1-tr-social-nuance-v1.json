    },
    {
      "kind": "utterance",
      "external_id": "u_social_nuance_06",
      "data": {
        "lesson_key": "b1-tr-social-nuance-03",
        "text": {
          "tr": "Fikrine karşı değilim; sadece bu kısmın biraz daha açık olmasını istiyorum."
        },
        "translations": {
          "fa": "با نظرت مخالف نیستم؛ فقط می‌خواهم این بخش کمی روشن‌تر باشد."
