    {
      "kind": "dialogue",
      "external_id": "d_invitation_and_polite_alternative_03",
      "data": {
        "lesson_key": "b1-tr-invitation-and-polite-alternative-03",
        "title": "Planı netleştirmek",
        "setting": "item",
        "cefr": "B1",
        "topic": "social",
        "characters": [
          "Deniz",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Pazar öğleden sonra sana uyar mı?",
            "translation_fa": "یکشنبه بعدازظهر برایت مناسب است؟"
          },
