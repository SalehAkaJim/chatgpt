    {
      "kind": "grammar_point",
      "external_id": "g_invitation_and_polite_alternative_core",
      "data": {
        "lesson_key": "b1-tr-invitation-and-polite-alternative-01",
        "slug": "b1-tr-invitation-and-polite-alternative-grammar",
        "title": "Nazikçe reddetmek ve alternatif sunmak",
        "rule_summary": "Use teşekkür ederim + a brief concrete reason, maalesef to soften refusal, and an ordinary future/realistic condition for an alternative plan.",
        "explanation": {
          "fa": "برای رد مؤدبانهٔ دعوت، اول تشکر می‌کنیم، یک دلیل کوتاه می‌دهیم و بعد یک پیشنهاد جایگزین واقعی ارائه می‌کنیم."
        },
        "examples": [
          {
            "tr": "Davetin için teşekkür ederim ama cumartesi gelemeyeceğim.",
            "fa": "برای دعوتت ممنونم اما شنبه نمی‌توانم بیایم."
          },
          {
            "tr": "Pazar uygunsan görüşebiliriz.",
            "fa": "اگر یکشنبه فرصت داری می‌توانیم همدیگر را ببینیم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_invitation_and_polite_alternative_01",
      "data": {
        "lesson_key": "b1-tr-invitation-and-polite-alternative-01",
        "title": "Cumartesi gelir misin?",
        "setting": "item",
        "cefr": "B1",
        "topic": "social",
        "characters": [
          "Zeynep",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Zeynep",
            "text": "Cumartesi akşamı bize gelir misin?",
            "translation_fa": "شنبه شب می‌آیی پیش ما؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Davetin için teşekkür ederim. Ailemle planım olduğu için gelemeyeceğim.",
            "translation_fa": "برای دعوتت ممنونم. چون با خانواده برنامه دارم نمی‌توانم بیایم."
          },
          {
            "order": 3,
            "speaker": "Zeynep",
            "text": "Sorun değil.",
            "translation_fa": "اشکالی ندارد."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Başka zaman mutlaka görüşelim.",
            "translation_fa": "حتماً یک زمان دیگر همدیگر را ببینیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_invitation_and_polite_alternative_02",
      "data": {
        "lesson_key": "b1-tr-invitation-and-polite-alternative-02",
        "title": "Başka bir zaman",
        "setting": "item",
        "cefr": "B1",
        "topic": "social",
        "characters": [
          "Emre",
          "Elif"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Emre",
            "text": "Bu hafta sonu uygun musun?",
            "translation_fa": "این آخرهفته فرصت داری؟"
          },
          {
            "order": 2,
            "speaker": "Elif",
            "text": "Maalesef uygun değilim.",
            "translation_fa": "متأسفانه فرصت ندارم."
          },
          {
            "order": 3,
            "speaker": "Emre",
            "text": "Gelecek hafta nasıl?",
            "translation_fa": "هفتهٔ بعد چطور؟"
          },
          {
            "order": 4,
            "speaker": "Elif",
            "text": "İstersen salı akşamı kahve içebiliriz.",
