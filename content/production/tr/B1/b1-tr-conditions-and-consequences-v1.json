    {
      "kind": "dialogue",
      "external_id": "d_conditions_and_consequences_01",
      "data": {
        "lesson_key": "b1-tr-conditions-and-consequences-01",
        "title": "Hava değişirse",
        "setting": "item",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "Elif",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Yarın yağmur yağarsa ne yapacağız?",
            "translation_fa": "اگر فردا باران ببارد چه کار می‌کنیم؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Müzeye gideriz.",
            "translation_fa": "می‌رویم موزه."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Hava güzel olursa?",
            "translation_fa": "اگر هوا خوب باشد؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "O zaman sahilde yürürüz.",
            "translation_fa": "آن وقت کنار ساحل قدم می‌زنیم."
          }
        ],
        "qa": {
