        "lesson_key": "b1-tr-conditions-and-consequences-01",
        "slug": "b1-tr-conditions-and-consequences-grammar",
        "title": "Gerçek koşul: -sa/-se",
        "rule_summary": "Use -sa/-se for realistic conditions and their consequences.",
        "explanation": {
          "fa": "برای شرط واقعی و ممکن از -sa/-se استفاده می‌کنیم: erken çıkarsak یعنی «اگر زود راه بیفتیم»."
        },
        "examples": [
          {
            "tr": "Yağmur yağarsa evde kalırız.",
            "fa": "اگر باران ببارد خانه می‌مانیم."
          },
          {
            "tr": "Geç kalırsan haber ver.",
            "fa": "اگر دیر کردی خبر بده."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
