    {
      "kind": "dialogue",
      "external_id": "d_conditions_and_consequences_02",
      "data": {
        "lesson_key": "b1-tr-conditions-and-consequences-02",
        "title": "Yol planı",
        "setting": "item",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "Selin",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Trafik çok olursa geç kalabiliriz.",
            "translation_fa": "اگر ترافیک زیاد باشد شاید دیر برسیم."
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Erken çıkarsak sorun olmaz.",
            "translation_fa": "اگر زود راه بیفتیم مشکلی نمی‌شود."
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Bir aksilik olursa ararım.",
            "translation_fa": "اگر مشکلی پیش بیاید زنگ می‌زنم."
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "Tamam, plana göre hareket ederiz.",
            "translation_fa": "باشه، طبق برنامه پیش می‌رویم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_conditions_and_consequences_03",
      "data": {
        "lesson_key": "b1-tr-conditions-and-consequences-03",
        "title": "Plan B oluştur",
        "setting": "item",
        "cefr": "B1",
        "topic": "future-plans",
        "characters": [
          "Deniz",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Ya dosyalar zamanında gelmezse?",
            "translation_fa": "اگر فایل‌ها به‌موقع نرسند چه؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Önce elimizdeki kısmı hazırlarız.",
            "translation_fa": "اول بخشی را که داریم آماده می‌کنیم."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Müşteriye ne söyleyelim?",
            "translation_fa": "به مشتری چه بگوییم؟"
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Gecikme olursa hemen haber veririz ve yeni tarih öneririz.",
            "translation_fa": "اگر تأخیر شد فوراً خبر می‌دهیم و تاریخ جدید پیشنهاد می‌کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
