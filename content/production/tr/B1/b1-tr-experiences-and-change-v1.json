    {
      "kind": "dialogue",
      "external_id": "d_experiences_and_change_01",
      "data": {
        "lesson_key": "b1-tr-experiences-and-change-01",
        "title": "Eski alışkanlıklar",
        "setting": "",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "Elif",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Eskiden de bu kadar yürür müydün?",
            "translation_fa": "قبلاً هم این‌قدر پیاده می‌رفتی؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Hayır, her yere arabayla giderdim.",
            "translation_fa": "نه، همه‌جا با ماشین می‌رفتم."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Ne zaman değişti?",
            "translation_fa": "از کی عوض شد؟"
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Taşındıktan sonra yavaş yavaş alıştım.",
            "translation_fa": "بعد از اسباب‌کشی کم‌کم عادت کردم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
