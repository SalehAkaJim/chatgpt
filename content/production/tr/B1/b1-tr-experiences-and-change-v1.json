    {
      "kind": "grammar_point",
      "external_id": "g_experiences_and_change_core",
      "data": {
        "lesson_key": "b1-tr-experiences-and-change-01",
        "slug": "b1-tr-experiences-and-change-grammar",
        "title": "Geçmiş alışkanlık: -irdi",
        "rule_summary": "Use -irdi for repeated past habits and contrast them with the present.",
        "explanation": {
          "fa": "برای عادت تکراری گذشته از ساخت‌هایی مثل giderdim استفاده می‌کنیم؛ eskiden و artık تغییر را روشن می‌کنند."
        },
        "examples": [
          {
            "tr": "Eskiden erken kalkardım.",
            "fa": "قبلاً زود بیدار می‌شدم."
          },
          {
            "tr": "Artık evden çalışıyorum.",
            "fa": "حالا از خانه کار می‌کنم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_experiences_and_change_01",
      "data": {
        "lesson_key": "b1-tr-experiences-and-change-01",
        "title": "Eski alışkanlıklar",
        "setting": "item",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "Elif",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Eskiden de bu kadar yürür müydün?",
            "translation_fa": "قبلاً هم این‌قدر پیاده می‌رفتی؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Hayır, her yere arabayla giderdim.",
            "translation_fa": "نه، همه‌جا با ماشین می‌رفتم."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Ne zaman değişti?",
            "translation_fa": "از کی عوض شد؟"
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "Taşındıktan sonra yavaş yavaş alıştım.",
            "translation_fa": "بعد از اسباب‌کشی کم‌کم عادت کردم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_experiences_and_change_02",
      "data": {
        "lesson_key": "b1-tr-experiences-and-change-02",
        "title": "Fikir değişikliği",
        "setting": "item",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "Selin",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Selin",
            "text": "Bu semti eskiden sevmezdim.",
            "translation_fa": "قبلاً این محله را دوست نداشتم."
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Şimdi fikrin değişti mi?",
            "translation_fa": "حالا نظرت عوض شده؟"
          },
          {
            "order": 3,
            "speaker": "Selin",
            "text": "Evet, zamanla güzel yanlarını fark ettim.",
            "translation_fa": "بله، کم‌کم خوبی‌هایش را دیدم."
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Ben de ilk başta alışamamıştım.",
            "translation_fa": "من هم اولش نتوانسته بودم عادت کنم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_experiences_and_change_03",
      "data": {
        "lesson_key": "b1-tr-experiences-and-change-03",
        "title": "Değişimi anlat",
        "setting": "item",
        "cefr": "B1",
        "topic": "daily-routine",
        "characters": [
          "Deniz",
          "Zeynep"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Son yıllarda sende en çok ne değişti?",
            "translation_fa": "در سال‌های اخیر چه چیزی بیشتر از همه در تو تغییر کرده؟"
          },
          {
            "order": 2,
            "speaker": "Zeynep",
            "text": "Eskiden yeni insanlarla konuşmakta zorlanırdım.",
            "translation_fa": "قبلاً صحبت با آدم‌های جدید برایم سخت بود."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Peki ne yardımcı oldu?",
            "translation_fa": "چه چیزی کمک کرد؟"
          },
          {
            "order": 4,
            "speaker": "Zeynep",
            "text": "İşim gereği sık sık konuşunca zamanla alıştım.",
            "translation_fa": "چون به‌خاطر کارم زیاد صحبت کردم، کم‌کم عادت کردم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
