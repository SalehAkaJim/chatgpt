    {
      "kind": "grammar_point",
      "external_id": "g_community_event_coordination_core",
      "data": {
        "lesson_key": "b1-tr-community-event-coordination-01",
        "slug": "b1-tr-community-event-coordination-grammar",
        "title": "Kısa arabuluculuk ve görev paylaşımı",
        "rule_summary": "Select the practical details another person needs, relay them in your own words, and use simple sequencing or realistic -sa/-se conditions for coordination.",
        "explanation": {
          "fa": "در میانجی‌گری کوتاه لازم نیست متن اطلاعیه را کلمه‌به‌کلمه تکرار کنیم؛ اطلاعات لازم را انتخاب می‌کنیم و روشن به فرد دیگر منتقل می‌کنیم."
        },
        "examples": [
          {
            "tr": "Duyuruda etkinliğin saat on birde başlayacağı yazıyor.",
            "fa": "در اطلاعیه نوشته برنامه ساعت یازده شروع می‌شود."
          },
          {
            "tr": "Hazırlık erken biterse girişte yardım ederim.",
            "fa": "اگر آماده‌سازی زود تمام شود در ورودی کمک می‌کنم."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_community_event_coordination_01",
      "data": {
        "lesson_key": "b1-tr-community-event-coordination-01",
        "title": "Etkinlik bilgisi",
        "setting": "item",
        "cefr": "B1",
        "topic": "community",
        "characters": [
          "Emre",
          "Elif"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Emre",
            "text": "Etkinlik ne zaman başlıyor?",
            "translation_fa": "برنامه کی شروع می‌شود؟"
          },
          {
            "order": 2,
            "speaker": "Elif",
            "text": "Cumartesi saat on birde.",
            "translation_fa": "شنبه ساعت یازده."
          },
          {
            "order": 3,
            "speaker": "Emre",
            "text": "Kaç kişi gelecek?",
            "translation_fa": "چند نفر می‌آیند؟"
          },
          {
            "order": 4,
            "speaker": "Elif",
            "text": "Şimdilik yaklaşık otuz kişi var.",
            "translation_fa": "فعلاً حدود سی نفر هستند."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
