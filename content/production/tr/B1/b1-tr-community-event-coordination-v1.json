    },
    {
      "kind": "dialogue",
      "external_id": "d_community_event_coordination_02",
      "data": {
        "lesson_key": "b1-tr-community-event-coordination-02",
        "title": "Duyuruyu aktarmak",
        "setting": "item",
        "cefr": "B1",
        "topic": "community",
        "characters": [
          "Mert",
          "Zeynep"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Mert",
            "text": "Duyuruda önemli bir şey var mı?",
            "translation_fa": "چیز مهمی در اطلاعیه هست؟"
          },
          {
            "order": 2,
            "speaker": "Zeynep",
            "text": "Evet, herkesin kendi bardağını getirmesi isteniyor.",
            "translation_fa": "بله، خواسته شده هرکس لیوان خودش را بیاورد."
          },
          {
            "order": 3,
            "speaker": "Mert",
            "text": "Görevler belli mi?",
            "translation_fa": "مسئولیت‌ها مشخص شده؟"
          },
          {
            "order": 4,
            "speaker": "Zeynep",
            "text": "Evet, ben kayıt masasındayım.",
            "translation_fa": "بله، من مسئول میز ثبت‌نام هستم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_community_event_coordination_03",
      "data": {
        "lesson_key": "b1-tr-community-event-coordination-03",
        "title": "Görev paylaşımı",
        "setting": "item",
        "cefr": "B1",
        "topic": "community",
        "characters": [
          "Kaan",
          "Selin"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Kaan",
            "text": "Akşam gruba ne yazacaksın?",
            "translation_fa": "عصر در گروه چه می‌نویسی؟"
          },
          {
            "order": 2,
            "speaker": "Selin",
            "text": "Saat, buluşma yeri ve görevleri kısaca ileteceğim.",
            "translation_fa": "زمان، محل قرار و مسئولیت‌ها را کوتاه منتقل می‌کنم."
          },
          {
            "order": 3,
            "speaker": "Kaan",
            "text": "Hazırlık erken biterse başka ne yapabiliriz?",
            "translation_fa": "اگر آماده‌سازی زود تمام شود چه کار دیگری می‌توانیم بکنیم؟"
          },
          {
            "order": 4,
            "speaker": "Selin",
            "text": "Girişte katılımcılara yardımcı olabiliriz.",
            "translation_fa": "می‌توانیم در ورودی به شرکت‌کننده‌ها کمک کنیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
