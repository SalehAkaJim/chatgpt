        "status": "validated"
      }
    },
    {
      "kind": "grammar_point",
      "external_id": "g_storytelling_sequence_core",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-01",
        "slug": "b1-tr-storytelling-sequence-grammar",
        "title": "Arka plan: -ken",
        "rule_summary": "Use -ken for a background action while another action happens.",
        "explanation": {
          "fa": "با -ken یک عمل را پس‌زمینه می‌کنیم: beklerken یعنی «وقتی منتظر بودم»."
        },
        "examples": [
          {
            "tr": "Yürürken onu gördüm.",
            "fa": "وقتی راه می‌رفتم او را دیدم."
          },
          {
            "tr": "Tam çıkarken yağmur başladı.",
            "fa": "درست موقع بیرون رفتن باران شروع شد."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_storytelling_sequence_01",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-01",
        "title": "Sabah karmaşası",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Deniz",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Neden geç kaldın?",
            "translation_fa": "چرا دیر کردی؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Tam çıkacakken anahtarımı bulamadım.",
            "translation_fa": "درست موقع بیرون رفتن کلیدم را پیدا نکردم."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Otobüse yetişebildin mi?",
            "translation_fa": "به اتوبوس رسیدی؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Son anda yetiştim ama trafik yoğundu.",
            "translation_fa": "لحظه آخر رسیدم ولی ترافیک سنگین بود."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_storytelling_sequence_02",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-02",
        "title": "Yolda ne oldu?",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Zeynep",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Zeynep",
            "text": "Dün seni aradım ama ulaşamadım.",
            "translation_fa": "دیروز زنگ زدم ولی نتوانستم پیدایت کنم."
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Metrodayken telefon çekmiyordu.",
            "translation_fa": "وقتی مترو بودم آنتن نمی‌داد."
          },
          {
            "order": 3,
            "speaker": "Zeynep",
            "text": "Sonra ne yaptın?",
            "translation_fa": "بعد چه کار کردی؟"
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "İnince seni geri aradım.",
            "translation_fa": "وقتی پیاده شدم دوباره زنگ زدم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_storytelling_sequence_03",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-03",
        "title": "Kısa bir olayı aktar",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Elif",
          "Kaan"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "Dün neden toplantıya geç geldin?",
            "translation_fa": "دیروز چرا دیر به جلسه رسیدی؟"
          },
          {
            "order": 2,
            "speaker": "Kaan",
            "text": "Ofise gelirken metro birden durdu.",
            "translation_fa": "وقتی به دفتر می‌آمدم مترو ناگهان ایستاد."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Sonra ne yaptın?",
            "translation_fa": "بعد چه کار کردی؟"
          },
          {
            "order": 4,
            "speaker": "Kaan",
            "text": "Bir sonraki durakta indim, otobüse bindim ve sonunda yetiştim.",
            "translation_fa": "ایستگاه بعد پیاده شدم، سوار اتوبوس شدم و در نهایت رسیدم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
