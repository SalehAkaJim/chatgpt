      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-01",
        "slug": "b1-tr-storytelling-sequence-grammar",
        "title": "Arka plan: -ken",
        "rule_summary": "Use -ken for a background action while another action happens.",
        "explanation": {
          "fa": "با -ken یک عمل را پس‌زمینه می‌کنیم: beklerken یعنی «وقتی منتظر بودم»."
        },
        "examples": [
          {
            "tr": "Yürürken onu gördüm.",
            "fa": "وقتی راه می‌رفتم او را دیدم."
          },
          {
            "tr": "Tam çıkarken yağmur başladı.",
            "fa": "درست موقع بیرون رفتن باران شروع شد."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_storytelling_sequence_01",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-01",
        "title": "Sabah karmaşası",
        "setting": "",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Deniz",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Neden geç kaldın?",
            "translation_fa": "چرا دیر کردی؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Tam çıkacakken anahtarımı bulamadım.",
            "translation_fa": "درست موقع بیرون رفتن کلیدم را پیدا نکردم."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Otobüse yetişebildin mi?",
            "translation_fa": "به اتوبوس رسیدی؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Son anda yetiştim ama trafik yoğundu.",
            "translation_fa": "لحظه آخر رسیدم ولی ترافیک سنگین بود."
          }
        ],
        "qa": {
