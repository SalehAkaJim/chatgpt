      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-01",
        "text": {
          "tr": "Tam evden çıkacakken telefon çaldı."
        },
        "translations": {
          "fa": "درست وقتی می‌خواستم بیرون بروم تلفن زنگ زد."
        },
        "intent": "interruption",
        "concept_refs": [
          "tr_b1_storytelling_sequence_tam"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
