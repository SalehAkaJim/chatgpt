      }
    },
    {
      "kind": "utterance",
      "external_id": "u_storytelling_sequence_02",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-01",
        "text": {
          "tr": "Otobüsü beklerken birden yağmur başladı."
        },
        "translations": {
          "fa": "وقتی منتظر اتوبوس بودم ناگهان باران شروع شد."
        },
        "intent": "background",
        "concept_refs": [
          "tr_b1_storytelling_sequence_birden"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "validated"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_storytelling_sequence_03",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-02",
        "text": {
          "tr": "Toplantıya biraz geç kaldım ama yetiştim."
        },
        "translations": {
          "fa": "کمی دیر به جلسه رسیدم اما رسیدم."
        },
        "intent": "result",
        "concept_refs": [
          "tr_b1_storytelling_sequence_gecikmek",
          "tr_b1_storytelling_sequence_yetismek"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "validated"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_storytelling_sequence_04",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-02",
        "text": {
          "tr": "Sonunda her şey yoluna girdi."
        },
        "translations": {
          "fa": "در نهایت همه‌چیز روبه‌راه شد."
        },
        "intent": "close_story",
        "concept_refs": [
          "tr_b1_storytelling_sequence_sonunda"
        ],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "validated"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_storytelling_sequence_05",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-03",
        "text": {
          "tr": "Eve dönerken otobüsü kaçırdım, bu yüzden bir süre yürümek zorunda kaldım."
        },
        "translations": {
          "fa": "وقتی به خانه برمی‌گشتم اتوبوس را از دست دادم، برای همین مجبور شدم مدتی پیاده بروم."
        },
        "intent": "narrate_complication",
        "concept_refs": [],
        "cefr": "B1",
        "topic": "simple-messages",
        "register": "neutral",
        "status": "validated"
      }
    },
    {
      "kind": "utterance",
      "external_id": "u_storytelling_sequence_06",
      "data": {
        "lesson_key": "b1-tr-storytelling-sequence-03",
        "text": {
          "tr": "Sonunda başka bir otobüse bindim ve beklediğimden geç eve vardım."
        },
        "translations": {
          "fa": "در نهایت سوار اتوبوس دیگری شدم و دیرتر از انتظار به خانه رسیدم."
        },
        "intent": "close_narrative",
        "concept_refs": [],
        "cefr": "B1",
