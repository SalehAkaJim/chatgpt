    {
      "kind": "dialogue",
      "external_id": "d_reported_information_01",
      "data": {
        "lesson_key": "b1-tr-reported-information-01",
        "title": "Toplantı haberi",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Deniz",
          "Burak"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Deniz",
            "text": "Toplantı saatini değiştirmişler mi?",
            "translation_fa": "ساعت جلسه را عوض کرده‌اند؟"
          },
          {
            "order": 2,
            "speaker": "Burak",
            "text": "Zeynep toplantının ertelendiğini söyledi.",
            "translation_fa": "زینب گفت جلسه عقب افتاده است."
          },
          {
            "order": 3,
            "speaker": "Deniz",
            "text": "Yeni saati biliyor musun?",
            "translation_fa": "ساعت جدید را می‌دانی؟"
          },
          {
            "order": 4,
            "speaker": "Burak",
            "text": "Henüz açıklanmadığını duydum.",
            "translation_fa": "شنیدم هنوز اعلام نشده است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_reported_information_02",
      "data": {
        "lesson_key": "b1-tr-reported-information-02",
        "title": "Doğrulanmamış haber",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Zeynep",
          "Mert"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Zeynep",
            "text": "Mert'in taşınacağını duydun mu?",
            "translation_fa": "شنیدی مرت قرار است اسباب‌کشی کند؟"
          },
          {
            "order": 2,
            "speaker": "Mert",
            "text": "Evet ama tarih belli değil.",
            "translation_fa": "بله، ولی تاریخ مشخص نیست."
          },
          {
            "order": 3,
            "speaker": "Zeynep",
            "text": "Selin gelecek ay dedi.",
            "translation_fa": "سلین گفت ماه بعد."
          },
          {
            "order": 4,
            "speaker": "Mert",
            "text": "O bilgi henüz doğrulanmadı.",
            "translation_fa": "آن اطلاعات هنوز تأیید نشده است."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_reported_information_03",
      "data": {
        "lesson_key": "b1-tr-reported-information-03",
        "title": "Bilgiyi aktar",
        "setting": "item",
        "cefr": "B1",
        "topic": "simple-messages",
        "characters": [
          "Elif",
          "Emre"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "Elif",
            "text": "İnsan kaynakları ne söyledi?",
            "translation_fa": "منابع انسانی چه گفت؟"
          },
          {
            "order": 2,
            "speaker": "Emre",
            "text": "Formun bugün gönderilmesi gerektiğini söylediler.",
            "translation_fa": "گفتند فرم باید امروز فرستاده شود."
          },
          {
            "order": 3,
            "speaker": "Elif",
            "text": "Başka bir şey var mı?",
            "translation_fa": "چیز دیگری هم هست؟"
          },
          {
            "order": 4,
            "speaker": "Emre",
            "text": "Evet, eksik belge varsa bize haber vermemizi istediler.",
            "translation_fa": "بله، خواستند اگر مدرکی کم است به آن‌ها خبر بدهیم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
          "single_situation": true
        },
        "status": "validated"
      }
