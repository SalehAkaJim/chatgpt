        "slug": "b1-tr-reported-information-grammar",
        "title": "Dolaylı anlatım: -DIK",
        "rule_summary": "Report propositions with a nominalized -DIK clause plus verbs such as söylemek and duymak.",
        "explanation": {
          "fa": "برای گزارش غیرمستقیم، جمله اغلب با -DIK اسمی می‌شود: ertelendiğini söyledi یعنی «گفت که عقب افتاده»."
        },
        "examples": [
          {
            "tr": "Geleceğini söyledi.",
            "fa": "گفت که خواهد آمد."
          },
          {
            "tr": "Taşındıklarını duydum.",
            "fa": "شنیدم که اسباب‌کشی کرده‌اند."
          }
        ],
        "cefr": "B1",
        "status": "validated"
      }
