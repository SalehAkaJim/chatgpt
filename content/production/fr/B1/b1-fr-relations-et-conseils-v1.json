        ],
        "turns": [
          {
            "order": 1,
            "speaker": "inès",
            "text": "Depuis hier, elle ne répond plus à mes messages.",
            "translation_fa": "از دیروز دیگر به پیام‌هایم جواب نمی‌دهد."
          },
          {
            "order": 2,
            "speaker": "hugo",
            "text": "Peut-être qu'il y a simplement un malentendu.",
            "translation_fa": "شاید فقط یک سوءتفاهم باشد."
