      "data": {
        "lesson_key": "a2-fr-opinions-and-media-01",
        "slug": "a2-fr-opinions-and-media-grammar",
        "title": "Exprimer une opinion et reprendre un objet",
        "rule_summary": "Use à mon avis / je trouve que / je préfère to express an opinion. Direct-object pronouns can replace a previously mentioned object.",
        "explanation": {
          "fa": "برای بیان نظر از à mon avis، je trouve que و je préfère استفاده می‌شود. ضمیر مفعولی مستقیم می‌تواند جای چیزی را بگیرد که قبلاً گفته شده است."
        },
        "examples": [
          {
            "fr": "À mon avis, c'est intéressant.",
            "fa": "به نظر من جالب است."
          },
          {
            "fr": "Je l'ai trouvé un peu long.",
            "fa": "به نظرم کمی طولانی بود."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
