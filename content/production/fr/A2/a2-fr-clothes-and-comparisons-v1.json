      "external_id": "g_clothes_and_comparisons_core",
      "data": {
        "lesson_key": "a2-fr-clothes-and-comparisons-01",
        "slug": "a2-fr-clothes-and-comparisons-grammar",
        "title": "Comparer avec plus, moins et aussi",
        "rule_summary": "Compare qualities with plus/moins/aussi + adjective + que. Pronouns such as le/la can avoid repeating a known object.",
        "explanation": {
          "fa": "برای مقایسه از plus / moins / aussi + صفت + que استفاده می‌شود. وقتی شیء مشخص است، ضمیر le یا la می‌تواند از تکرار اسم جلوگیری کند."
        },
        "examples": [
          {
            "fr": "Cette veste est moins chère.",
            "fa": "این ژاکت ارزان‌تر است."
          },
          {
            "fr": "Ce pantalon est plus confortable que l'autre.",
            "fa": "این شلوار از آن یکی راحت‌تر است."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
