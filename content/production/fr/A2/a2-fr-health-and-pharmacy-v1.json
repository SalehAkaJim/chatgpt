    {
      "kind": "dialogue",
      "external_id": "d_health_and_pharmacy_02",
      "data": {
        "lesson_key": "a2-fr-health-and-pharmacy-02",
        "title": "Un conseil",
        "setting": "item",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "claire",
          "thomas"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "claire",
            "text": "Tu n'as pas l'air en forme.",
            "translation_fa": "به نظر سرحال نمی‌آیی."
          },
          {
            "order": 2,
            "speaker": "thomas",
            "text": "Je suis fatigué depuis ce matin.",
            "translation_fa": "از صبح خسته‌ام."
          },
          {
            "order": 3,
            "speaker": "claire",
            "text": "Tu devrais rentrer et te reposer.",
            "translation_fa": "بهتره برگردی و استراحت کنی."
          },
          {
            "order": 4,
            "speaker": "thomas",
            "text": "Oui, je crois que tu as raison.",
            "translation_fa": "بله، فکر کنم حق با توست."
          }
        ],
