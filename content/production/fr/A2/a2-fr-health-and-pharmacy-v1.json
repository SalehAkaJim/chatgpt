    {
      "kind": "grammar_point",
      "external_id": "g_health_and_pharmacy_core",
      "data": {
        "lesson_key": "a2-fr-health-and-pharmacy-01",
        "slug": "a2-fr-health-and-pharmacy-grammar",
        "title": "Depuis et les conseils avec devoir au conditionnel",
        "rule_summary": "Use depuis with a present state that began earlier and still continues. Vous devriez + infinitive gives mild advice.",
        "explanation": {
          "fa": "برای حالتی که از گذشته شروع شده و هنوز ادامه دارد، depuis با زمان حال می‌آید. vous devriez + مصدر برای توصیه ملایم و مؤدبانه است."
        },
        "examples": [
          {
            "fr": "J'ai mal depuis hier.",
            "fa": "از دیروز درد دارم."
          },
          {
            "fr": "Vous devriez vous reposer.",
            "fa": "بهتر است استراحت کنید."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
    {
      "kind": "dialogue",
      "external_id": "d_health_and_pharmacy_01",
      "data": {
        "lesson_key": "a2-fr-health-and-pharmacy-01",
        "title": "À la pharmacie",
        "setting": "item",
        "cefr": "A2",
        "topic": "common-actions",
        "characters": [
          "inès",
          "julien"
        ],
        "turns": [
          {
            "order": 1,
            "speaker": "inès",
            "text": "Bonjour, j'ai mal à la gorge depuis deux jours.",
            "translation_fa": "سلام، دو روز است گلودرد دارم."
          },
          {
            "order": 2,
            "speaker": "julien",
            "text": "Vous avez de la fièvre ?",
            "translation_fa": "تب دارید؟"
          },
          {
            "order": 3,
            "speaker": "inès",
            "text": "Un peu, surtout le soir.",
            "translation_fa": "کمی، بیشتر شب‌ها."
          },
          {
            "order": 4,
            "speaker": "julien",
            "text": "Je vais vous montrer un médicament adapté.",
            "translation_fa": "یک داروی مناسب به شما نشان می‌دهم."
          }
        ],
        "qa": {
          "character_pair_unique_within_unit": true,
          "naturalness": "passed",
