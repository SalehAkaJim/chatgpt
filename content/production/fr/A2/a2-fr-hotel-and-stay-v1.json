      "data": {
        "lesson_key": "a2-fr-hotel-and-stay-01",
        "slug": "a2-fr-hotel-and-stay-grammar",
        "title": "Demander poliment avec pouvoir et devoir",
        "rule_summary": "Use pouvez-vous + infinitive for polite service requests and devoir + infinitive for obligations or requirements.",
        "explanation": {
          "fa": "برای درخواست مؤدبانه در خدمات می‌توان از pouvez-vous + مصدر استفاده کرد. devoir + مصدر هم برای الزام یا کاری که باید انجام شود به کار می‌رود."
        },
        "examples": [
          {
            "fr": "Pouvez-vous confirmer ma réservation ?",
            "fa": "می‌توانید رزرو من را تأیید کنید؟"
          },
          {
            "fr": "Je dois montrer mon passeport.",
            "fa": "باید گذرنامه‌ام را نشان بدهم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
