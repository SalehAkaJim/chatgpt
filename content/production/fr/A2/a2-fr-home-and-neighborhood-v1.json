      "data": {
        "lesson_key": "a2-fr-home-and-neighborhood-01",
        "slug": "a2-fr-home-and-neighborhood-grammar",
        "title": "Les comparatifs dans une description",
        "rule_summary": "Use plus/moins/aussi + adjective + que to compare places; beaucoup de introduces a large quantity before a noun.",
        "explanation": {
          "fa": "برای مقایسه مکان‌ها از plus / moins / aussi + صفت + que استفاده می‌شود. beaucoup de قبل از اسم مقدار زیاد را نشان می‌دهد."
        },
        "examples": [
          {
            "fr": "Ce quartier est plus tranquille.",
            "fa": "این محله آرام‌تر است."
          },
          {
            "fr": "Il y a beaucoup de bruit.",
            "fa": "سر و صدای زیادی هست."
          }
        ],
        "cefr": "A2",
        "status": "validated"
