    {
      "kind": "grammar_point",
      "external_id": "g_work_and_obligations_core",
      "data": {
        "lesson_key": "a2-fr-work-and-obligations-01",
        "slug": "a2-fr-work-and-obligations-grammar",
        "title": "Devoir, pouvoir et la négation",
        "rule_summary": "Use devoir + infinitive for obligation and pouvoir + infinitive for ability or permission; ne...pas surrounds the conjugated modal.",
        "explanation": {
          "fa": "devoir + مصدر الزام را می‌رساند و pouvoir + مصدر توانایی یا امکان را. در منفی‌کردن، ne...pas دور فعل صرف‌شده می‌آید."
        },
        "examples": [
          {
            "fr": "Je dois terminer ce dossier.",
            "fa": "باید این پرونده را تمام کنم."
          },
          {
            "fr": "Je ne peux pas rester.",
            "fa": "نمی‌توانم بمانم."
          }
        ],
        "cefr": "A2",
        "status": "validated"
      }
    },
