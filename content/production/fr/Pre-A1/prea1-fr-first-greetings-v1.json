    {
      "kind": "grammar_point",
      "external_id": "g_first_greetings_core",
      "data": {
        "lesson_key": "prea1-fr-first-greetings-01",
        "slug": "prea1-fr-first-greetings-grammar",
        "title": "Bonjour / salut",
        "rule_summary": "French greetings depend on register and time of day. Bonjour is a safe neutral daytime greeting; salut is informal.",
        "explanation": {
          "fa": "«Bonjour» برای شروع خنثی و امن در روز مناسب است؛ «salut» خودمانی است. در فرانسوی انتخاب سلام به رابطه و موقعیت بستگی دارد."
        },
        "examples": [
          {
            "fr": "Bonjour, madame.",
            "fa": "روز بخیر خانم."
          },
          {
            "fr": "Salut, Hugo !",
            "fa": "سلام هوگو!"
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
    },
