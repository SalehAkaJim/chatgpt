      "data": {
        "lesson_key": "prea1-fr-my-name-01",
        "slug": "prea1-fr-my-name-grammar",
        "title": "Je m'appelle… / Je suis…",
        "rule_summary": "Use Je m'appelle… as the most common beginner introduction. Je suis + first name is possible but less canonical for introducing yourself.",
        "explanation": {
          "fa": "برای معرفی، «Je m'appelle…» الگوی اصلی و طبیعی‌تر است. «Je suis + نام» هم ممکن است، اما فعلاً معرفی با «Je m'appelle…» را پایه بگیر."
        },
        "examples": [
          {
            "fr": "Je m'appelle Léa.",
            "fa": "اسمم لئاست."
          },
          {
            "fr": "Comment tu t'appelles ?",
            "fa": "اسمت چیه؟"
          }
        ],
        "cefr": "Pre-A1",
        "status": "validated"
      }
