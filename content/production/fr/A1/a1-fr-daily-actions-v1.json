    {
      "kind": "grammar_point",
      "external_id": "g_daily_actions_core",
      "data": {
        "lesson_key": "a1-fr-daily-actions-01",
        "slug": "a1-fr-daily-actions-grammar",
        "title": "Le présent des verbes en -er",
        "rule_summary": "Many regular -er verbs use -e, -es, -e with je, tu, il/elle.",
        "explanation": {
          "fa": "بسیاری از فعل‌های -er در زمان حال با je به -e، با tu به -es و با il/elle دوباره به -e ختم می‌شوند: je travaille, tu travailles, elle travaille."
        },
        "examples": [
          {
            "fr": "Je travaille ici.",
            "fa": "اینجا کار می‌کنم."
          },
          {
            "fr": "Tu étudies le français ?",
            "fa": "فرانسوی می‌خوانی؟"
          }
        ],
        "cefr": "A1",
        "status": "validated"
      }
    },
