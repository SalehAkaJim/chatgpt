{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.local/api/lesson-payload.schema.json",
  "title": "Nova Frontend Lesson Payload v1",
  "type": "object",
  "required": ["schema_version", "lesson", "course", "path", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "lesson": {
      "type": "object",
      "required": ["id", "slug", "title", "status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "slug": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "objective": {"type": ["string", "null"]},
        "estimated_minutes": {"type": ["integer", "null"], "minimum": 1},
        "sort_order": {"type": "integer"},
        "status": {"type": "string"}
      },
      "additionalProperties": false
    },
    "course": {
      "type": "object",
      "required": ["slug", "learner", "target"],
      "properties": {
        "slug": {"type": "string"},
        "title": {"type": "string"},
        "learner": {"$ref": "#/$defs/language"},
        "target": {"$ref": "#/$defs/language"}
      },
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "required": ["cefr", "unit"],
      "properties": {
        "cefr": {"enum": ["Pre-A1", "A1", "A2", "B1", "B2", "C1", "C2"]},
        "unit": {
          "type": "object",
          "properties": {
            "slug": {"type": ["string", "null"]},
            "title": {"type": ["string", "null"]},
            "objective": {"type": ["string", "null"]}
          },
          "required": ["slug", "title", "objective"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "language": {
      "type": "object",
      "required": ["language", "variant"],
      "properties": {"language": {"type": "string"}, "variant": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "key", "order", "stage", "type", "required", "items", "exercises", "metadata"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "key": {"type": "string"},
        "order": {"type": "integer", "minimum": 1}, "stage": {"type": "string"},
        "type": {"type": "string"}, "label_key": {"type": ["string", "null"]},
        "required": {"type": "boolean"},
        "items": {"type": "array", "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"type": "string"}, "content": {"type": "object", "required": ["kind", "id"]}}},
        "exercises": {"type": "array", "items": {"type": "object", "required": ["role", "exercise"], "properties": {"role": {"type": "string"}, "exercise": {"$ref": "#/$defs/exercise"}}},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "required": ["id", "type", "prompt", "options", "evaluation_mode", "annotations", "status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "type": {"type": "string"}, "prompt": {},
        "options": {"type": "array"}, "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "evaluation_mode": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}},
        "audio": {"type": ["object", "null"]}, "status": {"type": "string"}
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["start", "end", "surface", "type", "confidence", "provenance", "entry"],
      "properties": {
        "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "surface": {"type": "string"}, "type": {"enum": ["word", "phrase", "expression", "morpheme"]},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "provenance": {"type": "string"},
        "entry": {"type": "object", "properties": {
          "concept_id": {"type": ["string", "null"]}, "lexeme_id": {"type": ["string", "null"]},
          "word_form_id": {"type": ["string", "null"]}, "lemma": {"type": ["string", "null"]},
          "part_of_speech": {"type": ["string", "null"]}, "pronunciation": {"type": ["string", "null"]},
          "transliteration": {"type": ["string", "null"]}, "form": {"type": ["string", "null"]},
          "grammatical_features": {"type": ["object", "null"]}, "meaning": {"type": ["string", "null"]}
        }}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
