PRE_SPECS = json.loads('[{"slug":"prea1-de-first-greetings","name":"first-greetings","title":"Hallo!","topic":"greetings","skill":"foundations","lessons":2,"objective":"Recognize and use the most basic German greetings and farewells.","grammar":"German greeting chunks can be learned as complete expressions; nouns such as Morgen are capitalized.","note":"از همان ابتدا حروف بزرگ اسم\u200cها را نگه دار؛ «Morgen» در عبارت «Guten Morgen» با حرف بزرگ نوشته می\u200cشود.","vocab":[{"surface":"Hallo!","fa":"سلام!","pos":"interjection","lemma":"Hallo"},{"surface":"Guten Morgen!","fa":"صبح بخیر!","pos":"expression","lemma":"Guten Morgen!"},{"surface":"Tschüss!","fa":"فعلاً / خداحافظ!","pos":"interjection","lemma":"Tschüss"},{"surface":"Auf Wiedersehen!","fa":"خداحافظ!","pos":"expression","lemma":"Auf Wiedersehen!"},{"surface":"Guten Tag!","fa":"روز بخیر!","pos":"expression","lemma":"Guten Tag!"},{"surface":"Bis bald!","fa":"به\u200cزودی می\u200cبینمت!","pos":"expression","lemma":"Bis bald!"}],"scenes":[["An der Tür",[["Hallo!","سلام!"],["Hallo!","سلام!"],["Guten Morgen!","صبح بخیر!"],["Guten Morgen!","صبح بخیر!"]]],["Nach dem Kurs",[["Tschüss!","فعلاً!"],["Tschüss!","فعلاً!"],["Bis bald!","به\u200cزودی می\u200cبینمت!"],["Auf Wiedersehen!","خداحافظ!"]]]]},{"slug":"prea1-de-my-name","name":"my-name","title":"Mein Name","topic":"introductions","skill":"foundations","lessons":2,"objective":"Say your name and ask another person’s name with memorized beginner phrases.","grammar":"Use Ich heiße … or Ich bin … to give a name; Wie heißt du? asks an informal partner’s name.","note":"در آلمانی فاعل معمولاً گفته می\u200cشود: «Ich heiße …». فعل با شخص تغییر می\u200cکند، اما در Pre-A1 عبارت را یک تکه یاد می\u200cگیریم.","vocab":[{"surface":"Ich heiße Mia.","fa":"اسم من میاست.","pos":"expression","lemma":"Ich heiße Mia."},{"surface":"Wie heißt du?","fa":"اسمت چیه؟","pos":"expression","lemma":"Wie heißt du?"},{"surface":"Ich bin Leo.","fa":"من لئو هستم.","pos":"expression","lemma":"Ich bin Leo."},{"surface":"Und du?","fa":"و تو؟","pos":"expression","lemma":"Und du?"},{"surface":"Mein Name ist Anna.","fa":"اسم من آناست.","pos":"expression","lemma":"Mein Name ist Anna."},{"surface":"Freut mich.","fa":"خوشوقتم.","pos":"expression","lemma":"Freut mich."}],"scenes":[["Erstes Treffen",[["Hallo! Ich heiße Mia.","سلام! اسم من میاست."],["Hallo! Ich bin Jonas.","سلام! من یوناس هستم."],["Freut mich.","خوشوقتم."],["Mich auch.","من هم همین\u200cطور."]]],["Im Kurs",[["Wie heißt du?","اسمت چیه؟"],["Ich heiße Lea. Und du?","اسم من لیاست. و تو؟"],["Ich bin Emil.","من امیل هستم."],["Freut mich!","خوشوقتم!"]]]]},{"slug":"prea1-de-numbers-0-10","name":"numbers-0-10","title":"0 bis 10","topic":"numbers","skill":"foundations","lessons":2,"objective":"Recognize and say German numbers from zero to ten.","grammar":"Numbers 0–10 are learned as fixed forms before larger German number patterns.","note":"فعلاً عددها را به\u200cصورت واژه\u200cهای مستقل یاد بگیر؛ ترتیب برعکسِ عددهای بالاتر از ۲۰ هنوز وارد نمی\u200cشود.","vocab":[{"surface":"null","fa":"صفر","pos":"numeral","lemma":"null"},{"surface":"eins","fa":"یک","pos":"numeral","lemma":"eins"},{"surface":"zwei","fa":"دو","pos":"numeral","lemma":"zwei"},{"surface":"drei","fa":"سه","pos":"numeral","lemma":"drei"},{"surface":"fünf","fa":"پنج","pos":"numeral","lemma":"fünf"},{"surface":"zehn","fa":"ده","pos":"numeral","lemma":"zehn"}],"scenes":[["Zahlen im Kurs",[["Eins, zwei, drei.","یک، دو، سه."],["Vier, fünf.","چهار، پنج."],["Sechs, sieben.","شش، هفت."],["Acht, neun, zehn.","هشت، نه، ده."]]],["Eine Nummer",[["Null, eins, zwei?","صفر، یک، دو؟"],["Ja: null, eins, zwei.","بله: صفر، یک، دو."],["Und drei?","و سه؟"],["Drei.","سه."]]]]},{"slug":"prea1-de-alphabet","name":"alphabet","title":"Das Alphabet","topic":"script-basics","skill":"literacy","lessons":2,"objective":"Recognize the Latin letters used in German and the special characters ä, ö, ü and ß.","grammar":"German uses the Latin alphabet plus Ä/ä, Ö/ö, Ü/ü and ß; these spellings are meaningful.","note":"اوملاوت\u200cها و ß تزئینی نیستند و می\u200cتوانند شکل و معنی واژه را عوض کنند؛ آن\u200cها را بخشی از املای کلمه ببین.","vocab":[{"surface":"A","fa":"حرف A","pos":"letter","lemma":"A"},{"surface":"B","fa":"حرف B","pos":"letter","lemma":"B"},{"surface":"M","fa":"حرف M","pos":"letter","lemma":"M"},{"surface":"S","fa":"حرف S","pos":"letter","lemma":"S"},{"surface":"Ü","fa":"حرف Ü","pos":"letter","lemma":"Ü"},{"surface":"ß","fa":"حرف ß","pos":"letter","lemma":"ß"}],"scenes":[["Buchstaben sehen",[["Das ist A.","این A است."],["Das ist B.","این B است."],["Und das?","و این؟"],["Das ist Ü.","این Ü است."]]],["Sonderzeichen",[["Ä, Ö, Ü.","Ä، Ö، Ü."],["Und ß.","و ß."],["Ist ß ein B?","آیا ß یک B است؟"],["Nein.","نه."]]]]},{"slug":"prea1-de-letter-names","name":"letter-names","title":"Buchstaben hören","topic":"sound-letter-mapping","skill":"literacy","lessons":2,"objective":"Hear common German letter names and spell very short names.","grammar":"German letter names are not always the same as English letter names; spelling is introduced as a listening skill.","note":"اسم حروف آلمانی را با صدای آلمانی یاد بگیر؛ دانستن الفبای انگلیسی برای املای آلمانی کافی نیست.","vocab":[{"surface":"A – a","fa":"A، آ","pos":"expression","lemma":"A – a"},{"surface":"B – be","fa":"B، بِ","pos":"expression","lemma":"B – be"},{"surface":"D – de","fa":"D، دِ","pos":"expression","lemma":"D – de"},{"surface":"E – e","fa":"E، اِ","pos":"expression","lemma":"E – e"},{"surface":"M – em","fa":"M، اِم","pos":"expression","lemma":"M – em"},{"surface":"S – es","fa":"S، اِس","pos":"expression","lemma":"S – es"}],"scenes":[["Name buchstabieren",[["Mia. M-I-A.","میا. M-I-A."],["M-I-A?","M-I-A؟"],["Ja.","بله."],["Danke.","ممنون."]]],["Ein kurzer Name",[["Leo. L-E-O.","لئو. L-E-O."],["L-E-O.","L-E-O."],["Richtig.","درسته."],["Gut!","خوبه!"]]]]},{"slug":"prea1-de-first-sounds","name":"first-sounds","title":"Erste Laute","topic":"sound-letter-mapping","skill":"literacy","lessons":2,"objective":"Notice a few high-value German spelling-to-sound patterns in familiar words.","grammar":"Common beginner sound patterns include sch, ei, ie, eu, z and w.","note":"در آلمانی «ei» معمولاً شبیه «آی» و «ie» معمولاً صدای کشیدهٔ «ای» دارد؛ w هم معمولاً شبیه v انگلیسی شنیده می\u200cشود.","vocab":[{"surface":"Schule","fa":"مدرسه","pos":"noun","lemma":"Schule","gender":"feminine"},{"surface":"mein","fa":"مال من / ـم","pos":"determiner","lemma":"mein"},{"surface":"Liebe","fa":"عشق / علاقه","pos":"noun","lemma":"Liebe","gender":"feminine"},{"surface":"heute","fa":"امروز","pos":"adverb","lemma":"heute"},{"surface":"zwei","fa":"دو","pos":"numeral","lemma":"zwei"},{"surface":"Wasser","fa":"آب","pos":"noun","lemma":"Wasser","gender":"neuter"}],"scenes":[["Laute vergleichen",[["Schule beginnt mit sch.","Schule با sch شروع می\u200cشود."],["Sch.","sch."],["Zwei beginnt mit z.","Zwei با z شروع می\u200cشود."],["Zwei.","دو."]]],["Ei oder ie?",[["Mein: ei.","Mein: ei."],["Liebe: ie.","Liebe: ie."],["Heute: eu.","Heute: eu."],["Gut gehört!","خوب شنیدی!"]]]]},{"slug":"prea1-de-first-objects","name":"first-objects","title":"Erste Dinge","topic":"objects","skill":"describing","lessons":2,"objective":"Recognize a few everyday German nouns together with their articles.","grammar":"German nouns are capitalized and are best learned with der, die or das.","note":"از همین ابتدا اسم را با حرف تعریفش حفظ کن: «der Stift»، «die Tasche»، «das Buch».","vocab":[{"surface":"der Stift","fa":"خودکار / مداد","pos":"noun","lemma":"Stift","gender":"masculine"},{"surface":"das Buch","fa":"کتاب","pos":"noun","lemma":"Buch","gender":"neuter"},{"surface":"die Tasche","fa":"کیف","pos":"noun","lemma":"Tasche","gender":"feminine"},{"surface":"der Tisch","fa":"میز","pos":"noun","lemma":"Tisch","gender":"masculine"},{"surface":"die Tür","fa":"در","pos":"noun","lemma":"Tür","gender":"fe